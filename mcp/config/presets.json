{
  "presets": {
    "openaiDeveloperDocs": {
      "transport": "http",
      "url": "https://developers.openai.com/mcp"
    },
    "cloudflare-api": {
      "transport": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "cloudflare-docs": {
      "transport": "http",
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "xcode": {
      "transport": "stdio",
      "command": "xcrun",
      "args": [
        "mcpbridge"
      ],
      "startup_timeout_sec": 180,
      "tool_timeout_sec": 120
    }
  },
  "global_presets": [],
  "plugin_presets": {
    "xcodebuildmcp": {
      "command": "npx",
      "args": [
        "-y",
        "xcodebuildmcp@latest",
        "mcp"
      ],
      "env": {
        "XCODEBUILDMCP_ENABLED_WORKFLOWS": "simulator,ui-automation,debugging,logging"
      },
      "transport": "stdio"
    }
  },
  "plugin_global_presets": []
}
