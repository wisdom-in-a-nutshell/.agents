{
  "managed_hooks": [
    {
      "command": "python3 \"$HOME/GitHub/agents/hooks/scripts/session_start.py\" --runtime {runtime}",
      "enabled": true,
      "event": "SessionStart",
      "id": "repo-session-start",
      "matchers": {
        "codex": "startup|resume|clear",
        "claude": "startup|resume|clear|compact"
      },
      "repos": [
        "adi",
        "angie"
      ],
      "runtimes": [
        "codex",
        "claude"
      ],
      "scope": "repo",
      "timeout": 5
    },
    {
      "command": "python3 \"$HOME/GitHub/agents/hooks/scripts/user_prompt_submit.py\" --runtime {runtime}",
      "enabled": true,
      "event": "UserPromptSubmit",
      "id": "repo-user-prompt-submit",
      "repos": [
        "adi",
        "angie"
      ],
      "runtimes": [
        "codex",
        "claude"
      ],
      "scope": "repo",
      "timeout": 5
    },
    {
      "command": "python3 \"$HOME/GitHub/agents/hooks/scripts/stop.py\" --runtime {runtime}",
      "enabled": true,
      "event": "Stop",
      "id": "global-stop",
      "runtimes": [
        "codex"
      ],
      "scope": "global",
      "timeout": 900
    }
  ],
  "version": 1
}
