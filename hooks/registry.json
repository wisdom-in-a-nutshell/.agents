{
  "managed_hooks": [
    {
      "command": "python3 ~/.agents/hooks/scripts/session_start.py --runtime {runtime}",
      "enabled": true,
      "event": "SessionStart",
      "id": "repo-session-start",
      "matchers": {
        "codex": "startup|resume|clear"
      },
      "repos": [
        "adi",
        "angie"
      ],
      "runtimes": [
        "codex"
      ],
      "scope": "repo",
      "timeout": 5
    },
    {
      "command": "python3 ~/.agents/hooks/scripts/user_prompt_submit.py --runtime {runtime}",
      "enabled": true,
      "event": "UserPromptSubmit",
      "id": "repo-user-prompt-submit",
      "repos": [
        "adi",
        "angie"
      ],
      "runtimes": [
        "codex"
      ],
      "scope": "repo",
      "timeout": 5
    },
    {
      "command": "python3 ~/.agents/hooks/scripts/post_compact.py --runtime {runtime}",
      "enabled": true,
      "event": "PostCompact",
      "id": "repo-post-compact",
      "repos": [
        "adi",
        "angie"
      ],
      "runtimes": [
        "codex"
      ],
      "scope": "repo",
      "timeout": 5
    },
    {
      "command": "python3 ~/.agents/hooks/scripts/stop.py --runtime {runtime}",
      "enabled": true,
      "event": "Stop",
      "id": "global-stop",
      "runtimes": [
        "codex"
      ],
      "scope": "global",
      "timeout": 900
    },
    {
      "command": "python3 ~/.agents/hooks/scripts/session_end.py --runtime {runtime}",
      "enabled": true,
      "event": "SessionEnd",
      "id": "repo-session-end",
      "repos": [
        "adi",
        "angie"
      ],
      "runtimes": [
        "codex"
      ],
      "scope": "repo",
      "timeout": 5
    }
  ],
  "version": 1
}
