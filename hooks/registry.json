{
  "managed_hooks": [
    {
      "command": "python3 ~/.agents/hooks/scripts/session_start.py --runtime {runtime}",
      "enabled": true,
      "event": "SessionStart",
      "id": "global-session-start",
      "matchers": {
        "claude": "startup|resume|clear|compact",
        "codex": "startup|resume|clear"
      },
      "runtimes": [
        "codex",
        "claude"
      ],
      "scope": "global",
      "timeout": 5
    },
    {
      "command": "python3 ~/.agents/hooks/scripts/stop.py --runtime {runtime}",
      "enabled": true,
      "event": "Stop",
      "id": "global-stop",
      "runtimes": [
        "codex",
        "claude"
      ],
      "scope": "global",
      "timeout": 900
    }
  ],
  "version": 1
}
