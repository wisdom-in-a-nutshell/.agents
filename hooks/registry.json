{
  "managed_hooks": [
    {
      "command": "python3 ~/.agents/hooks/scripts/session_start.py --runtime {runtime}",
      "enabled": true,
      "event": "SessionStart",
      "id": "repo-session-start",
      "matchers": {
        "claude": "startup|resume|clear|compact",
        "codex": "startup|resume|clear"
      },
      "repos": [
        "adi",
        "angie"
      ],
      "runtimes": [
        "codex",
        "claude",
        "copilot"
      ],
      "scope": "repo",
      "timeout": 5
    },
    {
      "command": "python3 ~/.agents/hooks/scripts/user_prompt_submit.py --runtime {runtime}",
      "enabled": true,
      "event": "UserPromptSubmit",
      "id": "repo-user-prompt-submit",
      "repos": [
        "adi",
        "angie"
      ],
      "runtimes": [
        "codex",
        "claude",
        "copilot"
      ],
      "scope": "repo",
      "timeout": 5
    },
    {
      "command": "python3 ~/.agents/hooks/scripts/stop.py --runtime {runtime}",
      "enabled": true,
      "event": "Stop",
      "id": "repo-stop",
      "repos": [
        "*"
      ],
      "runtimes": [
        "codex",
        "claude",
        "copilot"
      ],
      "scope": "repo",
      "timeout": 900
    },
    {
      "command": "python3 ~/.agents/hooks/scripts/session_end.py --runtime {runtime}",
      "enabled": true,
      "event": "SessionEnd",
      "id": "repo-session-end",
      "matchers": {
        "claude": "clear|resume|logout|prompt_input_exit|bypass_permissions_disabled|other"
      },
      "repos": [
        "adi",
        "angie"
      ],
      "runtimes": [
        "claude",
        "copilot"
      ],
      "scope": "repo",
      "timeout": 5
    }
  ],
  "version": 1
}
