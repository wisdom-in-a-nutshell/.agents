{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "disabledMcpServers": [
    "claude_ai_Google_Drive",
    "Claude_in_Chrome",
    "computer-use"
  ],
  "enableAllProjectMcpServers": true,
  "enabledPlugins": {
    "anthropic-skills@anthropic": false,
    "cowork-plugin-management@anthropic": false,
    "fewer-permission-prompts@builtin": false,
    "init@builtin": false,
    "keybindings-help@builtin": false,
    "loop@builtin": false,
    "review@builtin": false,
    "schedule@builtin": false,
    "security-review@builtin": false,
    "simplify@builtin": false,
    "update-config@builtin": false
  },
  "env": {
    "CLAUDE_CODE_DISABLE_CLAUDE_API_SKILL": "1",
    "CLAUDE_CODE_DISABLE_CRON": "1",
    "CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL": "1",
    "CLAUDE_CODE_DISABLE_POLICY_SKILLS": "1"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "command": "python3 ~/.agents/hooks/scripts/stop.py --runtime claude",
            "timeout": 900,
            "type": "command"
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "sandbox": {
    "enabled": false
  }
}
