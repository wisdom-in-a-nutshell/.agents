{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "control-plane dashboard",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "scripts/control-plane-dashboard.py",
        "serve",
        "--root",
        "."
      ],
      "port": 8765,
      "autoPort": true
    },
    {
      "name": "dashboard-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "dashboard-app", "run", "dev"],
      "port": 5180,
      "autoPort": false
    }
  ]
}
