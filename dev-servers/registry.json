{
  "version": 1,
  "description": "Canonical agent preview server definitions per repo. Rendered into each runtime's own format (Claude Code: .claude/launch.json; Codex: .codex/environments/environment.toml). Opt-in only: a repo gets a launch surface ONLY if it appears here. The `port` and `host` fields are the single source of truth; reference them inside runtimeArgs with the {port} and {host} placeholders rather than hardcoding the literals. Keep production/public Cloudflare services in the scripts repo inventory, not here.",
  "paths": {
    "github_root": "~/GitHub"
  },
  "managed_dev_servers": [
    {
      "repo": "blog-personal",
      "servers": [
        {
          "name": "Preview",
          "host": "127.0.0.1",
          "runtimeExecutable": "pnpm",
          "runtimeArgs": [
            "dev",
            "--host",
            "{host}",
            "--port",
            "{port}"
          ],
          "port": 4321,
          "autoPort": false
        }
      ]
    },
    {
      "repo": "aipodcasting-website",
      "servers": [
        {
          "name": "Preview",
          "host": "127.0.0.1",
          "runtimeExecutable": "pnpm",
          "runtimeArgs": [
            "dev",
            "--host",
            "{host}",
            "--port",
            "{port}"
          ],
          "port": 4322,
          "autoPort": false
        }
      ]
    },
    {
      "repo": "adi",
      "servers": [
        {
          "name": "Dobby Dashboard",
          "host": "127.0.0.1",
          "runtimeExecutable": "/bin/bash",
          "runtimeArgs": [
            "-lc",
            "cd /Users/dobby/GitHub/dobby-engine/dashboard && DOBBY_DASHBOARD_WORKSPACE_ROOT=/Users/dobby/GitHub/adi npm run dev -- --host {host} --port {port} --strictPort"
          ],
          "port": 5174,
          "autoPort": false
        }
      ]
    },
    {
      "repo": "dobby-engine",
      "servers": [
        {
          "name": "Dobby Dashboard",
          "host": "127.0.0.1",
          "runtimeExecutable": "/bin/bash",
          "runtimeArgs": [
            "-lc",
            "cd /Users/dobby/GitHub/dobby-engine/dashboard && DOBBY_DASHBOARD_WORKSPACE_ROOT=/Users/dobby/GitHub/adi npm run dev -- --host {host} --port {port} --strictPort"
          ],
          "port": 5176,
          "autoPort": false
        }
      ]
    },
    {
      "repo": "angie",
      "servers": [
        {
          "name": "Dobby Dashboard",
          "host": "127.0.0.1",
          "runtimeExecutable": "/bin/bash",
          "runtimeArgs": [
            "-lc",
            "cd /Users/dobby/GitHub/dobby-engine/dashboard && DOBBY_DASHBOARD_WORKSPACE_ROOT=/Users/dobby/GitHub/angie npm run dev -- --host {host} --port {port} --strictPort"
          ],
          "port": 5175,
          "autoPort": false
        }
      ]
    },
    {
      "repo": "agents",
      "servers": [
        {
          "name": "Control Plane Dashboard",
          "host": "127.0.0.1",
          "runtimeExecutable": "python3",
          "runtimeArgs": [
            "scripts/control-plane-dashboard.py",
            "serve",
            "--root",
            ".",
            "--host",
            "{host}",
            "--port",
            "{port}"
          ],
          "port": 8765,
          "autoPort": false
        }
      ]
    }
  ],
  "unmanaged_repo_local_dev_servers": []
}
