{
  "version": 1,
  "description": "Canonical agent preview server definitions per repo. Rendered into each runtime's own format (Claude Code: .claude/launch.json; Codex: .codex/environments/environment.toml). Opt-in only: a repo gets a launch surface ONLY if it appears here. Keep production/public Cloudflare services in the scripts repo inventory, not here.",
  "paths": {
    "github_root": "~/GitHub"
  },
  "managed_dev_servers": [
    {
      "repo": "blog-personal",
      "servers": [
        {
          "name": "Preview",
          "host": "127.0.0.1",
          "runtimeExecutable": "pnpm",
          "runtimeArgs": ["dev", "--host", "127.0.0.1", "--port", "4321"],
          "port": 4321,
          "autoPort": false
        }
      ]
    },
    {
      "repo": "aipodcasting-website",
      "servers": [
        {
          "name": "Preview",
          "host": "127.0.0.1",
          "runtimeExecutable": "pnpm",
          "runtimeArgs": ["dev", "--host", "127.0.0.1", "--port", "4322"],
          "port": 4322,
          "autoPort": false
        }
      ]
    },
    {
      "repo": "dobby-dashboard",
      "servers": [
        {
          "name": "Preview",
          "host": "127.0.0.1",
          "runtimeExecutable": "npm",
          "runtimeArgs": ["run", "dev", "--", "--strictPort"],
          "port": 5173,
          "autoPort": false
        }
      ]
    },
    {
      "repo": "adi",
      "servers": [
        {
          "name": "Dobby Dashboard",
          "host": "127.0.0.1",
          "runtimeExecutable": "/bin/bash",
          "runtimeArgs": [
            "-lc",
            "cd /Users/dobby/GitHub/dobby-dashboard && DOBBY_DASHBOARD_WORKSPACE_ROOT=/Users/dobby/GitHub/adi npm run dev -- --host 127.0.0.1 --port 5174 --strictPort"
          ],
          "port": 5174,
          "autoPort": false
        }
      ]
    },
    {
      "repo": "angie",
      "servers": [
        {
          "name": "Dobby Dashboard",
          "host": "127.0.0.1",
          "runtimeExecutable": "/bin/bash",
          "runtimeArgs": [
            "-lc",
            "cd /Users/dobby/GitHub/dobby-dashboard && DOBBY_DASHBOARD_WORKSPACE_ROOT=/Users/dobby/GitHub/angie npm run dev -- --host 127.0.0.1 --port 5175 --strictPort"
          ],
          "port": 5175,
          "autoPort": false
        }
      ]
    }
  ],
  "unmanaged_repo_local_dev_servers": []
}
