{
  "version": 1,
  "description": "Canonical, frontend-agnostic dev/preview server definitions per repo. Rendered into each runtime's own format (Claude Code: .claude/launch.json; Codex/others: their own consumers). Opt-in only: a repo gets a launch surface ONLY if it appears here. Repos not listed are never touched, so public repos and served public/ directories are never written to.",
  "paths": {
    "github_root": "~/GitHub"
  },
  "managed_dev_servers": [
    {
      "repo": "blog-personal",
      "servers": [
        {
          "name": "blog dev (astro)",
          "runtimeExecutable": "pnpm",
          "runtimeArgs": ["dev"],
          "port": 4321,
          "autoPort": true
        },
        {
          "name": "blog production (static, serve dist)",
          "runtimeExecutable": "pnpm",
          "runtimeArgs": ["start"],
          "port": 8793,
          "autoPort": false
        }
      ]
    },
    {
      "repo": "aipodcasting-website-astro",
      "servers": [
        {
          "name": "AI Podcasting production (static)",
          "runtimeExecutable": "pnpm",
          "runtimeArgs": ["start"],
          "port": 8796,
          "autoPort": false
        }
      ]
    },
    {
      "repo": "~/.agents",
      "servers": [
        {
          "name": "control-plane dashboard",
          "runtimeExecutable": "python3",
          "runtimeArgs": ["scripts/control-plane-dashboard.py", "serve", "--root", "."],
          "port": 8765,
          "autoPort": true
        }
      ]
    }
  ],
  "unmanaged_repo_local_dev_servers": []
}
