.DS_Store

# Editor
.vscode/

# OS / tooling
*.swp
*.swo

# Never commit environment or auth artifacts
.env*
!.envrc
!.env.example
!*.env.example
auth.json
credentials*

# Node
node_modules/

# Python
__pycache__/
*.pyc

# Generic caches
.cache/

# Local runtime logs
log/

# Local rendered runtime backups
.codex/*.bak.*

# Obsidian runtime UI state (local/session-specific)
.obsidian/graph.json
.obsidian/workspace*.json
skills/.obsidian/

# Local temp artifacts
/tmp/
/.tmp/
/temp/
