{
  "description": "Managed GitHub Copilot CLI/app-adjacent settings. sync-copilot.py merges settings into ~/.copilot/settings.json, renders trusted folders into ~/.copilot/config.json where the installed CLI stores them, renders ~/.copilot/hooks/agents-control-plane.json, and renders a ~/bin/copilot wrapper for terminal sessions. It intentionally does not copy managed skills into ~/.copilot/skills or .github/skills; Copilot reuses existing .agents/skills and ~/.agents/skills surfaces.",
  "settings": {
    "askUser": false,
    "banner": "never",
    "beep": false,
    "disabledSkills": [
      "af",
      "agent-merge",
      "agentfinder",
      "adi-design",
      "codex-app-server",
      "create-canvas",
      "customize-cloud-agent",
      "find-skills",
      "imagegen",
      "impeccable",
      "media-toolkit",
      "openai-docs",
      "orchestrate",
      "pdf",
      "project",
      "social-media-publishing"
    ],
    "effortLevel": "high",
    "ide.autoConnect": false,
    "ide.openDiffOnEdit": false,
    "memory": false,
    "notifications": false,
    "showTipsOnStartup": false,
    "tabs.hide": [
      "issues",
      "pull-requests",
      "gists"
    ]
  },
  "trust": {
    "githubRoot": true,
    "directChildren": true,
    "extraFolders": [
      "~/.agents",
      "~/GitHub/agents"
    ]
  },
  "launcher": {
    "enabled": true,
    "defaultArgs": [
      "--yolo",
      "--no-ask-user",
      "--model",
      "claude-sonnet-5",
      "--effort",
      "high",
      "--mode",
      "autopilot",
      "--max-autopilot-continues",
      "10",
      "--disable-builtin-mcps"
    ],
    "managementCommands": [
      "completion",
      "help",
      "init",
      "login",
      "mcp",
      "plugin",
      "skill",
      "update",
      "version"
    ]
  },
  "skills": {
    "copilotSkillDirectoryPolicy": "empty",
    "projectGithubSkillDirectoryPolicy": "empty",
    "appSkillsPolicy": "allow-known-only",
    "expectedAppBundledSkills": [
      "af",
      "agent-merge",
      "agentfinder",
      "create-canvas",
      "customize-cloud-agent",
      "impeccable",
      "orchestrate"
    ]
  },
  "hooks": {
    "managedCopilotHooks": true,
    "userHookFile": "~/.copilot/hooks/agents-control-plane.json",
    "forbiddenCommandSubstrings": [
      "herdr",
      "herdr-agent-state.sh"
    ]
  }
}
