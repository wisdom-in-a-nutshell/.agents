{
  "description": "Managed GitHub Copilot CLI/app-adjacent settings. sync-copilot.py merges settings into ~/.copilot/settings.json, renders trusted folders into ~/.copilot/config.json where the installed CLI stores them, renders Copilot-only global MCP targets from mcp/config/presets.json into ~/.copilot/mcp-config.json, renders repo-specific MCP targets into workspace config, renders ~/.copilot/hooks/agents-control-plane.json, and renders a ~/bin/copilot wrapper for terminal sessions. It intentionally does not copy managed skills into ~/.copilot/skills or .github/skills; Copilot reuses existing .agents/skills and ~/.agents/skills surfaces.",
  "settings": {
    "askUser": false,
    "autoUpdate": false,
    "banner": "never",
    "beep": false,
    "disabledSkills": [
      "af",
      "agent-merge",
      "agentfinder",
      "create-canvas",
      "customize-cloud-agent"
    ],
    "effortLevel": "high",
    "ide.autoConnect": false,
    "ide.openDiffOnEdit": false,
    "memory": false,
    "notifications": false,
    "showTipsOnStartup": false,
    "tabs": {
      "hide": [
        "issues",
        "pull-requests",
        "gists"
      ]
    }
  },
  "settingsPrune": [
    "tabs.hide"
  ],
  "trust": {
    "githubRoot": true,
    "directChildren": true,
    "extraFolders": [
      "~/.agents",
      "~/GitHub/agents"
    ]
  },
  "launcher": {
    "enabled": true,
    "defaultArgs": [
      "--yolo",
      "--no-ask-user",
      "--model",
      "claude-sonnet-5",
      "--effort",
      "high",
      "--mode",
      "autopilot",
      "--max-autopilot-continues",
      "100",
      "--disable-builtin-mcps",
      "--disable-mcp-server",
      "ide",
      "--excluded-tools",
      "session_store_sql"
    ],
    "managementCommands": [
      "completion",
      "help",
      "init",
      "login",
      "mcp",
      "plugin",
      "skill",
      "update",
      "version"
    ]
  },
  "skills": {
    "copilotSkillDirectoryPolicy": "empty",
    "projectGithubSkillDirectoryPolicy": "empty",
    "appSkillsPolicy": "allow-known-only",
    "expectedAppBundledSkills": [
      "af",
      "agent-merge",
      "agentfinder",
      "create-canvas",
      "customize-cloud-agent",
      "impeccable",
      "orchestrate",
      "pr-stack"
    ]
  },
  "hooks": {
    "managedCopilotHooks": true,
    "userHookFile": "~/.copilot/hooks/agents-control-plane.json",
    "forbiddenCommandSubstrings": [
      "herdr",
      "herdr-agent-state.sh"
    ]
  }
}
