#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import subprocess
import sys
import time
from pathlib import Path
from typing import Any


DEFAULT_THINGS_CLIENT = Path("/Users/dobby/.agents/skills-source/owned/things-client/scripts/things-client")


def main(argv: list[str] | None = None) -> int:
    started = time.perf_counter()
    parser = build_parser()
    try:
        args = parser.parse_args(argv)
        note = read_note(args)
        if args.command == "complete":
            data = complete_task(args, note=note)
        elif args.command == "needs-input":
            if not note or not note.strip():
                raise WorkHandoffError("needs-input requires a non-empty note")
            data = mark_needs_input(args, note=note)
        else:
            raise WorkHandoffError(f"unsupported command: {args.command}")
    except WorkHandoffError as exc:
        emit({"status": "error", "error": {"message": str(exc)}, "meta": meta(started)})
        return 1
    except Exception as exc:
        emit({"status": "error", "error": {"message": str(exc), "type": type(exc).__name__}, "meta": meta(started)})
        return 1

    emit({"status": "ok", "data": data, "error": None, "meta": meta(started)})
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="work-handoff-task")
    parser.add_argument("--things-client", default=str(DEFAULT_THINGS_CLIENT), help="Path to the things-client CLI.")
    parser.add_argument("--no-input", action="store_true", help="Accepted for non-interactive callers; commands never prompt.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    complete = subparsers.add_parser("complete", help="Append an optional handoff and complete a Things task.")
    add_note_args(complete)

    needs_input = subparsers.add_parser("needs-input", help="Append a note and add the needs-input tag.")
    add_note_args(needs_input)
    return parser


def add_note_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("task_id", help="Things task id.")
    parser.add_argument("--note", help="Human-facing note to append.")
    parser.add_argument("--note-file", help="Read the note from a file, or '-' for stdin.")
    parser.add_argument("--no-input", action="store_true", default=argparse.SUPPRESS, help=argparse.SUPPRESS)


def read_note(args: argparse.Namespace) -> str | None:
    if args.note and args.note_file:
        raise WorkHandoffError("Use either --note or --note-file, not both.")
    if args.note_file == "-":
        return sys.stdin.read()
    if args.note_file:
        return Path(args.note_file).expanduser().read_text()
    return args.note


def complete_task(args: argparse.Namespace, *, note: str | None) -> dict[str, Any]:
    if note and note.strip():
        things(args, ["edit", args.task_id, "--append-notes", f"\n\n{note.strip()}", "--no-input"])
    payload = things(args, ["complete", args.task_id, "--no-input"])
    return {"task_id": args.task_id, "status": "completed", "things": payload.get("data", {})}


def mark_needs_input(args: argparse.Namespace, *, note: str) -> dict[str, Any]:
    things(
        args,
        [
            "edit",
            args.task_id,
            "--append-notes",
            f"\n\nNeeds input: {note.strip()}",
            "--add-tags",
            "needs-input",
            "--no-input",
        ],
    )
    return {"task_id": args.task_id, "status": "needs-input"}


def things(args: argparse.Namespace, command: list[str]) -> dict[str, Any]:
    proc = subprocess.run(
        [str(Path(args.things_client).expanduser()), *command],
        text=True,
        capture_output=True,
        stdin=subprocess.DEVNULL,
        check=False,
        timeout=60,
    )
    try:
        payload = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        raise WorkHandoffError(f"things-client returned invalid JSON: {proc.stdout[-500:]}") from exc
    if proc.returncode != 0 or payload.get("status") != "ok":
        error = payload.get("error") if isinstance(payload.get("error"), dict) else {}
        raise WorkHandoffError(str(error.get("message") or f"things-client failed with exit code {proc.returncode}"))
    return payload


def meta(started: float) -> dict[str, Any]:
    return {"duration_ms": round((time.perf_counter() - started) * 1000)}


def emit(payload: dict[str, Any]) -> None:
    print(json.dumps(payload, sort_keys=True))


class WorkHandoffError(Exception):
    pass


if __name__ == "__main__":
    raise SystemExit(main())
