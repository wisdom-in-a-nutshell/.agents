#!/usr/bin/env bash
# Test-only compatibility shim for `dobby calendar ...` calendar tests.
set -euo pipefail
SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cmd="${1:-}"
if [[ -z "$cmd" ]]; then
  echo "usage: dobby-shim calendar ..." >&2
  exit 2
fi
shift
case "$cmd" in
  calendar) exec "$SKILL_DIR/scripts/dobby-calendar" "$@" ;;
  *) echo "unknown dobby group: $cmd" >&2; exit 2 ;;
esac
