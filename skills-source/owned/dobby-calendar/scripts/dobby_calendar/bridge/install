#!/usr/bin/env bash
set -euo pipefail

INSTALL_ROOT="${HOME}/Applications"
APP_NAME="Dobby Calendar Bridge.app"
REQUEST_ACCESS=0
CHECK_ONLY=0
FORCE=0
SOCKET_PATH="${DOBBY_CALENDAR_BRIDGE_SOCKET:-${HOME}/Library/Application Support/DobbyCalendarBridge/bridge.sock}"
LAUNCH_LABEL="com.${USER}.dobby-calendar-bridge"
CODESIGN_IDENTITY="${DOBBY_CALENDAR_CODESIGN_IDENTITY:-}"
ALLOW_ADHOC_SIGNING="${DOBBY_CALENDAR_ALLOW_ADHOC_SIGNING:-0}"

usage() {
  cat <<USAGE
Usage: $(basename "$0") [options]

Build/install the native Dobby Calendar Bridge helper app.

The bridge is a per-user LaunchAgent/socket EventKit helper with a stable macOS
bundle identity (io.adithyan.dobby.calendar-bridge). Dobby's calendar CLI can
call it from Codex.app, Terminal, or other local agents without
inheriting the caller app's Calendar permission state.

Options:
  --install-root <path>     App install root (default: ~/Applications)
  --request-access          Run a permission request after install/check
  --check                   Only check existing install and Calendar access
  --force                   Rebuild/reinstall even if app already exists
  --codesign-identity <id>   Stable signing identity to use (or set
                             DOBBY_CALENDAR_CODESIGN_IDENTITY)
  --allow-adhoc-signing      Fall back to ad-hoc signing if no stable identity
                             exists (may reset macOS Calendar permission)
  -h, --help                Show this help

Examples:
  ~/.agents/skills-source/owned/dobby-calendar/scripts/dobby_calendar/bridge/install --request-access
  ~/.agents/skills-source/owned/dobby-calendar/scripts/dobby_calendar/bridge/install --check
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --install-root)
      INSTALL_ROOT="${2:-}"
      shift 2
      ;;
    --request-access)
      REQUEST_ACCESS=1
      shift
      ;;
    --check)
      CHECK_ONLY=1
      shift
      ;;
    --force)
      FORCE=1
      shift
      ;;
    --codesign-identity)
      CODESIGN_IDENTITY="${2:-}"
      shift 2
      ;;
    --allow-adhoc-signing)
      ALLOW_ADHOC_SIGNING=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOURCE_FILE="$SCRIPT_DIR/main.swift"
INFO_PLIST="$SCRIPT_DIR/Info.plist"
APP_DIR="$INSTALL_ROOT/$APP_NAME"
CONTENTS_DIR="$APP_DIR/Contents"
MACOS_DIR="$CONTENTS_DIR/MacOS"
BIN_PATH="$MACOS_DIR/DobbyCalendarBridge"
CACHE_DIR="${HOME}/Library/Caches/dobby-calendar-bridge"
BUILD_BIN="$CACHE_DIR/DobbyCalendarBridge"
PLIST_PATH="${HOME}/Library/LaunchAgents/${LAUNCH_LABEL}.plist"
LOG_PATH="${HOME}/Library/Logs/dobby-calendar-bridge.log"
ERR_PATH="${HOME}/Library/Logs/dobby-calendar-bridge.err.log"
DOMAIN="gui/$(id -u)"

if [[ ! -f "$SOURCE_FILE" || ! -f "$INFO_PLIST" ]]; then
  echo "Calendar bridge sources not found under $SCRIPT_DIR" >&2
  exit 1
fi

if ! command -v swiftc >/dev/null 2>&1; then
  echo "swiftc not found. Install Xcode Command Line Tools or Xcode." >&2
  exit 4
fi

check_installed() {
  if [[ ! -x "$BIN_PATH" ]]; then
    echo "missing: $BIN_PATH" >&2
    return 1
  fi
  local output ok
  set +e
  output="$("$BIN_PATH" send doctor --no-input --socket "$SOCKET_PATH")"
  local rc=$?
  set -e
  printf '%s\n' "$output"
  if (( rc != 0 )); then
    return "$rc"
  fi
  ok="$(printf '%s\n' "$output" | /usr/bin/python3 -c 'import json,sys; print(str(bool(json.load(sys.stdin).get("data",{}).get("ok"))).lower())' 2>/dev/null || printf 'false')"
  [[ "$ok" == "true" ]]
}

find_codesign_identity() {
  if [[ -n "$CODESIGN_IDENTITY" ]]; then
    printf '%s\n' "$CODESIGN_IDENTITY"
    return 0
  fi
  if ! command -v security >/dev/null 2>&1; then
    return 1
  fi

  local identities
  identities="$(security find-identity -v -p codesigning 2>/dev/null || true)"

  # Prefer a purpose-specific local identity when one exists. Fall back to
  # Adi's Apple Development certificate, which is stable across app rebuilds
  # on this machine and avoids TCC permission churn caused by ad-hoc signing.
  local identity
  identity="$(printf '%s\n' "$identities" | awk -F'"' '/"Dobby Local Code Signing"/ { print $2; exit }')"
  if [[ -n "$identity" ]]; then
    printf '%s\n' "$identity"
    return 0
  fi
  identity="$(printf '%s\n' "$identities" | awk -F'"' '/"Apple Development: Adithyan Ilangovan / { print $2; exit }')"
  if [[ -n "$identity" ]]; then
    printf '%s\n' "$identity"
    return 0
  fi
  identity="$(printf '%s\n' "$identities" | awk -F'"' '/"Apple Development: / { print $2; exit }')"
  if [[ -n "$identity" ]]; then
    printf '%s\n' "$identity"
    return 0
  fi
  return 1
}

sign_app() {
  if ! command -v codesign >/dev/null 2>&1; then
    echo "codesign not found; cannot install a stable Calendar permission identity." >&2
    exit 4
  fi

  local identity
  identity="$(find_codesign_identity || true)"
  if [[ -n "$identity" ]]; then
    echo "+ codesign --force --deep --sign \"$identity\" $APP_DIR" >&2
    codesign --force --deep --sign "$identity" "$APP_DIR" >/dev/null
    return 0
  fi

  if [[ "$ALLOW_ADHOC_SIGNING" == "1" ]]; then
    echo "WARNING: using ad-hoc signing. Rebuilds may reset macOS Calendar permission." >&2
    echo "+ codesign --force --deep --sign - $APP_DIR" >&2
    codesign --force --deep --sign - "$APP_DIR" >/dev/null
    return 0
  fi

  cat >&2 <<'ERR'
No stable code-signing identity found.

Install or configure one, then rerun. Options:
  - set DOBBY_CALENDAR_CODESIGN_IDENTITY to an existing code-signing identity
  - pass --codesign-identity "<identity>"
  - as a last resort, pass --allow-adhoc-signing (permission may reset)
ERR
  exit 4
}

request_access() {
  echo "+ $BIN_PATH send doctor --request-access --socket $SOCKET_PATH" >&2
  local output ok
  set +e
  output="$("$BIN_PATH" send doctor --request-access --socket "$SOCKET_PATH")"
  local rc=$?
  set -e
  printf '%s\n' "$output"
  if (( rc != 0 )); then
    return "$rc"
  fi
  ok="$(printf '%s\n' "$output" | /usr/bin/python3 -c 'import json,sys; print(str(bool(json.load(sys.stdin).get("data",{}).get("ok"))).lower())' 2>/dev/null || printf 'false')"
  [[ "$ok" == "true" ]]
}

install_launchagent() {
  mkdir -p "$(dirname "$PLIST_PATH")" "$(dirname "$LOG_PATH")" "$(dirname "$SOCKET_PATH")"
  /usr/bin/python3 - "$PLIST_PATH" "$LAUNCH_LABEL" "$BIN_PATH" "$SOCKET_PATH" "$LOG_PATH" "$ERR_PATH" <<'PY'
import plistlib
import sys

plist_path, label, bin_path, socket_path, log_path, err_path = sys.argv[1:]
plist = {
    "Label": label,
    "ProgramArguments": [bin_path, "serve", "--socket", socket_path],
    "RunAtLoad": True,
    "KeepAlive": True,
    "StandardOutPath": log_path,
    "StandardErrorPath": err_path,
}
with open(plist_path, "wb") as f:
    plistlib.dump(plist, f)
PY
  launchctl bootout "$DOMAIN/$LAUNCH_LABEL" >/dev/null 2>&1 || true
  launchctl bootout "$DOMAIN" "$PLIST_PATH" >/dev/null 2>&1 || true
  rm -f "$SOCKET_PATH"
  echo "+ launchctl bootstrap $DOMAIN $PLIST_PATH" >&2
  launchctl bootstrap "$DOMAIN" "$PLIST_PATH"
  launchctl kickstart -k "$DOMAIN/$LAUNCH_LABEL" >/dev/null 2>&1 || true
  sleep 0.5
}

if (( CHECK_ONLY == 1 )); then
  if (( REQUEST_ACCESS == 1 )); then
    request_access
  else
    check_installed
  fi
  exit $?
fi

if [[ -x "$BIN_PATH" && $FORCE -eq 0 ]]; then
  echo "Dobby Calendar Bridge already installed: $APP_DIR" >&2
else
  mkdir -p "$CACHE_DIR" "$MACOS_DIR"
  echo "+ swiftc $SOURCE_FILE" >&2
  swiftc "$SOURCE_FILE" \
    -framework Foundation \
    -framework EventKit \
    -Xlinker -sectcreate \
    -Xlinker __TEXT \
    -Xlinker __info_plist \
    -Xlinker "$INFO_PLIST" \
    -o "$BUILD_BIN"

  mkdir -p "$CONTENTS_DIR/Resources" "$MACOS_DIR"
  cp "$INFO_PLIST" "$CONTENTS_DIR/Info.plist"
  cp "$BUILD_BIN" "$BIN_PATH"
  chmod 755 "$BIN_PATH"

  sign_app
  echo "Installed Dobby Calendar Bridge: $APP_DIR" >&2
fi

install_launchagent

if (( REQUEST_ACCESS == 1 )); then
  request_access
else
  check_installed
fi
