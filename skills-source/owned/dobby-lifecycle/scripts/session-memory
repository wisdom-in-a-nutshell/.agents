#!/usr/bin/env python3
"""Agent-native CLI for Dobby session memory JSON records."""

from __future__ import annotations

import argparse
import json
import sys
import time
import uuid
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from session_memory_lib import (  # noqa: E402
    SCHEMA_VERSION,
    SessionMemoryError,
    build_recent_session_entries,
    make_record,
    read_record,
    record_from_legacy_md,
    upgrade_flat_record,
    write_record,
    write_record_files,
)

OUTPUT_SCHEMA_VERSION = "1.0"
COMMAND = "session-memory"

EXIT_GENERIC = 1
EXIT_USAGE = 2


def utc_now() -> str:
    return datetime.now(UTC).isoformat(timespec="seconds").replace("+00:00", "Z")


def envelope(command: str, status: str, data: dict[str, Any] | None, error: dict[str, Any] | None, started: float) -> dict[str, Any]:
    return {
        "schema_version": OUTPUT_SCHEMA_VERSION,
        "command": command,
        "status": status,
        "data": data or {},
        "error": error,
        "meta": {
            "request_id": str(uuid.uuid4()),
            "duration_ms": int((time.time() - started) * 1000),
            "timestamp_utc": utc_now(),
        },
    }


def print_json(value: dict[str, Any]) -> None:
    print(json.dumps(value, ensure_ascii=False, sort_keys=True))


def read_stdin_json() -> Any:
    raw = sys.stdin.read()
    if not raw.strip():
        raise SessionMemoryError("expected JSON on stdin")
    try:
        return json.loads(raw)
    except json.JSONDecodeError as exc:
        raise SessionMemoryError(f"invalid stdin JSON: {exc}") from exc


def add_common(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--json", action="store_true", help="Emit JSON envelope; default behavior.")
    parser.add_argument("--plain", action="store_true", help="Emit stable plain-text inspection output.")
    parser.add_argument("--no-input", action="store_true", help="Run non-interactively; accepted for agent callers.")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Read, write, and validate Dobby session memory records.")
    sub = parser.add_subparsers(dest="subcommand", required=True)

    schema = sub.add_parser("schema", help="Print the session-memory v4 schema summary.")
    add_common(schema)

    validate = sub.add_parser("validate", help="Validate one session folder (or a file inside it).")
    validate.add_argument("path")
    add_common(validate)

    read = sub.add_parser("read", help="Read and validate one session folder (or a file inside it).")
    read.add_argument("path")
    add_common(read)

    write = sub.add_parser("write", help="Write one session folder (meta.json + summary.md).")
    write.add_argument("--workspace-root", default=".")
    write.add_argument("--trigger")
    write.add_argument("--thread-id")
    write.add_argument("--runtime", choices=["codex", "claude"], help="Source runtime that owned the session.")
    write.add_argument("--created-at")
    write.add_argument("--cwd", dest="session_cwd", help="Working directory the session ran in, when known.")
    write.add_argument("--title")
    write.add_argument("--summary")
    write.add_argument("--workspace-changes")
    write.add_argument("--tldr")
    write.add_argument("--stdin-json", action="store_true", help="Read record fields from stdin JSON.")
    add_common(write)

    render = sub.add_parser("render-boot", help="Render recent session summaries for boot context.")
    render.add_argument("--workspace-root", default=".")
    add_common(render)

    migrate = sub.add_parser("migrate-md", help="Migrate legacy Markdown session notes to session folders.")
    migrate.add_argument("--workspace-root", default=".")
    migrate.add_argument("--apply", action="store_true")
    migrate.add_argument("--delete-source", action="store_true")
    add_common(migrate)

    migrate_flat = sub.add_parser(
        "migrate-flat", help="Migrate flat v2/v3 *.json cards to v4 session folders."
    )
    migrate_flat.add_argument("--workspace-root", default=".")
    migrate_flat.add_argument("--apply", action="store_true")
    add_common(migrate_flat)

    return parser


def command_schema() -> dict[str, Any]:
    return {
        "schemaVersion": SCHEMA_VERSION,
        "layout": {
            "folder": "memory/sessions/YYYY/MM/DD-HHMMSS/",
            "meta.json": "machine facts: schemaVersion, createdAt, threadId, runtime, trigger, cwd, tldr",
            "summary.md": "# <title>, summary body, then a '## Workspace changes' section",
            "raw.jsonl": "untouched runtime transcript copied at finalize time (may be absent)",
            "dialogue.md": "normalized human<->agent transcript rendered from raw.jsonl (may be absent)",
        },
        "required": [
            "schemaVersion",
            "createdAt",
            "threadId",
            "runtime",
            "trigger",
            "title",
            "summary",
            "workspaceChanges",
            "tldr",
            "cwd",
        ],
        "optional": [],
        "record": {
            "schemaVersion": SCHEMA_VERSION,
            "createdAt": "ISO-8601 timestamp with timezone",
            "threadId": "source session id (Codex thread id or Claude session id), or null when unavailable",
            "runtime": "source runtime that owned the session: codex or claude",
            "trigger": "why consolidation happened, e.g. codexclaw-idle-expiry, codexclaw-chat-end, stale-cleanup, manual, migration",
            "cwd": "working directory the session ran in, or null when unavailable",
            "tldr": "1-2 sentence continuity gist, single line, at most 240 chars",
            "title": f"short dashboard/index label, at most {120} characters",
            "summary": "Markdown continuity index: what matters from the thread, not a transcript recap",
            "workspaceChanges": "Markdown/plain-English visibility note about durable workspace changes made during consolidation, excluding this session-memory folder",
        },
    }


def command_write(args: argparse.Namespace) -> dict[str, Any]:
    if args.stdin_json:
        raw = read_stdin_json()
        if not isinstance(raw, dict):
            raise SessionMemoryError("stdin JSON must be an object")
        record = make_record(
            trigger=str(raw.get("trigger") or ""),
            thread_id=raw.get("threadId") if raw.get("threadId") is None or isinstance(raw.get("threadId"), str) else "",
            title=str(raw.get("title") or ""),
            summary=str(raw.get("summary") or ""),
            workspace_changes=str(raw.get("workspaceChanges") or ""),
            created_at=raw.get("createdAt") if isinstance(raw.get("createdAt"), str) else None,
            runtime=raw.get("runtime"),
            cwd=raw.get("cwd"),
            tldr=raw.get("tldr") if isinstance(raw.get("tldr"), str) else None,
        )
    else:
        record = make_record(
            trigger=args.trigger or "",
            thread_id=args.thread_id,
            title=args.title or "",
            summary=args.summary or "",
            workspace_changes=args.workspace_changes or "",
            created_at=args.created_at,
            runtime=args.runtime,
            cwd=args.session_cwd or str(Path(args.workspace_root).expanduser().resolve()),
            tldr=args.tldr,
        )
    path = write_record(Path(args.workspace_root).expanduser().resolve(), record)
    return {"path": str(path), "record": record}


def command_render_boot(args: argparse.Namespace) -> dict[str, Any]:
    root = Path(args.workspace_root).expanduser().resolve()
    entries = build_recent_session_entries(root / "memory" / "sessions")
    return {
        "entries": [
            {
                "label": entry["label"],
                "path": str(entry["path"]),
                "kind": entry["kind"],
                "content": entry["content"],
            }
            for entry in entries
        ]
    }


def _free_session_dir(path: Path) -> Path:
    target = path.with_name(path.stem) if path.suffix else path
    suffix = 2
    while target.exists():
        target = path.with_name(f"{path.stem}-{suffix}")
        suffix += 1
    return target


def command_migrate_md(args: argparse.Namespace) -> dict[str, Any]:
    root = Path(args.workspace_root).expanduser().resolve()
    sessions_dir = root / "memory" / "sessions"
    migrated: list[dict[str, str]] = []
    for path in sorted(sessions_dir.glob("*/*/*-*.md")):
        record = record_from_legacy_md(path)
        target = _free_session_dir(path)
        migrated.append({"from": str(path), "to": str(target)})
        if args.apply:
            write_record_files(target, record)
            if args.delete_source:
                path.unlink()
    return {"apply": bool(args.apply), "deleteSource": bool(args.delete_source), "migrated": migrated}


def command_migrate_flat(args: argparse.Namespace) -> dict[str, Any]:
    root = Path(args.workspace_root).expanduser().resolve()
    sessions_dir = root / "memory" / "sessions"
    migrated: list[dict[str, str]] = []
    errors: list[dict[str, str]] = []
    for path in sorted(sessions_dir.glob("*/*/*-*.json")):
        if path.name == "meta.json":
            continue
        try:
            record = upgrade_flat_record(json.loads(path.read_text(encoding="utf-8")))
        except (SessionMemoryError, json.JSONDecodeError, OSError) as exc:
            errors.append({"path": str(path), "error": str(exc)})
            continue
        target = _free_session_dir(path)
        migrated.append({"from": str(path), "to": str(target)})
        if args.apply:
            write_record_files(target, record)
            path.unlink()
    return {"apply": bool(args.apply), "migrated": migrated, "errors": errors}


def plain_output(subcommand: str, data: dict[str, Any]) -> str:
    if subcommand == "schema":
        return json.dumps(data, indent=2, ensure_ascii=False)
    if subcommand == "render-boot":
        parts = []
        for entry in data.get("entries", []):
            parts.append(f"## {entry['label']}\n{entry['content']}")
        return "\n\n".join(parts)
    if "path" in data:
        return str(data["path"])
    return json.dumps(data, indent=2, ensure_ascii=False)


def main() -> int:
    started = time.time()
    parser = build_parser()
    args = parser.parse_args()
    command = f"{COMMAND} {args.subcommand}"
    try:
        if args.subcommand == "schema":
            data = command_schema()
        elif args.subcommand == "validate":
            record = read_record(Path(args.path).expanduser().resolve())
            data = {"valid": True, "record": record}
        elif args.subcommand == "read":
            data = {"record": read_record(Path(args.path).expanduser().resolve())}
        elif args.subcommand == "write":
            data = command_write(args)
        elif args.subcommand == "render-boot":
            data = command_render_boot(args)
        elif args.subcommand == "migrate-md":
            data = command_migrate_md(args)
        elif args.subcommand == "migrate-flat":
            data = command_migrate_flat(args)
        else:  # pragma: no cover
            raise SessionMemoryError(f"unsupported subcommand: {args.subcommand}")
    except SessionMemoryError as exc:
        result = envelope(
            command,
            "error",
            None,
            {
                "code": "E_VALIDATION",
                "message": str(exc),
                "retryable": False,
                "hint": "Fix the input record or command arguments and retry.",
            },
            started,
        )
        print_json(result)
        return EXIT_USAGE
    except Exception as exc:  # pragma: no cover
        result = envelope(
            command,
            "error",
            None,
            {
                "code": "E_RUNTIME",
                "message": str(exc),
                "retryable": False,
                "hint": "Inspect stderr or rerun with simpler input.",
            },
            started,
        )
        print_json(result)
        return EXIT_GENERIC

    result = envelope(command, "ok", data, None, started)
    if args.plain:
        print(plain_output(args.subcommand, data))
    else:
        print_json(result)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
