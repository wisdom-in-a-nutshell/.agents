#!/usr/bin/env python3
"""Run Dobby's dreaming pass: cross-session consolidation, proposal-only.

The runner gathers a deterministic inputs manifest for the review window,
renders the versioned prompt in `prompts/dream-memory.md`, runs one headless
Claude turn in the workspace, and validates the run bundle the agent writes:

    <workspace>/projects/dobby-continuity-dreaming/runs/<run-id>/
      run.json              machine envelope with every candidate
      report.md             human proposal memo Adi reviews
      inputs.manifest.json  what the dream was allowed to read (runner-written)
      events.jsonl          runner lifecycle events (runner-written)

v0 is proposal-only: the dreaming agent must not write outside the run dir.
The runner watches the git state around the turn and reports any out-of-bounds
changes as warnings instead of silently trusting the prompt.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import time
import uuid
from datetime import UTC, datetime, timedelta
from pathlib import Path
from typing import Any

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from claude_lib import claude_bin  # noqa: E402
from remember_lib import RememberPromptError, render_prompt_template  # noqa: E402
from session_memory_lib import (  # noqa: E402
    DIALOGUE_FILENAME,
    RAW_FILENAME,
    SessionMemoryError,
    iter_session_dirs,
    now_local,
    parse_session_path_datetime,
    read_record,
)

SCHEMA_VERSION = "1.0"
COMMAND = "dream-memory"
RUN_SCHEMA_VERSION = 1
DEFAULT_WINDOW_DAYS = 7
DEFAULT_TIMEOUT_SECONDS = 1800.0
DEFAULT_RUN_ROOT = "projects/dobby-continuity-dreaming/runs"
MAX_OUTPUT_CHARS = 12_000

EXIT_GENERIC = 1
EXIT_USAGE = 2
EXIT_TURN_FAILED = 4
EXIT_INVALID_BUNDLE = 5


class DreamMemoryError(RuntimeError):
    pass


def utc_now() -> str:
    return datetime.now(UTC).isoformat(timespec="seconds").replace("+00:00", "Z")


def truncate_text(value: str, limit: int = MAX_OUTPUT_CHARS) -> str:
    text = value.strip()
    if len(text) <= limit:
        return text
    suffix = "\n...[truncated]"
    return text[: max(0, limit - len(suffix))] + suffix


def prompt_path() -> Path:
    return SCRIPT_DIR.parent / "prompts" / "dream-memory.md"


def body_map_path() -> Path:
    return Path.home() / "GitHub/agents/skills-source/owned/dobby-workspace/references/body-map.md"


class EventLog:
    def __init__(self, path: Path) -> None:
        self.path = path

    def emit(self, event: str, **fields: Any) -> None:
        record = {"ts": utc_now(), "event": event, **fields}
        with self.path.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(record, ensure_ascii=False) + "\n")


def rel(workspace_root: Path, path: Path) -> str:
    try:
        return str(path.relative_to(workspace_root))
    except ValueError:
        return str(path)


def gather_sessions(workspace_root: Path, cutoff: datetime) -> list[dict[str, Any]]:
    out: list[dict[str, Any]] = []
    for session_dir in iter_session_dirs(workspace_root / "memory" / "sessions"):
        stamp = parse_session_path_datetime(session_dir)
        if stamp is None or stamp < cutoff:
            continue
        entry: dict[str, Any] = {
            "path": rel(workspace_root, session_dir),
            "createdAt": stamp.isoformat(timespec="seconds"),
            "hasDialogue": (session_dir / DIALOGUE_FILENAME).is_file(),
            "hasRaw": (session_dir / RAW_FILENAME).is_file(),
        }
        try:
            record = read_record(session_dir)
            entry["title"] = record["title"]
            entry["runtime"] = record["runtime"]
            entry["trigger"] = record["trigger"]
        except SessionMemoryError as exc:
            entry["error"] = str(exc)
        out.append(entry)
    return out


def gather_journal_days(workspace_root: Path, cutoff: datetime) -> list[dict[str, Any]]:
    daily = workspace_root / "journal" / "daily"
    out: list[dict[str, Any]] = []
    if not daily.is_dir():
        return out
    cutoff_day = cutoff.date().isoformat()
    for day_dir in sorted(daily.iterdir()):
        if not day_dir.is_dir() or day_dir.name < cutoff_day:
            continue
        files = sorted(p.name for p in day_dir.iterdir() if p.is_file() and p.suffix == ".json")
        if files:
            out.append({"path": rel(workspace_root, day_dir), "files": files})
    return out


def gather_projects(workspace_root: Path) -> list[str]:
    projects = workspace_root / "projects"
    out: list[str] = []
    if not projects.is_dir():
        return out
    for project_dir in sorted(projects.iterdir()):
        if not project_dir.is_dir() or project_dir.name == "archive":
            continue
        tracker = project_dir / "tasks.md"
        if tracker.is_file():
            out.append(rel(workspace_root, tracker))
    return out


def gather_areas(workspace_root: Path) -> list[dict[str, Any]]:
    areas = workspace_root / "memory" / "areas"
    out: list[dict[str, Any]] = []
    if not areas.is_dir():
        return out
    for area_dir in sorted(areas.iterdir()):
        if not area_dir.is_dir() or not (area_dir / "area.json").is_file():
            continue
        log_path = area_dir / "log.jsonl"
        log_count = 0
        if log_path.is_file():
            log_count = sum(1 for line in log_path.read_text(encoding="utf-8").splitlines() if line.strip())
        out.append(
            {
                "id": area_dir.name,
                "area": rel(workspace_root, area_dir / "area.json"),
                "canon": rel(workspace_root, area_dir / "canon.json"),
                "log": rel(workspace_root, log_path),
                "logCount": log_count,
            }
        )
    return out


def build_manifest(workspace_root: Path, *, run_id: str, window_from: str, window_to: str, days: int) -> dict[str, Any]:
    cutoff = now_local() - timedelta(days=days)
    sessions = gather_sessions(workspace_root, cutoff)
    journal = gather_journal_days(workspace_root, cutoff)
    projects = gather_projects(workspace_root)
    areas = gather_areas(workspace_root)
    manifest = {
        "schemaVersion": RUN_SCHEMA_VERSION,
        "runId": run_id,
        "window": {"from": window_from, "to": window_to, "days": days},
        "sessions": sessions,
        "journalDays": journal,
        "now": "memory/now.json" if (workspace_root / "memory/now.json").is_file() else None,
        "shelf": "state/shelf.json" if (workspace_root / "state/shelf.json").is_file() else None,
        "projectTrackers": projects,
        "areas": areas,
        "counts": {
            "sessions": len(sessions),
            "sessionsWithDialogue": sum(1 for s in sessions if s.get("hasDialogue")),
            "journalDays": len(journal),
            "projectTrackers": len(projects),
            "areas": len(areas),
        },
    }
    return manifest


def build_instruction(
    *,
    workspace_root: Path,
    run_dir: Path,
    manifest_path: Path,
    run_id: str,
    window_from: str,
    window_to: str,
    days: int,
) -> str:
    try:
        template = prompt_path().read_text(encoding="utf-8")
    except OSError as exc:
        raise DreamMemoryError(f"failed to read dream prompt template: {prompt_path()}: {exc}") from exc
    values = {
        "workspace_root_json": json.dumps(str(workspace_root), ensure_ascii=False),
        "run_dir_json": json.dumps(str(run_dir), ensure_ascii=False),
        "manifest_path_json": json.dumps(str(manifest_path), ensure_ascii=False),
        "run_id_json": json.dumps(run_id, ensure_ascii=False),
        "window_days": str(days),
        "window_from_json": json.dumps(window_from, ensure_ascii=False),
        "window_to_json": json.dumps(window_to, ensure_ascii=False),
        "body_map_path": str(body_map_path()),
        "body_map_path_json": json.dumps(str(body_map_path()), ensure_ascii=False),
    }
    return render_prompt_template(template, values)


def git_snapshot(workspace_root: Path) -> tuple[str | None, set[str]]:
    """(HEAD sha, dirty paths) — best effort; None sha when not a git repo."""
    try:
        head = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            cwd=workspace_root,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=15,
        )
        status = subprocess.run(
            ["git", "status", "--porcelain"],
            cwd=workspace_root,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None, set()
    if head.returncode != 0:
        return None, set()
    dirty = {line[3:].strip() for line in status.stdout.splitlines() if line.strip()}
    return head.stdout.strip(), dirty


def committed_paths_since(workspace_root: Path, sha: str) -> set[str]:
    try:
        result = subprocess.run(
            ["git", "diff", "--name-only", f"{sha}..HEAD"],
            cwd=workspace_root,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return set()
    if result.returncode != 0:
        return set()
    return {line.strip() for line in result.stdout.splitlines() if line.strip()}


def run_dream_turn(*, workspace_root: Path, instruction: str, timeout_seconds: float) -> str:
    cmd = [
        claude_bin(),
        "-p",
        "--permission-mode",
        "bypassPermissions",
        "--output-format",
        "text",
        instruction,
    ]
    try:
        result = subprocess.run(
            cmd,
            cwd=str(workspace_root),
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout_seconds,
        )
    except subprocess.TimeoutExpired as exc:
        raise DreamMemoryError(f"dream turn timed out after {exc.timeout}s") from exc
    except OSError as exc:
        raise DreamMemoryError(f"failed to start claude: {exc}") from exc
    if result.returncode != 0:
        output = "\n".join(part for part in [result.stderr, result.stdout] if part.strip())
        raise DreamMemoryError(truncate_text(output or f"claude exited {result.returncode}"))
    return result.stdout.strip()


def validate_bundle(run_dir: Path, run_id: str) -> dict[str, Any]:
    run_json_path = run_dir / "run.json"
    report_path = run_dir / "report.md"
    problems: list[str] = []
    counts: dict[str, Any] = {}
    if not report_path.is_file() or not report_path.read_text(encoding="utf-8").strip():
        problems.append("report.md is missing or empty")
    if not run_json_path.is_file():
        problems.append("run.json is missing")
    else:
        try:
            run_data = json.loads(run_json_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            problems.append(f"run.json is not valid JSON: {exc}")
        else:
            if run_data.get("schemaVersion") != RUN_SCHEMA_VERSION:
                problems.append(f"run.json schemaVersion should be {RUN_SCHEMA_VERSION}")
            if run_data.get("runId") != run_id:
                problems.append(f"run.json runId should be {run_id}")
            candidates = run_data.get("candidates")
            if not isinstance(candidates, list):
                problems.append("run.json candidates should be a list")
            else:
                by_category: dict[str, int] = {}
                for candidate in candidates:
                    if not isinstance(candidate, dict):
                        problems.append("run.json candidates should hold objects")
                        break
                    category = str(candidate.get("category") or "unknown")
                    by_category[category] = by_category.get(category, 0) + 1
                counts = {
                    "candidates": len(candidates),
                    "byCategory": by_category,
                }
    return {"valid": not problems, "problems": problems, "counts": counts}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Run Dobby's proposal-only dreaming pass over recent workspace activity.")
    parser.add_argument("--workspace-root", default=".")
    parser.add_argument("--days", type=int, default=DEFAULT_WINDOW_DAYS)
    parser.add_argument("--run-root", default=DEFAULT_RUN_ROOT, help="Run-bundle root, relative to the workspace.")
    parser.add_argument("--timeout-seconds", type=float, default=DEFAULT_TIMEOUT_SECONDS)
    parser.add_argument("--print-instruction", action="store_true", help="Render and print the dreaming instruction without running the turn.")
    parser.add_argument("--json", action="store_true", help="Emit JSON envelope; default behavior.")
    parser.add_argument("--plain", action="store_true", help="Emit compact plain text.")
    parser.add_argument("--no-input", action="store_true", help="Accepted for non-interactive callers; this command never prompts.")
    return parser.parse_args()


def envelope(status: str, data: dict[str, Any] | None, error: dict[str, Any] | None, started: float) -> dict[str, Any]:
    return {
        "schema_version": SCHEMA_VERSION,
        "command": COMMAND,
        "status": status,
        "data": data,
        "error": error,
        "meta": {
            "request_id": str(uuid.uuid4()),
            "duration_ms": int((time.time() - started) * 1000),
            "timestamp_utc": utc_now(),
        },
    }


def print_json(value: dict[str, Any]) -> None:
    print(json.dumps(value, ensure_ascii=False, sort_keys=True))


def main() -> int:
    started = time.time()
    args = parse_args()
    try:
        if args.days <= 0:
            raise DreamMemoryError("--days must be positive")
        if args.timeout_seconds <= 0:
            raise DreamMemoryError("--timeout-seconds must be positive")
        workspace_root = Path(args.workspace_root).expanduser().resolve()
        if not workspace_root.is_dir():
            raise DreamMemoryError(f"workspace root is not a directory: {workspace_root}")

        now = now_local()
        run_id = f"{now:%Y-%m-%d-%H%M}-dream-memory"
        window_to = now.date().isoformat()
        window_from = (now - timedelta(days=args.days)).date().isoformat()
        run_dir = workspace_root / args.run_root / run_id
        if run_dir.exists():
            raise DreamMemoryError(f"run dir already exists: {run_dir}")
        manifest_path = run_dir / "inputs.manifest.json"

        instruction = build_instruction(
            workspace_root=workspace_root,
            run_dir=run_dir,
            manifest_path=manifest_path,
            run_id=run_id,
            window_from=window_from,
            window_to=window_to,
            days=args.days,
        )
        if args.print_instruction:
            data: dict[str, Any] = {"instruction": instruction, "runId": run_id}
            result = envelope("ok", data, None, started)
            if args.plain:
                print(instruction)
            else:
                print_json(result)
            return 0

        run_dir.mkdir(parents=True)
        events = EventLog(run_dir / "events.jsonl")
        events.emit("run_started", runId=run_id, windowFrom=window_from, windowTo=window_to, days=args.days)

        manifest = build_manifest(
            workspace_root,
            run_id=run_id,
            window_from=window_from,
            window_to=window_to,
            days=args.days,
        )
        manifest_path.write_text(json.dumps(manifest, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        events.emit("manifest_written", counts=manifest["counts"])

        head_before, dirty_before = git_snapshot(workspace_root)
        events.emit("dream_turn_started", timeoutSeconds=args.timeout_seconds)
        reply = run_dream_turn(
            workspace_root=workspace_root,
            instruction=instruction,
            timeout_seconds=args.timeout_seconds,
        )
        events.emit("dream_turn_completed", reply=truncate_text(reply, 1000))

        validation = validate_bundle(run_dir, run_id)
        events.emit("bundle_validated", valid=validation["valid"], problems=validation["problems"])

        run_root_rel = str(Path(args.run_root))
        out_of_bounds: list[str] = []
        head_after, dirty_after = git_snapshot(workspace_root)
        changed: set[str] = set(dirty_after - dirty_before)
        if head_before and head_after and head_before != head_after:
            changed |= committed_paths_since(workspace_root, head_before)
        out_of_bounds = sorted(
            path for path in changed if not path.startswith(run_root_rel)
        )
        if out_of_bounds:
            events.emit("out_of_bounds_changes", paths=out_of_bounds)

        data = {
            "runId": run_id,
            "runDir": str(run_dir),
            "window": {"from": window_from, "to": window_to, "days": args.days},
            "manifestCounts": manifest["counts"],
            "validation": validation,
            "outOfBounds": out_of_bounds,
            "reply": truncate_text(reply, 1000),
        }
        events.emit("run_finished", valid=validation["valid"], outOfBounds=len(out_of_bounds))
    except (DreamMemoryError, RememberPromptError) as exc:
        result = envelope(
            "error",
            None,
            {
                "code": "E_DREAM_MEMORY",
                "message": str(exc),
                "retryable": True,
                "hint": "Check the claude CLI, the dream prompt, and the workspace layout.",
            },
            started,
        )
        print_json(result)
        return EXIT_TURN_FAILED
    except Exception as exc:  # pragma: no cover
        result = envelope(
            "error",
            None,
            {
                "code": exc.__class__.__name__,
                "message": str(exc),
                "retryable": True,
                "hint": "Rerun with --print-instruction or inspect the run dir events.",
            },
            started,
        )
        print_json(result)
        return EXIT_GENERIC

    status = "ok" if validation["valid"] else "error"
    error = None
    if not validation["valid"]:
        error = {
            "code": "E_INVALID_BUNDLE",
            "message": "; ".join(validation["problems"]),
            "retryable": True,
            "hint": f"Inspect {run_dir} — the dream turn completed but the bundle is incomplete.",
        }
    result = envelope(status, data, error, started)
    if args.plain:
        counts = validation.get("counts") or {}
        print(
            f"{status} runId={run_id} candidates={counts.get('candidates', '?')} "
            f"outOfBounds={len(out_of_bounds)} dir={run_dir}"
        )
    else:
        print_json(result)
    return 0 if status == "ok" else EXIT_INVALID_BUNDLE


if __name__ == "__main__":
    raise SystemExit(main())
