#!/usr/bin/env python3
"""Run Dobby's end-of-session memory preservation flow for one Codex thread.

This is a behavior runner, not the session-memory storage client. It starts one
final same-thread Codex turn with Dobby's memory-preservation instruction. That
agent turn may call `session-memory` to write a compact JSON record.
"""

from __future__ import annotations

import argparse
import json
import os
import queue
import re
import subprocess
import sys
import threading
import time
import uuid
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

SCHEMA_VERSION = "1.0"
COMMAND = "remember-session"
DEFAULT_TIMEOUT_SECONDS = 60.0
DEFAULT_REMEMBER_TIMEOUT_SECONDS = 900.0
MAX_OUTPUT_CHARS = 12_000


class RememberSessionError(RuntimeError):
    pass


def utc_now() -> str:
    return datetime.now(UTC).isoformat(timespec="seconds").replace("+00:00", "Z")


def truncate_text(value: str, limit: int = MAX_OUTPUT_CHARS) -> str:
    text = value.strip()
    if len(text) <= limit:
        return text
    suffix = "\n...[truncated]"
    return text[: max(0, limit - len(suffix))] + suffix


def extract_id(payload: Any, *paths: tuple[str, ...]) -> str | None:
    for path in paths:
        current = payload
        for key in path:
            if not isinstance(current, dict):
                current = None
                break
            current = current.get(key)
        if isinstance(current, str) and current.strip():
            return current.strip()
    return None


def repo_root_for_cwd(cwd: str) -> Path:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=cwd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return Path(cwd).expanduser().resolve()
    if result.returncode != 0 or not result.stdout.strip():
        return Path(cwd).expanduser().resolve()
    return Path(result.stdout.strip()).expanduser().resolve()


def clean_label(value: str | None, default: str) -> str:
    label = (value or default).strip()
    return label or default


class AppServerClient:
    def __init__(self, timeout_seconds: float) -> None:
        self.timeout_seconds = timeout_seconds
        self.proc: subprocess.Popen[str] | None = None
        self.messages: queue.Queue[dict[str, Any]] = queue.Queue()
        self.stderr_lines: list[str] = []
        self.next_id = 1
        self.agent_text_parts: list[str] = []
        self.agent_completed_text: str | None = None
        self.turn_completed_events: list[dict[str, Any]] = []

    def __enter__(self) -> "AppServerClient":
        self.start()
        return self

    def __exit__(self, *_exc: object) -> None:
        self.close()

    def start(self) -> None:
        self.proc = subprocess.Popen(
            ["codex", "app-server"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
        )
        assert self.proc.stdout is not None
        assert self.proc.stderr is not None
        threading.Thread(target=self._read_stdout, args=(self.proc.stdout,), daemon=True).start()
        threading.Thread(target=self._read_stderr, args=(self.proc.stderr,), daemon=True).start()

        self.request(
            "initialize",
            {
                "clientInfo": {
                    "name": "dobby_remember_session",
                    "title": "Dobby Remember Session",
                    "version": SCHEMA_VERSION,
                }
            },
        )
        self.notify("initialized", {})

    def close(self) -> None:
        if self.proc is None:
            return
        proc = self.proc
        self.proc = None
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait(timeout=5)

    def _read_stdout(self, stream: Any) -> None:
        for line in stream:
            try:
                payload = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(payload, dict):
                self.messages.put(payload)

    def _read_stderr(self, stream: Any) -> None:
        for line in stream:
            text = line.rstrip("\n")
            if text:
                self.stderr_lines.append(text)
                del self.stderr_lines[:-80]

    def _write(self, message: dict[str, Any]) -> None:
        if self.proc is None or self.proc.stdin is None:
            raise RememberSessionError("app-server is not running")
        if self.proc.poll() is not None:
            raise RememberSessionError(f"app-server exited with code {self.proc.returncode}")
        self.proc.stdin.write(json.dumps(message, separators=(",", ":")) + "\n")
        self.proc.stdin.flush()

    def notify(self, method: str, params: dict[str, Any]) -> None:
        self._write({"method": method, "params": params})

    def request(
        self,
        method: str,
        params: dict[str, Any] | None = None,
        *,
        timeout_seconds: float | None = None,
    ) -> dict[str, Any]:
        request_id = self.next_id
        self.next_id += 1
        message: dict[str, Any] = {"method": method, "id": request_id}
        if params is not None:
            message["params"] = params
        self._write(message)
        return self._read_response(
            request_id,
            method=method,
            timeout_seconds=timeout_seconds or self.timeout_seconds,
        )

    def _next_message(self, *, timeout_seconds: float) -> dict[str, Any]:
        if self.proc is not None and self.proc.poll() is not None and self.messages.empty():
            stderr_tail = "\n".join(self.stderr_lines[-20:])
            raise RememberSessionError(
                f"app-server exited with code {self.proc.returncode}"
                + (f"\nstderr:\n{stderr_tail}" if stderr_tail else "")
            )
        try:
            return self.messages.get(timeout=timeout_seconds)
        except queue.Empty as exc:
            stderr_tail = "\n".join(self.stderr_lines[-20:])
            raise RememberSessionError(
                "timed out waiting for app-server message"
                + (f"\nstderr:\n{stderr_tail}" if stderr_tail else "")
            ) from exc

    def _read_response(self, request_id: int, *, method: str, timeout_seconds: float) -> dict[str, Any]:
        deadline = time.monotonic() + timeout_seconds
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                stderr_tail = "\n".join(self.stderr_lines[-20:])
                raise RememberSessionError(
                    f"timed out waiting for {method} response id={request_id}"
                    + (f"\nstderr:\n{stderr_tail}" if stderr_tail else "")
                )
            payload = self._next_message(timeout_seconds=remaining)
            self._handle_message_side_effects(payload)
            if "id" in payload and "method" in payload:
                self._handle_server_request(payload)
                continue
            if payload.get("id") != request_id:
                continue
            if "error" in payload:
                error = payload["error"]
                message = error.get("message") if isinstance(error, dict) else str(error)
                raise RememberSessionError(f"{method} failed: {message}")
            result = payload.get("result")
            if not isinstance(result, dict):
                return {}
            return result

    def wait_for_turn_completed(
        self,
        *,
        thread_id: str,
        turn_id: str | None,
        timeout_seconds: float,
    ) -> dict[str, Any]:
        for event in self.turn_completed_events:
            if self._turn_completed_matches(event, thread_id=thread_id, turn_id=turn_id):
                return event
        deadline = time.monotonic() + timeout_seconds
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise RememberSessionError("timed out waiting for remember-session turn completion")
            msg = self._next_message(timeout_seconds=remaining)
            self._handle_message_side_effects(msg)
            if "id" in msg and "method" in msg:
                self._handle_server_request(msg)
                continue
            if msg.get("method") != "turn/completed":
                continue
            if self._turn_completed_matches(msg, thread_id=thread_id, turn_id=turn_id):
                return msg

    def _turn_completed_matches(
        self,
        msg: dict[str, Any],
        *,
        thread_id: str,
        turn_id: str | None,
    ) -> bool:
        params = msg.get("params") if isinstance(msg.get("params"), dict) else {}
        completed_thread = extract_id(params, ("threadId",), ("thread", "id"))
        completed_turn = extract_id(params, ("turnId",), ("turn", "id"))
        if completed_thread and completed_thread != thread_id:
            return False
        if turn_id and completed_turn and completed_turn != turn_id:
            return False
        return True

    def _handle_message_side_effects(self, msg: dict[str, Any]) -> None:
        method = msg.get("method")
        params = msg.get("params") if isinstance(msg.get("params"), dict) else {}
        if method == "turn/completed":
            self.turn_completed_events.append(msg)
            del self.turn_completed_events[:-20]
        if method == "item/agentMessage/delta":
            delta = params.get("delta")
            if isinstance(delta, str):
                self.agent_text_parts.append(delta)
        elif method == "item/completed":
            item = params.get("item") if isinstance(params.get("item"), dict) else {}
            if item.get("type") == "agentMessage" and isinstance(item.get("text"), str):
                self.agent_completed_text = item["text"]

    def _handle_server_request(self, msg: dict[str, Any]) -> None:
        req_id = msg.get("id")
        method = msg.get("method")
        if req_id is None:
            return
        if method in {
            "item/commandExecution/requestApproval",
            "item/fileChange/requestApproval",
        }:
            self._write({"id": req_id, "result": {"decision": "acceptForSession"}})
            return
        if method == "applyPatchApproval":
            self._write({"id": req_id, "result": {"decision": "approved_for_session"}})
            return
        if method == "execCommandApproval":
            self._write({"id": req_id, "result": {"decision": "approved_for_session"}})
            return
        if isinstance(method, str) and method.startswith("item/") and method.endswith("/requestApproval"):
            self._write({"id": req_id, "result": {"decision": "decline"}})
            return
        self._write({"id": req_id, "result": {}})


def finalization_turn_status(completed: dict[str, Any]) -> str | None:
    params = completed.get("params") if isinstance(completed.get("params"), dict) else {}
    status = params.get("status")
    turn = params.get("turn") if isinstance(params.get("turn"), dict) else {}
    if isinstance(turn.get("status"), str):
        status = turn["status"]
    return status if isinstance(status, str) else None


def thread_read(client: AppServerClient, thread_id: str) -> dict[str, Any]:
    result = client.request("thread/read", {"threadId": thread_id, "includeTurns": False})
    thread = result.get("thread")
    if not isinstance(thread, dict):
        raise RememberSessionError("thread/read returned malformed response")
    return thread


def resolve_workspace_root(client: AppServerClient, thread_id: str) -> tuple[str, Path]:
    thread = thread_read(client, thread_id)
    cwd = thread.get("cwd")
    if not isinstance(cwd, str) or not cwd.strip():
        raise RememberSessionError("thread/read did not return a usable cwd")
    return cwd, repo_root_for_cwd(cwd)


def build_instruction(
    *,
    workspace_root: Path,
    thread_id: str,
    source: str,
    reason: str,
) -> str:
    session_memory_cli = Path.home() / ".agents/skills-source/owned/dobby-lifecycle/scripts/session-memory"
    return f"""You are running the final memory-preservation turn in this Codex thread before it is archived.

Remember this session for future Dobby. Use the shared `dobby-workspace` body map for memory routing and the `session-memory` client for session continuity JSON.

Context:
- Workspace root: `{workspace_root}`
- Source thread id: `{thread_id}`
- Session memory source: `{source}`
- Finalization reason: `{reason}`

Task:
1. Read `$HOME/.agents/skills-source/owned/dobby-workspace/references/body-map.md` for session continuity and memory routing.
2. Capture only what would make a future Dobby session worse if lost. Do not summarize everything.
3. If useful, write one concise session-memory JSON record with `$HOME/.agents/skills-source/owned/dobby-lifecycle/scripts/session-memory`.
   - If the thread contains nothing worth preserving, do not invent a record.
4. Promote durable facts only when the body map clearly says they belong in `memory/now.md`, an area file/log, `soul.md`, or Shelf.
5. Do not ask the user. Do not archive, delete, compact, or otherwise manage this thread; the external finalizer will archive it after this turn succeeds.
6. Keep any written memory compact, operationally useful, and optimized for a future agent to load.

Session-memory write shape:

```bash
cat <<'JSON' | {session_memory_cli} write --stdin-json --no-input
{{
  "source": "{source}",
  "reason": "{reason}",
  "threadId": "{thread_id}",
  "summary": [
    "One short carry-forward fact, decision, or next-context item."
  ],
  "notes": "Optional deeper context. Omit this field if the summary is enough."
}}
JSON
```

When finished, reply briefly with what memory path(s) you changed, or say that no memory changes were needed.
"""


def remember_session(
    *,
    thread_id: str,
    source: str,
    reason: str,
    timeout_seconds: float,
    remember_timeout_seconds: float,
) -> dict[str, Any]:
    source = clean_label(source, "remember-session")
    reason = clean_label(reason, "manual")
    with AppServerClient(timeout_seconds) as client:
        thread_cwd, workspace_root = resolve_workspace_root(client, thread_id)
        instruction = build_instruction(
            workspace_root=workspace_root,
            thread_id=thread_id,
            source=source,
            reason=reason,
        )
        response = client.request(
            "turn/start",
            {
                "threadId": thread_id,
                "input": [{"type": "text", "text": instruction}],
                "cwd": str(workspace_root),
            },
            timeout_seconds=timeout_seconds,
        )
        turn_id = extract_id(response, ("turn", "id"), ("turnId",))
        completed = client.wait_for_turn_completed(
            thread_id=thread_id,
            turn_id=turn_id,
            timeout_seconds=remember_timeout_seconds,
        )
        status = finalization_turn_status(completed) or "completed"
        if status != "completed":
            raise RememberSessionError(f"remember-session turn finished with status={status}")
        final_text = "".join(client.agent_text_parts).strip()
        if not final_text and client.agent_completed_text:
            final_text = client.agent_completed_text.strip()
    return {
        "threadId": thread_id,
        "threadCwd": thread_cwd,
        "workspaceRoot": str(workspace_root),
        "source": source,
        "reason": reason,
        "turnId": turn_id,
        "turnStatus": status,
        "reply": truncate_text(re.sub(r"\s+", " ", final_text), 1000) if final_text else "",
    }


def envelope(command: str, status: str, data: dict[str, Any] | None, error: dict[str, Any] | None, started: float) -> dict[str, Any]:
    return {
        "schema_version": SCHEMA_VERSION,
        "command": command,
        "status": status,
        "data": data,
        "error": error,
        "meta": {
            "request_id": str(uuid.uuid4()),
            "duration_ms": int((time.time() - started) * 1000),
            "timestamp_utc": utc_now(),
        },
    }


def print_json(value: dict[str, Any]) -> None:
    print(json.dumps(value, ensure_ascii=False, sort_keys=True))


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Remember useful Dobby session memory from an ending Codex thread.")
    parser.add_argument("--thread-id", required=True)
    parser.add_argument("--source", default="remember-session")
    parser.add_argument("--reason", default="manual")
    parser.add_argument("--timeout-seconds", type=float, default=DEFAULT_TIMEOUT_SECONDS)
    parser.add_argument("--remember-timeout-seconds", type=float, default=DEFAULT_REMEMBER_TIMEOUT_SECONDS)
    parser.add_argument("--finalization-timeout-seconds", type=float, help="Alias for --remember-timeout-seconds.")
    parser.add_argument("--print-instruction", action="store_true", help="Resolve the thread workspace and print the final-turn instruction without starting the final turn.")
    parser.add_argument("--json", action="store_true", help="Emit JSON envelope; default behavior.")
    parser.add_argument("--plain", action="store_true", help="Emit compact plain text for operator inspection.")
    parser.add_argument("--no-input", action="store_true", help="Accepted for non-interactive callers; this command never prompts.")
    return parser.parse_args()


def main() -> int:
    started = time.time()
    args = parse_args()
    remember_timeout = args.finalization_timeout_seconds or args.remember_timeout_seconds
    command = COMMAND
    try:
        if args.timeout_seconds <= 0 or remember_timeout <= 0:
            raise RememberSessionError("timeouts must be positive")
        if args.print_instruction:
            source = clean_label(args.source, "remember-session")
            reason = clean_label(args.reason, "manual")
            with AppServerClient(args.timeout_seconds) as client:
                _, workspace_root = resolve_workspace_root(client, args.thread_id)
            data = {
                "instruction": build_instruction(
                    workspace_root=workspace_root,
                    thread_id=args.thread_id,
                    source=source,
                    reason=reason,
                )
            }
        else:
            data = remember_session(
                thread_id=args.thread_id,
                source=args.source,
                reason=args.reason,
                timeout_seconds=args.timeout_seconds,
                remember_timeout_seconds=remember_timeout,
            )
    except RememberSessionError as exc:
        result = envelope(
            command,
            "error",
            None,
            {
                "code": "E_REMEMBER_SESSION",
                "message": str(exc),
                "retryable": True,
                "hint": "Check Codex app-server availability, the source thread id, and the Dobby memory prompt.",
            },
            started,
        )
        print_json(result)
        return 5
    except Exception as exc:  # pragma: no cover
        result = envelope(
            command,
            "error",
            None,
            {
                "code": exc.__class__.__name__,
                "message": str(exc),
                "retryable": True,
                "hint": "Rerun with --print-instruction or inspect Codex app-server output.",
            },
            started,
        )
        print_json(result)
        return 4

    result = envelope(command, "ok", data, None, started)
    if args.plain:
        if args.print_instruction:
            print(data["instruction"])
        else:
            print(f"ok remembered id={data['threadId']} turn={data.get('turnId') or 'unknown'}")
    else:
        print_json(result)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
