#!/usr/bin/env python3
"""Consolidate a Codex thread into Dobby memory.

This is the reusable Dobby lifecycle primitive: given a source Codex thread, it
starts a local `codex app-server`, forks the source thread into a sidecar thread,
injects a memory-consolidation turn, and lets the forked agent update the Dobby
workspace memory files directly.

It does not archive, delete, compact, or otherwise mutate the source thread.
Callers own policy: hooks, CodexClaw, manual commands, or future context-pressure
triggers may call this command when they decide consolidation is warranted.
"""

from __future__ import annotations

import argparse
import json
import os
import queue
import re
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any
from zoneinfo import ZoneInfo

LOCAL_TIMEZONE = "Europe/Berlin"
DEFAULT_TIMEOUT_SEC = 900
APP_SERVER_START_TIMEOUT_SEC = 30
CLIENT_NAME = "dobby_thread_consolidator"
CLIENT_TITLE = "Dobby Thread Consolidator"
CLIENT_VERSION = "0.1.0"
THREAD_CONSOLIDATION_DIR = Path("tmp/dobby-lifecycle/thread-consolidation")
CONSOLIDATED_THREADS_LOG = THREAD_CONSOLIDATION_DIR / "consolidated-threads.jsonl"


def log(message: str) -> None:
    print(f"[consolidate-thread] {message}", file=sys.stderr, flush=True)


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"failed to read job payload {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise RuntimeError(f"job payload {path} is not a JSON object")
    return value


def repo_root(payload: dict[str, Any], explicit: str | None) -> Path:
    raw = explicit or payload.get("repo_root") or os.environ.get("AGENT_REPO_ROOT") or "."
    return Path(str(raw)).expanduser().resolve()


def text_field(payload: dict[str, Any], *keys: str) -> str | None:
    for key in keys:
        value = payload.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    return None


def raw_payload(payload: dict[str, Any]) -> dict[str, Any]:
    raw = payload.get("raw_payload")
    return raw if isinstance(raw, dict) else {}


def source_thread_id(payload: dict[str, Any]) -> str | None:
    raw = raw_payload(payload)
    return (
        text_field(payload, "source_thread_id", "sourceThreadId")
        or text_field(raw, "source_thread_id", "sourceThreadId")
        or text_field(raw, "thread_id", "threadId")
        or text_field(payload, "session_id", "sessionId")
        or text_field(raw, "session_id", "sessionId")
    )


def source_turn_id(payload: dict[str, Any]) -> str | None:
    raw = raw_payload(payload)
    return (
        text_field(payload, "source_turn_id", "sourceTurnId")
        or text_field(raw, "source_turn_id", "sourceTurnId")
        or text_field(payload, "turn_id", "turnId")
        or text_field(raw, "turn_id", "turnId")
    )


def parse_timestamp(value: Any) -> datetime | None:
    if value is None:
        return None
    if isinstance(value, (int, float)):
        number = float(value)
        if number > 10_000_000_000:
            number /= 1000.0
        try:
            return datetime.fromtimestamp(number, tz=timezone.utc)
        except (OSError, ValueError):
            return None
    if isinstance(value, str):
        text = value.strip()
        if not text:
            return None
        if text.isdigit():
            return parse_timestamp(int(text))
        if text.endswith("Z"):
            text = text[:-1] + "+00:00"
        try:
            parsed = datetime.fromisoformat(text)
        except ValueError:
            return None
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=timezone.utc)
        return parsed.astimezone(timezone.utc)
    return None


def note_path_hint(root: Path, payload: dict[str, Any]) -> Path:
    start = (
        parse_timestamp(payload.get("timestamp"))
        or parse_timestamp(payload.get("recorded_at"))
        or parse_timestamp(payload.get("started_at"))
        or parse_timestamp(payload.get("created_at"))
        or datetime.now(timezone.utc)
    )
    local = start.astimezone(ZoneInfo(LOCAL_TIMEZONE))
    sessions_dir = root / "memory" / "sessions" / local.strftime("%Y") / local.strftime("%m")
    return sessions_dir / f"{local:%d-%H%M%S}.md"


def explicit_note_path(root: Path, payload: dict[str, Any]) -> Path | None:
    raw = text_field(payload, "note_path", "notePath", "target_note_path", "targetNotePath")
    if not raw:
        return None
    path = Path(raw).expanduser()
    if not path.is_absolute():
        path = root / path
    return path


def consolidation_prompt(
    *,
    root: Path,
    source_label: str,
    source_thread: str,
    source_turn: str | None,
    target_hint: Path,
    extra_instruction: str | None,
) -> str:
    label = source_label or "manual"
    source_turn_line = f"- Source turn id: `{source_turn}`\n" if source_turn else ""
    extra_line = f"- Caller instruction: {extra_instruction.strip()}\n" if extra_instruction and extra_instruction.strip() else ""
    return f"""You are running in a forked Codex sidecar thread.

Consolidate the source thread into Dobby memory. Use the shared `dobby-workspace` body map for memory routing and write directly to the workspace memory files.

Context:
- Workspace root: `{root}`
- Source label: `{label}`
- Source thread id: `{source_thread}`
{source_turn_line}{extra_line}- Suggested session note path: `{target_hint}`

Task:
1. Read `$HOME/.agents/skills-source/owned/dobby-workspace/references/body-map.md` for session continuity and memory routing.
2. Capture only what would make a future Dobby session worse if lost. Do not summarize everything.
3. If useful, write one concise session-continuity note under `memory/sessions/YYYY/MM/DD-HHMMSS.md`.
   - Use the suggested path above if it fits.
   - If that file already exists, use the next numeric suffix.
   - If the thread contains nothing worth preserving, do not invent a note.
4. Promote durable facts only when the body map clearly says they belong in `memory/now.md`, an area file/log, `soul.md`, or Shelf.
5. Do not ask the user. Do not modify, archive, delete, compact, or otherwise manage the source thread.
6. Keep any written memory human, compact, and operationally useful.

When finished, reply briefly with what memory path(s) you changed, or say that no memory changes were needed.
"""


def extract_id(payload: Any, *paths: tuple[str, ...]) -> str | None:
    for path in paths:
        current = payload
        for key in path:
            if not isinstance(current, dict):
                current = None
                break
            current = current.get(key)
        if isinstance(current, str) and current.strip():
            return current.strip()
    return None


class AppServerClient:
    def __init__(self, *, root: Path, codex_bin: str, debug: bool = False) -> None:
        self.root = root
        self.codex_bin = codex_bin
        self.debug = debug
        self.proc: subprocess.Popen[str] | None = None
        self.messages: queue.Queue[dict[str, Any]] = queue.Queue()
        self.request_id = 0
        self.agent_text_parts: list[str] = []
        self.agent_completed_text: str | None = None

    def start(self) -> None:
        self.proc = subprocess.Popen(
            [self.codex_bin, "app-server"],
            cwd=str(self.root),
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
        )
        assert self.proc.stdout is not None
        assert self.proc.stderr is not None
        threading.Thread(target=self._read_stdout, args=(self.proc.stdout,), daemon=True).start()
        threading.Thread(target=self._read_stderr, args=(self.proc.stderr,), daemon=True).start()

    def close(self) -> None:
        proc = self.proc
        if proc is None:
            return
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                proc.wait(timeout=5)

    def _read_stdout(self, stream: Any) -> None:
        for line in stream:
            stripped = line.strip()
            if not stripped:
                continue
            try:
                msg = json.loads(stripped)
            except json.JSONDecodeError:
                log(f"ignored non-json app-server stdout: {stripped[:300]}")
                continue
            if isinstance(msg, dict):
                self.messages.put(msg)

    def _read_stderr(self, stream: Any) -> None:
        for line in stream:
            text = line.rstrip()
            if text:
                log(f"app-server: {text}")

    def send(self, msg: dict[str, Any]) -> None:
        proc = self.proc
        if proc is None or proc.stdin is None:
            raise RuntimeError("app-server is not running")
        if self.debug:
            log(f"client -> {json.dumps(msg, sort_keys=True)}")
        proc.stdin.write(json.dumps(msg, separators=(",", ":")) + "\n")
        proc.stdin.flush()

    def request(self, method: str, params: Any = None, *, timeout_sec: int = 60) -> dict[str, Any]:
        self.request_id += 1
        req_id = self.request_id
        msg: dict[str, Any] = {"method": method, "id": req_id}
        if params is not None:
            msg["params"] = params
        self.send(msg)
        return self.wait_for_response(req_id, timeout_sec=timeout_sec)

    def notify(self, method: str, params: Any = None) -> None:
        msg: dict[str, Any] = {"method": method}
        if params is not None:
            msg["params"] = params
        self.send(msg)

    def wait_for_response(self, req_id: int, *, timeout_sec: int) -> dict[str, Any]:
        deadline = time.monotonic() + timeout_sec
        while True:
            timeout = deadline - time.monotonic()
            if timeout <= 0:
                raise TimeoutError(f"timed out waiting for response id={req_id}")
            msg = self._get_message(timeout)
            if self.debug:
                log(f"server -> {json.dumps(msg, sort_keys=True)[:2000]}")
            self._handle_message_side_effects(msg)
            if msg.get("id") == req_id and "method" not in msg:
                if "error" in msg:
                    raise RuntimeError(f"{msg['error']}")
                return msg
            if "id" in msg and "method" in msg:
                self._handle_server_request(msg)

    def wait_for_turn_completed(
        self,
        *,
        thread_id: str,
        turn_id: str | None,
        timeout_sec: int,
    ) -> dict[str, Any]:
        deadline = time.monotonic() + timeout_sec
        while True:
            timeout = deadline - time.monotonic()
            if timeout <= 0:
                raise TimeoutError("timed out waiting for consolidation turn completion")
            msg = self._get_message(timeout)
            if self.debug:
                log(f"server -> {json.dumps(msg, sort_keys=True)[:2000]}")
            self._handle_message_side_effects(msg)
            if "id" in msg and "method" in msg:
                self._handle_server_request(msg)
                continue
            if msg.get("method") != "turn/completed":
                continue
            params = msg.get("params") if isinstance(msg.get("params"), dict) else {}
            completed_thread = extract_id(params, ("threadId",), ("thread", "id"))
            completed_turn = extract_id(params, ("turnId",), ("turn", "id"))
            if completed_thread and completed_thread != thread_id:
                continue
            if turn_id and completed_turn and completed_turn != turn_id:
                continue
            return msg

    def _get_message(self, timeout: float) -> dict[str, Any]:
        proc = self.proc
        if proc is not None and proc.poll() is not None and self.messages.empty():
            raise RuntimeError(f"app-server exited with code {proc.returncode}")
        try:
            return self.messages.get(timeout=timeout)
        except queue.Empty as exc:
            raise TimeoutError("timed out waiting for app-server message") from exc

    def _handle_message_side_effects(self, msg: dict[str, Any]) -> None:
        method = msg.get("method")
        params = msg.get("params") if isinstance(msg.get("params"), dict) else {}
        if method == "item/agentMessage/delta":
            delta = params.get("delta")
            if isinstance(delta, str):
                self.agent_text_parts.append(delta)
        elif method == "item/completed":
            item = params.get("item") if isinstance(params.get("item"), dict) else {}
            if item.get("type") == "agentMessage" and isinstance(item.get("text"), str):
                self.agent_completed_text = item["text"]
        elif method == "error":
            log(f"server error notification: {params}")

    def _handle_server_request(self, msg: dict[str, Any]) -> None:
        req_id = msg.get("id")
        method = msg.get("method")
        if req_id is None:
            return
        if method in {
            "item/commandExecution/requestApproval",
            "item/fileChange/requestApproval",
        }:
            self.send({"id": req_id, "result": {"decision": "acceptForSession"}})
            return
        if method == "applyPatchApproval":
            self.send({"id": req_id, "result": {"decision": "approved_for_session"}})
            return
        if method == "execCommandApproval":
            self.send({"id": req_id, "result": {"decision": "approved_for_session"}})
            return
        if isinstance(method, str) and method.startswith("item/") and method.endswith("/requestApproval"):
            self.send({"id": req_id, "result": {"decision": "decline"}})
            return
        log(f"declining unsupported server request method={method}")
        self.send({"id": req_id, "result": {}})


def fork_thread(client: AppServerClient, source_thread: str) -> str:
    try:
        response = client.request("thread/fork", {"threadId": source_thread}, timeout_sec=60)
    except RuntimeError as exc:
        # Some generated local schemas have required persistExtendedHistory even
        # though the public docs show threadId-only. Retry with the local field.
        log(f"thread/fork with threadId only failed, retrying with persistExtendedHistory=true: {exc}")
        response = client.request(
            "thread/fork",
            {"threadId": source_thread, "persistExtendedHistory": True},
            timeout_sec=60,
        )
    thread_id = extract_id(response, ("result", "thread", "id"), ("result", "threadId"))
    if not thread_id:
        raise RuntimeError(f"thread/fork response missing thread id: {response}")
    return thread_id


def archive_sidecar_thread(client: AppServerClient, sidecar_thread: str) -> None:
    try:
        client.request("thread/archive", {"threadId": sidecar_thread}, timeout_sec=60)
        log(f"archived sidecar thread {sidecar_thread}")
    except Exception as exc:
        log(f"failed to archive sidecar thread {sidecar_thread}: {exc}")


def append_consolidated_thread_marker(root: Path, *, source_thread: str, sidecar_thread: str, source_label: str) -> None:
    path = root / CONSOLIDATED_THREADS_LOG
    path.parent.mkdir(parents=True, exist_ok=True)
    record = {
        "recorded_at": datetime.now(timezone.utc).isoformat().replace("+00:00", "Z"),
        "source_label": source_label,
        "source_thread_id": source_thread,
        "sidecar_thread_id": sidecar_thread,
    }
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(record, sort_keys=True) + "\n")


def run_consolidation(
    *,
    root: Path,
    payload: dict[str, Any],
    timeout_sec: int,
    codex_bin: str,
    dry_run: bool,
    debug: bool,
) -> None:
    source_thread = source_thread_id(payload)
    if not source_thread:
        log("missing source_thread_id; skipping")
        return

    source_label = text_field(payload, "source_label", "source", "hook_event_name") or "manual"
    source_turn = source_turn_id(payload)
    target_hint = explicit_note_path(root, payload) or note_path_hint(root, payload)
    prompt = consolidation_prompt(
        root=root,
        source_label=source_label,
        source_thread=source_thread,
        source_turn=source_turn,
        target_hint=target_hint,
        extra_instruction=text_field(payload, "instruction", "extra_instruction", "extraInstruction"),
    )

    if dry_run:
        print(prompt)
        return

    client = AppServerClient(root=root, codex_bin=codex_bin, debug=debug)
    client.start()
    sidecar_thread: str | None = None
    try:
        client.request(
            "initialize",
            {
                "clientInfo": {
                    "name": CLIENT_NAME,
                    "title": CLIENT_TITLE,
                    "version": CLIENT_VERSION,
                },
                "capabilities": {"experimentalApi": False},
            },
            timeout_sec=APP_SERVER_START_TIMEOUT_SEC,
        )
        client.notify("initialized", {})
        sidecar_thread = fork_thread(client, source_thread)
        append_consolidated_thread_marker(root, source_thread=source_thread, sidecar_thread=sidecar_thread, source_label=source_label)
        log(f"forked {source_thread} -> {sidecar_thread}")
        turn_response = client.request(
            "turn/start",
            {
                "threadId": sidecar_thread,
                "input": [
                    {"type": "text", "text": prompt},
                ],
                "cwd": str(root),
            },
            timeout_sec=60,
        )
        turn_id = extract_id(turn_response, ("result", "turn", "id"), ("result", "turnId"))
        log(f"started consolidation turn {turn_id or '<unknown>'} on {sidecar_thread}")
        completed = client.wait_for_turn_completed(
            thread_id=sidecar_thread,
            turn_id=turn_id,
            timeout_sec=timeout_sec,
        )
        params = completed.get("params") if isinstance(completed.get("params"), dict) else {}
        status = params.get("status")
        if isinstance(params.get("turn"), dict):
            status = params["turn"].get("status", status)
        if status and status != "completed":
            raise RuntimeError(f"consolidation turn finished with status={status}")
        final_text = "".join(client.agent_text_parts).strip()
        if not final_text and client.agent_completed_text:
            final_text = client.agent_completed_text.strip()
        if final_text:
            log(f"consolidation reply: {re.sub(r'\\s+', ' ', final_text)[:1000]}")
        else:
            log("consolidation completed without captured final reply")
    finally:
        if sidecar_thread:
            archive_sidecar_thread(client, sidecar_thread)
        client.close()


def payload_from_args(args: argparse.Namespace) -> dict[str, Any]:
    payload: dict[str, Any] = {}
    if args.job:
        payload.update(read_json(Path(args.job).expanduser()))
    if args.thread_id:
        payload["source_thread_id"] = args.thread_id
    if args.source_turn_id:
        payload["source_turn_id"] = args.source_turn_id
    if args.source_label:
        payload["source_label"] = args.source_label
    if args.note_path:
        payload["note_path"] = args.note_path
    if args.instruction:
        payload["instruction"] = args.instruction
    return payload


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Consolidate a Codex thread into Dobby memory via a sidecar fork.")
    parser.add_argument("--job", help="Optional normalized lifecycle payload JSON.")
    parser.add_argument("--thread-id", help="Source Codex/App Server thread id. Overrides job source_thread_id.")
    parser.add_argument("--source-turn-id", help="Optional source turn id for context. Overrides job source_turn_id.")
    parser.add_argument("--source-label", help="Optional caller/source label, e.g. manual, codexclaw-end-chat.")
    parser.add_argument("--repo-root", "--workspace-root", dest="repo_root", help="Dobby workspace root override.")
    parser.add_argument("--note-path", help="Optional suggested note path, absolute or workspace-relative.")
    parser.add_argument("--instruction", help="Optional caller instruction to include in the sidecar prompt.")
    parser.add_argument("--timeout-sec", type=int, default=DEFAULT_TIMEOUT_SEC)
    parser.add_argument("--dry-run", action="store_true", help="Print the injected consolidation prompt and exit.")
    parser.add_argument("--debug", action="store_true", help="Log JSON-RPC messages.")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    payload = payload_from_args(args)
    root = repo_root(payload, args.repo_root)
    codex_bin = os.environ.get("DOBBY_CODEX_BIN", "codex")
    run_consolidation(
        root=root,
        payload=payload,
        timeout_sec=args.timeout_sec,
        codex_bin=codex_bin,
        dry_run=args.dry_run,
        debug=args.debug,
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        log(str(exc))
        raise SystemExit(0)
