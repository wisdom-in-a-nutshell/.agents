#!/usr/bin/env python3
"""Compatibility wrapper for the renamed Dobby lifecycle primitive.

`codex-finalize-session` used to contain the sidecar memory worker directly.
The reusable primitive is now `consolidate-thread`; keep this wrapper so existing
PostCompact wiring continues to work until callers are rewired deliberately.
"""
from __future__ import annotations

import os
import sys
from pathlib import Path

TARGET = Path(__file__).resolve().parent / "consolidate-thread"
os.execvp(sys.executable, [sys.executable, str(TARGET), *sys.argv[1:]])
