#!/usr/bin/env python3
"""Dobby pre-compact hook.

Deliberately inert.

PreCompact runs while the runtime is actively trying to protect the live context
window. Dobby should not do anything here: no capture, no queue, no sidecar, no
synthesis. PostCompact owns continuity finalization after the runtime finishes
compacting.
"""

from __future__ import annotations


def main() -> int:
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
