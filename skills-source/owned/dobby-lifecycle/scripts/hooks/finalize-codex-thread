#!/usr/bin/env python3
"""Dobby Codex thread finalization hook.

The global `finalize-codex-thread` command calls this repo-local hook before it
archives a source Codex thread. This hook is self-contained repo policy: for
Dobby workspaces it runs the `remember-session` behavior runner. The global
finalizer archives only after this hook exits successfully.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any


HOOK_EVENT = "FinalizeCodexThread"
SCHEMA_VERSION = "1.0"
DEFAULT_TIMEOUT_SECONDS = 60.0
DEFAULT_REMEMBER_TIMEOUT_SECONDS = 900.0
MAX_OUTPUT_CHARS = 12_000


def truncate_text(value: str, limit: int = MAX_OUTPUT_CHARS) -> str:
    text = value.strip()
    if len(text) <= limit:
        return text
    suffix = "\n...[truncated]"
    return text[: max(0, limit - len(suffix))] + suffix


def read_payload() -> dict[str, Any]:
    raw = sys.stdin.read()
    if not raw.strip():
        return {}
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    return payload if isinstance(payload, dict) else {}


def first_text(payload: dict[str, Any], *keys: str) -> str | None:
    for key in keys:
        value = payload.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    return None


def thread_id(payload: dict[str, Any]) -> str | None:
    return first_text(payload, "thread_id")


def finalization_source_and_reason(payload: dict[str, Any]) -> tuple[str, str]:
    raw_reason = first_text(payload, "reason") or "manual"

    for prefix, source in [
        ("codexclaw-", "codexclaw"),
        ("codex-cloud-", "codexclaw"),
        ("desktop-", "codex-desktop"),
        ("codex-desktop-", "codex-desktop"),
    ]:
        if raw_reason.startswith(prefix):
            return source, raw_reason.removeprefix(prefix) or "manual"

    if raw_reason == "manual":
        return "manual", raw_reason
    return "codex-desktop", raw_reason


def remember_session_bin() -> Path:
    return Path(
        os.environ.get(
            "DOBBY_REMEMBER_SESSION_BIN",
            str(Path.home() / ".agents/skills-source/owned/dobby-lifecycle/scripts/remember-session"),
        )
    ).expanduser()


def run_remember_session(payload: dict[str, Any]) -> int:
    source_thread = thread_id(payload)
    if not source_thread:
        print("finalize-codex-thread hook: missing thread_id", file=sys.stderr)
        return 2

    root = Path.cwd().resolve()
    source, reason = finalization_source_and_reason(payload)

    runner = remember_session_bin()
    cmd = [
        str(runner),
        "--thread-id",
        source_thread,
        "--workspace-root",
        str(root),
        "--source",
        source,
        "--reason",
        reason,
        "--json",
        "--no-input",
    ]
    env = os.environ.copy()
    env.update(
        {
            "DOBBY_REMEMBER_SESSION_ACTIVE": "1",
        }
    )
    try:
        result = subprocess.run(
            cmd,
            cwd=root,
            env=env,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=DEFAULT_TIMEOUT_SECONDS + DEFAULT_REMEMBER_TIMEOUT_SECONDS + 30,
        )
    except subprocess.TimeoutExpired as exc:
        print(f"remember-session timed out after {exc.timeout}s", file=sys.stderr)
        return 5
    except OSError as exc:
        print(f"remember-session failed to start: {exc}", file=sys.stderr)
        return 5

    if result.returncode != 0:
        output = "\n".join(part for part in [result.stderr, result.stdout] if part.strip())
        print(truncate_text(output or f"remember-session exited {result.returncode}"), file=sys.stderr)
        return result.returncode

    if result.stderr.strip():
        print(truncate_text(result.stderr), file=sys.stderr)
    if result.stdout.strip():
        print(truncate_text(result.stdout))
    return 0


def main() -> int:
    payload = read_payload()
    event_name = payload.get("hook_event_name") or os.environ.get("AGENT_HOOK_EVENT")
    if event_name not in {None, HOOK_EVENT}:
        return 0
    if payload.get("schema_version") not in {None, SCHEMA_VERSION}:
        return 0
    return run_remember_session(payload)


if __name__ == "__main__":
    raise SystemExit(main())
