#!/usr/bin/env python3
"""Dobby session-start hook.

Emits situational boot context to stdout; the shared dispatcher at
`~/.agents/hooks/scripts/session_start.py` forwards it to the agent as
`hookSpecificOutput.additionalContext`.

Section order:

    workspace body map | profile | now | recent sessions | shelf | calendar | areas

Memory reads (`memory/profile.json`, `memory/now.json`, area manifest) and the shared workspace body
map happen inline via file I/O. Shelf snapshots go through the `dobby-shelf`
skill CLI so startup context uses the same curated decision surface as ordinary
agent planning. Calendar snapshots go through the `dobby-calendar` skill CLI
because EventKit is a non-trivial integration and is worth the CLI contract.

Dobby behavior lives in `dobby/constitution.json`, which Codex can load directly as `model_instructions_file`. Person-specific durable context lives in `memory/profile.json`, so this hook emits it as boot context.

Workspace-agnostic: resolves the active workspace via `AGENT_REPO_ROOT`,
`DOBBY_REPO_ROOT`, or `git rev-parse --show-toplevel`, in that order.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
from pathlib import Path

import re

SCRIPT_DIR = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(SCRIPT_DIR))

from session_memory_lib import build_recent_session_entries  # noqa: E402

PER_CALL_TIMEOUT_SEC = 4
BODY_MAP_MAX_CHARS = 12000


# ---------------------------------------------------------------------------
# paths
# ---------------------------------------------------------------------------


def git_root() -> Path:
    env_root = os.environ.get("AGENT_REPO_ROOT") or os.environ.get("DOBBY_REPO_ROOT")
    if env_root:
        return Path(env_root).expanduser().resolve()

    result = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        check=True,
        capture_output=True,
        text=True,
    )
    return Path(result.stdout.strip()).resolve()


REPO_ROOT = git_root()
CALENDAR_SCRIPTS_DIR = Path(
    os.environ.get(
        "DOBBY_CALENDAR_SCRIPTS_DIR",
        str(Path.home() / ".agents/skills-source/owned/dobby-calendar/scripts"),
    )
).expanduser()
SHELF_SCRIPTS_DIR = Path(
    os.environ.get(
        "DOBBY_SHELF_SCRIPTS_DIR",
        str(Path.home() / ".agents/skills-source/owned/dobby-shelf/scripts"),
    )
).expanduser()
DOBBY_WORKSPACE_SKILL_DIR = Path(
    os.environ.get(
        "DOBBY_WORKSPACE_SKILL_DIR",
        str(Path.home() / ".agents/skills-source/owned/dobby-workspace"),
    )
).expanduser()


# ---------------------------------------------------------------------------
# subprocess helpers (for non-trivial CLIs: calendar via EventKit; Shelf via
# the dobby-shelf client contract)
# ---------------------------------------------------------------------------


def run_json(cmd: list[str]) -> dict:
    """Run a Dobby CLI; return parsed JSON envelope or synthetic error."""
    executable = Path(cmd[0])
    if not executable.is_file() or not os.access(executable, os.X_OK):
        return {
            "status": "error",
            "error": {"message": f"missing executable: {executable}"},
        }

    try:
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=PER_CALL_TIMEOUT_SEC,
        )
    except subprocess.TimeoutExpired:
        return {
            "status": "error",
            "error": {"message": f"timeout after {PER_CALL_TIMEOUT_SEC}s"},
        }
    except Exception as exc:
        return {"status": "error", "error": {"message": f"exec failed: {exc}"}}

    if result.returncode != 0 and not result.stdout.strip():
        return {
            "status": "error",
            "error": {
                "message": result.stderr.strip() or "non-zero exit, empty stdout"
            },
        }

    try:
        return json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        return {"status": "error", "error": {"message": f"invalid JSON: {exc}"}}


def run_plain(cmd: list[str], *, env_extra: dict[str, str] | None = None) -> dict:
    """Run a Dobby CLI plain inspection command; return stdout or synthetic error."""
    executable = Path(cmd[0])
    if not executable.is_file() or not os.access(executable, os.X_OK):
        return {
            "status": "error",
            "error": {"message": f"missing executable: {executable}"},
        }

    env = os.environ.copy()
    if env_extra:
        env.update(env_extra)

    try:
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=PER_CALL_TIMEOUT_SEC,
            env=env,
        )
    except subprocess.TimeoutExpired:
        return {
            "status": "error",
            "error": {"message": f"timeout after {PER_CALL_TIMEOUT_SEC}s"},
        }
    except Exception as exc:
        return {"status": "error", "error": {"message": f"exec failed: {exc}"}}

    if result.returncode != 0:
        return {
            "status": "error",
            "error": {
                "message": result.stderr.strip()
                or result.stdout.strip()
                or f"exit {result.returncode}"
            },
        }
    return {"status": "ok", "data": {"stdout": result.stdout.strip()}}


# ---------------------------------------------------------------------------
# memory (inlined — trivial file I/O, no CLI round-trip)
# ---------------------------------------------------------------------------


def read_memory_file(path: Path) -> str:
    """Read a memory file; return empty string if missing or unreadable."""
    try:
        return path.read_text(encoding="utf-8")
    except OSError:
        return ""


def read_json_object(path: Path) -> dict | None:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return data if isinstance(data, dict) else None


def build_area_manifest(areas_dir: Path) -> list[dict]:
    """Walk memory/areas/ → area metadata from area.json."""
    if not areas_dir.exists():
        return []
    out: list[dict] = []
    for area_dir in sorted(d for d in areas_dir.iterdir() if d.is_dir()):
        data = read_json_object(area_dir / "area.json") or {}
        out.append({
            "area": area_dir.name,
            "title": data.get("title") or area_dir.name,
            "sensitivity": data.get("sensitivity"),
            "dataDirs": data.get("dataDirs") if isinstance(data.get("dataDirs"), list) else [],
            "assets": data.get("assets") if isinstance(data.get("assets"), list) else [],
        })
    return out


def truncate_text(content: str, limit: int, label: str = "content") -> str:
    content = content.strip()
    if len(content) <= limit:
        return content
    suffix = f"\n...[{label} truncated]"
    return content[: max(0, limit - len(suffix))].rstrip() + suffix


# ---------------------------------------------------------------------------
# rendering helpers
# ---------------------------------------------------------------------------


def strip_leading_h1(content: str) -> str:
    """Drop a leading `# Heading\\n` so hook-level h1 markers don't collide
    with file-embedded h1s. Idempotent on already-clean files."""
    if not content:
        return content
    return re.sub(r"^#\s[^\n]*\n+", "", content, count=1).strip()


def path_mtime_iso(path: Path) -> str | None:
    if not path.exists():
        return None
    return datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc).strftime(
        "%Y-%m-%dT%H:%MZ"
    )


def file_mtime_iso(rel_path: str) -> str | None:
    return path_mtime_iso(REPO_ROOT / rel_path)


def section(name: str) -> None:
    print("")
    print(f"# {name}")


def read_shelf_snapshot() -> dict:
    shelf_cli = SHELF_SCRIPTS_DIR / "dobby-shelf"
    return run_plain(
        [
            str(shelf_cli),
            "snapshot",
            "--mode",
            "boot",
            "--plain",
            "--no-input",
        ],
        env_extra={"DOBBY_WORKSPACE": str(REPO_ROOT)},
    )


def print_shelf(shelf: dict) -> None:
    section("shelf")
    if shelf.get("status") != "ok":
        err = (shelf.get("error") or {}).get("message", "shelf unavailable")
        print(f"unavailable: {err}")
        return

    data = shelf.get("data") or {}
    output = str(data.get("stdout") or "").strip()
    if not output:
        print("(empty)")
        return
    print(output)


def print_calendar(calendar: dict) -> None:
    section("calendar (next 2d)")
    if calendar.get("status") != "ok":
        error = calendar.get("error") or {}
        err = error.get("hint") or error.get("message", "calendar unavailable")
        print(f"unavailable: {err}")
        return

    data = calendar.get("data") or {}
    events = data.get("events") if isinstance(data, dict) else None
    if not events:
        print("(no events)")
        return

    for event in events[:20]:
        start = str(event.get("start") or "").strip()
        title = str(event.get("title") or "").strip()
        loc = str(event.get("location") or "").strip()
        suffix = f" @ {loc}" if loc else ""
        print(f"- {start} - {title}{suffix}")


def print_areas(areas: list[dict]) -> None:
    if not areas:
        return

    section("areas")
    max_name = max((len(area.get("area", "")) for area in areas), default=0)
    for area in areas:
        name = area.get("area", "")
        title = area.get("title") or name
        bits: list[str] = []
        if area.get("sensitivity"):
            bits.append(f"sensitivity={area.get('sensitivity')}")
        data_dirs = area.get("dataDirs") or []
        if data_dirs:
            bits.append("data=" + ",".join(str(x) for x in data_dirs[:5]))
        assets = area.get("assets") or []
        if assets:
            bits.append(f"assets={len(assets)}")
        suffix = f" ({'; '.join(bits)})" if bits else ""
        print(f"- {name.ljust(max_name)}  {title}{suffix}")




def render_grouped_json(data: dict) -> str:
    groups = data.get("groups")
    if not isinstance(groups, dict):
        return json.dumps(data, ensure_ascii=False, indent=2)
    out: list[str] = []
    person = data.get("person")
    if isinstance(person, dict):
        display = person.get("displayName") or person.get("id")
        if display:
            out.append(f"person: {display}")
            out.append("")
    for group in groups.values():
        if not isinstance(group, dict):
            continue
        title = str(group.get("title") or "Group")
        out.append(f"## {title}")
        sections = group.get("sections")
        if isinstance(sections, dict):
            for sec in sections.values():
                if not isinstance(sec, dict):
                    continue
                sec_title = str(sec.get("title") or "Section")
                body = str(sec.get("body") or "").strip()
                out.append(f"### {sec_title}")
                if body:
                    out.append(body)
                out.append("")
        out.append("")
    return "\n".join(out).strip()


def render_now_json(data: dict) -> str:
    body = str(data.get("body") or "").strip()
    if body:
        return body
    sections = data.get("sections")
    if not isinstance(sections, dict):
        return ""
    out: list[str] = []
    for sec in sections.values():
        if not isinstance(sec, dict):
            continue
        title = str(sec.get("title") or "Section")
        sec_body = str(sec.get("body") or "").strip()
        out.append(f"## {title}")
        if sec_body:
            out.append(sec_body)
        out.append("")
    return "\n".join(out).strip()


def print_profile(profile: dict | None) -> None:
    if not profile:
        return
    rendered = render_grouped_json(profile)
    if not rendered:
        return
    section("profile")
    print(truncate_text(rendered, 12000, "profile"))


def print_recent_sessions(entries: list[dict]) -> None:
    if not entries:
        return

    section("recent sessions")
    for index, entry in enumerate(entries):
        if index:
            print("")
        print(f"## {entry['label']}")
        print(str(entry["content"]).strip())


def print_workspace_body_map() -> None:
    content = read_memory_file(
        DOBBY_WORKSPACE_SKILL_DIR / "references" / "body-map.md"
    ).strip()
    if not content:
        return
    section("workspace body map")
    print(
        truncate_text(
            strip_leading_h1(content),
            BODY_MAP_MAX_CHARS,
            "workspace body map",
        )
    )


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------


def main() -> int:
    cal_cli = CALENDAR_SCRIPTS_DIR / "dobby-calendar"

    os.chdir(REPO_ROOT)

    # Parallelize CLI calls. Memory reads stay on the main thread — they're fast
    # local file I/O.
    with ThreadPoolExecutor(max_workers=2) as pool:
        cal_future = pool.submit(
            run_json,
            [
                str(cal_cli),
                "upcoming",
                "--days",
                "2",
                "--all-calendars",
            ],
        )
        shelf_future = pool.submit(read_shelf_snapshot)

        memory_dir = REPO_ROOT / "memory"
        profile = read_json_object(memory_dir / "profile.json")
        now_data = read_json_object(memory_dir / "now.json")
        recent_sessions = build_recent_session_entries(memory_dir / "sessions")
        areas = build_area_manifest(memory_dir / "areas")

        calendar = cal_future.result()
        shelf = shelf_future.result()

    # --- Header (# session) --------------------------------------------------
    session_started = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%MZ")
    body_map_mtime = path_mtime_iso(
        DOBBY_WORKSPACE_SKILL_DIR / "references" / "body-map.md"
    ) or "?"
    profile_mtime = file_mtime_iso("memory/profile.json") or "?"
    now_mtime = file_mtime_iso("memory/now.json") or "?"
    areas_count = len(areas)

    print("# session")
    print(f"started:  {session_started}")
    print(f"body-map.md:  modified {body_map_mtime}")
    print(f"profile.json: modified {profile_mtime}")
    print(f"now.json:     modified {now_mtime}")
    print(f"areas:        {areas_count} areas")

    # --- Sections ------------------------------------------------------------
    print_workspace_body_map()
    print_profile(profile)

    now = render_now_json(now_data or {})
    if now:
        section("now")
        print(now)

    print_recent_sessions(recent_sessions)
    print_shelf(shelf)
    print_calendar(calendar)
    print_areas(areas)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
