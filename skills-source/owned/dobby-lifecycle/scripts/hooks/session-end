#!/usr/bin/env python3
"""Dobby session-end hook.

Session end should stay fast. This hook captures a compact handoff record under
`<repo>/tmp/hooks/session-end/`, then exits successfully. Codex continuity
finalization is handled by PostCompact so SessionEnd does not launch a second
worker.
"""

from __future__ import annotations

import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

HOOK_EVENT = "SessionEnd"
SCHEMA_VERSION = "1.0"
SESSION_END_DIR = Path("tmp/hooks/session-end")


def utc_now_iso_z() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def utc_now_file_stamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H-%M-%SZ")


def read_payload() -> dict[str, Any]:
    raw = sys.stdin.read()
    if not raw.strip():
        return {}
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    return payload if isinstance(payload, dict) else {}


def repo_root(payload: dict[str, Any]) -> Path:
    return Path(
        payload.get("repo_root")
        or os.environ.get("AGENT_REPO_ROOT")
        or "."
    ).expanduser().resolve()


def text_field(payload: dict[str, Any], key: str) -> str | None:
    value = payload.get(key)
    if isinstance(value, str) and value.strip():
        return value.strip()
    return None


def runtime(payload: dict[str, Any]) -> str | None:
    value = text_field(payload, "runtime") or os.environ.get("AGENT_HOOK_RUNTIME")
    return value.strip().lower() if isinstance(value, str) and value.strip() else None


def raw_payload(payload: dict[str, Any]) -> dict[str, Any]:
    raw = payload.get("raw_payload")
    return raw if isinstance(raw, dict) else {}


def first_text(payload: dict[str, Any], *keys: str) -> str | None:
    for key in keys:
        value = payload.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    return None


def source_thread_id(payload: dict[str, Any]) -> str | None:
    raw = raw_payload(payload)
    return (
        first_text(payload, "source_thread_id", "sourceThreadId")
        or first_text(raw, "source_thread_id", "sourceThreadId")
        or first_text(raw, "thread_id", "threadId")
        or first_text(payload, "session_id", "sessionId")
        or first_text(raw, "session_id", "sessionId")
    )


def source_turn_id(payload: dict[str, Any]) -> str | None:
    raw = raw_payload(payload)
    return (
        first_text(payload, "source_turn_id", "sourceTurnId")
        or first_text(raw, "source_turn_id", "sourceTurnId")
        or first_text(payload, "turn_id", "turnId")
        or first_text(raw, "turn_id", "turnId")
    )


def compact_record(payload: dict[str, Any]) -> dict[str, Any]:
    transcript_path = text_field(payload, "transcript_path")
    transcript_exists = False
    transcript_bytes: int | None = None
    if transcript_path:
        try:
            transcript = Path(transcript_path).expanduser()
            stat = transcript.stat()
            transcript_exists = transcript.is_file()
            transcript_bytes = stat.st_size if transcript_exists else None
        except OSError:
            transcript_exists = False
            transcript_bytes = None

    return {
        "schema_version": SCHEMA_VERSION,
        "recorded_at": utc_now_iso_z(),
        "hook_event_name": HOOK_EVENT,
        "runtime": runtime(payload),
        "source_thread_id": source_thread_id(payload),
        "source_turn_id": source_turn_id(payload),
        "session_id": text_field(payload, "session_id"),
        "turn_id": text_field(payload, "turn_id"),
        "reason": text_field(payload, "reason"),
        "cwd": text_field(payload, "cwd"),
        "transcript_path": transcript_path,
        "transcript_exists": transcript_exists,
        "transcript_bytes": transcript_bytes,
    }


def safe_file_stem(value: str | None) -> str:
    if not value:
        return f"unknown-{utc_now_file_stamp()}"
    cleaned = re.sub(r"[^A-Za-z0-9._-]+", "-", value.strip()).strip(".-")
    return cleaned or f"unknown-{utc_now_file_stamp()}"


def write_session_end_record(root: Path, record: dict[str, Any]) -> None:
    source_id = record.get("source_thread_id") or record.get("session_id")
    stem = safe_file_stem(source_id if isinstance(source_id, str) else None)
    path = root / SESSION_END_DIR / f"{stem}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = path.with_suffix(path.suffix + ".tmp")
    tmp_path.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")
    tmp_path.replace(path)


def main() -> int:
    payload = read_payload()
    event_name = payload.get("hook_event_name") or os.environ.get("AGENT_HOOK_EVENT")
    if event_name not in {None, HOOK_EVENT}:
        return 0
    if payload.get("schema_version") not in {None, SCHEMA_VERSION}:
        return 0

    root = repo_root(payload)
    os.chdir(root)
    write_session_end_record(root, compact_record(payload))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"session-end: {exc}", file=sys.stderr)
        raise SystemExit(0)
