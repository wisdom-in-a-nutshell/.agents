#!/usr/bin/env python3
"""Background worker that turns an ended agent transcript into a Dobby session note.

This worker is launched by the Dobby SessionEnd hook and intentionally runs out
of band. It reads the normalized lifecycle payload, renders a compact transcript,
hands that transcript to a note-generation placeholder, and writes the note under:

    memory/sessions/YYYY/MM/DD-HHMMSS.md

The stored note is free-form prose only. Runtime labels and timestamps are added
by the SessionStart boot loader when notes are injected into context.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any
from zoneinfo import ZoneInfo

LOCAL_TIMEZONE = "Europe/Berlin"
MAX_TRANSCRIPT_CHARS = 120_000
TEXT_SNIPPET_CHARS = 8_000
TOOL_RESULT_CHARS = 1_200
SESSION_NOTE_PROMPT = """You are Dobby writing a short memory note about the session that just ended.

You have the full transcript above. Write a brief note — what we talked about, what came up, what was decided, anything still hanging, anything worth remembering next time we pick up.

Keep it natural. Write it the way a thoughtful friend would write a note to themselves so they don't forget. Not a form, not a report — just a note.

Length: as long as it needs to be, no longer. A two-message check-in might be one line. A long working session might be a paragraph or two. Don't pad.

Voice: direct, warm, human. First person plural ("we talked about...") is fine. No corporate language, no headings unless they genuinely help.

Output only the note body. No preamble, no explanation.
"""


def log(message: str) -> None:
    print(f"[write-session-note] {message}", file=sys.stderr)


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"failed to read job payload {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise RuntimeError(f"job payload {path} is not a JSON object")
    return value


def repo_root(payload: dict[str, Any], explicit: str | None) -> Path:
    raw = explicit or payload.get("repo_root") or os.environ.get("AGENT_REPO_ROOT") or "."
    return Path(str(raw)).expanduser().resolve()


def load_dotenv(root: Path) -> None:
    """Tiny .env loader for hooks launched outside an interactive direnv shell.

    Existing environment variables win. This intentionally supports only the
    common KEY=VALUE shape used by this workspace's local secret bootstrap.
    """
    path = root / ".env"
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return

    for raw in lines:
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip()
        if not key or key in os.environ:
            continue
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
            value = value[1:-1]
        os.environ[key] = value


def parse_timestamp(value: Any) -> datetime | None:
    if value is None:
        return None
    if isinstance(value, (int, float)):
        # Runtime payloads may use milliseconds. Seconds are also accepted.
        number = float(value)
        if number > 10_000_000_000:
            number /= 1000.0
        try:
            return datetime.fromtimestamp(number, tz=timezone.utc)
        except (OSError, ValueError):
            return None
    if isinstance(value, str):
        text = value.strip()
        if not text:
            return None
        if text.isdigit():
            return parse_timestamp(int(text))
        if text.endswith("Z"):
            text = text[:-1] + "+00:00"
        try:
            parsed = datetime.fromisoformat(text)
        except ValueError:
            return None
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=timezone.utc)
        return parsed.astimezone(timezone.utc)
    return None


def session_start_timestamp(payload: dict[str, Any], events: list[dict[str, Any]]) -> datetime:
    for event in events:
        event_type = event.get("type")
        data = event.get("data") if isinstance(event.get("data"), dict) else {}
        candidates: list[Any] = []
        if event_type == "session.start":
            candidates.append(data.get("startTime"))
        candidates.append(event.get("timestamp"))
        for candidate in candidates:
            parsed = parse_timestamp(candidate)
            if parsed is not None:
                return parsed

    for key in ("timestamp", "started_at", "created_at"):
        parsed = parse_timestamp(payload.get(key))
        if parsed is not None:
            return parsed

    return datetime.now(timezone.utc)


def truncate_text(value: str, limit: int) -> str:
    text = re.sub(r"\n{3,}", "\n\n", value.strip())
    if len(text) <= limit:
        return text
    suffix = "\n...[truncated]"
    return text[: max(0, limit - len(suffix))].rstrip() + suffix


def stringify_content(value: Any, *, tool_result: bool = False) -> str:
    if value is None:
        return ""
    if isinstance(value, str):
        return truncate_text(value, TOOL_RESULT_CHARS if tool_result else TEXT_SNIPPET_CHARS)
    if isinstance(value, list):
        parts: list[str] = []
        for item in value:
            if isinstance(item, str):
                parts.append(item)
            elif isinstance(item, dict):
                kind = item.get("type")
                if kind == "text" and isinstance(item.get("text"), str):
                    parts.append(item["text"])
                elif kind == "tool_use":
                    name = item.get("name") or "tool"
                    parts.append(f"[assistant used tool: {name}]")
                elif kind == "tool_result":
                    content = stringify_content(item.get("content"), tool_result=True)
                    if content:
                        parts.append(f"[tool result]\n{content}")
                elif isinstance(item.get("content"), str):
                    parts.append(item["content"])
        return truncate_text("\n".join(part for part in parts if part), TOOL_RESULT_CHARS if tool_result else TEXT_SNIPPET_CHARS)
    if isinstance(value, dict):
        if isinstance(value.get("content"), str):
            return truncate_text(value["content"], TOOL_RESULT_CHARS if tool_result else TEXT_SNIPPET_CHARS)
        if isinstance(value.get("text"), str):
            return truncate_text(value["text"], TOOL_RESULT_CHARS if tool_result else TEXT_SNIPPET_CHARS)
        return truncate_text(json.dumps(value, ensure_ascii=False, sort_keys=True), TOOL_RESULT_CHARS if tool_result else TEXT_SNIPPET_CHARS)
    return truncate_text(str(value), TOOL_RESULT_CHARS if tool_result else TEXT_SNIPPET_CHARS)


def read_jsonl(path: Path) -> list[dict[str, Any]]:
    events: list[dict[str, Any]] = []
    try:
        with path.open("r", encoding="utf-8", errors="replace") as handle:
            for line in handle:
                stripped = line.strip()
                if not stripped:
                    continue
                try:
                    value = json.loads(stripped)
                except json.JSONDecodeError:
                    continue
                if isinstance(value, dict):
                    events.append(value)
    except OSError as exc:
        raise RuntimeError(f"failed to read transcript {path}: {exc}") from exc
    return events


def render_copilot_events(events: list[dict[str, Any]]) -> str:
    lines: list[str] = []
    for event in events:
        event_type = str(event.get("type") or "")
        data = event.get("data") if isinstance(event.get("data"), dict) else {}

        if event_type == "session.start":
            context = data.get("context") if isinstance(data.get("context"), dict) else {}
            cwd = context.get("cwd") or context.get("gitRoot")
            start = data.get("startTime") or event.get("timestamp")
            meta = f"Session started: {start}"
            if cwd:
                meta += f" cwd={cwd}"
            lines.append(meta)
        elif event_type == "session.resume":
            lines.append(f"Session resumed: {event.get('timestamp')}")
        elif event_type == "session.model_change":
            model = data.get("newModel")
            if model:
                lines.append(f"Model: {model}")
        elif event_type == "user.message":
            text = stringify_content(data.get("content") or data.get("transformedContent"))
            if text:
                lines.append(f"User:\n{text}")
        elif event_type == "assistant.message":
            text = stringify_content(data.get("content"))
            tool_requests = data.get("toolRequests")
            if isinstance(tool_requests, list) and tool_requests:
                names = [str(item.get("name") or item.get("toolName") or "tool") for item in tool_requests if isinstance(item, dict)]
                if names:
                    text = (text + "\n" if text else "") + f"[assistant requested tools: {', '.join(names)}]"
            if text:
                lines.append(f"Assistant:\n{text}")
        elif event_type == "tool.execution_start":
            name = data.get("toolName") or "tool"
            args = data.get("arguments")
            detail = ""
            if isinstance(args, dict):
                command = args.get("command") or args.get("cmd") or args.get("description")
                if command:
                    detail = f": {truncate_text(str(command), 500)}"
            lines.append(f"Tool started ({name}){detail}")
        elif event_type == "tool.execution_complete":
            success = data.get("success")
            result = data.get("result") if isinstance(data.get("result"), dict) else {}
            content = stringify_content(result.get("content") or result.get("detailedContent"), tool_result=True)
            status = "success" if success is True else "failed" if success is False else "complete"
            if content and content != "<exited with exit code 0>":
                lines.append(f"Tool {status}:\n{content}")
            else:
                lines.append(f"Tool {status}.")
        elif event_type == "subagent.started":
            name = data.get("agentDisplayName") or data.get("agentName") or "subagent"
            lines.append(f"Subagent started: {name}")
        elif event_type == "subagent.completed":
            name = data.get("agentDisplayName") or data.get("agentName") or "subagent"
            lines.append(f"Subagent completed: {name}")
        elif event_type == "session.shutdown":
            metrics = data.get("codeChanges") if isinstance(data.get("codeChanges"), dict) else {}
            modified = metrics.get("filesModified")
            if isinstance(modified, list) and modified:
                lines.append("Files modified: " + ", ".join(str(item) for item in modified[:30]))

    return truncate_text("\n\n".join(lines), MAX_TRANSCRIPT_CHARS)


def render_claude_events(events: list[dict[str, Any]]) -> str:
    lines: list[str] = []
    for event in events:
        event_type = str(event.get("type") or "")
        if event_type == "summary":
            summary = stringify_content(event.get("summary") or event.get("content"))
            if summary:
                lines.append(f"Existing summary:\n{summary}")
            continue
        if event_type not in {"user", "assistant"}:
            continue
        message = event.get("message") if isinstance(event.get("message"), dict) else {}
        role = message.get("role") or event_type
        content = stringify_content(message.get("content"))
        if content:
            label = "User" if role == "user" else "Assistant"
            lines.append(f"{label}:\n{content}")
    return truncate_text("\n\n".join(lines), MAX_TRANSCRIPT_CHARS)


def render_fallback_payload(payload: dict[str, Any]) -> str:
    lines: list[str] = []
    initial = stringify_content(payload.get("initial_prompt"))
    prompt = stringify_content(payload.get("prompt"))
    final = stringify_content(payload.get("final_message"))
    error = stringify_content(payload.get("error"))
    if initial:
        lines.append(f"Initial prompt:\n{initial}")
    if prompt:
        lines.append(f"User:\n{prompt}")
    if final:
        lines.append(f"Assistant final message:\n{final}")
    if error:
        lines.append(f"Error:\n{error}")
    return truncate_text("\n\n".join(lines), MAX_TRANSCRIPT_CHARS)


def transcript_path(payload: dict[str, Any]) -> Path | None:
    raw = payload.get("transcript_path") or payload.get("transcriptPath")
    if isinstance(raw, str) and raw.strip():
        return Path(raw).expanduser()
    return None


def render_transcript(payload: dict[str, Any]) -> tuple[str, list[dict[str, Any]]]:
    path = transcript_path(payload)
    events: list[dict[str, Any]] = []
    if path and path.is_file():
        events = read_jsonl(path)
        fmt = str(payload.get("transcript_format") or payload.get("transcriptFormat") or "")
        runtime = str(payload.get("runtime") or os.environ.get("AGENT_HOOK_RUNTIME") or "")
        if fmt == "copilot-gateway-jsonl" or runtime == "copilot":
            rendered = render_copilot_events(events)
        elif fmt == "claude-jsonl" or runtime == "claude":
            rendered = render_claude_events(events)
        else:
            rendered = render_claude_events(events) or render_copilot_events(events)
        if rendered:
            return rendered, events

    fallback = render_fallback_payload(payload)
    return fallback, events


def resolve_output_path(root: Path, start_utc: datetime) -> Path:
    local = start_utc.astimezone(ZoneInfo(LOCAL_TIMEZONE))
    sessions_dir = root / "memory" / "sessions" / local.strftime("%Y") / local.strftime("%m")
    sessions_dir.mkdir(parents=True, exist_ok=True)
    base = local.strftime("%d-%H%M%S")
    for index in range(1, 1000):
        suffix = "" if index == 1 else f"-{index}"
        candidate = sessions_dir / f"{base}{suffix}.md"
        if not candidate.exists():
            return candidate
    raise RuntimeError(f"could not allocate unique session note path under {sessions_dir}")


def generate_note(transcript: str, payload: dict[str, Any], *, fake_note: str | None) -> str | None:
    """Return a prose session note, or None when no generator is configured.

    This is intentionally a placeholder. Do not add a provider-specific SDK or
    API key dependency here without the user's explicit choice. Future provider
    implementations can use `SESSION_NOTE_PROMPT`, `transcript`, and `payload`.
    """
    fake = fake_note if fake_note is not None else os.environ.get("DOBBY_SESSION_MEMORY_FAKE_NOTE")
    if fake is not None:
        return fake.strip()

    # Provider intentionally not wired yet. Keep the hook path alive while the
    # model client/API route is decided separately.
    return None


def write_note(path: Path, note: str) -> Path:
    text = note.strip()
    if not text:
        raise RuntimeError("model returned empty note")
    if len(text) > 12_000:
        text = truncate_text(text, 12_000)
    try:
        with path.open("x", encoding="utf-8") as handle:
            handle.write(text + "\n")
        return path
    except FileExistsError:
        # Race-safe fallback if another worker claimed the path after allocation.
        base = path.with_suffix("")
        for index in range(2, 1000):
            candidate = base.parent / f"{base.name}-{index}.md"
            try:
                with candidate.open("x", encoding="utf-8") as handle:
                    handle.write(text + "\n")
                return candidate
            except FileExistsError:
                continue
        raise RuntimeError(f"could not write unique note near {path}")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Write a Dobby session memory note from a hook payload.")
    parser.add_argument("--job", required=True, help="Path to normalized hook payload JSON.")
    parser.add_argument("--repo-root", help="Workspace root override.")
    parser.add_argument("--fake-note", help=argparse.SUPPRESS)
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    payload = read_json(Path(args.job).expanduser())
    root = repo_root(payload, args.repo_root)
    load_dotenv(root)

    transcript, events = render_transcript(payload)
    if not transcript.strip():
        log("no transcript or fallback prompt content available; skipping note")
        return 0

    note = generate_note(transcript, payload, fake_note=args.fake_note)
    if note is None:
        log("note generation is not configured yet; skipping note")
        return 0

    start = session_start_timestamp(payload, events)
    path = resolve_output_path(root, start)
    written = write_note(path, note)
    log(f"wrote {written.relative_to(root)}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:  # Session memory must never break the caller.
        log(str(exc))
        raise SystemExit(0)
