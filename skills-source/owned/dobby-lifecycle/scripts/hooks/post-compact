#!/usr/bin/env python3
"""Dobby post-compact hook.

Intentionally inert for now.

Memory consolidation is exposed as the explicit `consolidate-thread` primitive.
PostCompact should not record events, launch sidecars, or write memory until a
caller deliberately wires a policy back in.
"""
from __future__ import annotations

import sys


def main() -> int:
    # Drain stdin so runtimes can send payloads without risking a broken pipe,
    # but intentionally do nothing with the payload.
    sys.stdin.read()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
