#!/usr/bin/env python3
"""Agent-native CLI for Dobby session transcripts.

Copies the raw runtime transcript into a session folder (raw.jsonl) and renders
the normalized dialogue.md from it. raw.jsonl is the durable source of truth;
dialogue.md can be re-rendered at any time (see transcript_lib.NORMALIZER_VERSION).

Subcommands:
- capture   copy raw + render dialogue for one session folder
- render    render dialogue.md from a raw transcript file (stdout; debugging)
- backfill  walk a workspace's session folders and capture any missing transcripts
"""

from __future__ import annotations

import argparse
import json
import shutil
import sys
import time
import uuid
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from session_memory_lib import (  # noqa: E402
    DIALOGUE_FILENAME,
    RAW_FILENAME,
    SessionMemoryError,
    iter_session_dirs,
    read_record,
    resolve_session_dir,
    update_meta,
)
from transcript_lib import (  # noqa: E402
    NORMALIZER_VERSION,
    TranscriptError,
    find_raw_transcript,
    parse_raw_transcript,
    render_dialogue_md,
)

OUTPUT_SCHEMA_VERSION = "1.0"
COMMAND = "session-transcript"

EXIT_GENERIC = 1
EXIT_USAGE = 2


def utc_now() -> str:
    return datetime.now(UTC).isoformat(timespec="seconds").replace("+00:00", "Z")


def envelope(command: str, status: str, data: dict[str, Any] | None, error: dict[str, Any] | None, started: float) -> dict[str, Any]:
    return {
        "schema_version": OUTPUT_SCHEMA_VERSION,
        "command": command,
        "status": status,
        "data": data or {},
        "error": error,
        "meta": {
            "request_id": str(uuid.uuid4()),
            "duration_ms": int((time.time() - started) * 1000),
            "timestamp_utc": utc_now(),
        },
    }


def print_json(value: dict[str, Any]) -> None:
    print(json.dumps(value, ensure_ascii=False, sort_keys=True))


def add_common(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--json", action="store_true", help="Emit JSON envelope; default behavior.")
    parser.add_argument("--plain", action="store_true", help="Emit stable plain-text output.")
    parser.add_argument("--no-input", action="store_true", help="Run non-interactively; accepted for agent callers.")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Capture and normalize raw transcripts for Dobby session folders.")
    sub = parser.add_subparsers(dest="subcommand", required=True)

    capture = sub.add_parser("capture", help="Copy raw transcript + render dialogue.md for one session folder.")
    capture.add_argument("--workspace-root", default=".")
    capture.add_argument("--session-dir", help="Session folder (or a file inside it). Defaults to newest folder matching --thread-id.")
    capture.add_argument("--thread-id", help="Locate the session folder by source thread/session id.")
    capture.add_argument("--raw", help="Path to the raw transcript; located from runtime stores when omitted.")
    capture.add_argument("--force", action="store_true", help="Re-copy raw.jsonl even when it already exists.")
    add_common(capture)

    render = sub.add_parser("render", help="Render dialogue markdown from a raw transcript file.")
    render.add_argument("--raw", required=True)
    render.add_argument("--runtime", required=True, choices=["codex", "claude"])
    add_common(render)

    backfill = sub.add_parser("backfill", help="Capture transcripts for all session folders missing them.")
    backfill.add_argument("--workspace-root", default=".")
    backfill.add_argument("--apply", action="store_true", help="Write files; default is a dry-run report.")
    backfill.add_argument("--rerender", action="store_true", help="Also re-render dialogue.md where raw.jsonl already exists.")
    add_common(backfill)

    return parser


class SessionTranscriptError(RuntimeError):
    pass


def locate_session_dir(workspace_root: Path, thread_id: str) -> Path:
    sessions_dir = workspace_root / "memory" / "sessions"
    matches: list[Path] = []
    for session_dir in iter_session_dirs(sessions_dir):
        try:
            record = read_record(session_dir)
        except SessionMemoryError:
            continue
        if record.get("threadId") == thread_id:
            matches.append(session_dir)
    if not matches:
        raise SessionTranscriptError(f"no session folder found for threadId {thread_id}")
    return matches[-1]


def capture_session(
    session_dir: Path,
    *,
    raw_override: Path | None = None,
    force: bool = False,
    rerender: bool = True,
) -> dict[str, Any]:
    record = read_record(session_dir)
    runtime = str(record["runtime"])
    thread_id = record.get("threadId")
    raw_target = session_dir / RAW_FILENAME
    copied = False
    if raw_override is not None:
        source: Path | None = raw_override
        if not source.is_file():
            raise SessionTranscriptError(f"raw transcript not found: {source}")
    elif raw_target.is_file() and not force:
        source = None
    else:
        if not thread_id:
            raise SessionTranscriptError(f"{session_dir}: threadId is null; cannot locate raw transcript")
        source = find_raw_transcript(runtime, thread_id)
        if source is None:
            raise SessionTranscriptError(
                f"{session_dir}: raw transcript for {runtime} session {thread_id} no longer exists"
            )
    if source is not None and (force or not raw_target.is_file() or raw_override is not None):
        tmp = raw_target.with_name(f".{raw_target.name}.tmp")
        shutil.copyfile(source, tmp)
        tmp.replace(raw_target)
        copied = True
    dialogue_target = session_dir / DIALOGUE_FILENAME
    rendered = False
    if rerender or not dialogue_target.is_file():
        dialogue = parse_raw_transcript(raw_target, runtime)
        dialogue_target.write_text(render_dialogue_md(dialogue), encoding="utf-8")
        rendered = True
        if dialogue.cwd and record.get("cwd") != dialogue.cwd:
            update_meta(session_dir, {"cwd": dialogue.cwd})
    return {
        "sessionDir": str(session_dir),
        "runtime": runtime,
        "threadId": thread_id,
        "rawCopied": copied,
        "dialogueRendered": rendered,
        "normalizerVersion": NORMALIZER_VERSION,
    }


def command_capture(args: argparse.Namespace) -> dict[str, Any]:
    workspace_root = Path(args.workspace_root).expanduser().resolve()
    if args.session_dir:
        session_dir = resolve_session_dir(Path(args.session_dir).expanduser().resolve())
    elif args.thread_id:
        session_dir = locate_session_dir(workspace_root, args.thread_id)
    else:
        raise SessionTranscriptError("capture needs --session-dir or --thread-id")
    raw_override = Path(args.raw).expanduser().resolve() if args.raw else None
    return capture_session(session_dir, raw_override=raw_override, force=args.force)


def command_render(args: argparse.Namespace) -> dict[str, Any]:
    raw = Path(args.raw).expanduser().resolve()
    if not raw.is_file():
        raise SessionTranscriptError(f"raw transcript not found: {raw}")
    dialogue = parse_raw_transcript(raw, args.runtime)
    return {"dialogue": render_dialogue_md(dialogue)}


def command_backfill(args: argparse.Namespace) -> dict[str, Any]:
    workspace_root = Path(args.workspace_root).expanduser().resolve()
    sessions_dir = workspace_root / "memory" / "sessions"
    captured: list[dict[str, Any]] = []
    missing: list[dict[str, str]] = []
    skipped = 0
    for session_dir in iter_session_dirs(sessions_dir):
        raw_present = (session_dir / RAW_FILENAME).is_file()
        dialogue_present = (session_dir / DIALOGUE_FILENAME).is_file()
        if raw_present and dialogue_present and not args.rerender:
            skipped += 1
            continue
        if not args.apply:
            try:
                record = read_record(session_dir)
            except SessionMemoryError as exc:
                missing.append({"sessionDir": str(session_dir), "reason": str(exc)})
                continue
            thread_id = record.get("threadId")
            source = (
                find_raw_transcript(str(record["runtime"]), thread_id)
                if thread_id and not raw_present
                else None
            )
            if raw_present or source is not None:
                captured.append(
                    {
                        "sessionDir": str(session_dir),
                        "runtime": record["runtime"],
                        "threadId": thread_id,
                        "rawCopied": not raw_present,
                        "dialogueRendered": True,
                        "dryRun": True,
                    }
                )
            else:
                missing.append(
                    {
                        "sessionDir": str(session_dir),
                        "reason": "raw transcript no longer exists" if thread_id else "threadId is null",
                    }
                )
            continue
        try:
            captured.append(capture_session(session_dir, rerender=args.rerender or not dialogue_present))
        except (SessionTranscriptError, TranscriptError, SessionMemoryError) as exc:
            missing.append({"sessionDir": str(session_dir), "reason": str(exc)})
    return {
        "apply": bool(args.apply),
        "captured": captured,
        "missing": missing,
        "alreadyComplete": skipped,
    }


def plain_output(subcommand: str, data: dict[str, Any]) -> str:
    if subcommand == "render":
        return str(data.get("dialogue", ""))
    if subcommand == "backfill":
        return (
            f"captured={len(data.get('captured', []))} "
            f"missing={len(data.get('missing', []))} "
            f"alreadyComplete={data.get('alreadyComplete', 0)} apply={data.get('apply')}"
        )
    return json.dumps(data, indent=2, ensure_ascii=False)


def main() -> int:
    started = time.time()
    parser = build_parser()
    args = parser.parse_args()
    command = f"{COMMAND} {args.subcommand}"
    try:
        if args.subcommand == "capture":
            data = command_capture(args)
        elif args.subcommand == "render":
            data = command_render(args)
        elif args.subcommand == "backfill":
            data = command_backfill(args)
        else:  # pragma: no cover
            raise SessionTranscriptError(f"unsupported subcommand: {args.subcommand}")
    except (SessionTranscriptError, TranscriptError, SessionMemoryError) as exc:
        result = envelope(
            command,
            "error",
            None,
            {
                "code": "E_SESSION_TRANSCRIPT",
                "message": str(exc),
                "retryable": False,
                "hint": "Check the session folder, thread id, and runtime transcript stores.",
            },
            started,
        )
        print_json(result)
        return EXIT_USAGE
    except Exception as exc:  # pragma: no cover
        result = envelope(
            command,
            "error",
            None,
            {
                "code": "E_RUNTIME",
                "message": str(exc),
                "retryable": False,
                "hint": "Inspect stderr or rerun with --plain.",
            },
            started,
        )
        print_json(result)
        return EXIT_GENERIC

    result = envelope(command, "ok", data, None, started)
    if args.plain:
        print(plain_output(args.subcommand, data))
    else:
        print_json(result)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        raise SystemExit(0) from None
