#!/usr/bin/env python3
"""Shared validator orchestrator for Dobby workspaces.

This script owns validation routing, not domain schemas. Domain contracts stay in
owning skills exposed through their public `scripts/validate` facades.
"""

from __future__ import annotations

import argparse
import fnmatch
import subprocess
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
LINT_WORKSPACE = SCRIPT_DIR / "lint-workspace"

ROUTES: tuple[tuple[str, str, tuple[str, ...]], ...] = (
    ("dobby-lifecycle", "lifecycle", ("memory/sessions/*/*/*.json",)),
    ("journal-checkin", "journal", ("journal/daily/*/morning.json", "journal/daily/*/night.json")),
    ("dobby-shelf", "shelf", ("state/shelf.json",)),
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Validate a Dobby workspace.")
    parser.add_argument("--workspace-root", default=".", help="Dobby workspace root.")
    parser.add_argument("--scope", choices=("staged", "full"), default="staged")
    parser.add_argument("--no-input", action="store_true", help="Accepted for non-interactive callers.")
    return parser.parse_args()


def fail(message: str) -> None:
    print(f"[validate-workspace] {message}", file=sys.stderr)
    raise SystemExit(1)


def run(cmd: list[str], root: Path, *, label: str, timeout: int = 120, quiet_stdout: bool = False) -> None:
    try:
        result = subprocess.run(
            cmd,
            cwd=root,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as exc:
        fail(f"{label} timed out after {exc.timeout}s: {' '.join(cmd)}")
    except OSError as exc:
        fail(f"{label} failed to start: {exc}")

    if result.stdout.strip() and not quiet_stdout:
        print(result.stdout.rstrip())
    if result.stderr.strip():
        print(result.stderr.rstrip(), file=sys.stderr)
    if result.returncode != 0:
        fail(f"{label} failed with exit code {result.returncode}: {' '.join(cmd)}")


def git_files(root: Path, scope: str) -> list[str]:
    if scope == "staged":
        cmd = ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"]
    else:
        cmd = ["git", "ls-files"]
    result = subprocess.run(cmd, cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=60)
    if result.returncode != 0:
        fail(f"could not collect {scope} files\n{result.stderr.strip()}")
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def existing_file_paths(root: Path, rel_paths: list[str]) -> list[tuple[str, Path]]:
    out: list[tuple[str, Path]] = []
    for rel in rel_paths:
        path = root / rel
        if path.is_file():
            out.append((rel, path))
    return out


def check_conflict_markers(root: Path, files: list[tuple[str, Path]]) -> None:
    markers = ("<<<<<<< ", "=======", ">>>>>>> ")
    findings: list[str] = []
    for rel, path in files:
        try:
            for idx, line in enumerate(path.read_text(encoding="utf-8", errors="ignore").splitlines(), start=1):
                if line.startswith(markers):
                    findings.append(f"{rel}:{idx}:{line}")
        except OSError:
            continue
    if findings:
        fail("merge conflict markers detected\n" + "\n".join(findings[:50]))


def check_generic_syntax(root: Path, files: list[tuple[str, Path]]) -> None:
    for rel, path in files:
        if rel.endswith(".sh"):
            run(["bash", "-n", str(path)], root, label=f"bash syntax {rel}", timeout=30)
        elif rel.endswith(".py"):
            run([sys.executable, "-m", "py_compile", str(path)], root, label=f"python compile {rel}", timeout=30)
        elif rel.endswith(".json"):
            run(
                [sys.executable, "-m", "json.tool", str(path)],
                root,
                label=f"json syntax {rel}",
                timeout=30,
                quiet_stdout=True,
            )


def route_matches(rel: str, patterns: tuple[str, ...]) -> bool:
    return any(fnmatch.fnmatchcase(rel, pattern) for pattern in patterns)


def skill_validator(root: Path, skill: str) -> Path:
    path = root / ".agents" / "skills" / skill / "scripts" / "validate"
    if not path.is_file():
        fail(f"missing validator for {skill}: {path}")
    return path


def run_domain_validators(root: Path, rel_paths: list[str]) -> None:
    for skill, label, patterns in ROUTES:
        matched = sorted(rel for rel in rel_paths if route_matches(rel, patterns))
        if not matched:
            continue
        validator = skill_validator(root, skill)
        run(
            [str(validator), "--workspace-root", str(root), "--scope", "paths", *matched, "--no-input"],
            root,
            label=f"{label} validation",
            timeout=120,
        )


def main() -> int:
    args = parse_args()
    root = Path(args.workspace_root).expanduser().resolve()
    if not root.is_dir():
        fail(f"workspace root does not exist or is not a directory: {root}")
    if not LINT_WORKSPACE.is_file():
        fail(f"missing workspace linter: {LINT_WORKSPACE}")

    run([str(LINT_WORKSPACE), "--workspace-root", str(root)], root, label="workspace shape lint", timeout=120)

    rel_paths = git_files(root, args.scope)
    files = existing_file_paths(root, rel_paths)
    check_conflict_markers(root, files)
    if args.scope == "staged":
        run(["git", "diff", "--cached", "--check"], root, label="staged diff check", timeout=60)
    check_generic_syntax(root, files)
    run_domain_validators(root, rel_paths)

    print(f"[validate-workspace] passed scope={args.scope} files={len(rel_paths)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
