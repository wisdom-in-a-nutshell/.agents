#!/usr/bin/env python3
"""Fast Dobby workspace shape linter.

This is Dobby's cheap mechanical reflex. The shared semantic map lives in
`dobby-workspace/references/body-map.md`; this script owns the exact enforceable
body shape.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from datetime import datetime
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPT_DIR))

from frontmatter import FrontmatterError, iter_markdown_headings, read_frontmatter_file  # noqa: E402


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Lint a Dobby workspace body shape.")
    parser.add_argument(
        "--workspace-root",
        default=".",
        help="Workspace repo root to lint. Defaults to the current directory.",
    )
    return parser.parse_args()


def resolve_root(value: str) -> Path:
    path = Path(value).expanduser().resolve()
    if not path.exists():
        raise SystemExit(f"workspace root does not exist: {path}")
    return path


ARGS = parse_args()
ROOT = resolve_root(ARGS.workspace_root)

REQUIRED_TOP_LEVEL = {
    "memory": "dir",
    "journal": "dir",
    "state": "dir",
    "dobby": "dir",
    "projects": "dir",
    "scripts": "dir",
}

ALLOWED_TOP_LEVEL = {
    *REQUIRED_TOP_LEVEL.keys(),
    ".agents",
    ".antigravitycli",
    ".claude",
    ".codex",
    ".github",
    ".gitignore",
    ".envrc",
    "tmp",
}

LOCAL_TOP_LEVEL_IGNORES = {
    ".git",
    ".venv",
    ".ruff_cache",
    ".DS_Store",
}

SECOND_LEVEL = {
    "memory": {
        "files": {"now.md", "profile.md"},
        "dirs": {"areas", "sessions", "dreams"},
    },
    "journal": {
        "files": set(),
        "dirs": {"daily", "monthly", "templates"},
    },
    "state": {
        "files": {"shelf.json"},
        "dirs": set(),
    },
    "dobby": {
        "files": {"constitution.md", "growth.jsonl"},
        "dirs": set(),
    },
    "scripts": {
        "files": {"check-fast.sh", "check-full.sh", "lint-workspace.py"},
        "dirs": {"hooks", "local"},
    },
    ".agents": {
        "files": set(),
        "dirs": {"skills"},
    },
    ".codex": {
        "files": {"config.toml", "hooks.json"},
        "dirs": {"agents", "environments"},
    },
    ".github": {
        "files": set(),
        "dirs": {"hooks"},
    },
}

IGNORED_CHILD_NAMES = {".DS_Store", "__pycache__"}
SENSITIVITY_VALUES = {"public", "personal", "sensitive", "restricted"}
GROWTH_KIND_VALUES = {"behavioral-correction", "blindspot", "operational-instinct", "promotion"}
GROWTH_SOURCE_TYPE_VALUES = {"conversation", "review", "dream"}
SECTION_KEY_RE = re.compile(r"^[a-z0-9]+(?:_[a-z0-9]+)*$")
ISOISH_RE = re.compile(r"^\d{4}-\d{2}-\d{2}T")
SESSION_FOLDER_RE = re.compile(r"^\d{2}-\d{6}(?:-\d+)?$")
SESSION_TLDR_MAX = 240
WORKSPACE_CHANGES_HEADING = "## Workspace changes"

COMMON_FRONTMATTER_KEYS = {"schemaVersion", "kind", "updatedAt", "sensitivity"}


class Finding:
    def __init__(self, kind: str, path: Path, message: str):
        self.kind = kind
        self.path = path
        self.message = message

    def render(self) -> str:
        rel = self.path.relative_to(ROOT) if self.path.is_absolute() else self.path
        return (
            f"{self.kind}: {rel}\n"
            f"{self.message}\n"
            "\n"
            "If this was accidental, remove it.\n"
            "If this was intentional, ask Adi whether this should become part of "
            "Dobby's workspace body, then update the dobby-workspace "
            "shared body map and linter."
        )


errors: list[Finding] = []
warnings: list[Finding] = []


def add_error(path: Path, message: str) -> None:
    errors.append(Finding("ERROR", path, message))


def add_warning(path: Path, message: str) -> None:
    warnings.append(Finding("WARNING", path, message))


def iter_children(path: Path):
    if not path.exists() or not path.is_dir():
        return []
    return sorted(path.iterdir(), key=lambda p: p.name)


def check_required_top_level() -> None:
    for name, expected in REQUIRED_TOP_LEVEL.items():
        path = ROOT / name
        if not path.exists():
            add_error(path, f"Required Dobby workspace organ is missing: {name}.")
            continue
        if expected == "file" and not path.is_file():
            add_error(path, f"Required Dobby workspace organ should be a file: {name}.")
        if expected == "dir" and not path.is_dir():
            add_error(path, f"Required Dobby workspace organ should be a directory: {name}.")


def is_ignored_top_level(name: str) -> bool:
    if name in LOCAL_TOP_LEVEL_IGNORES:
        return True
    return name.startswith(".env") and name != ".envrc"


def check_top_level_shape() -> None:
    for child in iter_children(ROOT):
        name = child.name
        if is_ignored_top_level(name) or name in ALLOWED_TOP_LEVEL:
            continue
        add_error(
            child,
            "Unexpected top-level path. Dobby's root should stay small: only "
            "intentional organs belong here.",
        )


def check_second_level_shape() -> None:
    for parent_name, contract in SECOND_LEVEL.items():
        parent = ROOT / parent_name
        if not parent.exists():
            continue
        allowed_files = contract["files"]
        allowed_dirs = contract["dirs"]
        for child in iter_children(parent):
            if child.name in IGNORED_CHILD_NAMES:
                continue
            if child.is_dir() and child.name in allowed_dirs:
                continue
            if child.is_file() and child.name in allowed_files:
                continue
            add_error(
                child,
                f"Unexpected second-level path under {parent_name}/. This is a "
                "new folder/file in a deliberate workspace organ.",
            )


def check_projects() -> None:
    projects = ROOT / "projects"
    if not projects.exists():
        return
    for child in iter_children(projects):
        if child.name in IGNORED_CHILD_NAMES:
            continue
        if not child.is_dir():
            add_error(child, "projects/ should contain project folders, not loose files.")
            continue
        if child.name == "archive":
            for archived in iter_children(child):
                if archived.is_dir() and not (archived / "tasks.md").exists():
                    add_warning(archived, "Archived project folder does not contain tasks.md.")
            continue
        if not (child / "tasks.md").exists():
            add_error(child, "Active project folders must contain tasks.md.")


def load_json_object(path: Path, label: str, *, missing_error: bool = True) -> dict | None:
    if not path.exists():
        if missing_error:
            add_error(path, f"Missing {label}.")
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        add_error(path, f"{label} is not valid JSON: {exc}.")
        return None
    if not isinstance(data, dict):
        add_error(path, f"{label} should be a JSON object.")
        return None
    return data


def require_keys(path: Path, data: dict, keys: set[str], label: str) -> None:
    missing = sorted(key for key in keys if key not in data)
    if missing:
        add_error(path, f"{label} is missing required key(s): {', '.join(missing)}.")


def require_string(path: Path, data: dict, key: str, label: str, *, allow_empty: bool = False) -> None:
    value = data.get(key)
    if not isinstance(value, str):
        add_error(path, f"{label} key `{key}` should be a string.")
    elif not allow_empty and not value.strip():
        add_error(path, f"{label} key `{key}` should not be empty.")


def check_iso_timestamp(path: Path, value: object, label: str) -> None:
    if not isinstance(value, str) or not ISOISH_RE.match(value):
        add_error(path, f"{label} should be an ISO-8601 timestamp string.")
        return
    candidate = value[:-1] + "+00:00" if value.endswith("Z") else value
    try:
        datetime.fromisoformat(candidate)
    except ValueError:
        add_error(path, f"{label} is not parseable as ISO-8601: {value!r}.")


def check_sensitivity(path: Path, value: object, label: str) -> None:
    if value not in SENSITIVITY_VALUES:
        add_error(
            path,
            f"{label} should be one of {', '.join(sorted(SENSITIVITY_VALUES))}.",
        )


def check_source_ref(path: Path, source: object, label: str) -> None:
    if not isinstance(source, dict):
        add_error(path, f"{label} key `source` should be an object.")
        return
    require_keys(path, source, {"type", "ref"}, f"{label} source")
    require_string(path, source, "type", f"{label} source")
    require_string(path, source, "ref", f"{label} source")


def check_jsonl(path: Path, label: str, *, row_kind: str = "generic") -> None:
    if not path.exists():
        add_error(path, f"Missing {label}.")
        return
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        add_error(path, f"Could not read {label}: {exc}.")
        return
    for idx, line in enumerate(lines, start=1):
        if not line.strip():
            continue
        try:
            data = json.loads(line)
        except json.JSONDecodeError as exc:
            add_error(path, f"{label} line {idx} is not valid JSON: {exc}.")
            continue
        if not isinstance(data, dict):
            add_error(path, f"{label} line {idx} should be a JSON object.")
            continue
        row_label = f"{label} line {idx}"
        if row_kind == "growth":
            require_keys(path, data, {"schemaVersion", "kind", "id", "createdAt", "title", "body", "status", "source"}, row_label)
            if data.get("schemaVersion") != 1:
                add_error(path, f"{row_label} should use schemaVersion 1.")
            require_string(path, data, "kind", row_label)
            if data.get("kind") not in GROWTH_KIND_VALUES:
                add_error(path, f"{row_label} kind should be one of: {', '.join(sorted(GROWTH_KIND_VALUES))}.")
            require_string(path, data, "id", row_label)
            require_string(path, data, "title", row_label)
            require_string(path, data, "body", row_label)
            check_iso_timestamp(path, data.get("createdAt"), f"{row_label} createdAt")
            if data.get("status") not in {"open", "done", "dropped"}:
                add_error(path, f"{row_label} status should be open, done, or dropped.")
            check_source_ref(path, data.get("source"), row_label)
            source = data.get("source")
            if isinstance(source, dict) and source.get("type") not in GROWTH_SOURCE_TYPE_VALUES:
                add_error(path, f"{row_label} source.type should be one of: {', '.join(sorted(GROWTH_SOURCE_TYPE_VALUES))}.")
        elif row_kind == "area-log":
            require_keys(path, data, {"schemaVersion", "kind", "id", "createdAt", "title", "body", "source", "sensitivity"}, row_label)
            if data.get("schemaVersion") != 1:
                add_error(path, f"{row_label} should use schemaVersion 1.")
            require_string(path, data, "kind", row_label)
            require_string(path, data, "id", row_label)
            require_string(path, data, "title", row_label)
            require_string(path, data, "body", row_label, allow_empty=True)
            check_iso_timestamp(path, data.get("createdAt"), f"{row_label} createdAt")
            check_source_ref(path, data.get("source"), row_label)
            check_sensitivity(path, data.get("sensitivity"), f"{row_label} sensitivity")


def is_heading_line(line: str) -> bool:
    if not line.startswith("#"):
        return False
    hashes = len(line) - len(line.lstrip("#"))
    return 1 <= hashes <= 6 and len(line) > hashes and line[hashes] == " "


def check_sensitivity_annotations(path: Path, body: str) -> None:
    lines = body.replace("\r\n", "\n").split("\n")
    in_fence = False
    previous_was_heading = False
    for idx, raw in enumerate(lines, start=1):
        stripped = raw.strip()
        if stripped.startswith("```"):
            in_fence = not in_fence
            previous_was_heading = False
            continue
        if in_fence:
            previous_was_heading = False
            continue
        if stripped.startswith("<!-- sensitivity:"):
            if not stripped.endswith("-->"):
                add_error(path, f"sensitivity annotation on body line {idx} should be an HTML comment.")
            value = stripped.removeprefix("<!-- sensitivity:").removesuffix("-->").strip()
            check_sensitivity(path, value, f"sensitivity annotation on body line {idx}")
            if not previous_was_heading:
                add_error(path, f"sensitivity annotation on body line {idx} must appear directly under a heading.")
            previous_was_heading = False
            continue
        previous_was_heading = is_heading_line(raw)


def check_heading_rules(path: Path, body: str) -> None:
    seen: set[tuple[int, str]] = set()
    for line_no, level, text in iter_markdown_headings(body):
        if level == 1 and line_no != 1:
            add_error(path, f"H1 heading is only allowed as the first body line; found H1 on body line {line_no}.")
        key = (level, text.casefold())
        if key in seen:
            add_error(path, f"Duplicate heading at depth {level}: {text!r}.")
        seen.add(key)
    check_sensitivity_annotations(path, body)


def check_prose_organ(
    path: Path,
    *,
    label: str,
    expected_kind: str,
    extra_keys: set[str] | None = None,
    budget_chars: int | None = None,
    warn_budget_chars: int | None = None,
    area_id: str | None = None,
) -> dict[str, str] | None:
    if not path.exists():
        add_error(path, f"Missing {label}; prose organs must be markdown+frontmatter.")
        return None
    try:
        doc = read_frontmatter_file(path)
    except FrontmatterError as exc:
        add_error(path, str(exc))
        return None
    allowed = COMMON_FRONTMATTER_KEYS | (extra_keys or set())
    missing = sorted(COMMON_FRONTMATTER_KEYS - set(doc.frontmatter))
    if missing:
        add_error(path, f"{label} frontmatter missing required key(s): {', '.join(missing)}.")
    unknown = sorted(set(doc.frontmatter) - allowed)
    if unknown:
        add_error(path, f"{label} frontmatter has unknown key(s): {', '.join(unknown)}.")
    if doc.frontmatter.get("schemaVersion") != "2":
        add_error(path, f"{label} schemaVersion should be 2.")
    if doc.frontmatter.get("kind") != expected_kind:
        add_error(path, f"{label} kind should be {expected_kind!r}.")
    check_iso_timestamp(path, doc.frontmatter.get("updatedAt"), f"{label} updatedAt")
    check_sensitivity(path, doc.frontmatter.get("sensitivity"), f"{label} sensitivity")
    if extra_keys:
        for key in sorted(extra_keys):
            if key not in doc.frontmatter or not str(doc.frontmatter.get(key, "")).strip():
                add_error(path, f"{label} frontmatter key `{key}` should not be empty.")
    if area_id is not None and doc.frontmatter.get("areaId") != area_id:
        add_error(path, f"{label} areaId should match folder name {area_id!r}.")
    body = doc.body
    if budget_chars is not None and len(body) > budget_chars:
        add_error(path, f"{label} body is {len(body)} chars; limit is {budget_chars}.")
    if warn_budget_chars is not None and len(body) > warn_budget_chars:
        add_warning(path, f"{label} body is {len(body)} chars; warning threshold is {warn_budget_chars}.")
    check_heading_rules(path, body)
    return doc.frontmatter


def check_core_schema_files() -> None:
    for legacy in (
        ROOT / "soul.md",
        ROOT / "memory" / "now.json",
        ROOT / "memory" / "profile.json",
        ROOT / "dobby" / "constitution.json",
        ROOT / "dobby" / "growth.md",
    ):
        if legacy.exists():
            add_error(legacy, "Legacy prose-organ path should not exist after markdown+frontmatter migration.")

    check_prose_organ(
        ROOT / "dobby" / "constitution.md",
        label="Dobby constitution",
        expected_kind="dobby-constitution",
        budget_chars=16000,
    )
    check_prose_organ(
        ROOT / "memory" / "profile.md",
        label="person profile",
        expected_kind="person-profile",
        extra_keys={"personId", "personDisplayName"},
        budget_chars=11500,
    )
    check_prose_organ(
        ROOT / "memory" / "now.md",
        label="current orientation",
        expected_kind="current-orientation",
        budget_chars=6000,
    )
    check_jsonl(ROOT / "dobby" / "growth.jsonl", "Dobby growth log", row_kind="growth")


def check_shelf_json() -> None:
    path = ROOT / "state" / "shelf.json"
    if not path.exists():
        add_error(path, "Shelf state is missing. Personal open loops live in state/shelf.json.")
        return
    data = load_json_object(path, "Shelf state")
    if data is None:
        return
    if "revision" not in data:
        add_error(path, "Shelf state is missing required key: revision.")
    if "items" not in data:
        add_error(path, "Shelf state is missing required key: items.")
    elif not isinstance(data["items"], list):
        add_error(path, "Shelf state key `items` should be a list.")


def check_memory_area_schemas() -> None:
    areas = ROOT / "memory" / "areas"
    if not areas.exists():
        return
    for area_dir in sorted(p for p in areas.iterdir() if p.is_dir()):
        area_id = area_dir.name
        area_json = load_json_object(area_dir / "area.json", f"area metadata for {area_id}")
        if area_json is not None:
            require_keys(area_dir / "area.json", area_json, {"schemaVersion", "kind", "id", "title", "updatedAt", "canonicalFiles", "sensitivity", "dashboard", "assets", "dataDirs"}, f"area metadata for {area_id}")
            if area_json.get("schemaVersion") != 1 or area_json.get("kind") != "memory-area":
                add_error(area_dir / "area.json", f"area metadata for {area_id} should use schemaVersion 1 and kind 'memory-area'.")
            if area_json.get("id") != area_id:
                add_error(area_dir / "area.json", f"area metadata id should match folder name {area_id!r}.")
            check_iso_timestamp(area_dir / "area.json", area_json.get("updatedAt"), f"area metadata for {area_id} updatedAt")
            require_string(area_dir / "area.json", area_json, "title", f"area metadata for {area_id}")
            check_sensitivity(area_dir / "area.json", area_json.get("sensitivity"), f"area metadata for {area_id} sensitivity")
            canonical_files = area_json.get("canonicalFiles")
            if canonical_files != {"canon": "canon.md", "log": "log.jsonl"}:
                add_error(area_dir / "area.json", f"area metadata for {area_id} canonicalFiles should be {{'canon': 'canon.md', 'log': 'log.jsonl'}}.")
            dashboard = area_json.get("dashboard")
            if not isinstance(dashboard, dict):
                add_error(area_dir / "area.json", f"area metadata for {area_id} key `dashboard` should be an object.")
            elif not isinstance(dashboard.get("visible"), bool) or not isinstance(dashboard.get("defaultView"), str):
                add_error(area_dir / "area.json", f"area metadata for {area_id} dashboard should include boolean visible and string defaultView.")
            for list_key in ("assets", "dataDirs"):
                if not isinstance(area_json.get(list_key), list):
                    add_error(area_dir / "area.json", f"area metadata for {area_id} key `{list_key}` should be a list.")
            if isinstance(area_json.get("assets"), list):
                for idx, asset in enumerate(area_json["assets"], start=1):
                    if not isinstance(asset, dict):
                        add_error(area_dir / "area.json", f"area metadata for {area_id} asset {idx} should be an object.")
                        continue
                    require_keys(area_dir / "area.json", asset, {"path", "kind", "title"}, f"area metadata for {area_id} asset {idx}")
                    require_string(area_dir / "area.json", asset, "path", f"area metadata for {area_id} asset {idx}")
                    require_string(area_dir / "area.json", asset, "kind", f"area metadata for {area_id} asset {idx}")
                    require_string(area_dir / "area.json", asset, "title", f"area metadata for {area_id} asset {idx}")
            if isinstance(area_json.get("dataDirs"), list) and not all(isinstance(item, str) for item in area_json["dataDirs"]):
                add_error(area_dir / "area.json", f"area metadata for {area_id} dataDirs should contain only strings.")
        if (area_dir / "canon.json").exists():
            add_error(area_dir / "canon.json", "Legacy canon.json should not exist after canon.md migration.")
        check_prose_organ(
            area_dir / "canon.md",
            label=f"area canon for {area_id}",
            expected_kind="memory-area-canon",
            extra_keys={"areaId"},
            warn_budget_chars=20000,
            area_id=area_id,
        )
        check_jsonl(area_dir / "log.jsonl", f"area log for {area_id}", row_kind="area-log")
        for path in sorted(p for p in area_dir.rglob("*") if p.is_file()):
            if path.name in {".DS_Store", ".gitignore", "canon.md"}:
                continue
            if path.suffix.lower() in {".md", ".txt"}:
                add_error(path, "Loose Markdown/TXT under memory areas is non-canonical. The only canonical Markdown area prose file is canon.md; logs stay JSONL and data dirs should use structured/source files.")


def check_session_summary(path: Path) -> None:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        add_error(path, f"Could not read session summary: {exc}.")
        return
    if text.startswith("\ufeff") or "\r" in text:
        add_error(path, "summary.md must be UTF-8 text with LF line endings and no BOM.")
    lines = text.replace("\r\n", "\n").split("\n")
    first_nonblank = next((i for i, line in enumerate(lines) if line.strip()), None)
    if first_nonblank is None or not lines[first_nonblank].startswith("# "):
        add_error(path, "summary.md must start with '# <title>'.")
        return
    title = lines[first_nonblank][2:].strip()
    if not (1 <= len(title) <= 120):
        add_error(path, "summary.md title must be 1–120 chars.")
    heading_idx = -1
    in_fence = False
    for idx, raw in enumerate(lines):
        if raw.strip().startswith("```"):
            in_fence = not in_fence
            continue
        if not in_fence and raw.strip() == WORKSPACE_CHANGES_HEADING:
            heading_idx = idx
    if heading_idx < 0:
        add_error(path, f"summary.md must end with a '{WORKSPACE_CHANGES_HEADING}' section.")


def check_session_meta(path: Path) -> None:
    data = load_json_object(path, "session meta")
    if data is None:
        return
    required = {"schemaVersion", "createdAt", "threadId", "runtime", "trigger", "cwd", "tldr"}
    require_keys(path, data, required, "session meta")
    extra = sorted(set(data) - required)
    if extra:
        add_error(path, f"session meta has unsupported key(s): {', '.join(extra)}.")
    if data.get("schemaVersion") != 4:
        add_error(path, "session meta should use schemaVersion 4.")
    check_iso_timestamp(path, data.get("createdAt"), "session meta createdAt")
    if data.get("threadId") is not None and not isinstance(data.get("threadId"), str):
        add_error(path, "session meta threadId should be a string or null.")
    if data.get("runtime") not in {"codex", "claude"}:
        add_error(path, "session meta runtime should be codex or claude.")
    require_string(path, data, "trigger", "session meta")
    if data.get("cwd") is not None and not isinstance(data.get("cwd"), str):
        add_error(path, "session meta cwd should be a string or null.")
    tldr = data.get("tldr")
    if not isinstance(tldr, str) or not tldr.strip():
        add_error(path, "session meta tldr should be a non-empty string.")
    elif "\n" in tldr or len(tldr) > SESSION_TLDR_MAX:
        add_error(path, f"session meta tldr should be a single line at most {SESSION_TLDR_MAX} chars.")


def check_session_memory_files() -> None:
    sessions = ROOT / "memory" / "sessions"
    if not sessions.exists():
        return
    session_file_re = re.compile(
        r"^memory/sessions/\d{4}/\d{2}/\d{2}-\d{6}(?:-\d+)?/"
        r"(meta\.json|summary\.md|dialogue\.md|raw\.jsonl)$"
    )
    for year_dir in sorted(p for p in sessions.iterdir() if p.is_dir()):
        if not re.fullmatch(r"\d{4}", year_dir.name):
            add_error(year_dir, "memory/sessions/ children should be YYYY folders.")
            continue
        for month_dir in sorted(p for p in year_dir.iterdir() if p.is_dir()):
            if not re.fullmatch(r"\d{2}", month_dir.name):
                add_error(month_dir, "memory/sessions/YYYY/ children should be MM folders.")
                continue
            for folder in sorted(p for p in month_dir.iterdir() if p.is_dir()):
                if not SESSION_FOLDER_RE.fullmatch(folder.name):
                    add_error(folder, "Session folders should be DD-HHMMSS or DD-HHMMSS-N.")
                for required in ("meta.json", "summary.md"):
                    if not (folder / required).is_file():
                        add_error(folder / required, f"Session folder {folder.name} is missing {required}; meta.json + summary.md are required.")
                if (folder / "meta.json").is_file():
                    check_session_meta(folder / "meta.json")
                if (folder / "summary.md").is_file():
                    check_session_summary(folder / "summary.md")
    for path in sorted(p for p in sessions.rglob("*") if p.is_file()):
        if path.name in {".gitkeep", ".DS_Store"}:
            continue
        rel = str(path.relative_to(ROOT))
        if not session_file_re.match(rel):
            add_error(
                path,
                "Session continuity lives in session folders: memory/sessions/YYYY/MM/DD-HHMMSS[-N]/ holding meta.json, summary.md, dialogue.md, and raw.jsonl only.",
            )


def check_journal_daily_files() -> None:
    daily = ROOT / "journal" / "daily"
    if not daily.exists():
        return
    date_dir_re = re.compile(r"^\d{4}-\d{2}-\d{2}$")
    allowed_json = {"morning.json", "night.json", "general.json"}
    for path in sorted(p for p in daily.rglob("*") if p.is_file()):
        if path.name in {".gitkeep", ".DS_Store"}:
            continue
        try:
            relative_parts = path.relative_to(daily).parts
            date_dir = relative_parts[0]
        except IndexError:
            add_error(path, "journal/daily/ should contain dated folders, not loose files.")
            continue
        if len(relative_parts) != 2:
            add_error(path, "journal/daily/ files must be exactly journal/daily/YYYY-MM-DD/<file>.")
        if not date_dir_re.match(date_dir):
            add_error(path, "journal/daily/ files must live under YYYY-MM-DD date folders.")
        if path.suffix != ".json":
            add_error(path, "Daily journal storage is JSON-only. Convert legacy Markdown/raw captures into journal/daily/YYYY-MM-DD/general.json entries.")
            continue
        if path.name not in allowed_json:
            add_error(path, "Daily journal JSON files must be one of morning.json, night.json, or general.json. Put flexible captures in general.json entries[].")


def check_journal_non_daily_files() -> None:
    for base_name, expected_kind in (("monthly", "journal-monthly"), ("templates", "journal-template")):
        base = ROOT / "journal" / base_name
        if not base.exists():
            continue
        for path in sorted(p for p in base.rglob("*") if p.is_file()):
            if path.name in {".gitkeep", ".DS_Store"}:
                continue
            if path.suffix != ".json":
                add_error(path, f"journal/{base_name}/ canonical files should be JSON, not legacy Markdown or loose text.")
                continue
            data = load_json_object(path, f"journal {base_name} document")
            if data is None:
                continue
            require_keys(path, data, {"schemaVersion", "kind", "updatedAt", "title", "body"}, f"journal {base_name} document")
            if data.get("schemaVersion") != 1 or data.get("kind") != expected_kind:
                add_error(path, f"journal/{base_name}/ JSON should use schemaVersion 1 and kind {expected_kind!r}.")


def tracked_files() -> list[str]:
    try:
        result = subprocess.run(
            ["git", "-C", str(ROOT), "ls-files"],
            check=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return []
    return [line for line in result.stdout.splitlines() if line]


def check_tracked_generated_artifacts() -> None:
    for rel in tracked_files():
        if rel.startswith("memory/areas/builder/career/cv/latex/") and rel.endswith(".pdf"):
            add_error(ROOT / rel, "Generated CV PDFs should not be tracked. Keep LaTeX sources and regenerate PDFs when needed.")


def main() -> int:
    check_required_top_level()
    check_top_level_shape()
    check_second_level_shape()
    check_projects()
    check_shelf_json()
    check_core_schema_files()
    check_memory_area_schemas()
    check_session_memory_files()
    check_journal_daily_files()
    check_journal_non_daily_files()
    check_tracked_generated_artifacts()

    if warnings:
        print("[lint-workspace] warnings:", file=sys.stderr)
        for finding in warnings:
            print("", file=sys.stderr)
            print(finding.render(), file=sys.stderr)

    if errors:
        print("[lint-workspace] Dobby workspace shape check failed.", file=sys.stderr)
        for finding in errors:
            print("", file=sys.stderr)
            print(finding.render(), file=sys.stderr)
        return 1

    print("[lint-workspace] passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
