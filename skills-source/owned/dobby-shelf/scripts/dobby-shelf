#!/usr/bin/env python3
"""Dobby Shelf CLI entrypoint."""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from lib import shelf  # noqa: E402
from lib.contract import DobbyArgumentParser, emit_json, err_envelope  # noqa: E402
from lib.workspace import WorkspaceError  # noqa: E402


def build_parser() -> argparse.ArgumentParser:
    parser = DobbyArgumentParser(prog="dobby-shelf", description="Dobby Shelf personal open-loop operations")
    parser.add_argument("--version", action="version", version="dobby-shelf 0.1.0")
    shelf.add_subparsers(parser)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    if not hasattr(args, "handler"):
        parser.print_help()
        return 2
    try:
        return args.handler(args)
    except WorkspaceError as e:
        return emit_json(err_envelope("shelf.workspace", "E_VALIDATION", str(e)))
    except shelf.ShelfError as e:
        return emit_json(err_envelope(e.command, e.code, str(e), hint=e.hint))
    except shelf.ShelfValidationError as e:
        return emit_json(err_envelope("shelf.validation", "E_VALIDATION", str(e)))
    except shelf.ShelfStoreError as e:
        return emit_json(err_envelope("shelf.store", "E_IO", str(e)))
    except KeyError as e:
        return emit_json(err_envelope("shelf.item", "E_NOT_FOUND", f"Shelf item not found: {e.args[0]}"))


if __name__ == "__main__":
    sys.exit(main())
