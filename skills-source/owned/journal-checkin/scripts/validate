#!/usr/bin/env python3
"""Validate structured Dobby journal entries.

Public skill validator facade used by workspace checks. The journal-checkin
skill owns daily journal JSON contracts: morning, night, and general.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from pathlib import Path
from datetime import datetime
from typing import Any

SCRIPT_DIR = Path(__file__).resolve().parent
if str(SCRIPT_DIR) not in sys.path:
    sys.path.insert(0, str(SCRIPT_DIR))

from write_journal_entry import STATE_FIELDS, missing_fields, validate_entry as validate_payload_fields  # noqa: E402

DAILY_FILE_RE = re.compile(r"^journal/daily/(\d{4}-\d{2}-\d{2})/([^/]+)$")
DAILY_JSON_RE = re.compile(r"^journal/daily/(\d{4}-\d{2}-\d{2})/([^/]+)\.json$")
JOURNAL_RE = re.compile(r"^journal/daily/(\d{4}-\d{2}-\d{2})/(morning|night|general)\.json$")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Validate structured Dobby journal JSON entries.")
    parser.add_argument("paths", nargs="*", help="Repo-relative journal paths to validate.")
    parser.add_argument("--workspace-root", default=".", help="Dobby workspace root.")
    parser.add_argument("--scope", choices=("paths", "staged", "full"), default="paths")
    parser.add_argument("--paths-from-stdin", action="store_true", help="Read repo-relative paths from stdin.")
    parser.add_argument("--no-input", action="store_true", help="Accepted for non-interactive callers.")
    return parser.parse_args()


def fail(message: str) -> None:
    print(f"[validate-journal] {message}", file=sys.stderr)
    raise SystemExit(1)


def is_record(value: Any) -> bool:
    return isinstance(value, dict)


def rel_path(root: Path, path: Path) -> str:
    try:
        return str(path.resolve().relative_to(root))
    except ValueError:
        return str(path)


def require_non_empty_str(value: Any, label: str, field: str) -> None:
    if not isinstance(value, str) or not value.strip():
        fail(f"{label}: {field} must be a non-empty string")


def require_iso_timestamp(value: Any, label: str, field: str) -> None:
    require_non_empty_str(value, label, field)
    try:
        datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        fail(f"{label}: {field} must be an ISO-8601 timestamp")


def validate_common_metadata(entry: dict[str, Any], label: str, path_date: str, path_kind: str) -> None:
    for field in ("agent", "date", "kind", "tz", "captured_at", "source"):
        require_non_empty_str(entry.get(field), label, field)

    if entry["date"] != path_date:
        fail(f"{label}: date must match path date {path_date}")
    if entry["kind"] != path_kind:
        fail(f"{label}: kind must match file name {path_kind}")
    require_iso_timestamp(entry.get("captured_at"), label, "captured_at")


def validate_morning_or_night_file(root: Path, path: Path, path_date: str, path_kind: str) -> None:
    label = rel_path(root, path)
    if not path.exists():
        fail(f"{label}: file is missing")

    try:
        entry = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        fail(f"{label}: invalid JSON: {exc}")
    if not is_record(entry):
        fail(f"{label}: entry must be an object")

    validate_common_metadata(entry, label, path_date, path_kind)

    validation_errors = validate_payload_fields(path_kind, entry)
    if validation_errors:
        fail(f"{label}: {'; '.join(validation_errors)}")

    missing = missing_fields(path_kind, entry)
    if missing:
        fail(f"{label}: missing required field(s): {', '.join(missing)}")

    for field in STATE_FIELDS:
        state = entry.get(field)
        if isinstance(state, dict) and "notes" in state and state["notes"] is not None and not state["notes"].strip():
            fail(f"{label}: {field}.notes must be a non-empty string when present")


def validate_general_file(root: Path, path: Path, path_date: str) -> None:
    label = rel_path(root, path)
    if not path.exists():
        fail(f"{label}: file is missing")

    try:
        record = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        fail(f"{label}: invalid JSON: {exc}")
    if not is_record(record):
        fail(f"{label}: entry must be an object")

    validate_common_metadata(record, label, path_date, "general")

    schema_version = record.get("schema_version")
    if not isinstance(schema_version, int) or schema_version < 1:
        fail(f"{label}: schema_version must be a positive integer")

    updated_at = record.get("updated_at")
    if updated_at is not None:
        require_iso_timestamp(updated_at, label, "updated_at")

    entries = record.get("entries")
    if not isinstance(entries, list) or not entries:
        fail(f"{label}: entries must be a non-empty list")

    seen_ids: set[str] = set()
    for idx, entry in enumerate(entries):
        entry_label = f"{label}:entries[{idx}]"
        if not is_record(entry):
            fail(f"{entry_label}: entry must be an object")
        for field in ("id", "title", "summary", "body", "body_format", "source", "captured_at"):
            require_non_empty_str(entry.get(field), entry_label, field)
        if entry["id"] in seen_ids:
            fail(f"{entry_label}: duplicate id {entry['id']}")
        seen_ids.add(entry["id"])
        validation_errors = validate_payload_fields("general", entry)
        if validation_errors:
            fail(f"{entry_label}: {'; '.join(validation_errors)}")
        require_iso_timestamp(entry.get("captured_at"), entry_label, "captured_at")
        tags = entry.get("tags")
        if tags is None:
            fail(f"{entry_label}: tags must be a list, even when empty")
        if not isinstance(tags, list) or any(not isinstance(tag, str) or not tag.strip() for tag in tags):
            fail(f"{entry_label}: tags must be a list of non-empty strings")
        raw_input = entry.get("raw_input")
        if raw_input is not None and not isinstance(raw_input, str):
            fail(f"{entry_label}: raw_input must be a string or null")
        migrated_from = entry.get("migrated_from")
        if migrated_from is not None and (not isinstance(migrated_from, str) or not migrated_from.strip()):
            fail(f"{entry_label}: migrated_from must be a non-empty string when present")


def validate_journal_file(root: Path, path: Path) -> None:
    label = rel_path(root, path)
    if not path.exists():
        return
    daily_file_match = DAILY_FILE_RE.match(label)
    if not daily_file_match:
        return
    if not label.endswith(".json"):
        fail(f"{label}: daily journal files must be JSON; put flexible captures in general.json entries[]")
    daily_match = DAILY_JSON_RE.match(label)
    if not daily_match:
        return
    path_date, stem = daily_match.groups()
    match = JOURNAL_RE.match(label)
    if not match:
        fail(f"{label}: daily journal JSON must be morning.json, night.json, or general.json")
    _, path_kind = match.groups()
    if path_kind == "general":
        validate_general_file(root, path, path_date)
    else:
        validate_morning_or_night_file(root, path, path_date, path_kind)


def git_paths(root: Path, scope: str) -> list[str]:
    if scope == "staged":
        cmd = ["git", "diff", "--cached", "--name-only", "--diff-filter=ACMR"]
    elif scope == "full":
        cmd = ["git", "ls-files"]
    else:
        return []
    result = subprocess.run(cmd, cwd=root, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=30)
    if result.returncode != 0:
        return []
    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def full_journal_paths(root: Path) -> list[str]:
    daily = root / "journal" / "daily"
    if not daily.exists():
        return []
    out = []
    for path in sorted(p for p in daily.glob("*/*") if p.is_file()):
        out.append(str(path.relative_to(root)))
    return out


def candidate_paths(root: Path, args: argparse.Namespace) -> list[Path]:
    raw = list(args.paths)
    if args.paths_from_stdin:
        raw.extend(line.strip() for line in sys.stdin if line.strip())
    if not raw and args.scope == "staged":
        raw = git_paths(root, args.scope)
    elif not raw and args.scope == "full":
        raw = full_journal_paths(root)
    return [Path(item) if Path(item).is_absolute() else root / item for item in raw]


def main() -> int:
    args = parse_args()
    root = Path(args.workspace_root).expanduser().resolve()
    paths = [path for path in candidate_paths(root, args) if DAILY_FILE_RE.match(rel_path(root, path))]
    for path in paths:
        validate_journal_file(root, path)
    print(f"[validate-journal] passed ({len(paths)} files)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
