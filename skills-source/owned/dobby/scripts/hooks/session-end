#!/usr/bin/env python3
"""Dobby session-end hook.

Session end should stay fast. This hook captures a compact handoff record with
the session/transcript pointer under `<repo>/tmp/hooks/session-end/`, launches
the background `write-session-note` worker, then exits successfully. The worker owns
slow transcript rendering, note generation, and writing the prose note under
`memory/sessions/YYYY/MM/DD-HHMMSS.md`.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

HOOK_EVENT = "SessionEnd"
SCHEMA_VERSION = "1.0"
SESSION_END_DIR = Path("tmp/hooks/session-end")
SESSION_MEMORY_DIR = Path("tmp/hooks/session-memory")


def utc_now_iso_z() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def utc_now_file_stamp() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H-%M-%SZ")


def read_payload() -> dict[str, Any]:
    raw = sys.stdin.read()
    if not raw.strip():
        return {}
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    return payload if isinstance(payload, dict) else {}


def repo_root(payload: dict[str, Any]) -> Path:
    return Path(
        payload.get("repo_root")
        or os.environ.get("AGENT_REPO_ROOT")
        or "."
    ).expanduser().resolve()


def text_field(payload: dict[str, Any], key: str) -> str | None:
    value = payload.get(key)
    if isinstance(value, str) and value.strip():
        return value.strip()
    return None


def transcript_format(payload: dict[str, Any], transcript_path: str | None) -> str | None:
    explicit = text_field(payload, "transcript_format")
    if explicit or not transcript_path:
        return explicit
    runtime = text_field(payload, "runtime") or os.environ.get("AGENT_HOOK_RUNTIME")
    if runtime == "copilot":
        return "copilot-gateway-jsonl"
    if runtime == "claude":
        return "claude-jsonl"
    return "unknown"


def compact_record(payload: dict[str, Any]) -> dict[str, Any]:
    transcript_path = text_field(payload, "transcript_path")
    transcript_exists = False
    transcript_bytes: int | None = None
    if transcript_path:
        try:
            transcript = Path(transcript_path).expanduser()
            stat = transcript.stat()
            transcript_exists = transcript.is_file()
            transcript_bytes = stat.st_size if transcript_exists else None
        except OSError:
            transcript_exists = False
            transcript_bytes = None

    return {
        "schema_version": SCHEMA_VERSION,
        "recorded_at": utc_now_iso_z(),
        "hook_event_name": HOOK_EVENT,
        "runtime": text_field(payload, "runtime")
        or os.environ.get("AGENT_HOOK_RUNTIME"),
        "session_id": text_field(payload, "session_id"),
        "reason": text_field(payload, "reason"),
        "cwd": text_field(payload, "cwd"),
        "transcript_path": transcript_path,
        "transcript_format": transcript_format(payload, transcript_path),
        "transcript_exists": transcript_exists,
        "transcript_bytes": transcript_bytes,
    }


def safe_file_stem(value: str | None) -> str:
    if not value:
        return f"unknown-{utc_now_file_stamp()}"
    cleaned = re.sub(r"[^A-Za-z0-9._-]+", "-", value.strip()).strip(".-")
    return cleaned or f"unknown-{utc_now_file_stamp()}"


def write_session_end_record(root: Path, record: dict[str, Any]) -> None:
    session_id = record.get("session_id")
    stem = safe_file_stem(session_id if isinstance(session_id, str) else None)
    path = root / SESSION_END_DIR / f"{stem}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = path.with_suffix(path.suffix + ".tmp")
    tmp_path.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")
    tmp_path.replace(path)


def write_session_memory_job(root: Path, payload: dict[str, Any]) -> Path:
    session_id = text_field(payload, "session_id")
    stem = safe_file_stem(session_id)
    path = root / SESSION_MEMORY_DIR / f"{stem}-{utc_now_file_stamp()}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = path.with_suffix(path.suffix + ".tmp")
    tmp_path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    tmp_path.replace(path)
    return path


def launch_session_memory_worker(root: Path, payload: dict[str, Any]) -> None:
    job_path = write_session_memory_job(root, payload)
    worker = Path(__file__).resolve().parent / "write-session-note"
    if not worker.is_file():
        print(f"session-end: missing session memory worker: {worker}", file=sys.stderr)
        return

    log_path = root / SESSION_MEMORY_DIR / "worker.log"
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with log_path.open("a", encoding="utf-8") as stderr_log:
        subprocess.Popen(
            [
                sys.executable,
                str(worker),
                "--job",
                str(job_path),
                "--repo-root",
                str(root),
            ],
            cwd=str(root),
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=stderr_log,
            start_new_session=True,
            close_fds=True,
        )


def main() -> int:
    payload = read_payload()
    event_name = payload.get("hook_event_name") or os.environ.get("AGENT_HOOK_EVENT")
    if event_name not in {None, HOOK_EVENT}:
        return 0
    if payload.get("schema_version") not in {None, SCHEMA_VERSION}:
        return 0

    root = repo_root(payload)
    os.chdir(root)
    write_session_end_record(root, compact_record(payload))
    launch_session_memory_worker(root, payload)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"session-end: {exc}", file=sys.stderr)
        raise SystemExit(0)
