#!/usr/bin/env python3
"""Dobby prompt-submit hook.

Emits only lightweight per-turn context (current local time). Session memory,
tasks, and calendar belong to the session-start hook and should not be
reloaded before every prompt.
"""

from __future__ import annotations

import json
import os
import sys
from datetime import datetime
from zoneinfo import ZoneInfo

HOOK_EVENT = "UserPromptSubmit"
LOCAL_TIMEZONE = "Europe/Berlin"


def read_payload() -> dict:
    raw = sys.stdin.read()
    if not raw.strip():
        return {}
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    return payload if isinstance(payload, dict) else {}


def main() -> int:
    payload = read_payload()
    event_name = payload.get("hook_event_name") or os.environ.get("AGENT_HOOK_EVENT")
    if event_name not in {None, HOOK_EVENT}:
        return 0

    now = datetime.now(ZoneInfo(LOCAL_TIMEZONE))
    print(f"Current local time: {now:%A, %Y-%m-%d %H:%M %Z}.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
