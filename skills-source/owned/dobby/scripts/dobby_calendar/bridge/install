#!/usr/bin/env bash
set -euo pipefail

INSTALL_ROOT="${HOME}/Applications"
APP_NAME="Dobby Calendar Bridge.app"
REQUEST_ACCESS=0
CHECK_ONLY=0
FORCE=0
SOCKET_PATH="${DOBBY_CALENDAR_BRIDGE_SOCKET:-${HOME}/Library/Application Support/DobbyCalendarBridge/bridge.sock}"
LAUNCH_LABEL="com.${USER}.dobby-calendar-bridge"
CODESIGN_IDENTITY="${DOBBY_CALENDAR_CODESIGN_IDENTITY:-}"
ALLOW_ADHOC_SIGNING="${DOBBY_CALENDAR_ALLOW_ADHOC_SIGNING:-0}"
BOOTSTRAP_LOCAL_CODESIGN="${DOBBY_CALENDAR_BOOTSTRAP_LOCAL_CODESIGN:-1}"
LOCAL_CODESIGN_NAME="${DOBBY_CALENDAR_LOCAL_CODESIGN_NAME:-Dobby Local Code Signing}"
LOCAL_CODESIGN_KEYCHAIN="${DOBBY_CALENDAR_CODESIGN_KEYCHAIN:-${HOME}/Library/Keychains/dobby-local-codesign.keychain-db}"
LOCAL_CODESIGN_SECRET_ENV="${DOBBY_CALENDAR_CODESIGN_SECRET_ENV:-${HOME}/.secrets/dobby-codesign/env}"
CODESIGN_KEYCHAIN_ARGS=()

usage() {
  cat <<USAGE
Usage: $(basename "$0") [options]

Build/install the native Dobby Calendar Bridge helper app.

The bridge is a per-user LaunchAgent/socket EventKit helper with a stable macOS
bundle identity (io.adithyan.dobby.calendar-bridge). Dobby's calendar CLI can
call it from Codex.app, Claude, Terminal, or other local agents without
inheriting the caller app's Calendar permission state.

Options:
  --install-root <path>     App install root (default: ~/Applications)
  --request-access          Run a permission request after install/check
  --check                   Only check existing install and Calendar access
  --force                   Rebuild/reinstall even if app already exists
  --codesign-identity <id>   Stable signing identity to use (or set
                             DOBBY_CALENDAR_CODESIGN_IDENTITY)
  --no-bootstrap-codesign-identity
                             Do not create the local Dobby signing keychain if
                             no stable identity exists
  --allow-adhoc-signing      Fall back to ad-hoc signing if no stable identity
                             exists (may reset macOS Calendar permission)
  -h, --help                Show this help

Examples:
  ~/.agents/skills-source/owned/dobby/scripts/dobby_calendar/bridge/install --request-access
  ~/.agents/skills-source/owned/dobby/scripts/dobby_calendar/bridge/install --check
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --install-root)
      INSTALL_ROOT="${2:-}"
      shift 2
      ;;
    --request-access)
      REQUEST_ACCESS=1
      shift
      ;;
    --check)
      CHECK_ONLY=1
      shift
      ;;
    --force)
      FORCE=1
      shift
      ;;
    --codesign-identity)
      CODESIGN_IDENTITY="${2:-}"
      shift 2
      ;;
    --no-bootstrap-codesign-identity)
      BOOTSTRAP_LOCAL_CODESIGN=0
      shift
      ;;
    --allow-adhoc-signing)
      ALLOW_ADHOC_SIGNING=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOURCE_FILE="$SCRIPT_DIR/main.swift"
INFO_PLIST="$SCRIPT_DIR/Info.plist"
APP_DIR="$INSTALL_ROOT/$APP_NAME"
CONTENTS_DIR="$APP_DIR/Contents"
MACOS_DIR="$CONTENTS_DIR/MacOS"
BIN_PATH="$MACOS_DIR/DobbyCalendarBridge"
CACHE_DIR="${HOME}/Library/Caches/dobby-calendar-bridge"
BUILD_BIN="$CACHE_DIR/DobbyCalendarBridge"
PLIST_PATH="${HOME}/Library/LaunchAgents/${LAUNCH_LABEL}.plist"
LOG_PATH="${HOME}/Library/Logs/dobby-calendar-bridge.log"
ERR_PATH="${HOME}/Library/Logs/dobby-calendar-bridge.err.log"
DOMAIN="gui/$(id -u)"

if [[ ! -f "$SOURCE_FILE" || ! -f "$INFO_PLIST" ]]; then
  echo "Calendar bridge sources not found under $SCRIPT_DIR" >&2
  exit 1
fi

if ! command -v swiftc >/dev/null 2>&1; then
  echo "swiftc not found. Install Xcode Command Line Tools or Xcode." >&2
  exit 4
fi

check_installed() {
  if [[ ! -x "$BIN_PATH" ]]; then
    echo "missing: $BIN_PATH" >&2
    return 1
  fi
  local output ok
  set +e
  output="$("$BIN_PATH" send doctor --no-input --socket "$SOCKET_PATH")"
  local rc=$?
  set -e
  printf '%s\n' "$output"
  if (( rc != 0 )); then
    return "$rc"
  fi
  ok="$(printf '%s\n' "$output" | /usr/bin/python3 -c 'import json,sys; print(str(bool(json.load(sys.stdin).get("data",{}).get("ok"))).lower())' 2>/dev/null || printf 'false')"
  [[ "$ok" == "true" ]]
}

find_codesign_identity() {
  if [[ -n "$CODESIGN_IDENTITY" ]]; then
    printf '%s\n' "$CODESIGN_IDENTITY"
    return 0
  fi
  if ! command -v security >/dev/null 2>&1; then
    return 1
  fi

  # Prefer the purpose-specific local identity. It lives in a Dobby-owned
  # keychain so agents can sign helper rebuilds without triggering private-key
  # prompts from Adi's Apple Development keychain item.
  local identity
  identity="$(find_local_codesign_identity || true)"
  if [[ -n "$identity" ]]; then
    CODESIGN_KEYCHAIN_ARGS=(--keychain "$LOCAL_CODESIGN_KEYCHAIN")
    printf '%s\n' "$identity"
    return 0
  fi

  if [[ "$BOOTSTRAP_LOCAL_CODESIGN" == "1" ]]; then
    identity="$(bootstrap_local_codesign_identity || true)"
    if [[ -n "$identity" ]]; then
      CODESIGN_KEYCHAIN_ARGS=(--keychain "$LOCAL_CODESIGN_KEYCHAIN")
      printf '%s\n' "$identity"
      return 0
    fi
  fi

  # Last stable fallback: a normal Apple Development identity. This may require
  # an interactive private-key prompt depending on the user's Keychain ACL, so
  # the local Dobby identity above should be used for autonomous agent work.
  local identities
  identities="$(security find-identity -v -p codesigning 2>/dev/null || true)"
  identity="$(printf '%s\n' "$identities" | awk -F'"' '/"Apple Development: Adithyan Ilangovan / { print $2; exit }')"
  if [[ -n "$identity" ]]; then
    printf '%s\n' "$identity"
    return 0
  fi
  identity="$(printf '%s\n' "$identities" | awk -F'"' '/"Apple Development: / { print $2; exit }')"
  if [[ -n "$identity" ]]; then
    printf '%s\n' "$identity"
    return 0
  fi
  return 1
}

find_local_codesign_identity() {
  [[ -f "$LOCAL_CODESIGN_KEYCHAIN" ]] || return 1
  unlock_local_codesign_keychain
  ensure_keychain_in_search_list "$LOCAL_CODESIGN_KEYCHAIN"
  local identity
  identity="$(
    security find-identity -v -p codesigning "$LOCAL_CODESIGN_KEYCHAIN" 2>/dev/null |
      awk -v name="\"$LOCAL_CODESIGN_NAME\"" '$0 ~ name { print $2; exit }'
  )"
  if [[ -n "$identity" ]]; then
    printf '%s\n' "$identity"
    return 0
  fi
  return 1
}

load_or_create_local_codesign_password() {
  mkdir -p "$(dirname "$LOCAL_CODESIGN_SECRET_ENV")"
  chmod 700 "$(dirname "$LOCAL_CODESIGN_SECRET_ENV")"

  if [[ -f "$LOCAL_CODESIGN_SECRET_ENV" ]]; then
    # shellcheck disable=SC1090
    source "$LOCAL_CODESIGN_SECRET_ENV"
  fi

  if [[ -z "${DOBBY_CODESIGN_KEYCHAIN_PASSWORD:-}" ]]; then
    if ! command -v openssl >/dev/null 2>&1; then
      echo "openssl not found; cannot create local Dobby code-signing identity." >&2
      return 1
    fi
    DOBBY_CODESIGN_KEYCHAIN_PASSWORD="$(openssl rand -base64 48 | tr -d '\n')"
    umask 077
    printf 'DOBBY_CODESIGN_KEYCHAIN_PASSWORD=%q\n' "$DOBBY_CODESIGN_KEYCHAIN_PASSWORD" >"$LOCAL_CODESIGN_SECRET_ENV"
    chmod 600 "$LOCAL_CODESIGN_SECRET_ENV"
  fi
}

unlock_local_codesign_keychain() {
  load_or_create_local_codesign_password
  security unlock-keychain -p "$DOBBY_CODESIGN_KEYCHAIN_PASSWORD" "$LOCAL_CODESIGN_KEYCHAIN" >/dev/null 2>&1 || true
  security set-keychain-settings -lut 21600 "$LOCAL_CODESIGN_KEYCHAIN" >/dev/null 2>&1 || true
}

ensure_keychain_in_search_list() {
  local keychain_path="$1"
  local existing=()
  local found=0
  local line
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%\"}"
    line="${line#\"}"
    [[ -z "$line" ]] && continue
    existing+=("$line")
    if [[ "$line" == "$keychain_path" ]]; then
      found=1
    fi
  done < <(security list-keychains -d user 2>/dev/null || true)
  if [[ "$found" != "1" ]]; then
    security list-keychains -d user -s "$keychain_path" "${existing[@]}" >/dev/null
  fi
}

bootstrap_local_codesign_identity() {
  if ! command -v openssl >/dev/null 2>&1; then
    echo "openssl not found; cannot create local Dobby code-signing identity." >&2
    return 1
  fi

  load_or_create_local_codesign_password
  mkdir -p "$(dirname "$LOCAL_CODESIGN_KEYCHAIN")"
  if [[ ! -f "$LOCAL_CODESIGN_KEYCHAIN" ]]; then
    echo "+ security create-keychain $LOCAL_CODESIGN_KEYCHAIN" >&2
    security create-keychain -p "$DOBBY_CODESIGN_KEYCHAIN_PASSWORD" "$LOCAL_CODESIGN_KEYCHAIN" >/dev/null
  fi
  unlock_local_codesign_keychain
  ensure_keychain_in_search_list "$LOCAL_CODESIGN_KEYCHAIN"

  local existing
  existing="$(find_local_codesign_identity || true)"
  if [[ -n "$existing" ]]; then
    printf '%s\n' "$existing"
    return 0
  fi

  echo "+ create local code-signing identity: $LOCAL_CODESIGN_NAME" >&2
  local tmp_dir p12_pass
  tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/dobby-codesign.XXXXXX")"
  p12_pass="$(openssl rand -base64 32 | tr -d '\n')"
  cat >"$tmp_dir/openssl.cnf" <<EOF
[req]
distinguished_name = dn
x509_extensions = v3_req
prompt = no

[dn]
CN = $LOCAL_CODESIGN_NAME
O = Dobby Local

[v3_req]
basicConstraints = critical, CA:false
keyUsage = critical, digitalSignature
extendedKeyUsage = critical, codeSigning
subjectKeyIdentifier = hash
EOF

  openssl req -x509 -newkey rsa:2048 -sha256 -days 3650 -nodes \
    -keyout "$tmp_dir/key.pem" \
    -out "$tmp_dir/cert.pem" \
    -config "$tmp_dir/openssl.cnf" \
    -extensions v3_req >/dev/null 2>&1
  openssl pkcs12 -export \
    -inkey "$tmp_dir/key.pem" \
    -in "$tmp_dir/cert.pem" \
    -name "$LOCAL_CODESIGN_NAME" \
    -out "$tmp_dir/identity.p12" \
    -passout "pass:$p12_pass" >/dev/null 2>&1
  security import "$tmp_dir/identity.p12" \
    -k "$LOCAL_CODESIGN_KEYCHAIN" \
    -P "$p12_pass" \
    -T /usr/bin/codesign \
    -T /usr/bin/security >/dev/null
  security set-key-partition-list \
    -S apple-tool:,apple:,codesign: \
    -s \
    -k "$DOBBY_CODESIGN_KEYCHAIN_PASSWORD" \
    "$LOCAL_CODESIGN_KEYCHAIN" >/dev/null 2>&1 || true
  security add-trusted-cert \
    -r trustAsRoot \
    -p codeSign \
    -k "$LOCAL_CODESIGN_KEYCHAIN" \
    "$tmp_dir/cert.pem" >/dev/null 2>&1 || true
  rm -rf "$tmp_dir"

  find_local_codesign_identity
}

sign_app() {
  if ! command -v codesign >/dev/null 2>&1; then
    echo "codesign not found; cannot install a stable Calendar permission identity." >&2
    exit 4
  fi

  local identity
  identity="$(find_codesign_identity || true)"
  if [[ -n "$identity" ]]; then
    echo "+ codesign --force --deep ${CODESIGN_KEYCHAIN_ARGS[*]} --sign \"$identity\" $APP_DIR" >&2
    codesign --force --deep "${CODESIGN_KEYCHAIN_ARGS[@]}" --sign "$identity" "$APP_DIR" >/dev/null
    return 0
  fi

  if [[ "$ALLOW_ADHOC_SIGNING" == "1" ]]; then
    echo "WARNING: using ad-hoc signing. Rebuilds may reset macOS Calendar permission." >&2
    echo "+ codesign --force --deep --sign - $APP_DIR" >&2
    codesign --force --deep --sign - "$APP_DIR" >/dev/null
    return 0
  fi

  cat >&2 <<'ERR'
No stable code-signing identity found.

Install or configure one, then rerun. Options:
  - allow the installer to create the Dobby local signing keychain
  - set DOBBY_CALENDAR_CODESIGN_IDENTITY to an existing code-signing identity
  - pass --codesign-identity "<identity>"
  - as a last resort, pass --allow-adhoc-signing (permission may reset)
ERR
  exit 4
}

request_access() {
  echo "+ $BIN_PATH send doctor --request-access --socket $SOCKET_PATH" >&2
  local output ok
  set +e
  output="$("$BIN_PATH" send doctor --request-access --socket "$SOCKET_PATH")"
  local rc=$?
  set -e
  printf '%s\n' "$output"
  if (( rc != 0 )); then
    return "$rc"
  fi
  ok="$(printf '%s\n' "$output" | /usr/bin/python3 -c 'import json,sys; print(str(bool(json.load(sys.stdin).get("data",{}).get("ok"))).lower())' 2>/dev/null || printf 'false')"
  [[ "$ok" == "true" ]]
}

install_launchagent() {
  mkdir -p "$(dirname "$PLIST_PATH")" "$(dirname "$LOG_PATH")" "$(dirname "$SOCKET_PATH")"
  /usr/bin/python3 - "$PLIST_PATH" "$LAUNCH_LABEL" "$BIN_PATH" "$SOCKET_PATH" "$LOG_PATH" "$ERR_PATH" <<'PY'
import plistlib
import sys

plist_path, label, bin_path, socket_path, log_path, err_path = sys.argv[1:]
plist = {
    "Label": label,
    "ProgramArguments": [bin_path, "serve", "--socket", socket_path],
    "RunAtLoad": True,
    "KeepAlive": True,
    "StandardOutPath": log_path,
    "StandardErrorPath": err_path,
}
with open(plist_path, "wb") as f:
    plistlib.dump(plist, f)
PY
  launchctl bootout "$DOMAIN/$LAUNCH_LABEL" >/dev/null 2>&1 || true
  launchctl bootout "$DOMAIN" "$PLIST_PATH" >/dev/null 2>&1 || true
  rm -f "$SOCKET_PATH"
  echo "+ launchctl bootstrap $DOMAIN $PLIST_PATH" >&2
  launchctl bootstrap "$DOMAIN" "$PLIST_PATH"
  launchctl kickstart -k "$DOMAIN/$LAUNCH_LABEL" >/dev/null 2>&1 || true
  sleep 0.5
}

if (( CHECK_ONLY == 1 )); then
  if (( REQUEST_ACCESS == 1 )); then
    request_access
  else
    check_installed
  fi
  exit $?
fi

if [[ -x "$BIN_PATH" && $FORCE -eq 0 ]]; then
  echo "Dobby Calendar Bridge already installed: $APP_DIR" >&2
else
  mkdir -p "$CACHE_DIR" "$MACOS_DIR"
  echo "+ swiftc $SOURCE_FILE" >&2
  swiftc "$SOURCE_FILE" \
    -framework Foundation \
    -framework EventKit \
    -Xlinker -sectcreate \
    -Xlinker __TEXT \
    -Xlinker __info_plist \
    -Xlinker "$INFO_PLIST" \
    -o "$BUILD_BIN"

  mkdir -p "$CONTENTS_DIR/Resources" "$MACOS_DIR"
  cp "$INFO_PLIST" "$CONTENTS_DIR/Info.plist"
  cp "$BUILD_BIN" "$BIN_PATH"
  chmod 755 "$BIN_PATH"

  sign_app
  echo "Installed Dobby Calendar Bridge: $APP_DIR" >&2
fi

install_launchagent

if (( REQUEST_ACCESS == 1 )); then
  request_access
else
  check_installed
fi
