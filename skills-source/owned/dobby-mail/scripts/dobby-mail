SCHEMA_VERSION = "1.0"
TOOL = "dobby-mail"
VERSION = "0.3.0"

EXIT_OK = 0
EXIT_FAILURE = 1
EXIT_USAGE = 2
EXIT_AUTH = 3
EXIT_DEP = 4
EXIT_TIMEOUT = 5

DEFAULT_LIMIT = 20
MAX_LIMIT = 200
DEFAULT_ACCOUNT_ENV = "DOBBY_MAIL_DEFAULT_ACCOUNT"
DEFAULT_FROM_ENV = "DOBBY_MAIL_DEFAULT_FROM"
GMAIL_CLIENT_FILE_ENV = "DOBBY_GMAIL_OAUTH_CLIENT_FILE"
GMAIL_TOKENS_FILE_ENV = "DOBBY_GMAIL_TOKENS_FILE"
GMAIL_KEYCHAIN_SERVICE = "dobby-mail-gmail-refresh-token"
GMAIL_SCOPES = [
    "https://mail.google.com/",
    "https://www.googleapis.com/auth/gmail.settings.basic",
]


def utc_now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def iso_from_mail_timestamp(value: Any) -> str | None:
    if value is None:
        return None
    try:
        n = float(value)
    except (TypeError, ValueError):
        raw = str(value).strip()
        if not raw:
            return None
        # If SQLite already stores a readable date, pass it through.
        return raw

    if n <= 0:
        return None
    # Apple absolute dates are seconds since 2001-01-01. Unix timestamps for
    # current mail are comfortably > 1_000_000_000; Apple absolute dates are not.
    if n < 1_000_000_000:
        n += 978_307_200
    try:
        return dt.datetime.fromtimestamp(n, tz=dt.timezone.utc).isoformat().replace("+00:00", "Z")
    except (OverflowError, OSError, ValueError):
        return None


def parse_date_arg(raw: str | None) -> tuple[int, int] | None:
    if not raw:
        return None
    value = raw.strip()
    if not value:
        return None
    try:
        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", value):
            parsed = dt.datetime.fromisoformat(value).replace(tzinfo=dt.timezone.utc)
        else:
            parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
            if parsed.tzinfo is None:
                parsed = parsed.replace(tzinfo=dt.timezone.utc)
        unix = int(parsed.timestamp())
        apple = unix - 978_307_200
        return unix, apple
    except ValueError as exc:
        raise CliError(
            "E_INVALID_DATE",
            f"Invalid date: {raw}",
            "Use YYYY-MM-DD or ISO-8601, e.g. 2026-05-27 or 2026-05-27T12:00:00Z.",
            EXIT_USAGE,
        ) from exc


def clamp_limit(value: int | None) -> int:
    if value is None:
        return DEFAULT_LIMIT
    if value < 1:
        raise CliError("E_INVALID_LIMIT", "--limit must be >= 1", "Pass --limit between 1 and 200.", EXIT_USAGE)
    return min(value, MAX_LIMIT)


def sanitize_filename(raw: str | None, fallback: str) -> str:
    name = (raw or fallback).strip() or fallback
    name = re.sub(r"[\\/:\0]+", "_", name)
    name = re.sub(r"\s+", " ", name).strip()
    if name in {".", ".."}:
        name = fallback
    return name[:180]


def process_chain(limit: int = 8) -> list[dict[str, Any]]:
    chain: list[dict[str, Any]] = []
    pid = os.getpid()
    for _ in range(limit):
        try:
            proc = subprocess.run(
                ["ps", "-p", str(pid), "-o", "pid=", "-o", "ppid=", "-o", "comm="],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                check=False,
            )
        except OSError:
            break
        line = proc.stdout.strip()
        if not line:
            break
        parts = line.split(None, 2)
        if len(parts) < 3:
            break
        cur_pid, ppid, comm = parts
        chain.append({"pid": int(cur_pid), "ppid": int(ppid), "command": comm})
        next_pid = int(ppid)
        if next_pid <= 1 or next_pid == pid:
            break
        pid = next_pid
    return chain


def recommended_access_targets() -> list[dict[str, Any]]:
    chain = process_chain()
    commands = " ".join(item["command"] for item in chain).lower()
    targets = []
    # TCC Full Disk Access is usually granted to the responsible app, not to python itself.
    if "codex" in commands:
        targets.append({"app": "Codex", "reason": "main Dobby host running this client"})
    if "ghostty" in commands:
        targets.append({"app": "Ghostty", "reason": "terminal host when running Dobby commands directly"})
    if "terminal" in commands:
        targets.append({"app": "Terminal", "reason": "terminal host when running Dobby commands directly"})
    if "iterm" in commands:
        targets.append({"app": "iTerm", "reason": "terminal host when running Dobby commands directly"})
    if not targets:
        targets.append({"app": "the app that launched this command", "reason": "macOS grants Full Disk Access to the responsible parent app"})
    # Keep unique while preserving order.
    seen: set[str] = set()
    out = []
    for target in targets:
        if target["app"] in seen:
            continue
        seen.add(target["app"])
        out.append(target)
    return out


def open_full_disk_access_settings() -> bool:
    urls = [
        "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles",
        "x-apple.systempreferences:com.apple.preference.security?Privacy",
    ]
    for url in urls:
        try:
            proc = subprocess.run(["open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
            if proc.returncode == 0:
                return True
        except OSError:
            pass
    return False


class CliError(Exception):
    def __init__(self, code: str, message: str, hint: str, exit_code: int = EXIT_FAILURE, retryable: bool = False):
        super().__init__(message)
        self.code = code
        self.message = message
        self.hint = hint
        self.exit_code = exit_code
        self.retryable = retryable


class WarningSink:
    def __init__(self, quiet: bool = False):
        self.items: list[dict[str, Any]] = []
        self.quiet = quiet

    def warn(self, code: str, message: str, hint: str | None = None, *, backend: str | None = None) -> None:
        item = {"code": code, "message": message, "hint": hint, "backend": backend}
        self.items.append(item)
        if not self.quiet:
            suffix = f" Hint: {hint}" if hint else ""
            print(f"[dobby-mail warning] {code}: {message}{suffix}", file=sys.stderr)


def make_envelope(command: str, status: str, data: dict[str, Any], error: dict[str, Any] | None, request_id: str, started: float) -> dict[str, Any]:
    return {
        "schema_version": SCHEMA_VERSION,
        "command": command,
        "status": status,
        "data": data,
        "error": error,
        "meta": {
            "request_id": request_id,
            "duration_ms": int((time.time() - started) * 1000),
            "timestamp_utc": utc_now(),
            "tool_version": VERSION,
        },
    }


def emit(payload: dict[str, Any], plain: bool = False) -> None:
    if plain:
        if payload["status"] == "ok":
            data = payload["data"]
            print(f"ok {payload['command']} backend={data.get('backend', data.get('selected_backend', '-'))}")
            if "messages" in data:
                for msg in data["messages"]:
                    date = msg.get("date_received") or msg.get("date_sent") or ""
                    print(f"{msg.get('id')}\t{date}\t{msg.get('sender','')}\t{msg.get('subject','')}")
            elif "checks" in data:
                for check in data["checks"]:
                    print(f"{check['status']}\t{check['name']}\t{check.get('message','')}")
            else:
                print(json.dumps(data, ensure_ascii=False))
        else:
            err = payload["error"] or {}
            print(f"error {err.get('code')}: {err.get('message')}", file=sys.stderr)
            if err.get("hint"):
                print(err["hint"], file=sys.stderr)
        return
    print(json.dumps(payload, ensure_ascii=False, indent=2))


def _decode_dotenv_value(raw: str) -> str:
    value = raw.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
        value = value[1:-1]
    return value.strip()


def candidate_dotenv_files(start: Path | None = None) -> list[Path]:
    workspace = os.environ.get("DOBBY_WORKSPACE", "").strip()
    if workspace:
        candidate = Path(workspace).expanduser().resolve() / ".env"
        return [candidate] if candidate.exists() else []

    cur = (start or Path.cwd()).resolve()
    return [candidate / ".env" for candidate in [cur, *cur.parents] if (candidate / ".env").exists()]


def dotenv_value(name: str) -> str | None:
    prefix = name + "="
    for env_file in candidate_dotenv_files():
        try:
            lines = env_file.read_text(encoding="utf-8").splitlines()
        except OSError:
            continue
        for line in lines:
            stripped = line.strip()
            if not stripped or stripped.startswith("#") or "=" not in stripped:
                continue
            if stripped.startswith("export "):
                stripped = stripped[len("export "):].lstrip()
            if stripped.startswith(prefix):
                return _decode_dotenv_value(stripped[len(prefix):]) or None
    return None


def config_value(name: str) -> str | None:
    raw = os.environ.get(name)
    if raw and raw.strip():
        return raw.strip()
    return dotenv_value(name)


def resolve_sender(raw: str | None) -> str | None:
    if raw and raw.strip():
        return raw.strip()
    value = config_value(DEFAULT_FROM_ENV)
    if value:
        return value
    raise CliError(
        "E_DEFAULT_FROM_REQUIRED",
        f"{DEFAULT_FROM_ENV} is required for draft/send identity",
        f"Set {DEFAULT_FROM_ENV} in the workspace .env/static defaults, or pass --sender explicitly.",
        EXIT_USAGE,
    )


def resolve_read_account(args: argparse.Namespace) -> str | None:
    if getattr(args, "all_accounts", False):
        return None
    raw = getattr(args, "account", None) or config_value(DEFAULT_ACCOUNT_ENV)
    if raw and raw.strip():
        return raw.strip()
    raise CliError(
        "E_DEFAULT_ACCOUNT_REQUIRED",
        f"{DEFAULT_ACCOUNT_ENV} is required for ambiguous mail reads",
        f"Set {DEFAULT_ACCOUNT_ENV} in the workspace .env/static defaults, pass --account, or pass --all-accounts explicitly.",
        EXIT_USAGE,
    )


def account_matches(account: dict[str, Any], raw: str) -> bool:
    needle = raw.strip().lower()
    candidates = [account.get("id"), account.get("name"), *(account.get("email_addresses") or [])]
    return any(str(candidate).strip().lower() == needle for candidate in candidates if candidate)


def validate_sender_for_default_account(args: argparse.Namespace, sender: str) -> dict[str, Any]:
    default_account = config_value(DEFAULT_ACCOUNT_ENV)
    if not default_account:
        raise CliError(
            "E_DEFAULT_ACCOUNT_REQUIRED",
            f"{DEFAULT_ACCOUNT_ENV} is required for draft/send identity validation",
            f"Set {DEFAULT_ACCOUNT_ENV} in the workspace .env/static defaults.",
            EXIT_USAGE,
        )
    result = jxa_accounts(getattr(args, "timeout_sec", 30))
    accounts = result.get("accounts", [])
    matched = None
    for account in accounts:
        if account_matches(account, default_account):
            matched = account
            break
    if not matched:
        raise CliError(
            "E_DEFAULT_ACCOUNT_NOT_FOUND",
            f"Configured mail account not found in Apple Mail: {default_account}",
            f"Set {DEFAULT_ACCOUNT_ENV} to one of the Apple Mail account email addresses/names/ids.",
            EXIT_USAGE,
        )
    emails = [str(email).strip().lower() for email in matched.get("email_addresses") or []]
    if sender.strip().lower() not in emails:
        available = ", ".join(matched.get("email_addresses") or [])
        raise CliError(
            "E_SENDER_NOT_CONFIGURED_FOR_ACCOUNT",
            f"Configured sender is not available on the default Apple Mail account: {sender}",
            f"Add {sender} as a sending address/alias for {DEFAULT_ACCOUNT_ENV} in Apple Mail, or set {DEFAULT_FROM_ENV} to one of: {available}.",
            EXIT_USAGE,
        )
    return matched


def public_account_scope(scope: dict[str, Any]) -> dict[str, Any]:
    matched = scope.get("matched_account")
    if matched:
        matched = {
            "id": matched.get("id"),
            "name": matched.get("name"),
            "email_addresses": matched.get("email_addresses") or [],
        }
    return {
        "mode": scope["mode"],
        "configured": scope.get("configured"),
        "matched_account": matched,
    }


def resolve_account_scope(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    raw = resolve_read_account(args)
    if raw is None:
        return {"mode": "all", "configured": None, "tokens": [], "matched_account": None}

    requested_backend = getattr(args, "backend", "auto")
    # UUID/local path tokens can be applied directly to the fast mailbox URLs.
    raw_tokens = [raw]
    should_lookup = "@" in raw or requested_backend in {"auto", "mail-app"}
    if not should_lookup:
        return {"mode": "account", "configured": raw, "tokens": raw_tokens, "matched_account": None}

    try:
        accounts = jxa_accounts(getattr(args, "timeout_sec", 30)).get("accounts", [])
    except CliError as exc:
        if requested_backend == "fast" and "@" not in raw:
            warnings.warn(
                exc.code,
                f"Could not resolve {DEFAULT_ACCOUNT_ENV} via Mail.app; using raw account token for fast filtering.",
                exc.hint,
                backend="mail-app",
            )
            return {"mode": "account", "configured": raw, "tokens": raw_tokens, "matched_account": None}
        raise

    for account in accounts:
        if account_matches(account, raw):
            tokens = [str(account.get("id"))] if account.get("id") else raw_tokens
            return {"mode": "account", "configured": raw, "tokens": tokens, "matched_account": account}

    raise CliError(
        "E_DEFAULT_ACCOUNT_NOT_FOUND",
        f"Configured mail account not found in Apple Mail: {raw}",
        f"Set {DEFAULT_ACCOUNT_ENV} to one of the Apple Mail account email addresses/names/ids, or pass --all-accounts explicitly.",
        EXIT_USAGE,
    )


def resolve_mail_root(raw: str | None) -> Path:
    if raw:
        return Path(raw).expanduser().resolve()
    if os.environ.get("DOBBY_MAIL_ROOT"):
        return Path(os.environ["DOBBY_MAIL_ROOT"]).expanduser().resolve()
    return (Path.home() / "Library" / "Mail").resolve()


def version_key(path: Path) -> tuple[int, str]:
    m = re.fullmatch(r"V(\d+)", path.name)
    return (int(m.group(1)) if m else -1, path.name)


def find_mail_version_root(mail_root: Path) -> Path:
    try:
        versions = [p for p in mail_root.iterdir() if p.is_dir() and re.fullmatch(r"V\d+", p.name)]
    except FileNotFoundError as exc:
        raise CliError(
            "E_MAIL_ROOT_NOT_FOUND",
            f"Apple Mail root not found: {mail_root}",
            "Open Apple Mail once, pass --mail-root, or allow Mail.app fallback for live reads.",
            EXIT_DEP,
        ) from exc
    except PermissionError as exc:
        raise CliError(
            "E_MAIL_ROOT_PERMISSION",
            f"Cannot read Apple Mail root: {mail_root}",
            "Grant Full Disk Access to the terminal/Codex host, or use the Mail.app fallback backend.",
            EXIT_AUTH,
        ) from exc
    if not versions:
        raise CliError(
            "E_MAIL_ROOT_NOT_FOUND",
            f"No Apple Mail V* folder found under {mail_root}",
            "Open Apple Mail once, or pass --mail-root to a fixture/alternate Mail root.",
            EXIT_DEP,
        )
    return sorted(versions, key=version_key)[-1]


def resolve_index_path(mail_root: Path, raw: str | None) -> Path:
    if raw:
        return Path(raw).expanduser().resolve()
    if os.environ.get("DOBBY_MAIL_INDEX"):
        return Path(os.environ["DOBBY_MAIL_INDEX"]).expanduser().resolve()
    version_root = find_mail_version_root(mail_root)
    return version_root / "MailData" / "Envelope Index"


def sqlite_uri(path: Path) -> str:
    return f"file:{path}?mode=ro"


def clean_text(value: Any, limit: int | None = None) -> str | None:
    if value is None:
        return None
    text = str(value).replace("\x00", "").strip()
    if limit is not None and len(text) > limit:
        return text[: limit - 1] + "…"
    return text


def email_body_from_message(msg: email.message.EmailMessage) -> tuple[str | None, str | None, list[dict[str, Any]]]:
    attachments: list[dict[str, Any]] = []
    plain_parts: list[str] = []
    html_parts: list[str] = []

    if msg.is_multipart():
        for part in msg.walk():
            if part.is_multipart():
                continue
            disposition = (part.get_content_disposition() or "").lower()
            ctype = part.get_content_type()
            filename = part.get_filename()
            if disposition == "attachment" or filename:
                payload = part.get_payload(decode=True) or b""
                attachments.append({
                    "filename": filename,
                    "content_type": ctype,
                    "size_bytes": len(payload),
                })
                continue
            with contextlib.suppress(Exception):
                content = part.get_content()
                if ctype == "text/plain":
                    plain_parts.append(str(content))
                elif ctype == "text/html":
                    html_parts.append(str(content))
    else:
        with contextlib.suppress(Exception):
            content = msg.get_content()
            if msg.get_content_type() == "text/html":
                html_parts.append(str(content))
            else:
                plain_parts.append(str(content))

    plain = "\n".join(p.strip() for p in plain_parts if p and p.strip()) or None
    html = "\n".join(p.strip() for p in html_parts if p and p.strip()) or None
    return plain, html, attachments


def parse_emlx(path: Path, max_body_chars: int | None = None) -> dict[str, Any]:
    raw_all = path.read_bytes()
    first_line, sep, rest = raw_all.partition(b"\n")
    raw_msg: bytes
    try:
        length = int(first_line.strip())
        raw_msg = rest[:length]
    except ValueError:
        raw_msg = raw_all

    msg = email.message_from_bytes(raw_msg, policy=policy.default)
    plain, html, attachments = email_body_from_message(msg)  # type: ignore[arg-type]
    if max_body_chars is not None:
        if plain and len(plain) > max_body_chars:
            plain = plain[: max_body_chars - 1] + "…"
        if html and len(html) > max_body_chars:
            html = html[: max_body_chars - 1] + "…"

    headers = {k: str(v) for k, v in msg.items()}
    return {
        "headers": headers,
        "body_text": plain,
        "body_html": html,
        "attachments": attachments,
        "raw_size_bytes": len(raw_msg),
        "emlx_path": str(path),
    }


def extract_emlx_attachments(path: Path, out_dir: Path) -> list[dict[str, Any]]:
    raw_all = path.read_bytes()
    first_line, _sep, rest = raw_all.partition(b"\n")
    try:
        length = int(first_line.strip())
        raw_msg = rest[:length]
    except ValueError:
        raw_msg = raw_all
    msg = email.message_from_bytes(raw_msg, policy=policy.default)
    out_dir.mkdir(parents=True, exist_ok=True)
    saved: list[dict[str, Any]] = []
    counter = 0
    for part in msg.walk() if msg.is_multipart() else [msg]:
        if part.is_multipart():
            continue
        filename = part.get_filename()
        disposition = (part.get_content_disposition() or "").lower()
        if disposition != "attachment" and not filename:
            continue
        payload = part.get_payload(decode=True) or b""
        counter += 1
        safe_name = sanitize_filename(filename, f"attachment-{counter}")
        target = out_dir / safe_name
        if target.exists():
            stem, suffix = target.stem, target.suffix
            i = 2
            while (out_dir / f"{stem}-{i}{suffix}").exists():
                i += 1
            target = out_dir / f"{stem}-{i}{suffix}"
        target.write_bytes(payload)
        saved.append({
            "filename": filename,
            "content_type": part.get_content_type(),
            "size_bytes": len(payload),
            "path": str(target),
        })
    return saved


def read_raw_eml_from_emlx(path: Path) -> bytes:
    raw_all = path.read_bytes()
    first_line, _sep, rest = raw_all.partition(b"\n")
    try:
        length = int(first_line.strip())
        return rest[:length]
    except ValueError:
        return raw_all


class FastMailStore:
    def __init__(self, mail_root: Path, index_path: Path):
        self.mail_root = mail_root
        self.index_path = index_path
        self.conn: sqlite3.Connection | None = None
        self._columns: dict[str, set[str]] = {}
        self._tables: set[str] | None = None

    def connect(self) -> sqlite3.Connection:
        if self.conn is not None:
            return self.conn
        if not self.index_path.exists():
            raise CliError(
                "E_FAST_INDEX_NOT_FOUND",
                f"Apple Mail Envelope Index not found: {self.index_path}",
                "Open Apple Mail once, grant Full Disk Access, or allow fallback to Mail.app.",
                EXIT_DEP,
            )
        try:
            conn = sqlite3.connect(sqlite_uri(self.index_path), uri=True, timeout=5)
            conn.text_factory = lambda b: b.decode("utf-8", "replace")
            conn.row_factory = sqlite3.Row
            self.conn = conn
            return conn
        except sqlite3.OperationalError as exc:
            message = str(exc)
            code = "E_FAST_INDEX_PERMISSION" if "authorization" in message.lower() or "unable to open" in message.lower() else "E_FAST_INDEX_OPEN"
            raise CliError(
                code,
                f"Cannot open Apple Mail Envelope Index: {message}",
                "Grant Full Disk Access to the terminal/Codex host, or allow fallback to Mail.app.",
                EXIT_AUTH if code.endswith("PERMISSION") else EXIT_DEP,
            ) from exc

    def tables(self) -> set[str]:
        if self._tables is None:
            rows = self.connect().execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()
            self._tables = {str(row[0]) for row in rows}
        return self._tables

    def columns(self, table: str) -> set[str]:
        if table not in self._columns:
            rows = self.connect().execute(f"PRAGMA table_info({quote_ident(table)})").fetchall()
            self._columns[table] = {str(row[1]) for row in rows}
        return self._columns[table]

    def has(self, table: str, col: str) -> bool:
        return table in self.tables() and col in self.columns(table)

    def expr(self, table_alias: str, table: str, candidates: list[str], default: str = "NULL") -> str:
        for col in candidates:
            if self.has(table, col):
                return f"{table_alias}.{quote_ident(col)}"
        return default

    def build_query(
        self,
        *,
        query: str | None,
        limit: int,
        date_from: str | None,
        date_to: str | None,
        mailbox: str | None,
        rowid: str | None = None,
        account_tokens: list[str] | None = None,
    ) -> tuple[str, list[Any]]:
        if "messages" not in self.tables():
            raise CliError("E_FAST_SCHEMA_UNSUPPORTED", "Envelope Index has no messages table", "Use Mail.app fallback or update dobby-mail schema support.", EXIT_DEP)

        joins: list[str] = []
        subject_expr = self.expr("m", "messages", ["subject", "subject_text", "normalized_subject"])
        if "subjects" in self.tables() and self.has("messages", "subject"):
            subj_cols = [c for c in ["subject", "normalized_subject"] if self.has("subjects", c)]
            if subj_cols:
                joins.append("LEFT JOIN subjects s ON m.subject = s.ROWID")
                subject_expr = "COALESCE(" + ", ".join([f"s.{quote_ident(c)}" for c in subj_cols] + ["CAST(m.subject AS TEXT)"]) + ")"

        sender_expr = self.expr("m", "messages", ["sender", "sender_address", "from_address"])
        if "addresses" in self.tables() and self.has("messages", "sender"):
            addr_cols = [c for c in ["address", "comment", "display_name"] if self.has("addresses", c)]
            if addr_cols:
                joins.append("LEFT JOIN addresses sender ON m.sender = sender.ROWID")
                sender_expr = "COALESCE(" + ", ".join([f"sender.{quote_ident(c)}" for c in addr_cols] + ["CAST(m.sender AS TEXT)"]) + ")"

        mailbox_expr = self.expr("m", "messages", ["mailbox", "mailbox_name"])
        mailbox_url_expr = "NULL"
        if "mailboxes" in self.tables() and self.has("messages", "mailbox"):
            mb_cols = [c for c in ["display_name", "name", "mailbox_name", "url"] if self.has("mailboxes", c)]
            if mb_cols:
                joins.append("LEFT JOIN mailboxes mb ON m.mailbox = mb.ROWID")
                mailbox_expr = "COALESCE(" + ", ".join([f"mb.{quote_ident(c)}" for c in mb_cols] + ["CAST(m.mailbox AS TEXT)"]) + ")"
                if self.has("mailboxes", "url"):
                    mailbox_url_expr = "mb.url"

        date_received_expr = self.expr("m", "messages", ["date_received", "date_last_viewed", "date_sent", "date"])
        date_sent_expr = self.expr("m", "messages", ["date_sent", "date_received", "date"])
        message_id_expr = self.expr("m", "messages", ["message_id", "internet_message_id", "rfc_message_id", "external_id", "remote_id"])
        document_id_expr = self.expr("m", "messages", ["document_id", "message_id"])
        read_expr = self.expr("m", "messages", ["read", "read_status", "is_read"], "NULL")
        flags_expr = self.expr("m", "messages", ["flags"], "NULL")
        size_expr = self.expr("m", "messages", ["size", "message_size"], "NULL")

        where: list[str] = []
        params: list[Any] = []
        if rowid is not None:
            where.append("CAST(m.ROWID AS TEXT) = ?")
            params.append(str(rowid))
        if query:
            q = f"%{query.lower()}%"
            where.append(f"(LOWER(CAST({subject_expr} AS TEXT)) LIKE ? OR LOWER(CAST({sender_expr} AS TEXT)) LIKE ?)")
            params.extend([q, q])
        if mailbox:
            where.append(f"LOWER(CAST({mailbox_expr} AS TEXT)) LIKE ?")
            params.append(f"%{mailbox.lower()}%")
        account_clauses: list[str] = []
        for token in account_tokens or []:
            cleaned = str(token).strip().lower()
            if not cleaned:
                continue
            account_clauses.append(f"(LOWER(CAST({mailbox_expr} AS TEXT)) LIKE ? OR LOWER(CAST({mailbox_url_expr} AS TEXT)) LIKE ?)")
            params.extend([f"%{cleaned}%", f"%{cleaned}%"])
        if account_clauses:
            where.append("(" + " OR ".join(account_clauses) + ")")
        from_pair = parse_date_arg(date_from)
        to_pair = parse_date_arg(date_to)
        if from_pair:
            where.append(f"(({date_received_expr} >= ?) OR ({date_received_expr} >= ? AND {date_received_expr} < 1000000000))")
            params.extend([from_pair[0], from_pair[1]])
        if to_pair:
            # Include the full day when a date-only value is passed.
            unix_to, apple_to = to_pair
            if date_to and re.fullmatch(r"\d{4}-\d{2}-\d{2}", date_to.strip()):
                unix_to += 86399
                apple_to += 86399
            where.append(f"(({date_received_expr} <= ?) OR ({date_received_expr} <= ? AND {date_received_expr} < 1000000000))")
            params.extend([unix_to, apple_to])

        where_sql = " WHERE " + " AND ".join(where) if where else ""
        sql = f"""
            SELECT
              m.ROWID AS rowid,
              CAST({message_id_expr} AS TEXT) AS source_message_id,
              CAST({document_id_expr} AS TEXT) AS document_id,
              CAST({subject_expr} AS TEXT) AS subject,
              CAST({sender_expr} AS TEXT) AS sender,
              {date_received_expr} AS date_received_raw,
              {date_sent_expr} AS date_sent_raw,
              CAST({mailbox_expr} AS TEXT) AS mailbox,
              CAST({mailbox_url_expr} AS TEXT) AS mailbox_url,
              {read_expr} AS read_raw,
              {flags_expr} AS flags_raw,
              {size_expr} AS size_bytes
            FROM messages m
            {' '.join(joins)}
            {where_sql}
            ORDER BY {date_received_expr} DESC
            LIMIT ?
        """
        params.append(limit)
        return sql, params

    def search(
        self,
        *,
        query: str | None,
        limit: int,
        date_from: str | None,
        date_to: str | None,
        mailbox: str | None = None,
        account_tokens: list[str] | None = None,
    ) -> list[dict[str, Any]]:
        sql, params = self.build_query(query=query, limit=limit, date_from=date_from, date_to=date_to, mailbox=mailbox, account_tokens=account_tokens)
        rows = self.connect().execute(sql, params).fetchall()
        return [self.normalize_row(row) for row in rows]

    def get(self, rowid: str, account_tokens: list[str] | None = None) -> dict[str, Any]:
        sql, params = self.build_query(query=None, limit=1, date_from=None, date_to=None, mailbox=None, rowid=rowid, account_tokens=account_tokens)
        row = self.connect().execute(sql, params).fetchone()
        if row is None:
            raise CliError("E_MESSAGE_NOT_FOUND", f"No Apple Mail message found for id {rowid}", "Use search/recent to find a current message id.", EXIT_FAILURE)
        item = self.normalize_row(row)
        emlx = self.find_emlx(item)
        if emlx:
            item.update(parse_emlx(emlx))
        else:
            item["body_text"] = None
            item["body_html"] = None
            item["attachments"] = []
            item["emlx_path"] = None
            item["body_unavailable_reason"] = "E_EMLX_NOT_FOUND"
        return item

    def get_emlx_for_rowid(self, rowid: str, account_tokens: list[str] | None = None) -> tuple[dict[str, Any], Path]:
        sql, params = self.build_query(query=None, limit=1, date_from=None, date_to=None, mailbox=None, rowid=rowid, account_tokens=account_tokens)
        row = self.connect().execute(sql, params).fetchone()
        if row is None:
            raise CliError("E_MESSAGE_NOT_FOUND", f"No Apple Mail message found for id {rowid}", "Use search/recent to find a current fast:<rowid> id.", EXIT_FAILURE)
        item = self.normalize_row(row)
        emlx = self.find_emlx(item)
        if not emlx:
            raise CliError("E_EMLX_NOT_FOUND", f"Could not locate .emlx file for fast:{rowid}", "Use `get` without export/attachment extraction, or try Mail.app fallback.", EXIT_DEP)
        return item, emlx

    def mailboxes(self, limit: int = 500, account_tokens: list[str] | None = None) -> list[dict[str, Any]]:
        if "mailboxes" not in self.tables():
            raise CliError("E_FAST_SCHEMA_UNSUPPORTED", "Envelope Index has no mailboxes table", "Use Mail.app fallback or update dobby-mail schema support.", EXIT_DEP)
        cols = self.columns("mailboxes")
        select = ["ROWID AS rowid"]
        for col in ["display_name", "name", "mailbox_name", "url", "total_count", "unread_count"]:
            if col in cols:
                select.append(f"{quote_ident(col)} AS {quote_ident(col)}")
        rows = self.connect().execute(f"SELECT {', '.join(select)} FROM mailboxes ORDER BY ROWID LIMIT ?", (limit,)).fetchall()
        out = []
        tokens = [str(token).strip().lower() for token in account_tokens or [] if str(token).strip()]
        for row in rows:
            d = dict(row)
            haystack = " ".join(str(d.get(col) or "") for col in ["display_name", "name", "mailbox_name", "url"]).lower()
            if tokens and not any(token in haystack for token in tokens):
                continue
            out.append({
                "id": f"fast-mailbox:{d.get('rowid')}",
                "rowid": d.get("rowid"),
                "name": clean_text(d.get("display_name") or d.get("name") or d.get("mailbox_name") or d.get("url")),
                "url": clean_text(d.get("url")),
                "total_count": d.get("total_count"),
                "unread_count": d.get("unread_count"),
            })
        return out

    def normalize_row(self, row: sqlite3.Row) -> dict[str, Any]:
        d = dict(row)
        rowid = str(d.get("rowid"))
        message_id = clean_text(d.get("source_message_id"))
        document_id = clean_text(d.get("document_id"))
        flags = d.get("flags_raw")
        read_raw = d.get("read_raw")
        read_status = None
        if read_raw is not None:
            with contextlib.suppress(Exception):
                read_status = bool(int(read_raw))
        return {
            "id": f"fast:{rowid}",
            "backend": "fast",
            "rowid": rowid,
            "apple_mail_id": rowid,
            "source_message_id": message_id,
            "document_id": document_id,
            "subject": clean_text(d.get("subject"), 500),
            "sender": clean_text(d.get("sender"), 500),
            "date_received": iso_from_mail_timestamp(d.get("date_received_raw")),
            "date_sent": iso_from_mail_timestamp(d.get("date_sent_raw")),
            "mailbox": clean_text(d.get("mailbox"), 500),
            "mailbox_url": clean_text(d.get("mailbox_url"), 1000),
            "read_status": read_status,
            "flags_raw": flags,
            "size_bytes": d.get("size_bytes"),
            "threading_supported": False,
        }

    def find_emlx(self, item: dict[str, Any]) -> Path | None:
        candidates: list[str] = []
        for key in ["rowid", "document_id", "source_message_id", "apple_mail_id"]:
            value = item.get(key)
            if value is None:
                continue
            text = str(value).strip().strip("<>")
            if re.fullmatch(r"\d+", text) and text not in candidates:
                candidates.append(text)
        if not candidates:
            return None
        try:
            version_root = find_mail_version_root(self.mail_root)
        except CliError:
            version_root = self.index_path.parents[1] if len(self.index_path.parents) > 1 else self.mail_root
        for cand in candidates:
            pattern = f"{cand}.emlx"
            # Common case: Mail stores message files in nested Messages directories.
            with contextlib.suppress(PermissionError, OSError):
                for p in version_root.rglob(pattern):
                    if p.is_file():
                        return p
        return None


def quote_ident(name: str) -> str:
    return '"' + name.replace('"', '""') + '"'


def run_osascript(script: str, *, input_json: dict[str, Any] | None = None, timeout_sec: int = 30) -> dict[str, Any]:
    osascript = os.environ.get("DOBBY_MAIL_OSASCRIPT") or shutil.which("osascript")
    if not osascript:
        raise CliError("E_OSASCRIPT_NOT_FOUND", "osascript not found", "Run on macOS with /usr/bin/osascript available.", EXIT_DEP)
    env = os.environ.copy()
    tmp_path: str | None = None
    if input_json is not None:
        fd, tmp_path = tempfile.mkstemp(prefix="dobby-mail-input-", suffix=".json")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(input_json, f)
        env["DOBBY_MAIL_INPUT_JSON"] = tmp_path
    try:
        proc = subprocess.run(
            [osascript, "-l", "JavaScript", "-e", script],
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout_sec,
            check=False,
            env=env,
        )
    except subprocess.TimeoutExpired as exc:
        raise CliError("E_MAIL_APP_TIMEOUT", "Mail.app automation timed out", "Retry, open Mail.app manually, or use the fast read backend.", EXIT_TIMEOUT, retryable=True) from exc
    finally:
        if tmp_path:
            with contextlib.suppress(OSError):
                os.unlink(tmp_path)
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "").strip()
        code = "E_MAIL_APP_PERMISSION" if "not authorized" in err.lower() or "not permitted" in err.lower() else "E_MAIL_APP_AUTOMATION"
        raise CliError(code, f"Mail.app automation failed: {err}", "Grant Automation permission for the terminal/Codex host to control Mail.app, or use fast read-only backend.", EXIT_AUTH if code.endswith("PERMISSION") else EXIT_DEP)
    raw = proc.stdout.strip()
    try:
        parsed = json.loads(raw) if raw else {}
    except json.JSONDecodeError as exc:
        raise CliError("E_MAIL_APP_BAD_OUTPUT", f"Mail.app automation returned non-JSON output: {raw[:200]}", "Inspect the JXA script or run with --backend fast for reads.", EXIT_DEP) from exc
    if isinstance(parsed, dict) and parsed.get("status") == "error":
        raise CliError(parsed.get("code", "E_MAIL_APP_ERROR"), parsed.get("message", "Mail.app returned an error"), parsed.get("hint", "Inspect Mail.app state."), EXIT_FAILURE, retryable=bool(parsed.get("retryable")))
    if not isinstance(parsed, dict):
        raise CliError("E_MAIL_APP_BAD_OUTPUT", "Mail.app automation did not return a JSON object", "Inspect the JXA script.", EXIT_DEP)
    return parsed


JXA_LIBRARY = r'''
function readInput() {
  ObjC.import('Foundation');
  var path = $.NSProcessInfo.processInfo.environment.objectForKey('DOBBY_MAIL_INPUT_JSON');
  if (!path) return {};
  var ns = $.NSString.stringWithContentsOfFileEncodingError(path, $.NSUTF8StringEncoding, null);
  return JSON.parse(ObjC.unwrap(ns));
}
function isoDate(value) {
  if (!value) return null;
  try {
    var d = new Date(value);
    if (isNaN(d.getTime())) return String(value);
    return d.toISOString();
  } catch (e) { return String(value); }
}
function safe(fn, fallback) {
  try { return fn(); } catch (e) { return fallback; }
}
function msgSummary(m) {
  return {
    id: 'mail:' + safe(function(){ return String(m.id()); }, ''),
    backend: 'mail-app',
    apple_mail_id: safe(function(){ return String(m.id()); }, null),
    source_message_id: safe(function(){ return String(m.messageId()); }, null),
    subject: safe(function(){ return String(m.subject()); }, null),
    sender: safe(function(){ return String(m.sender()); }, null),
    date_received: isoDate(safe(function(){ return m.dateReceived(); }, null)),
    date_sent: isoDate(safe(function(){ return m.dateSent(); }, null)),
    mailbox: safe(function(){ return String(m.mailbox().name()); }, null),
    account: safe(function(){ return String(m.mailbox().account().name()); }, null),
    read_status: safe(function(){ return Boolean(m.readStatus()); }, null),
    threading_supported: true
  };
}
function accountMatches(a, raw) {
  if (!raw) return true;
  var needle = String(raw).trim().toLowerCase();
  if (!needle) return true;
  var candidates = [
    safe(function(){ return String(a.id()); }, ''),
    safe(function(){ return String(a.name()); }, '')
  ];
  var emails = safe(function(){ return a.emailAddresses().map(String); }, []);
  candidates = candidates.concat(emails);
  for (var i = 0; i < candidates.length; i++) {
    if (String(candidates[i] || '').trim().toLowerCase() === needle) return true;
  }
  return false;
}
function findAccount(Mail, raw) {
  if (!raw) return null;
  var accounts = Mail.accounts();
  for (var i = 0; i < accounts.length; i++) {
    if (accountMatches(accounts[i], raw)) return accounts[i];
  }
  return null;
}
function inboxesForAccount(account) {
  var boxes = safe(function(){ return account.mailboxes(); }, []);
  var out = [];
  for (var i = 0; i < boxes.length; i++) {
    var name = safe(function(){ return String(boxes[i].name()); }, '').toLowerCase();
    if (name === 'inbox') out.push(boxes[i]);
  }
  return out.length ? out : boxes;
}
function normalizeAddresses(raw) {
  if (!raw) return [];
  if (Array.isArray(raw)) return raw.filter(Boolean).map(String);
  return String(raw).split(',').map(function(s){ return s.trim(); }).filter(Boolean);
}
'''


def jxa_accounts(timeout_sec: int) -> dict[str, Any]:
    script = JXA_LIBRARY + r'''
var Mail = Application('Mail');
var accounts = Mail.accounts().map(function(a) {
  return {
    id: safe(function(){ return String(a.id()); }, null),
    name: safe(function(){ return String(a.name()); }, null),
    enabled: safe(function(){ return Boolean(a.enabled()); }, null),
    account_type: safe(function(){ return String(a.accountType()); }, null),
    email_addresses: safe(function(){ return a.emailAddresses().map(String); }, [])
  };
});
JSON.stringify({accounts: accounts});
'''
    return run_osascript(script, timeout_sec=timeout_sec)


def jxa_mailboxes(timeout_sec: int, limit: int, account: str | None = None) -> dict[str, Any]:
    script = JXA_LIBRARY + r'''
var input = readInput();
var limit = input.limit || 200;
var accountRaw = input.account || null;
var Mail = Application('Mail');
var out = [];
function addMailbox(mb, accountName, prefix, depth) {
  if (out.length >= limit || depth > 8) return;
  var name = safe(function(){ return String(mb.name()); }, '');
  var path = prefix ? prefix + '/' + name : name;
  out.push({
    id: 'mailbox:' + out.length,
    backend: 'mail-app',
    name: name,
    path: path,
    account: accountName,
    unread_count: safe(function(){ return Number(mb.unreadCount()); }, null)
  });
  var children = safe(function(){ return mb.mailboxes(); }, []);
  for (var i = 0; i < children.length && out.length < limit; i++) addMailbox(children[i], accountName, path, depth + 1);
}
var accounts = Mail.accounts();
if (accountRaw && !findAccount(Mail, accountRaw)) {
  JSON.stringify({status:'error', code:'E_DEFAULT_ACCOUNT_NOT_FOUND', message:'Configured mail account not found in Apple Mail: ' + accountRaw, hint:'Set DOBBY_MAIL_DEFAULT_ACCOUNT to an Apple Mail account email/name/id, or pass --all-accounts.'});
} else {
for (var a = 0; a < accounts.length && out.length < limit; a++) {
  if (accountRaw && !accountMatches(accounts[a], accountRaw)) continue;
  var accountName = safe(function(){ return String(accounts[a].name()); }, null);
  var boxes = safe(function(){ return accounts[a].mailboxes(); }, []);
  for (var b = 0; b < boxes.length && out.length < limit; b++) addMailbox(boxes[b], accountName, '', 0);
}
JSON.stringify({mailboxes: out});
}
'''
    return run_osascript(script, input_json={"limit": limit, "account": account}, timeout_sec=timeout_sec)


def jxa_search(query: str | None, limit: int, timeout_sec: int, scope: str = "inbox", account: str | None = None) -> dict[str, Any]:
    script = JXA_LIBRARY + r'''
var input = readInput();
var limit = input.limit || 20;
var q = (input.query || '').toLowerCase();
var accountRaw = input.account || null;
var Mail = Application('Mail');
var boxes = [];
if (input.scope === 'selected') {
  var selected = safe(function(){ return Mail.selection(); }, []);
  var selectedOut = selected.map(msgSummary).filter(function(m) {
    if (!q) return true;
    return ((m.subject || '') + ' ' + (m.sender || '')).toLowerCase().indexOf(q) >= 0;
  }).slice(0, limit);
  JSON.stringify({messages: selectedOut, scope: 'selected'});
} else {
  if (accountRaw) {
    var account = findAccount(Mail, accountRaw);
    if (!account) {
      JSON.stringify({status:'error', code:'E_DEFAULT_ACCOUNT_NOT_FOUND', message:'Configured mail account not found in Apple Mail: ' + accountRaw, hint:'Set DOBBY_MAIL_DEFAULT_ACCOUNT to an Apple Mail account email/name/id, or pass --all-accounts.'});
    } else {
      boxes = inboxesForAccount(account);
      var out = [];
      for (var bi = 0; bi < boxes.length && out.length < limit; bi++) {
        var msgs = safe(function(){ return boxes[bi].messages(); }, []);
        for (var i = msgs.length - 1; i >= 0 && out.length < limit; i--) {
          var s = msgSummary(msgs[i]);
          if (q && (((s.subject || '') + ' ' + (s.sender || '')).toLowerCase().indexOf(q) < 0)) continue;
          out.push(s);
        }
      }
      JSON.stringify({messages: out, scope: 'inbox', account: accountRaw});
    }
  } else {
    boxes.push(Mail.inbox());
    var out = [];
    for (var bi = 0; bi < boxes.length && out.length < limit; bi++) {
      var msgs = safe(function(){ return boxes[bi].messages(); }, []);
      for (var i = msgs.length - 1; i >= 0 && out.length < limit; i--) {
        var s = msgSummary(msgs[i]);
        if (q && (((s.subject || '') + ' ' + (s.sender || '')).toLowerCase().indexOf(q) < 0)) continue;
        out.push(s);
      }
    }
    JSON.stringify({messages: out, scope: 'inbox'});
  }
}
'''
    return run_osascript(script, input_json={"query": query, "limit": limit, "scope": scope, "account": account}, timeout_sec=timeout_sec)


def jxa_get(mail_id: str, timeout_sec: int, scope: str = "inbox", max_body_chars: int | None = None, account: str | None = None) -> dict[str, Any]:
    script = JXA_LIBRARY + r'''
var input = readInput();
var target = String(input.id || '').replace(/^mail:/, '');
var accountRaw = input.account || null;
var Mail = Application('Mail');
function attachBody(s) {
  var body = safe(function(){ return String(s._message.content()); }, null);
  if (body && input.max_body_chars && body.length > input.max_body_chars) body = body.slice(0, input.max_body_chars - 1) + '…';
  s.body_text = body;
  s.body_html = null;
  s.attachments = [];
  return s;
}
function findInMessages(msgs) {
  for (var i = msgs.length - 1; i >= 0; i--) {
    var m = msgs[i];
    var id = safe(function(){ return String(m.id()); }, '');
    var mid = safe(function(){ return String(m.messageId()); }, '');
    if (id === target || mid === target) {
      var s = msgSummary(m);
      s._message = m;
      return s;
    }
  }
  return null;
}
var found = null;
if (input.scope === 'selected') found = findInMessages(safe(function(){ return Mail.selection(); }, []));
if (!found) {
  var boxes = [];
  if (accountRaw) {
    var account = findAccount(Mail, accountRaw);
    if (!account) {
      JSON.stringify({status:'error', code:'E_DEFAULT_ACCOUNT_NOT_FOUND', message:'Configured mail account not found in Apple Mail: ' + accountRaw, hint:'Set DOBBY_MAIL_DEFAULT_ACCOUNT to an Apple Mail account email/name/id, or pass --all-accounts.'});
    } else {
      boxes = inboxesForAccount(account);
    }
  } else {
    boxes = [Mail.inbox()];
  }
  for (var bi = 0; bi < boxes.length && !found; bi++) found = findInMessages(safe(function(){ return boxes[bi].messages(); }, []));
}
if (!found) {
  JSON.stringify({status:'error', code:'E_MESSAGE_NOT_FOUND', message:'Message not found in Mail.app fallback scope', hint:'Use search/recent first, or use fast backend with Full Disk Access.'});
} else {
  var mObj = found._message;
  delete found._message;
  found.body_text = safe(function(){ return String(mObj.content()); }, null);
  if (found.body_text && input.max_body_chars && found.body_text.length > input.max_body_chars) found.body_text = found.body_text.slice(0, input.max_body_chars - 1) + '…';
  found.body_html = null;
  found.attachments = [];
  JSON.stringify({message: found});
}
'''
    return run_osascript(script, input_json={"id": mail_id, "scope": scope, "max_body_chars": max_body_chars, "account": account}, timeout_sec=timeout_sec)


def jxa_create_draft(payload: dict[str, Any], timeout_sec: int) -> dict[str, Any]:
    script = JXA_LIBRARY + r'''
var input = readInput();
var Mail = Application('Mail');
var mailWasRunning = safe(function(){ return Boolean(Mail.running()); }, null);
safe(function(){ Mail.launch(); }, null);
var to = normalizeAddresses(input.to);
var cc = normalizeAddresses(input.cc);
var bcc = normalizeAddresses(input.bcc);
if (to.length === 0) {
  JSON.stringify({status:'error', code:'E_RECIPIENT_REQUIRED', message:'At least one --to recipient is required', hint:'Pass --to recipient@example.com'});
} else {
  var msg = Mail.OutgoingMessage({subject: input.subject || '', content: input.body || '', visible: input.visible !== false});
  Mail.outgoingMessages.push(msg);
  to.forEach(function(addr) { msg.toRecipients.push(Mail.ToRecipient({address: addr})); });
  cc.forEach(function(addr) { msg.ccRecipients.push(Mail.CcRecipient({address: addr})); });
  bcc.forEach(function(addr) { msg.bccRecipients.push(Mail.BccRecipient({address: addr})); });
  if (input.sender) msg.sender = input.sender;
  safe(function(){ msg.visible = false; }, null);
  msg.save();
  safe(function(){ msg.visible = false; }, null);
  var draftId = safe(function(){ return String(msg.id()); }, '');
  var messageId = safe(function(){ return String(msg.messageId()); }, null);
  var actualSender = safe(function(){ return String(msg.sender()); }, input.sender || null);
  JSON.stringify({draft: {
    id: 'draft:' + draftId,
    backend: 'mail-app',
    apple_mail_id: draftId,
    source_message_id: messageId,
    subject: input.subject || '',
    to: to,
    cc: cc,
    bcc_count: bcc.length,
    requested_sender: input.sender || null,
    sender: actualSender,
    visible: input.visible !== false,
    mail_was_running: mailWasRunning,
    state: 'created_unsent_draft'
  }});
}
'''
    return run_osascript(script, input_json=payload, timeout_sec=timeout_sec)


def jxa_send_direct(payload: dict[str, Any], timeout_sec: int) -> dict[str, Any]:
    script = JXA_LIBRARY + r'''
var input = readInput();
var Mail = Application('Mail');
var to = normalizeAddresses(input.to);
if (to.length === 0) {
  JSON.stringify({status:'error', code:'E_RECIPIENT_REQUIRED', message:'At least one --to recipient is required', hint:'Pass --to recipient@example.com'});
} else {
  var msg = Mail.OutgoingMessage({subject: input.subject || '', content: input.body || '', visible: false});
  Mail.outgoingMessages.push(msg);
  to.forEach(function(addr) { msg.toRecipients.push(Mail.ToRecipient({address: addr})); });
  normalizeAddresses(input.cc).forEach(function(addr) { msg.ccRecipients.push(Mail.CcRecipient({address: addr})); });
  normalizeAddresses(input.bcc).forEach(function(addr) { msg.bccRecipients.push(Mail.BccRecipient({address: addr})); });
  if (input.sender) msg.sender = input.sender;
  var id = safe(function(){ return String(msg.id()); }, null);
  Mail.send(msg);
  JSON.stringify({sent: {id: id ? 'sent-attempt:' + id : null, backend:'mail-app', subject: input.subject || '', to: to, state:'send_requested'}});
}
'''
    return run_osascript(script, input_json=payload, timeout_sec=timeout_sec)


def jxa_set_message_state(mail_id: str, timeout_sec: int, *, scope: str, read: bool | None = None, flagged: bool | None = None) -> dict[str, Any]:
    script = JXA_LIBRARY + r'''
var input = readInput();
var target = String(input.id || '').replace(/^mail:/, '');
var Mail = Application('Mail');
function findInMessages(msgs) {
  for (var i = msgs.length - 1; i >= 0; i--) {
    var m = msgs[i];
    var id = safe(function(){ return String(m.id()); }, '');
    var mid = safe(function(){ return String(m.messageId()); }, '');
    if (id === target || mid === target) return m;
  }
  return null;
}
var found = null;
if (input.scope === 'selected') found = findInMessages(safe(function(){ return Mail.selection(); }, []));
if (!found) found = findInMessages(safe(function(){ return Mail.inbox().messages(); }, []));
if (!found) {
  JSON.stringify({status:'error', code:'E_MESSAGE_NOT_FOUND', message:'Message not found in Mail.app mutation scope', hint:'Use selected scope or a mail:<id> from recent/search.'});
} else {
  if (input.read !== null) found.readStatus = Boolean(input.read);
  if (input.flagged !== null) found.flaggedStatus = Boolean(input.flagged);
  JSON.stringify({message: msgSummary(found), changed: {read_status: input.read, flagged_status: input.flagged}});
}
'''
    return run_osascript(script, input_json={"id": mail_id, "scope": scope, "read": read, "flagged": flagged}, timeout_sec=timeout_sec)


def read_body_arg(args: argparse.Namespace) -> str:
    body = getattr(args, "body", None)
    body_file = getattr(args, "body_file", None)
    if body is not None and body_file is not None:
        raise CliError("E_BODY_AMBIGUOUS", "Pass either --body or --body-file, not both", "Use --body-file - to read from stdin.", EXIT_USAGE)
    if body_file:
        if body_file == "-":
            return sys.stdin.read()
        path = Path(body_file).expanduser()
        try:
            return path.read_text(encoding="utf-8")
        except OSError as exc:
            raise CliError("E_BODY_FILE_READ", f"Cannot read body file: {path}", "Check the path and permissions.", EXIT_USAGE) from exc
    if body is not None:
        return body
    raise CliError("E_BODY_REQUIRED", "Message body required", "Pass --body, --body-file PATH, or --body-file -.", EXIT_USAGE)


def parse_recipients(values: list[str] | None) -> list[str]:
    out: list[str] = []
    for value in values or []:
        for part in value.split(","):
            addr = part.strip()
            if addr:
                out.append(addr)
    return out


def mail_message_url(message_id: str | None) -> str | None:
    if not message_id:
        return None
    from urllib.parse import quote

    return "message://" + quote(message_id.strip(), safe="")


def header_value(headers: dict[str, Any], name: str) -> str | None:
    wanted = name.lower()
    for key, value in headers.items():
        if str(key).lower() == wanted:
            return str(value)
    return None


def apply_draft_link(draft: dict[str, Any], message_id: str | None, *, source: str, resolved_message: dict[str, Any] | None = None) -> None:
    draft["mail_url"] = mail_message_url(message_id)
    draft["links"] = {"mail": draft["mail_url"]} if draft["mail_url"] else {}
    draft["link_resolution"] = {
        "status": "resolved" if draft["mail_url"] else "unavailable",
        "source": source,
    }
    if resolved_message:
        draft["link_resolution"]["message"] = {
            "id": resolved_message.get("id"),
            "mailbox": resolved_message.get("mailbox"),
            "mailbox_url": resolved_message.get("mailbox_url"),
        }


def resolve_draft_link_from_index(args: argparse.Namespace, payload: dict[str, Any], draft: dict[str, Any], warnings: WarningSink) -> None:
    if draft.get("mail_url"):
        return
    subject = payload.get("subject") or ""
    recipients = [addr.lower() for addr in payload.get("to", []) if addr]
    sender = (payload.get("sender") or "").lower()
    try:
        store = make_store(args)
    except CliError as exc:
        draft["link_resolution"] = {"status": "unavailable", "source": "fast-index", "reason": exc.code}
        return

    last_error: str | None = None
    for attempt in range(8):
        try:
            candidates = store.search(query=subject or None, limit=50, date_from=None, date_to=None, mailbox="Draft", account_tokens=None)
        except CliError as exc:
            last_error = exc.code
            break
        for item in candidates:
            if (item.get("subject") or "") != subject:
                continue
            mailbox_text = f"{item.get('mailbox') or ''} {item.get('mailbox_url') or ''}".lower()
            if "draft" not in mailbox_text:
                continue
            try:
                full = store.get(str(item.get("rowid")), account_tokens=None)
            except CliError:
                continue
            headers = full.get("headers") or {}
            to_header = (header_value(headers, "To") or "").lower()
            from_header = (header_value(headers, "From") or "").lower()
            if recipients and not all(addr in to_header for addr in recipients):
                continue
            if sender and sender not in from_header:
                # Apple Mail may rewrite aliases/signatures; don't reject a
                # unique exact-subject+recipient match solely on From mismatch.
                pass
            message_id = header_value(headers, "Message-ID") or header_value(headers, "Message-Id")
            if message_id:
                draft["source_message_id"] = message_id
                apply_draft_link(draft, message_id, source="fast-index", resolved_message=full)
                return
        if attempt < 7:
            time.sleep(0.5)
    draft["mail_url"] = None
    draft["links"] = {}
    draft["link_resolution"] = {
        "status": "unavailable",
        "source": "fast-index",
        "reason": last_error or "draft_message_id_not_indexed_yet",
    }


def clean_email_address(raw: str | None) -> str | None:
    if not raw:
        return None
    _name, addr = parseaddr(raw)
    return (addr or raw).strip() or None


def gmail_client_file_candidates() -> list[Path]:
    raw = os.environ.get(GMAIL_CLIENT_FILE_ENV, "").strip()
    if raw:
        return [Path(raw).expanduser().resolve()]
    root = Path.home() / ".secrets" / "gmail"
    return [
        root / "client_secret.json",
        root / "oauth_client.json",
        root / "credentials.json",
    ]


def resolve_gmail_client_file() -> Path:
    candidates = gmail_client_file_candidates()
    for path in candidates:
        if path.exists():
            return path
    raise CliError(
        "E_GMAIL_CLIENT_SECRET_MISSING",
        "Gmail OAuth client file not found",
        f"Create an installed-app OAuth client JSON at {candidates[0]} or set {GMAIL_CLIENT_FILE_ENV} to a local client JSON path.",
        EXIT_AUTH,
    )


def load_gmail_client_config() -> dict[str, str]:
    path = resolve_gmail_client_file()
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise CliError(
            "E_GMAIL_CLIENT_SECRET_READ",
            f"Cannot read Gmail OAuth client file: {path}",
            "Check local secret file permissions.",
            EXIT_AUTH,
        ) from exc
    except json.JSONDecodeError as exc:
        raise CliError(
            "E_GMAIL_CLIENT_SECRET_JSON",
            f"Gmail OAuth client file is not valid JSON: {path}",
            "Download a valid OAuth client JSON from Google Cloud Console.",
            EXIT_AUTH,
        ) from exc

    cfg = raw.get("installed") or raw.get("web") or raw
    client_id = str(cfg.get("client_id") or "").strip()
    token_uri = str(cfg.get("token_uri") or "https://oauth2.googleapis.com/token").strip()
    auth_uri = str(cfg.get("auth_uri") or "https://accounts.google.com/o/oauth2/v2/auth").strip()
    client_secret = str(cfg.get("client_secret") or "").strip()
    if not client_id:
        raise CliError(
            "E_GMAIL_CLIENT_SECRET_INVALID",
            f"Gmail OAuth client file has no client_id: {path}",
            "Download an installed-app OAuth client JSON from Google Cloud Console.",
            EXIT_AUTH,
        )
    return {
        "path": str(path),
        "client_id": client_id,
        "client_secret": client_secret,
        "token_uri": token_uri,
        "auth_uri": auth_uri,
    }


def gmail_tokens_file_candidates() -> list[Path]:
    raw = os.environ.get(GMAIL_TOKENS_FILE_ENV, "").strip()
    if raw:
        return [Path(raw).expanduser().resolve()]
    return [Path.home() / ".secrets" / "gmail" / "tokens.json"]


def resolve_gmail_tokens_file(required: bool = False) -> Path | None:
    candidates = gmail_tokens_file_candidates()
    for path in candidates:
        if path.exists():
            return path
    if required:
        raise CliError(
            "E_GMAIL_TOKENS_FILE_MISSING",
            "Gmail token file not found",
            f"Run `~/GitHub/scripts/sync/keyvault-sync-gmail-secrets.sh --apply` or set {GMAIL_TOKENS_FILE_ENV} to a local tokens.json path.",
            EXIT_AUTH,
        )
    return None


def gmail_file_get_refresh_token(account: str) -> str | None:
    path = resolve_gmail_tokens_file(required=False)
    if not path:
        return None
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise CliError(
            "E_GMAIL_TOKENS_FILE_READ",
            f"Cannot read Gmail token file: {path}",
            "Check local secret file permissions or rerun keyvault-sync-gmail-secrets.",
            EXIT_AUTH,
        ) from exc
    except json.JSONDecodeError as exc:
        raise CliError(
            "E_GMAIL_TOKENS_FILE_JSON",
            f"Gmail token file is not valid JSON: {path}",
            "Rerun keyvault-sync-gmail-secrets to regenerate it from Key Vault.",
            EXIT_AUTH,
        ) from exc
    tokens = raw.get("tokens") if isinstance(raw, dict) else None
    if not isinstance(tokens, dict):
        return None
    value = tokens.get(account)
    token: str | None = None
    if isinstance(value, str):
        token = value
    elif isinstance(value, dict):
        token = value.get("refresh_token")
    token = str(token or "").strip()
    return token or None


def gmail_update_tokens_file(account: str, refresh_token: str) -> Path:
    path = resolve_gmail_tokens_file(required=False) or (Path.home() / ".secrets" / "gmail" / "tokens.json")
    data: dict[str, Any] = {"schemaVersion": 1, "tokens": {}}
    if path.exists():
        try:
            parsed = json.loads(path.read_text(encoding="utf-8"))
            if isinstance(parsed, dict):
                data.update(parsed)
        except (OSError, json.JSONDecodeError):
            # Keep the successful interactive OAuth result instead of failing
            # because a local cache file is corrupt. The Key Vault materializer
            # can restore canonical metadata later.
            data = {"schemaVersion": 1, "tokens": {}}
    tokens = data.get("tokens")
    if not isinstance(tokens, dict):
        tokens = {}
    tokens[account] = {"refresh_token": refresh_token, "source": "interactive-gmail-auth"}
    data["tokens"] = tokens
    data["updatedAt"] = utc_now()
    path.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(path, 0o600)
    return path


def gmail_refresh_token_with_source(account: str) -> tuple[str | None, str | None]:
    token = gmail_file_get_refresh_token(account)
    if token:
        path = resolve_gmail_tokens_file(required=False)
        return token, f"tokens_file:{path}" if path else "tokens_file"
    token = gmail_keychain_get_refresh_token(account)
    if token:
        return token, "keychain_cache"
    return None, None


def gmail_keychain_get_refresh_token(account: str) -> str | None:
    security = shutil.which("security")
    if not security:
        return None
    proc = subprocess.run(
        [security, "find-generic-password", "-s", GMAIL_KEYCHAIN_SERVICE, "-a", account, "-w"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    token = proc.stdout.strip()
    return token if proc.returncode == 0 and token else None


def gmail_keychain_has_refresh_token(account: str) -> bool:
    return gmail_keychain_get_refresh_token(account) is not None


def gmail_has_refresh_token(account: str) -> tuple[bool, str | None]:
    _token, source = gmail_refresh_token_with_source(account)
    return bool(_token), source


def gmail_keychain_set_refresh_token(account: str, refresh_token: str) -> None:
    security = shutil.which("security")
    if not security:
        raise CliError(
            "E_KEYCHAIN_UNAVAILABLE",
            "macOS security command not found",
            "Run gmail-auth on macOS so the refresh token can be stored in Keychain.",
            EXIT_AUTH,
        )
    proc = subprocess.run(
        [security, "add-generic-password", "-U", "-s", GMAIL_KEYCHAIN_SERVICE, "-a", account, "-w", refresh_token],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "").strip()
        raise CliError(
            "E_KEYCHAIN_WRITE_FAILED",
            f"Could not store Gmail refresh token in Keychain for {account}",
            f"Check Keychain access. security output: {err[:200]}",
            EXIT_AUTH,
        )


def resolve_gmail_write_account(args: argparse.Namespace) -> str:
    raw = getattr(args, "gmail_account", None) or config_value(DEFAULT_ACCOUNT_ENV)
    account = clean_email_address(raw)
    if not account:
        raise CliError(
            "E_DEFAULT_ACCOUNT_REQUIRED",
            f"{DEFAULT_ACCOUNT_ENV} is required for Gmail API writes",
            f"Set {DEFAULT_ACCOUNT_ENV} in the workspace .env/static defaults, or pass --write-backend mail-app explicitly.",
            EXIT_USAGE,
        )
    return account


def resolve_write_backend(args: argparse.Namespace, warnings: WarningSink, payload: dict[str, Any]) -> dict[str, Any]:
    requested = getattr(args, "write_backend", "auto")
    if requested not in {"auto", "gmail-api", "mail-app"}:
        raise CliError("E_WRITE_BACKEND_UNSUPPORTED", f"Unsupported write backend: {requested}", "Use --write-backend auto, gmail-api, or mail-app.", EXIT_USAGE)
    if requested == "mail-app":
        return {"backend": "mail-app", "requested_backend": requested, "gmail_account": None}

    if requested == "gmail-api":
        return {"backend": "gmail-api", "requested_backend": requested, "gmail_account": resolve_gmail_write_account(args)}

    # Auto is intentionally conservative for Adi's workspace: if a default
    # account exists, writes go through the account's Gmail API token instead
    # of waking Mail.app. If no default account is configured (e.g. old tests or
    # one-off local runs), keep the legacy Mail.app path but make it explicit.
    raw_account = config_value(DEFAULT_ACCOUNT_ENV)
    if raw_account and raw_account.strip():
        return {"backend": "gmail-api", "requested_backend": requested, "gmail_account": resolve_gmail_write_account(args)}
    warnings.warn(
        "W_WRITE_BACKEND_MAIL_APP_AUTO",
        "No default account configured; auto write backend is Mail.app.",
        f"Set {DEFAULT_ACCOUNT_ENV} to use Gmail API writes by default, or pass --write-backend gmail-api.",
        backend="mail-app",
    )
    return {"backend": "mail-app", "requested_backend": requested, "gmail_account": None}


def gmail_form_post(url: str, fields: dict[str, str], timeout_sec: int) -> dict[str, Any]:
    data = urllib.parse.urlencode(fields).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout_sec) as resp:
            body = resp.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        message = body
        with contextlib.suppress(Exception):
            parsed = json.loads(body)
            message = parsed.get("error_description") or parsed.get("error") or body
        raise CliError(
            "E_GMAIL_OAUTH_HTTP",
            f"Gmail OAuth token exchange failed ({exc.code}): {message}",
            "Check the OAuth client JSON and re-run gmail-auth.",
            EXIT_AUTH,
        ) from exc
    except urllib.error.URLError as exc:
        raise CliError(
            "E_GMAIL_OAUTH_NETWORK",
            f"Could not reach Google OAuth endpoint: {exc.reason}",
            "Check network connectivity and retry.",
            EXIT_TIMEOUT,
            retryable=True,
        ) from exc
    try:
        parsed = json.loads(body)
    except json.JSONDecodeError as exc:
        raise CliError("E_GMAIL_OAUTH_BAD_JSON", "Google OAuth returned non-JSON output", "Retry or inspect the OAuth client setup.", EXIT_AUTH) from exc
    if not isinstance(parsed, dict):
        raise CliError("E_GMAIL_OAUTH_BAD_JSON", "Google OAuth returned a non-object response", "Retry or inspect the OAuth client setup.", EXIT_AUTH)
    return parsed


def gmail_access_token(account: str, timeout_sec: int) -> str:
    cfg = load_gmail_client_config()
    refresh_token, token_source = gmail_refresh_token_with_source(account)
    if not refresh_token:
        raise CliError(
            "E_GMAIL_AUTH_NOT_CONFIGURED",
            f"No Gmail refresh token is stored for {account}",
            f"Run `~/GitHub/scripts/sync/keyvault-sync-gmail-secrets.sh --apply`, or run `dobby-mail gmail-auth --account {account}` once and update Key Vault.",
            EXIT_AUTH,
        )
    fields = {
        "client_id": cfg["client_id"],
        "refresh_token": refresh_token,
        "grant_type": "refresh_token",
    }
    if cfg.get("client_secret"):
        fields["client_secret"] = cfg["client_secret"]
    token = gmail_form_post(cfg["token_uri"], fields, timeout_sec)
    access = str(token.get("access_token") or "").strip()
    if not access:
        raise CliError(
            "E_GMAIL_ACCESS_TOKEN_MISSING",
            f"Google did not return an access token for {account}",
            "Re-run gmail-auth for this account.",
            EXIT_AUTH,
        )
    return access


def gmail_api_request(account: str, method: str, path: str, body: dict[str, Any] | None, timeout_sec: int) -> dict[str, Any]:
    access_token = gmail_access_token(account, timeout_sec)
    url = "https://gmail.googleapis.com/gmail/v1/users/me/" + path.lstrip("/")
    data = json.dumps(body or {}, ensure_ascii=False).encode("utf-8") if body is not None else None
    req = urllib.request.Request(
        url,
        data=data,
        headers={
            "Authorization": f"Bearer {access_token}",
            "Content-Type": "application/json",
            "Accept": "application/json",
        },
        method=method,
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout_sec) as resp:
            raw = resp.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode("utf-8", errors="replace")
        message = raw
        status = None
        with contextlib.suppress(Exception):
            parsed = json.loads(raw)
            err = parsed.get("error") or {}
            if isinstance(err, dict):
                message = err.get("message") or raw
                status = err.get("status")
        code = "E_GMAIL_API_AUTH" if exc.code in {401, 403} else "E_GMAIL_API_ERROR"
        hint = (
            "Re-run gmail-auth and make sure Gmail API is enabled for the OAuth client."
            if code == "E_GMAIL_API_AUTH"
            else "Check recipients, sender alias/send-as settings, and Gmail API status."
        )
        raise CliError(
            code,
            f"Gmail API request failed ({exc.code}{', ' + status if status else ''}): {message}",
            hint,
            EXIT_AUTH if code == "E_GMAIL_API_AUTH" else EXIT_FAILURE,
        ) from exc
    except urllib.error.URLError as exc:
        raise CliError(
            "E_GMAIL_API_NETWORK",
            f"Could not reach Gmail API: {exc.reason}",
            "Check network connectivity and retry.",
            EXIT_TIMEOUT,
            retryable=True,
        ) from exc
    if not raw:
        return {}
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise CliError("E_GMAIL_API_BAD_JSON", "Gmail API returned non-JSON output", "Retry or inspect Gmail API status.", EXIT_FAILURE) from exc
    if not isinstance(parsed, dict):
        raise CliError("E_GMAIL_API_BAD_JSON", "Gmail API returned a non-object response", "Retry or inspect Gmail API status.", EXIT_FAILURE)
    return parsed


def build_gmail_raw_message(payload: dict[str, Any]) -> tuple[str, str]:
    msg = EmailMessage()
    sender = payload.get("sender") or ""
    msg["From"] = sender
    msg["To"] = ", ".join(payload.get("to") or [])
    if payload.get("cc"):
        msg["Cc"] = ", ".join(payload["cc"])
    if payload.get("bcc"):
        msg["Bcc"] = ", ".join(payload["bcc"])
    msg["Subject"] = payload.get("subject") or ""
    msg["Date"] = formatdate(localtime=False)
    if payload.get("in_reply_to"):
        msg["In-Reply-To"] = str(payload["in_reply_to"])
    if payload.get("references"):
        refs = payload["references"]
        msg["References"] = " ".join(str(item) for item in refs) if isinstance(refs, list) else str(refs)
    domain = clean_email_address(sender)
    domain = domain.split("@", 1)[1] if domain and "@" in domain else None
    message_id = make_msgid(domain=domain)
    msg["Message-ID"] = message_id
    msg.set_content(payload.get("body") or "")
    raw = base64.urlsafe_b64encode(msg.as_bytes(policy=policy.SMTP)).decode("ascii")
    return raw, message_id


def gmail_drafts_url(account: str) -> str:
    return "https://mail.google.com/mail/u/" + urllib.parse.quote(account, safe="") + "/#drafts"


def gmail_create_draft(account: str, payload: dict[str, Any], timeout_sec: int) -> dict[str, Any]:
    raw, message_id = build_gmail_raw_message(payload)
    result = gmail_api_request(account, "POST", "drafts", {"message": {"raw": raw}}, timeout_sec)
    message = result.get("message") if isinstance(result.get("message"), dict) else {}
    draft_id = result.get("id")
    draft = {
        "id": f"gmail-draft:{draft_id}" if draft_id else None,
        "backend": "gmail-api",
        "gmail_account": account,
        "gmail_draft_id": draft_id,
        "gmail_message_id": message.get("id"),
        "gmail_thread_id": message.get("threadId"),
        "source_message_id": message_id,
        "subject": payload.get("subject") or "",
        "to": payload.get("to") or [],
        "cc": payload.get("cc") or [],
        "bcc_count": len(payload.get("bcc") or []),
        "requested_sender": payload.get("sender"),
        "sender": payload.get("sender"),
        "visible": False,
        "state": "created_unsent_draft",
        "mail_url": mail_message_url(message_id),
        "links": {
            "gmail_drafts": gmail_drafts_url(account),
            "mail": mail_message_url(message_id),
        },
        "link_resolution": {
            "status": "drafts_mailbox",
            "source": "gmail-api",
            "reason": "Gmail API returns a draft id but no universal draft deep link; open Gmail drafts or use message:// after local Mail sync.",
        },
    }
    return {"draft": draft}


def gmail_send_direct(account: str, payload: dict[str, Any], timeout_sec: int) -> dict[str, Any]:
    raw, message_id = build_gmail_raw_message(payload)
    result = gmail_api_request(account, "POST", "messages/send", {"raw": raw}, timeout_sec)
    sent = {
        "id": f"gmail-message:{result.get('id')}" if result.get("id") else None,
        "backend": "gmail-api",
        "gmail_account": account,
        "gmail_message_id": result.get("id"),
        "gmail_thread_id": result.get("threadId"),
        "source_message_id": message_id,
        "subject": payload.get("subject") or "",
        "to": payload.get("to") or [],
        "sender": payload.get("sender"),
        "state": "sent",
    }
    return {"sent": sent}


class _GmailOAuthCallbackHandler(http.server.BaseHTTPRequestHandler):
    server_version = "DobbyMailOAuth/1.0"

    def log_message(self, fmt: str, *args: Any) -> None:  # silence stdlib access log
        return

    def do_GET(self) -> None:  # noqa: N802 - stdlib naming
        parsed = urllib.parse.urlparse(self.path)
        params = urllib.parse.parse_qs(parsed.query)
        expected_state = getattr(self.server, "oauth_state", None)  # type: ignore[attr-defined]
        actual_state = (params.get("state") or [None])[0]
        if expected_state and actual_state != expected_state:
            self.server.oauth_error = "state_mismatch"  # type: ignore[attr-defined]
            self.server.oauth_code = None  # type: ignore[attr-defined]
        else:
            self.server.oauth_code = (params.get("code") or [None])[0]  # type: ignore[attr-defined]
        self.server.oauth_error = (params.get("error") or [None])[0]  # type: ignore[attr-defined]
        if self.server.oauth_code:  # type: ignore[attr-defined]
            body = b"OAuth complete. You can close this tab and return to Dobby."
            self.send_response(200)
        else:
            body = b"OAuth failed or was denied. Return to Dobby for details."
            self.send_response(400)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def command_gmail_auth(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    if getattr(args, "no_input", False):
        raise CliError(
            "E_GMAIL_AUTH_INTERACTIVE",
            "gmail-auth requires a browser consent click and cannot run with --no-input",
            f"Run `dobby-mail gmail-auth --account {args.account or config_value(DEFAULT_ACCOUNT_ENV) or '<email>'}` interactively once.",
            EXIT_USAGE,
        )
    account = clean_email_address(args.account or config_value(DEFAULT_ACCOUNT_ENV))
    if not account:
        raise CliError(
            "E_DEFAULT_ACCOUNT_REQUIRED",
            f"{DEFAULT_ACCOUNT_ENV} or --account is required for gmail-auth",
            f"Run `dobby-mail gmail-auth --account you@example.com`.",
            EXIT_USAGE,
        )
    cfg = load_gmail_client_config()
    state = "dobby-mail-" + uuid.uuid4().hex
    timeout = int(getattr(args, "timeout_sec", 300) or 300)
    with socketserver.TCPServer(("127.0.0.1", 0), _GmailOAuthCallbackHandler) as server:
        server.timeout = timeout
        server.oauth_code = None  # type: ignore[attr-defined]
        server.oauth_error = None  # type: ignore[attr-defined]
        server.oauth_state = state  # type: ignore[attr-defined]
        host, port = server.server_address
        redirect_uri = f"http://localhost:{port}/"
        query = urllib.parse.urlencode(
            {
                "client_id": cfg["client_id"],
                "redirect_uri": redirect_uri,
                "response_type": "code",
                "scope": " ".join(GMAIL_SCOPES),
                "access_type": "offline",
                "prompt": "select_account consent",
                "state": state,
                "login_hint": account,
            }
        )
        auth_url = cfg["auth_uri"] + "?" + query
        print(f"[dobby-mail] Open this Gmail OAuth URL if the browser does not open automatically:\n{auth_url}", file=sys.stderr)
        if not getattr(args, "no_browser", False):
            with contextlib.suppress(Exception):
                webbrowser.open(auth_url)
        server.handle_request()
        if server.oauth_error:  # type: ignore[attr-defined]
            raise CliError("E_GMAIL_AUTH_DENIED", f"Gmail OAuth was denied: {server.oauth_error}", "Re-run gmail-auth and approve Gmail access.", EXIT_AUTH)
        code = server.oauth_code  # type: ignore[attr-defined]
    if not code:
        raise CliError(
            "E_GMAIL_AUTH_TIMEOUT",
            "Timed out waiting for Gmail OAuth callback",
            "Re-run gmail-auth and complete the browser consent flow.",
            EXIT_TIMEOUT,
            retryable=True,
        )
    fields = {
        "client_id": cfg["client_id"],
        "code": str(code),
        "grant_type": "authorization_code",
        "redirect_uri": redirect_uri,
    }
    if cfg.get("client_secret"):
        fields["client_secret"] = cfg["client_secret"]
    token = gmail_form_post(cfg["token_uri"], fields, timeout)
    refresh = str(token.get("refresh_token") or "").strip()
    if not refresh:
        raise CliError(
            "E_GMAIL_REFRESH_TOKEN_MISSING",
            "Google did not return a refresh token",
            "Re-run gmail-auth. If you previously approved this app, revoke it in Google Account access first or keep prompt=consent.",
            EXIT_AUTH,
        )
    tokens_path = gmail_update_tokens_file(account, refresh)
    return {
        "backend": "gmail-api",
        "account": account,
        "stored_refresh_token": "tokens_file",
        "tokens_file": str(tokens_path),
        "scopes": GMAIL_SCOPES,
        "client_file": cfg["path"],
        "canonical_source": "Azure Key Vault via ~/GitHub/scripts/sync/keyvault-sync-gmail-secrets.sh",
        "warnings": warnings.items,
    }


def make_store(args: argparse.Namespace) -> FastMailStore:
    root = resolve_mail_root(getattr(args, "mail_root", None))
    index = resolve_index_path(root, getattr(args, "index_path", None))
    return FastMailStore(root, index)


def run_with_fallback(args: argparse.Namespace, warnings: WarningSink, op_name: str, fast_fn, app_fn):
    requested = getattr(args, "backend", "auto")
    allow_fallback = requested == "auto" and not getattr(args, "no_fallback", False)
    if requested in {"auto", "fast"}:
        try:
            result = fast_fn()
            return "fast", False, result
        except CliError as exc:
            if requested == "fast" or not allow_fallback:
                raise
            warnings.warn(
                exc.code,
                f"Fast Apple Mail read path failed for {op_name}; falling back to Mail.app automation explicitly.",
                exc.hint,
                backend="fast",
            )
    if requested in {"auto", "mail-app"}:
        result = app_fn()
        return "mail-app", requested == "auto", result
    raise CliError("E_BACKEND_UNSUPPORTED", f"Unsupported backend: {requested}", "Use --backend auto, fast, or mail-app.", EXIT_USAGE)


def command_doctor(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    checks: list[dict[str, Any]] = []

    def add(name: str, status: str, message: str, hint: str | None = None, details: dict[str, Any] | None = None):
        checks.append({"name": name, "status": status, "message": message, "hint": hint, "details": details or {}})

    add("platform", "ok" if platform.system() == "Darwin" else "warn", platform.platform(), "Apple Mail backend requires macOS." if platform.system() != "Darwin" else None)
    mail_app = Path("/System/Applications/Mail.app")
    add("mail_app", "ok" if mail_app.exists() else "error", str(mail_app), "Install/restore Apple Mail.app." if not mail_app.exists() else None)
    osascript = os.environ.get("DOBBY_MAIL_OSASCRIPT") or shutil.which("osascript")
    add("osascript", "ok" if osascript else "error", osascript or "not found", "Install macOS osascript." if not osascript else None)

    mail_root = resolve_mail_root(args.mail_root)
    try:
        version_root = find_mail_version_root(mail_root)
        add("mail_root", "ok", str(version_root), details={"mail_root": str(mail_root)})
    except CliError as exc:
        add("mail_root", "error" if exc.exit_code != EXIT_AUTH else "warn", exc.message, exc.hint, {"mail_root": str(mail_root), "code": exc.code})
        version_root = None

    index_path: Path | None = None
    try:
        index_path = resolve_index_path(mail_root, args.index_path)
        add("envelope_index_path", "ok" if index_path.exists() else "warn", str(index_path), "Grant Full Disk Access or allow Mail.app fallback." if not index_path.exists() else None)
    except CliError as exc:
        add("envelope_index_path", "warn", exc.message, exc.hint, {"code": exc.code})

    if index_path:
        try:
            store = FastMailStore(mail_root, index_path)
            tables = sorted(store.tables())
            add("fast_backend", "ok", "Envelope Index opened read-only", details={"tables_sample": tables[:20]})
        except CliError as exc:
            add("fast_backend", "warn", exc.message, exc.hint, {"code": exc.code})

    if args.check_mail_app:
        try:
            result = jxa_accounts(args.timeout_sec)
            add("mail_app_automation", "ok", f"Read {len(result.get('accounts', []))} accounts via Mail.app")
        except CliError as exc:
            add("mail_app_automation", "warn" if exc.exit_code in {EXIT_AUTH, EXIT_DEP, EXIT_TIMEOUT} else "error", exc.message, exc.hint, {"code": exc.code})
    else:
        add("mail_app_automation", "skipped", "Pass --check-mail-app to test live Mail.app automation; this may launch Mail.app.")

    gmail_account = clean_email_address(config_value(DEFAULT_ACCOUNT_ENV))
    try:
        cfg = load_gmail_client_config()
        add("gmail_oauth_client", "ok", cfg["path"], details={"scopes": GMAIL_SCOPES})
    except CliError as exc:
        add("gmail_oauth_client", "warn", exc.message, exc.hint, {"code": exc.code})
        cfg = None
    if gmail_account:
        has_token, token_source = gmail_has_refresh_token(gmail_account)
        add(
            "gmail_refresh_token",
            "ok" if has_token else "warn",
            f"Refresh token {'found' if has_token else 'not found'} for {gmail_account}",
            f"Run `~/GitHub/scripts/sync/keyvault-sync-gmail-secrets.sh --apply`, or run `dobby-mail gmail-auth --account {gmail_account}` once." if not has_token else None,
            {
                "account": gmail_account,
                "source": token_source,
                "tokens_file": str(resolve_gmail_tokens_file(required=False)) if resolve_gmail_tokens_file(required=False) else None,
                "keychain_service": GMAIL_KEYCHAIN_SERVICE,
            },
        )
        if getattr(args, "check_gmail_api", False) and cfg and has_token:
            try:
                gmail_access_token(gmail_account, args.timeout_sec)
                add("gmail_api_write_backend", "ok", f"Access token refresh succeeded for {gmail_account}")
            except CliError as exc:
                add("gmail_api_write_backend", "warn" if exc.exit_code in {EXIT_AUTH, EXIT_TIMEOUT} else "error", exc.message, exc.hint, {"code": exc.code})
        elif getattr(args, "check_gmail_api", False):
            reason = "oauth_client_missing" if not cfg else "refresh_token_missing"
            add("gmail_api_write_backend", "skipped", f"Cannot test Gmail API write backend: {reason}", "Fix the Gmail OAuth client/token checks above, then re-run doctor --check-gmail-api.")
        elif not getattr(args, "check_gmail_api", False):
            add("gmail_api_write_backend", "skipped", "Pass --check-gmail-api to test token refresh; no mail is read or written.")
    else:
        add("gmail_refresh_token", "skipped", f"No {DEFAULT_ACCOUNT_ENV} configured for Gmail write account.")

    statuses = {c["status"] for c in checks}
    selected = "fast" if any(c["name"] == "fast_backend" and c["status"] == "ok" for c in checks) else "mail-app"
    summary = "needs_attention" if "error" in statuses else ("degraded" if "warn" in statuses else "ok")
    return {
        "selected_backend": selected,
        "checks": checks,
        "summary": summary,
        "warnings": warnings.items,
    }


def command_accounts(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    result = jxa_accounts(args.timeout_sec)
    return {"backend": "mail-app", "accounts": result.get("accounts", []), "warnings": warnings.items}


def command_mailboxes(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    limit = clamp_limit(args.limit)
    account_scope = resolve_account_scope(args, warnings)
    backend, fallback, result = run_with_fallback(
        args,
        warnings,
        "mailboxes",
        lambda: {"mailboxes": make_store(args).mailboxes(limit=limit, account_tokens=account_scope["tokens"])},
        lambda: jxa_mailboxes(args.timeout_sec, limit, account=account_scope.get("configured")),
    )
    return {"backend": backend, "requested_backend": args.backend, "fallback_used": fallback, "account_scope": public_account_scope(account_scope), "mailboxes": result.get("mailboxes", []), "warnings": warnings.items}


def command_search(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    limit = clamp_limit(args.limit)
    account_scope = resolve_account_scope(args, warnings)
    backend, fallback, result = run_with_fallback(
        args,
        warnings,
        "search",
        lambda: {"messages": make_store(args).search(query=args.query, limit=limit, date_from=args.date_from, date_to=args.date_to, mailbox=args.mailbox, account_tokens=account_scope["tokens"])},
        lambda: jxa_search(args.query, limit, args.timeout_sec, scope=args.scope, account=account_scope.get("configured")),
    )
    return {
        "backend": backend,
        "requested_backend": args.backend,
        "fallback_used": fallback,
        "account_scope": public_account_scope(account_scope),
        "query": args.query,
        "messages": result.get("messages", []),
        "warnings": warnings.items,
    }


def command_recent(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    args.query = None
    return command_search(args, warnings)


def normalize_message_id(raw: str) -> tuple[str, str]:
    if ":" in raw:
        kind, value = raw.split(":", 1)
        return kind, value
    return "fast", raw


def command_get(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    kind, value = normalize_message_id(args.id)
    max_body_chars = args.max_body_chars
    account_scope = resolve_account_scope(args, warnings)

    def fast_get() -> dict[str, Any]:
        if kind not in {"fast", "rowid"}:
            raise CliError("E_FAST_ID_UNSUPPORTED", f"Fast backend cannot get id kind {kind}", "Use a fast:<rowid> id from search/recent, or --backend mail-app for mail:<id>.", EXIT_USAGE)
        return {"message": make_store(args).get(value, account_tokens=account_scope["tokens"])}

    def app_get() -> dict[str, Any]:
        return jxa_get(value if kind != "mail" else value, args.timeout_sec, scope=args.scope, max_body_chars=max_body_chars, account=account_scope.get("configured"))

    backend, fallback, result = run_with_fallback(args, warnings, "get", fast_get, app_get)
    msg = result.get("message")
    if msg and max_body_chars is not None:
        for field in ["body_text", "body_html"]:
            if isinstance(msg.get(field), str) and len(msg[field]) > max_body_chars:
                msg[field] = msg[field][: max_body_chars - 1] + "…"
    return {"backend": backend, "requested_backend": args.backend, "fallback_used": fallback, "account_scope": public_account_scope(account_scope), "message": msg, "warnings": warnings.items}


def draft_payload_from_args(args: argparse.Namespace) -> dict[str, Any]:
    body = read_body_arg(args)
    to = parse_recipients(args.to)
    cc = parse_recipients(args.cc)
    bcc = parse_recipients(args.bcc)
    if not to:
        raise CliError("E_RECIPIENT_REQUIRED", "At least one --to recipient is required", "Pass --to recipient@example.com.", EXIT_USAGE)
    return {
        "to": to,
        "cc": cc,
        "bcc": bcc,
        "subject": args.subject or "",
        "body": body,
        "sender": resolve_sender(args.sender),
        "visible": False,
    }


def command_draft(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    payload = draft_payload_from_args(args)
    write = resolve_write_backend(args, warnings, payload)
    if args.dry_run:
        return {
            "backend": write["backend"],
            "requested_backend": write["requested_backend"],
            "gmail_account": write.get("gmail_account"),
            "dry_run": True,
            "draft": {
                "state": "would_create_unsent_draft",
                "to": payload["to"],
                "cc": payload["cc"],
                "bcc_count": len(payload["bcc"]),
                "subject": payload["subject"],
                "sender": payload["sender"],
                "visible": payload["visible"],
                "body_preview": clean_text(payload["body"], 500),
            },
            "warnings": warnings.items,
        }
    if write["backend"] == "gmail-api":
        result = gmail_create_draft(write["gmail_account"], payload, args.timeout_sec)
        return {"backend": "gmail-api", "requested_backend": write["requested_backend"], "gmail_account": write["gmail_account"], "dry_run": False, "draft": result.get("draft"), "warnings": warnings.items}
    validate_sender_for_default_account(args, payload["sender"])
    result = jxa_create_draft(payload, args.timeout_sec)
    draft = result.get("draft") or {}
    if draft.get("sender") and payload["sender"].lower() not in str(draft.get("sender")).lower():
        raise CliError(
            "E_SENDER_MISMATCH",
            f"Apple Mail created the draft with a different sender: {draft.get('sender')}",
            f"Check Apple Mail account aliases. Expected sender: {payload['sender']}.",
            EXIT_FAILURE,
        )
    apply_draft_link(draft, draft.get("source_message_id"), source="mail-app")
    resolve_draft_link_from_index(args, payload, draft, warnings)
    return {"backend": "mail-app", "requested_backend": write["requested_backend"], "dry_run": False, "draft": draft, "warnings": warnings.items}


def command_draft_reply(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    # Safe v1 behavior: create an unsent draft addressed to the original sender.
    # This does not mutate/send and does not rely on fragile native reply scripting.
    body = read_body_arg(args)
    get_args = argparse.Namespace(**vars(args))
    get_args.backend = args.read_backend
    get_args.no_fallback = args.no_fallback
    get_args.max_body_chars = 0
    data = command_get(get_args, warnings)
    msg = data.get("message") or {}
    sender_name, sender_addr = parseaddr(msg.get("sender") or "")
    recipient = args.to or ([sender_addr] if sender_addr else [])
    subject = args.subject or (msg.get("subject") or "")
    if subject and not subject.lower().startswith("re:"):
        subject = "Re: " + subject
    payload = {
        "to": parse_recipients(recipient),
        "cc": parse_recipients(args.cc),
        "bcc": parse_recipients(args.bcc),
        "subject": subject,
        "body": body,
        "sender": resolve_sender(args.sender),
        "visible": False,
        "in_reply_to": msg.get("source_message_id"),
        "references": [msg.get("source_message_id")] if msg.get("source_message_id") else [],
    }
    if not payload["to"]:
        raise CliError("E_REPLY_RECIPIENT_UNAVAILABLE", "Could not infer reply recipient", "Pass --to explicitly.", EXIT_USAGE)
    write = resolve_write_backend(args, warnings, payload)
    if args.dry_run:
        draft = {
            "state": "would_create_unsent_reply_draft",
            "to": payload["to"],
            "cc": payload["cc"],
            "bcc_count": len(payload["bcc"]),
            "subject": payload["subject"],
            "visible": payload["visible"],
            "body_preview": clean_text(payload["body"], 500),
            "sender": payload["sender"],
            "reply_to": {"id": args.id, "sender": msg.get("sender"), "source_message_id": msg.get("source_message_id")},
            "threading_supported": bool(payload.get("in_reply_to")) if write["backend"] == "gmail-api" else False,
        }
    else:
        if write["backend"] == "gmail-api":
            result = gmail_create_draft(write["gmail_account"], payload, args.timeout_sec)
            draft = result.get("draft") or {}
            draft["reply_to"] = {"id": args.id, "sender": msg.get("sender"), "source_message_id": msg.get("source_message_id")}
            draft["threading_supported"] = bool(msg.get("source_message_id"))
            warnings.warn(
                "W_REPLY_DRAFT_THREADING_NOT_VERIFIED",
                "Gmail draft-reply adds reply headers when the source Message-ID is available, but it does not yet resolve Gmail threadId.",
                "Inspect the draft before sending if exact thread placement matters.",
                backend="gmail-api",
            )
            return {"backend": "gmail-api", "requested_backend": write["requested_backend"], "gmail_account": write["gmail_account"], "read_backend": data.get("backend"), "dry_run": False, "draft": draft, "warnings": warnings.items}
        validate_sender_for_default_account(args, payload["sender"])
        result = jxa_create_draft(payload, args.timeout_sec)
        draft = result.get("draft") or {}
        if draft.get("sender") and payload["sender"].lower() not in str(draft.get("sender")).lower():
            raise CliError(
                "E_SENDER_MISMATCH",
                f"Apple Mail created the draft with a different sender: {draft.get('sender')}",
                f"Check Apple Mail account aliases. Expected sender: {payload['sender']}.",
                EXIT_FAILURE,
            )
        apply_draft_link(draft, draft.get("source_message_id"), source="mail-app")
        resolve_draft_link_from_index(args, payload, draft, warnings)
        draft["reply_to"] = {"id": args.id, "sender": msg.get("sender"), "source_message_id": msg.get("source_message_id")}
        draft["threading_supported"] = False
    if write["backend"] == "gmail-api":
        warnings.warn(
            "W_REPLY_DRAFT_THREADING_NOT_VERIFIED",
            "Gmail draft-reply adds reply headers when the source Message-ID is available, but it does not yet resolve Gmail threadId.",
            "Inspect the draft before sending if exact thread placement matters.",
            backend="gmail-api",
        )
    else:
        warnings.warn(
            "W_REPLY_DRAFT_NOT_NATIVE_THREADED",
            "draft-reply creates an unsent addressed draft; it does not yet use Mail.app's native reply command/thread headers.",
            "Inspect the draft in Apple Mail before sending. Native reply can be added later if needed.",
            backend="mail-app",
        )
    return {"backend": write["backend"], "requested_backend": write["requested_backend"], "gmail_account": write.get("gmail_account"), "read_backend": data.get("backend"), "dry_run": bool(args.dry_run), "draft": draft, "warnings": warnings.items}


def command_send(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    payload = draft_payload_from_args(args)
    if not args.confirm_send:
        raise CliError(
            "E_SEND_CONFIRMATION_REQUIRED",
            "Sending email requires --confirm-send",
            "Prefer `dobby-mail draft` first. Only pass --confirm-send after the user explicitly approves recipients and body.",
            EXIT_USAGE,
        )
    write = resolve_write_backend(args, warnings, payload)
    if args.dry_run:
        return {
            "backend": write["backend"],
            "requested_backend": write["requested_backend"],
            "gmail_account": write.get("gmail_account"),
            "dry_run": True,
            "sent": {
                "state": "would_send",
                "to": payload["to"],
                "cc": payload["cc"],
                "bcc_count": len(payload["bcc"]),
                "subject": payload["subject"],
                "sender": payload["sender"],
                "body_preview": clean_text(payload["body"], 500),
            },
            "warnings": warnings.items,
        }
    if write["backend"] == "gmail-api":
        result = gmail_send_direct(write["gmail_account"], payload, args.timeout_sec)
        return {"backend": "gmail-api", "requested_backend": write["requested_backend"], "gmail_account": write["gmail_account"], "dry_run": False, "sent": result.get("sent"), "warnings": warnings.items}
    validate_sender_for_default_account(args, payload["sender"])
    result = jxa_send_direct(payload, args.timeout_sec)
    return {"backend": "mail-app", "requested_backend": write["requested_backend"], "dry_run": False, "sent": result.get("sent"), "warnings": warnings.items}


def command_selected(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    limit = clamp_limit(args.limit)
    result = jxa_search(args.query, limit, args.timeout_sec, scope="selected")
    return {"backend": "mail-app", "scope": "selected", "messages": result.get("messages", []), "warnings": warnings.items}


def command_setup(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    opened = open_full_disk_access_settings() if args.open_settings else False
    checks = command_doctor(args, warnings)
    return {
        "summary": checks.get("summary"),
        "selected_backend": checks.get("selected_backend"),
        "opened_settings": opened,
        "process_chain": process_chain(),
        "required_access": [
            {
                "permission": "Full Disk Access",
                "targets": recommended_access_targets(),
                "why": "Needed for fast read-only Apple Mail Envelope Index + .emlx access.",
                "status": "ok" if checks.get("selected_backend") == "fast" else "needed",
            },
            {
                "permission": "Automation: control Mail.app",
                "targets": recommended_access_targets(),
                "why": "Needed for Mail.app fallback reads and draft/send/write actions.",
                "status": "ok" if any(c["name"] == "mail_app_automation" and c["status"] == "ok" for c in checks.get("checks", [])) else "check_with_doctor",
            },
        ],
        "checks": checks.get("checks", []),
        "warnings": warnings.items,
    }


def command_mark_read(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    if not args.confirm_mark:
        raise CliError("E_MARK_CONFIRMATION_REQUIRED", "Marking email read/unread requires --confirm-mark", "Only pass --confirm-mark after the user explicitly approves this mailbox state change.", EXIT_USAGE)
    kind, value = normalize_message_id(args.id)
    if args.dry_run:
        return {
            "backend": "mail-app",
            "dry_run": True,
            "changed": {"id": args.id, "read_status": args.read},
            "warnings": warnings.items,
        }
    result = jxa_set_message_state(value if kind != "mail" else value, args.timeout_sec, scope=args.scope, read=args.read)
    return {"backend": "mail-app", "dry_run": False, "message": result.get("message"), "changed": result.get("changed"), "warnings": warnings.items}


def command_flag(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    if not args.confirm_flag:
        raise CliError("E_FLAG_CONFIRMATION_REQUIRED", "Flagging/unflagging email requires --confirm-flag", "Only pass --confirm-flag after the user explicitly approves this mailbox state change.", EXIT_USAGE)
    kind, value = normalize_message_id(args.id)
    flagged = not args.clear
    if args.dry_run:
        return {
            "backend": "mail-app",
            "dry_run": True,
            "changed": {"id": args.id, "flagged_status": flagged},
            "warnings": warnings.items,
        }
    result = jxa_set_message_state(value if kind != "mail" else value, args.timeout_sec, scope=args.scope, flagged=flagged)
    return {"backend": "mail-app", "dry_run": False, "message": result.get("message"), "changed": result.get("changed"), "warnings": warnings.items}


def command_export(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    kind, value = normalize_message_id(args.id)
    if kind not in {"fast", "rowid"}:
        raise CliError("E_EXPORT_FAST_ONLY", "export currently requires a fast:<rowid> id", "Use search/recent with the fast backend first.", EXIT_USAGE)
    account_scope = resolve_account_scope(args, warnings)
    out_dir = Path(args.out_dir).expanduser().resolve()
    item, emlx = make_store(args).get_emlx_for_rowid(value, account_tokens=account_scope["tokens"])
    parsed = parse_emlx(emlx)
    out_dir.mkdir(parents=True, exist_ok=True)
    written: list[dict[str, Any]] = []

    meta_path = out_dir / f"message-{value}.json"
    meta = {**item, **{k: parsed.get(k) for k in ["headers", "attachments", "raw_size_bytes", "emlx_path"]}}
    meta_path.write_text(json.dumps(meta, ensure_ascii=False, indent=2), encoding="utf-8")
    written.append({"kind": "metadata_json", "path": str(meta_path)})

    if parsed.get("body_text"):
        body_path = out_dir / f"message-{value}.txt"
        body_path.write_text(parsed["body_text"], encoding="utf-8")
        written.append({"kind": "body_text", "path": str(body_path)})
    if parsed.get("body_html"):
        html_path = out_dir / f"message-{value}.html"
        html_path.write_text(parsed["body_html"], encoding="utf-8")
        written.append({"kind": "body_html", "path": str(html_path)})
    if args.raw:
        raw_path = out_dir / f"message-{value}.eml"
        raw_path.write_bytes(read_raw_eml_from_emlx(emlx))
        written.append({"kind": "raw_eml", "path": str(raw_path)})
    return {"backend": "fast", "account_scope": public_account_scope(account_scope), "message": item, "out_dir": str(out_dir), "written": written, "warnings": warnings.items}


def command_attachments(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    kind, value = normalize_message_id(args.id)
    if kind not in {"fast", "rowid"}:
        raise CliError("E_ATTACHMENTS_FAST_ONLY", "attachments currently requires a fast:<rowid> id", "Use search/recent with the fast backend first.", EXIT_USAGE)
    account_scope = resolve_account_scope(args, warnings)
    out_dir = Path(args.out_dir).expanduser().resolve()
    item, emlx = make_store(args).get_emlx_for_rowid(value, account_tokens=account_scope["tokens"])
    saved = extract_emlx_attachments(emlx, out_dir)
    return {"backend": "fast", "account_scope": public_account_scope(account_scope), "message": item, "out_dir": str(out_dir), "attachments": saved, "warnings": warnings.items}


def add_common(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--json", action="store_true", help="Emit JSON output (default).")
    parser.add_argument("--plain", action="store_true", help="Emit stable plain text for operator inspection.")
    parser.add_argument("--no-input", action="store_true", help="Accepted for non-interactive agent safety; prompts are never used.")
    parser.add_argument("--quiet", action="store_true", help="Suppress fallback warnings on stderr; warnings remain in JSON.")
    parser.add_argument("--timeout-sec", type=int, default=30, help="Timeout for Mail.app automation calls.")


def add_backend(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--backend", choices=["auto", "fast", "mail-app"], default="auto", help="Read backend. auto tries fast local index then explicitly falls back to Mail.app.")
    parser.add_argument("--no-fallback", action="store_true", help="Do not fall back from fast path to Mail.app automation.")
    parser.add_argument("--mail-root", help="Apple Mail root. Defaults to ~/Library/Mail or DOBBY_MAIL_ROOT.")
    parser.add_argument("--index-path", help="Apple Mail Envelope Index path. Defaults to latest V*/MailData/Envelope Index or DOBBY_MAIL_INDEX.")


def add_account_scope(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--account", help=f"Read account email/name/id. Defaults to {DEFAULT_ACCOUNT_ENV}.")
    parser.add_argument("--all-accounts", action="store_true", help=f"Explicitly read all Apple Mail accounts instead of {DEFAULT_ACCOUNT_ENV}.")


def add_draft_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--to", action="append", help="Recipient address. Repeat or comma-separate.")
    parser.add_argument("--cc", action="append", help="CC address. Repeat or comma-separate.")
    parser.add_argument("--bcc", action="append", help="BCC address. Repeat or comma-separate.")
    parser.add_argument("--subject", required=False, help="Message subject.")
    parser.add_argument("--body", help="Message body text.")
    parser.add_argument("--body-file", help="Path to body text, or - for stdin.")
    parser.add_argument("--sender", help=f"Sender address. If omitted, {DEFAULT_FROM_ENV} is required.")
    parser.add_argument("--write-backend", choices=["auto", "gmail-api", "mail-app"], default="auto", help="Write backend. auto uses Gmail API when DOBBY_MAIL_DEFAULT_ACCOUNT is configured; otherwise Mail.app.")
    parser.add_argument("--dry-run", action="store_true", help="Return intended action without creating/sending anything.")


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Local Apple Mail/Gmail write client for Dobby. JSON-first, local-first for reads, permission-safe.")
    add_common(parser)
    parser.add_argument("--version", action="store_true", help="Print version envelope.")
    sub = parser.add_subparsers(dest="cmd")

    p = sub.add_parser("doctor", help="Check Apple Mail/local backend availability.")
    add_common(p)
    p.add_argument("--mail-root")
    p.add_argument("--index-path")
    p.add_argument("--check-mail-app", action="store_true", help="Test live Mail.app automation; may launch Mail.app.")
    p.add_argument("--check-gmail-api", action="store_true", help="Test Gmail API access-token refresh for write backend; no mail is read/written.")
    p.set_defaults(func=command_doctor)

    p = sub.add_parser("setup", help="Show/access-check one-time macOS permissions for Dobby Mail.")
    add_common(p)
    p.add_argument("--mail-root")
    p.add_argument("--index-path")
    p.add_argument("--check-mail-app", action="store_true", default=True, help="Test live Mail.app automation; may launch Mail.app.")
    p.add_argument("--check-gmail-api", action="store_true", help="Test Gmail API access-token refresh for write backend; no mail is read/written.")
    p.add_argument("--open-settings", action="store_true", help="Open Full Disk Access settings.")
    p.set_defaults(func=command_setup)

    p = sub.add_parser("gmail-auth", help="One-time interactive Gmail OAuth setup for Gmail API write backend.")
    add_common(p)
    p.add_argument("--account", help=f"Gmail/Google Workspace account to authorize. Defaults to {DEFAULT_ACCOUNT_ENV}.")
    p.add_argument("--no-browser", action="store_true", help="Print OAuth URL but do not open a browser.")
    p.set_defaults(func=command_gmail_auth)

    p = sub.add_parser("accounts", help="List Apple Mail accounts via Mail.app automation.")
    add_common(p)
    p.set_defaults(func=command_accounts)

    p = sub.add_parser("mailboxes", help="List Apple Mail mailboxes.")
    add_common(p); add_backend(p); add_account_scope(p)
    p.add_argument("--limit", type=int, default=200)
    p.set_defaults(func=command_mailboxes)

    p = sub.add_parser("search", help="Search message metadata.")
    add_common(p); add_backend(p); add_account_scope(p)
    p.add_argument("--query", required=True, help="Case-insensitive search over subject/sender metadata.")
    p.add_argument("--limit", type=int, default=DEFAULT_LIMIT)
    p.add_argument("--from", dest="date_from", help="Lower bound date (fast backend).")
    p.add_argument("--to", dest="date_to", help="Upper bound date (fast backend).")
    p.add_argument("--mailbox", help="Mailbox name/url filter (fast backend).")
    p.add_argument("--scope", choices=["inbox", "selected"], default="inbox", help="Mail.app fallback search scope.")
    p.set_defaults(func=command_search)

    p = sub.add_parser("recent", help="List recent messages.")
    add_common(p); add_backend(p); add_account_scope(p)
    p.add_argument("--limit", type=int, default=DEFAULT_LIMIT)
    p.add_argument("--from", dest="date_from")
    p.add_argument("--to", dest="date_to")
    p.add_argument("--mailbox")
    p.add_argument("--scope", choices=["inbox", "selected"], default="inbox")
    p.set_defaults(func=command_recent)

    p = sub.add_parser("get", help="Get one message by id from search/recent.")
    add_common(p); add_backend(p); add_account_scope(p)
    p.add_argument("--id", required=True, help="Message id, e.g. fast:123 or mail:456.")
    p.add_argument("--max-body-chars", type=int, default=None)
    p.add_argument("--scope", choices=["inbox", "selected"], default="inbox", help="Mail.app fallback get scope.")
    p.set_defaults(func=command_get)

    p = sub.add_parser("selected", help="List messages currently selected in Mail.app.")
    add_common(p)
    p.add_argument("--query")
    p.add_argument("--limit", type=int, default=DEFAULT_LIMIT)
    p.set_defaults(func=command_selected)

    p = sub.add_parser("mark-read", help="Mark a message read or unread. Requires --confirm-mark.")
    add_common(p)
    p.add_argument("--id", required=True)
    p.add_argument("--read", dest="read", action="store_true", default=True)
    p.add_argument("--unread", dest="read", action="store_false")
    p.add_argument("--scope", choices=["inbox", "selected"], default="inbox")
    p.add_argument("--confirm-mark", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=command_mark_read)

    p = sub.add_parser("flag", help="Flag or unflag a message. Requires --confirm-flag.")
    add_common(p)
    p.add_argument("--id", required=True)
    p.add_argument("--clear", action="store_true", help="Clear the flag instead of setting it.")
    p.add_argument("--scope", choices=["inbox", "selected"], default="inbox")
    p.add_argument("--confirm-flag", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=command_flag)

    p = sub.add_parser("export", help="Export one fast-backend message body/metadata to files.")
    add_common(p); add_backend(p); add_account_scope(p)
    p.add_argument("--id", required=True, help="fast:<rowid> id.")
    p.add_argument("--out-dir", required=True)
    p.add_argument("--raw", action="store_true", help="Also export raw .eml content.")
    p.set_defaults(func=command_export)

    p = sub.add_parser("attachments", help="Extract attachments from one fast-backend message.")
    add_common(p); add_backend(p); add_account_scope(p)
    p.add_argument("--id", required=True, help="fast:<rowid> id.")
    p.add_argument("--out-dir", required=True)
    p.set_defaults(func=command_attachments)

    p = sub.add_parser("draft", help="Create an unsent email draft.")
    add_common(p); add_draft_args(p)
    p.set_defaults(func=command_draft)

    p = sub.add_parser("draft-reply", help="Create an unsent reply draft from a message id.")
    add_common(p); add_backend(p); add_account_scope(p); add_draft_args(p)
    p.add_argument("--id", required=True, help="Original message id, e.g. fast:123.")
    p.add_argument("--read-backend", choices=["auto", "fast", "mail-app"], default="auto", help="Backend used to read original message metadata.")
    p.set_defaults(func=command_draft_reply)

    p = sub.add_parser("send", help="Send a new email through the write backend. Requires --confirm-send.")
    add_common(p); add_draft_args(p)
    p.add_argument("--confirm-send", action="store_true", help="Required explicit confirmation for externally visible send.")
    p.set_defaults(func=command_send)

    args = parser.parse_args(argv)
    if args.version:
        args.cmd = "version"
        return args
    if not args.cmd:
        parser.error("a subcommand is required")
    return args


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    request_id = f"mail-{uuid.uuid4()}"
    started = time.time()
    command_name = TOOL
    try:
        args = parse_args(argv)
        warnings = WarningSink(quiet=bool(getattr(args, "quiet", False)))
        if getattr(args, "version", False) and getattr(args, "cmd", None) == "version":
            data = {"version": VERSION, "warnings": []}
            payload = make_envelope(f"{TOOL} version", "ok", data, None, request_id, started)
            emit(payload, plain=bool(getattr(args, "plain", False)))
            return EXIT_OK
        command_name = f"{TOOL} {args.cmd}"
        data = args.func(args, warnings)
        payload = make_envelope(command_name, "ok", data, None, request_id, started)
        emit(payload, plain=bool(getattr(args, "plain", False)))
        return EXIT_OK
    except CliError as exc:
        payload = make_envelope(
            command_name,
            "error",
            {},
            {"code": exc.code, "message": exc.message, "retryable": exc.retryable, "hint": exc.hint},
            request_id,
            started,
        )
        emit(payload, plain="--plain" in argv)
        return exc.exit_code
    except KeyboardInterrupt:
        payload = make_envelope(command_name, "error", {}, {"code": "E_INTERRUPTED", "message": "Interrupted", "retryable": True, "hint": "Re-run the command."}, request_id, started)
        emit(payload, plain="--plain" in argv)
        return EXIT_TIMEOUT
    except Exception as exc:  # compact default, no stack trace unless debug env set
        if os.environ.get("DEBUG"):
            import traceback
            traceback.print_exc(file=sys.stderr)
        payload = make_envelope(command_name, "error", {}, {"code": "E_UNEXPECTED", "message": str(exc), "retryable": False, "hint": "Re-run with DEBUG=1 for stack trace, then fix/classify this error."}, request_id, started)
        emit(payload, plain="--plain" in argv)
        return EXIT_FAILURE


if __name__ == "__main__":
    raise SystemExit(main())
