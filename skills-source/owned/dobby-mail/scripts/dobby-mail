SCHEMA_VERSION = "1.0"
TOOL = "dobby-mail"
VERSION = "0.6.1"

EXIT_OK = 0
EXIT_FAILURE = 1
EXIT_USAGE = 2
EXIT_AUTH = 3
EXIT_DEP = 4
EXIT_TIMEOUT = 5

DEFAULT_LIMIT = 20
MAX_LIMIT = 200
DEFAULT_ACCOUNT_ENV = "DOBBY_MAIL_DEFAULT_ACCOUNT"
DEFAULT_FROM_ENV = "DOBBY_MAIL_DEFAULT_FROM"
GMAIL_CLIENT_FILE_ENV = "DOBBY_GMAIL_OAUTH_CLIENT_FILE"
GMAIL_TOKENS_FILE_ENV = "DOBBY_GMAIL_TOKENS_FILE"
GMAIL_CACHE_PATH_ENV = "DOBBY_MAIL_CACHE_PATH"
GMAIL_KEYCHAIN_SERVICE = "dobby-mail-gmail-refresh-token"
GMAIL_SCOPES = [
    "https://mail.google.com/",
    "https://www.googleapis.com/auth/gmail.settings.basic",
]
GMAIL_METADATA_HEADERS = ["From", "To", "Cc", "Bcc", "Subject", "Date", "Message-ID", "In-Reply-To", "References"]


def utc_now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


class CliError(Exception):
    def __init__(self, code: str, message: str, hint: str, exit_code: int = EXIT_FAILURE, retryable: bool = False):
        super().__init__(message)
        self.code = code
        self.message = message
        self.hint = hint
        self.exit_code = exit_code
        self.retryable = retryable


class DobbyArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        raise CliError(
            "E_INVALID_USAGE",
            message,
            f"Run `{self.prog} --help` for valid arguments.",
            EXIT_USAGE,
        )


class WarningSink:
    def __init__(self, quiet: bool = False):
        self.items: list[dict[str, Any]] = []
        self.quiet = quiet

    def warn(self, code: str, message: str, hint: str | None = None, *, backend: str | None = None) -> None:
        item = {"code": code, "message": message, "hint": hint, "backend": backend}
        self.items.append(item)
        if not self.quiet:
            suffix = f" Hint: {hint}" if hint else ""
            print(f"[dobby-mail warning] {code}: {message}{suffix}", file=sys.stderr)


def make_envelope(command: str, status: str, data: dict[str, Any], error: dict[str, Any] | None, request_id: str, started: float) -> dict[str, Any]:
    return {
        "schema_version": SCHEMA_VERSION,
        "command": command,
        "status": status,
        "data": data,
        "error": error,
        "meta": {
            "request_id": request_id,
            "duration_ms": int((time.time() - started) * 1000),
            "timestamp_utc": utc_now(),
            "tool_version": VERSION,
        },
    }


def emit(payload: dict[str, Any], plain: bool = False) -> None:
    if plain:
        if payload["status"] == "ok":
            data = payload["data"]
            print(f"ok {payload['command']} backend={data.get('backend', data.get('selected_backend', '-'))}")
            if "messages" in data:
                for msg in data["messages"]:
                    date = msg.get("date_received") or msg.get("date_sent") or ""
                    print(f"{msg.get('id')}\t{date}\t{msg.get('sender','')}\t{msg.get('subject','')}")
            elif "checks" in data:
                for check in data["checks"]:
                    print(f"{check['status']}\t{check['name']}\t{check.get('message','')}")
            else:
                print(json.dumps(data, ensure_ascii=False))
        else:
            err = payload["error"] or {}
            print(f"error {err.get('code')}: {err.get('message')}", file=sys.stderr)
            if err.get("hint"):
                print(err["hint"], file=sys.stderr)
        return
    print(json.dumps(payload, ensure_ascii=False, indent=2))


def _decode_dotenv_value(raw: str) -> str:
    value = raw.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
        value = value[1:-1]
    return value


def dotenv_values(start: Path | None = None) -> dict[str, str]:
    cur = (start or Path.cwd()).resolve()
    candidates = [cur, *cur.parents]
    out: dict[str, str] = {}
    for directory in reversed(candidates):
        env_file = directory / ".env"
        if not env_file.exists():
            continue
        try:
            lines = env_file.read_text(encoding="utf-8").splitlines()
        except OSError:
            continue
        for line in lines:
            stripped = line.strip()
            if not stripped or stripped.startswith("#") or "=" not in stripped:
                continue
            key, value = stripped.split("=", 1)
            key = key.strip()
            if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
                out[key] = _decode_dotenv_value(value)
    return out


def config_value(name: str) -> str | None:
    raw = os.environ.get(name)
    if raw is not None and raw.strip():
        return raw.strip()
    raw = dotenv_values().get(name)
    if raw and raw.strip():
        return raw.strip()
    return None


def clean_email_address(raw: str | None) -> str | None:
    if not raw:
        return None
    _name, addr = parseaddr(raw)
    return (addr or raw).strip() or None


def resolve_gmail_account(args: argparse.Namespace) -> str:
    raw = getattr(args, "gmail_account", None) or getattr(args, "account", None) or config_value(DEFAULT_ACCOUNT_ENV)
    account = clean_email_address(raw)
    if not account:
        raise CliError(
            "E_DEFAULT_ACCOUNT_REQUIRED",
            f"{DEFAULT_ACCOUNT_ENV} or --account is required for Gmail API operations",
            f"Set {DEFAULT_ACCOUNT_ENV} in the workspace .env/static defaults, or pass --account you@example.com.",
            EXIT_USAGE,
        )
    return account


def resolve_sender(raw: str | None) -> str:
    if raw and raw.strip():
        return raw.strip()
    value = config_value(DEFAULT_FROM_ENV)
    if value:
        return value
    raise CliError(
        "E_DEFAULT_FROM_REQUIRED",
        f"{DEFAULT_FROM_ENV} is required for draft/send identity",
        f"Set {DEFAULT_FROM_ENV} in the workspace .env/static defaults, or pass --sender explicitly.",
        EXIT_USAGE,
    )


def clamp_limit(value: int | None) -> int:
    if value is None:
        return DEFAULT_LIMIT
    if value < 1:
        raise CliError("E_INVALID_LIMIT", "--limit must be >= 1", "Pass --limit between 1 and 200.", EXIT_USAGE)
    return min(value, MAX_LIMIT)


def sanitize_filename(raw: str | None, fallback: str) -> str:
    name = (raw or fallback).strip() or fallback
    name = re.sub(r"[\\/:\0]+", "_", name)
    name = re.sub(r"\s+", " ", name).strip()
    if name in {".", ".."}:
        name = fallback
    return name[:180]


# --- Gmail OAuth / API ---

def gmail_client_file_candidates() -> list[Path]:
    raw = os.environ.get(GMAIL_CLIENT_FILE_ENV, "").strip()
    if raw:
        return [Path(raw).expanduser().resolve()]
    root = Path.home() / ".secrets" / "gmail"
    return [root / "client_secret.json", root / "oauth_client.json", root / "credentials.json"]


def resolve_gmail_client_file() -> Path:
    for path in gmail_client_file_candidates():
        if path.exists():
            return path
    raise CliError(
        "E_GMAIL_CLIENT_SECRET_MISSING",
        "Gmail OAuth client file not found",
        f"Create an installed-app OAuth client JSON at {gmail_client_file_candidates()[0]} or set {GMAIL_CLIENT_FILE_ENV} to a local client JSON path.",
        EXIT_AUTH,
    )


def load_gmail_client_config() -> dict[str, str]:
    path = resolve_gmail_client_file()
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise CliError("E_GMAIL_CLIENT_SECRET_READ", f"Cannot read Gmail OAuth client file: {path}", "Check local secret file permissions.", EXIT_AUTH) from exc
    except json.JSONDecodeError as exc:
        raise CliError("E_GMAIL_CLIENT_SECRET_JSON", f"Gmail OAuth client file is not valid JSON: {path}", "Download a valid OAuth client JSON from Google Cloud Console.", EXIT_AUTH) from exc
    cfg = raw.get("installed") or raw.get("web") or raw
    client_id = str(cfg.get("client_id") or "").strip()
    if not client_id:
        raise CliError("E_GMAIL_CLIENT_SECRET_INVALID", f"Gmail OAuth client file has no client_id: {path}", "Download an installed-app OAuth client JSON from Google Cloud Console.", EXIT_AUTH)
    return {
        "path": str(path),
        "client_id": client_id,
        "client_secret": str(cfg.get("client_secret") or "").strip(),
        "token_uri": str(cfg.get("token_uri") or "https://oauth2.googleapis.com/token").strip(),
        "auth_uri": str(cfg.get("auth_uri") or "https://accounts.google.com/o/oauth2/v2/auth").strip(),
    }


def gmail_tokens_file_candidates() -> list[Path]:
    raw = os.environ.get(GMAIL_TOKENS_FILE_ENV, "").strip()
    if raw:
        return [Path(raw).expanduser().resolve()]
    return [Path.home() / ".secrets" / "gmail" / "tokens.json"]


def resolve_gmail_tokens_file(required: bool = False) -> Path | None:
    for path in gmail_tokens_file_candidates():
        if path.exists():
            return path
    if required:
        raise CliError(
            "E_GMAIL_TOKENS_FILE_MISSING",
            "Gmail token file not found",
            f"Run `~/GitHub/scripts/sync/keyvault-sync-gmail-secrets.sh --apply` or set {GMAIL_TOKENS_FILE_ENV} to a local tokens.json path.",
            EXIT_AUTH,
        )
    return None


def gmail_file_get_refresh_token(account: str) -> str | None:
    path = resolve_gmail_tokens_file(required=False)
    if not path:
        return None
    try:
        raw = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise CliError("E_GMAIL_TOKENS_FILE_READ", f"Cannot read Gmail token file: {path}", "Check local secret file permissions or rerun keyvault-sync-gmail-secrets.", EXIT_AUTH) from exc
    except json.JSONDecodeError as exc:
        raise CliError("E_GMAIL_TOKENS_FILE_JSON", f"Gmail token file is not valid JSON: {path}", "Rerun keyvault-sync-gmail-secrets to regenerate it from Key Vault.", EXIT_AUTH) from exc
    tokens = raw.get("tokens") if isinstance(raw, dict) else None
    if not isinstance(tokens, dict):
        return None
    value = tokens.get(account)
    token = value if isinstance(value, str) else (value.get("refresh_token") if isinstance(value, dict) else None)
    token = str(token or "").strip()
    return token or None


def gmail_update_tokens_file(account: str, refresh_token: str) -> Path:
    path = resolve_gmail_tokens_file(required=False) or (Path.home() / ".secrets" / "gmail" / "tokens.json")
    data: dict[str, Any] = {"schemaVersion": 1, "tokens": {}}
    if path.exists():
        with contextlib.suppress(OSError, json.JSONDecodeError):
            parsed = json.loads(path.read_text(encoding="utf-8"))
            if isinstance(parsed, dict):
                data.update(parsed)
    tokens = data.get("tokens")
    if not isinstance(tokens, dict):
        tokens = {}
    tokens[account] = {"refresh_token": refresh_token, "source": "interactive-gmail-auth"}
    data["tokens"] = tokens
    data["updatedAt"] = utc_now()
    path.parent.mkdir(parents=True, exist_ok=True)
    os.chmod(path.parent, 0o700)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    os.chmod(path, 0o600)
    return path


def gmail_keychain_get_refresh_token(account: str) -> str | None:
    security = shutil.which("security")
    if not security:
        return None
    proc = subprocess.run([security, "find-generic-password", "-s", GMAIL_KEYCHAIN_SERVICE, "-a", account, "-w"], text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, check=False)
    token = proc.stdout.strip()
    return token if proc.returncode == 0 and token else None


def gmail_refresh_token_with_source(account: str) -> tuple[str | None, str | None]:
    token = gmail_file_get_refresh_token(account)
    if token:
        path = resolve_gmail_tokens_file(required=False)
        return token, f"tokens_file:{path}" if path else "tokens_file"
    token = gmail_keychain_get_refresh_token(account)
    if token:
        return token, "keychain_cache"
    return None, None


def gmail_has_refresh_token(account: str) -> tuple[bool, str | None]:
    token, source = gmail_refresh_token_with_source(account)
    return bool(token), source


def gmail_form_post(url: str, fields: dict[str, str], timeout_sec: int) -> dict[str, Any]:
    data = urllib.parse.urlencode(fields).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/x-www-form-urlencoded", "Accept": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(req, timeout=timeout_sec) as resp:
            body = resp.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        message = body
        with contextlib.suppress(Exception):
            parsed = json.loads(body)
            message = parsed.get("error_description") or parsed.get("error") or body
        raise CliError("E_GMAIL_OAUTH_HTTP", f"Gmail OAuth token exchange failed ({exc.code}): {message}", "Check the OAuth client JSON and re-run gmail-auth.", EXIT_AUTH) from exc
    except urllib.error.URLError as exc:
        raise CliError("E_GMAIL_OAUTH_NETWORK", f"Could not reach Google OAuth endpoint: {exc.reason}", "Check network connectivity and retry.", EXIT_TIMEOUT, retryable=True) from exc
    try:
        parsed = json.loads(body)
    except json.JSONDecodeError as exc:
        raise CliError("E_GMAIL_OAUTH_BAD_JSON", "Google OAuth returned non-JSON output", "Retry or inspect the OAuth client setup.", EXIT_AUTH) from exc
    if not isinstance(parsed, dict):
        raise CliError("E_GMAIL_OAUTH_BAD_JSON", "Google OAuth returned a non-object response", "Retry or inspect the OAuth client setup.", EXIT_AUTH)
    return parsed


def gmail_access_token(account: str, timeout_sec: int) -> str:
    cfg = load_gmail_client_config()
    refresh_token, _source = gmail_refresh_token_with_source(account)
    if not refresh_token:
        raise CliError(
            "E_GMAIL_AUTH_NOT_CONFIGURED",
            f"No Gmail refresh token is stored for {account}",
            f"Run `~/GitHub/scripts/sync/keyvault-sync-gmail-secrets.sh --apply`, or run `dobby-mail gmail-auth --account {account}` once and update Key Vault.",
            EXIT_AUTH,
        )
    fields = {"client_id": cfg["client_id"], "refresh_token": refresh_token, "grant_type": "refresh_token"}
    if cfg.get("client_secret"):
        fields["client_secret"] = cfg["client_secret"]
    token = gmail_form_post(cfg["token_uri"], fields, timeout_sec)
    access = str(token.get("access_token") or "").strip()
    if not access:
        raise CliError("E_GMAIL_ACCESS_TOKEN_MISSING", f"Google did not return an access token for {account}", "Re-run gmail-auth for this account.", EXIT_AUTH)
    return access


def gmail_mock_api_request(method: str, path: str) -> dict[str, Any] | None:
    mock_file = os.environ.get("DOBBY_GMAIL_API_MOCK_FILE", "").strip()
    if not mock_file:
        return None
    try:
        raw = json.loads(Path(mock_file).expanduser().read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise CliError("E_GMAIL_API_MOCK_READ", f"Cannot read Gmail API mock file: {mock_file}", f"Fix the test/mock fixture. Error: {exc}", EXIT_DEP) from exc
    responses = raw.get("responses") if isinstance(raw, dict) else None
    if not isinstance(responses, list):
        raise CliError("E_GMAIL_API_MOCK_SCHEMA", "Gmail API mock file must contain responses[]", "Use responses with method plus path/path_contains/response.", EXIT_DEP)
    for item in responses:
        if not isinstance(item, dict):
            continue
        if str(item.get("method") or "GET").upper() != method.upper():
            continue
        exact = item.get("path")
        contains = item.get("path_contains")
        if exact is not None and str(exact) != path:
            continue
        if contains is not None and str(contains) not in path:
            continue
        if exact is None and contains is None:
            continue
        response = item.get("response")
        if not isinstance(response, dict):
            raise CliError("E_GMAIL_API_MOCK_SCHEMA", "Gmail API mock response must be an object", "Fix the mock fixture response.", EXIT_DEP)
        return response
    raise CliError("E_GMAIL_API_MOCK_MISS", f"No Gmail API mock response for {method} {path}", "Add a matching mock response.", EXIT_DEP)


def gmail_api_request(account: str, method: str, path: str, body: dict[str, Any] | None, timeout_sec: int) -> dict[str, Any]:
    mocked = gmail_mock_api_request(method, path)
    if mocked is not None:
        return mocked
    access_token = gmail_access_token(account, timeout_sec)
    url = "https://gmail.googleapis.com/gmail/v1/users/me/" + path.lstrip("/")
    data = json.dumps(body or {}, ensure_ascii=False).encode("utf-8") if body is not None else None
    req = urllib.request.Request(url, data=data, headers={"Authorization": f"Bearer {access_token}", "Content-Type": "application/json", "Accept": "application/json"}, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout_sec) as resp:
            raw = resp.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode("utf-8", errors="replace")
        message = raw
        status = None
        with contextlib.suppress(Exception):
            parsed = json.loads(raw)
            err = parsed.get("error") or {}
            if isinstance(err, dict):
                message = err.get("message") or raw
                status = err.get("status")
        code = "E_GMAIL_HISTORY_EXPIRED" if exc.code == 404 and path.startswith("history?") else ("E_GMAIL_API_AUTH" if exc.code in {401, 403} else "E_GMAIL_API_ERROR")
        hint = "History cursor is stale; run `dobby-mail sync --reset` or `dobby-mail history` for a new baseline." if code == "E_GMAIL_HISTORY_EXPIRED" else ("Re-run gmail-auth and make sure Gmail API is enabled for the OAuth client." if code == "E_GMAIL_API_AUTH" else "Check Gmail API status, inputs, and retry/backoff.")
        raise CliError(code, f"Gmail API request failed ({exc.code}{', ' + status if status else ''}): {message}", hint, EXIT_AUTH if code == "E_GMAIL_API_AUTH" else EXIT_FAILURE, retryable=code != "E_GMAIL_API_AUTH") from exc
    except urllib.error.URLError as exc:
        raise CliError("E_GMAIL_API_NETWORK", f"Could not reach Gmail API: {exc.reason}", "Check network connectivity and retry.", EXIT_TIMEOUT, retryable=True) from exc
    if not raw:
        return {}
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise CliError("E_GMAIL_API_BAD_JSON", "Gmail API returned non-JSON output", "Retry or inspect Gmail API status.", EXIT_FAILURE) from exc
    if not isinstance(parsed, dict):
        raise CliError("E_GMAIL_API_BAD_JSON", "Gmail API returned a non-object response", "Retry or inspect Gmail API status.", EXIT_FAILURE)
    return parsed


# --- cache ---

def cache_default_path() -> Path:
    raw = os.environ.get(GMAIL_CACHE_PATH_ENV, "").strip()
    if raw:
        return Path(raw).expanduser().resolve()
    return (Path.home() / ".cache" / "dobby-mail" / "cache.sqlite").resolve()


def resolve_cache_path(args: argparse.Namespace) -> Path:
    raw = getattr(args, "cache_path", None)
    if raw:
        return Path(raw).expanduser().resolve()
    return cache_default_path()


def cache_enabled(args: argparse.Namespace) -> bool:
    return not bool(getattr(args, "no_cache", False))


def cache_connect(path: Path) -> sqlite3.Connection:
    path.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(path)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA busy_timeout=5000")
    conn.executescript(
        """
        CREATE TABLE IF NOT EXISTS messages (
          account TEXT NOT NULL,
          gmail_message_id TEXT NOT NULL,
          gmail_thread_id TEXT,
          source_message_id TEXT,
          subject TEXT,
          sender TEXT,
          to_header TEXT,
          cc TEXT,
          date_received TEXT,
          date_sent TEXT,
          snippet TEXT,
          label_ids_json TEXT NOT NULL DEFAULT '[]',
          history_id TEXT,
          size_bytes INTEGER,
          read_status INTEGER,
          headers_json TEXT NOT NULL DEFAULT '{}',
          body_text TEXT,
          body_html TEXT,
          attachments_json TEXT NOT NULL DEFAULT '[]',
          raw_json TEXT,
          fetched_at TEXT NOT NULL,
          body_fetched_at TEXT,
          updated_at TEXT NOT NULL,
          PRIMARY KEY (account, gmail_message_id)
        );
        CREATE INDEX IF NOT EXISTS idx_messages_account_received ON messages(account, date_received DESC);
        CREATE INDEX IF NOT EXISTS idx_messages_account_thread ON messages(account, gmail_thread_id);
        CREATE TABLE IF NOT EXISTS sync_state (
          account TEXT PRIMARY KEY,
          history_id TEXT,
          email_address TEXT,
          messages_total INTEGER,
          threads_total INTEGER,
          updated_at TEXT NOT NULL
        );
        """
    )
    return conn


def cache_message_from_row(row: sqlite3.Row) -> dict[str, Any]:
    def loads(value: str | None, fallback: Any) -> Any:
        if not value:
            return fallback
        with contextlib.suppress(json.JSONDecodeError):
            return json.loads(value)
        return fallback
    return {
        "id": f"gmail-message:{row['gmail_message_id']}",
        "backend": "gmail-api",
        "gmail_message_id": row["gmail_message_id"],
        "gmail_thread_id": row["gmail_thread_id"],
        "thread_id": row["gmail_thread_id"],
        "source_message_id": row["source_message_id"],
        "subject": row["subject"],
        "sender": row["sender"],
        "to": row["to_header"],
        "cc": row["cc"],
        "date_received": row["date_received"],
        "date_sent": row["date_sent"],
        "snippet": row["snippet"],
        "label_ids": loads(row["label_ids_json"], []),
        "history_id": row["history_id"],
        "size_bytes": row["size_bytes"],
        "read_status": bool(row["read_status"]) if row["read_status"] is not None else None,
        "headers": loads(row["headers_json"], {}),
        "headers_count": len(loads(row["headers_json"], {})),
        "body_text": row["body_text"],
        "body_html": row["body_html"],
        "attachments": loads(row["attachments_json"], []),
        "body_unavailable_reason": None if (row["body_text"] or row["body_html"]) else "E_CACHE_BODY_NOT_FETCHED",
        "threading_supported": True,
        "cache": {"hit": True, "body_cached": bool(row["body_text"] or row["body_html"]), "fetched_at": row["fetched_at"], "body_fetched_at": row["body_fetched_at"]},
    }


def cache_get_message(path: Path, account: str, gmail_id: str) -> dict[str, Any] | None:
    if not path.exists():
        return None
    with cache_connect(path) as conn:
        row = conn.execute("SELECT * FROM messages WHERE account=? AND gmail_message_id=?", (account, gmail_id)).fetchone()
        return cache_message_from_row(row) if row else None


def cache_put_message(path: Path, account: str, msg: dict[str, Any], *, raw: dict[str, Any] | None = None, include_body: bool = False) -> None:
    gmail_id = msg.get("gmail_message_id")
    if not gmail_id:
        return
    now = utc_now()
    with cache_connect(path) as conn:
        existing = conn.execute("SELECT body_text, body_html, body_fetched_at FROM messages WHERE account=? AND gmail_message_id=?", (account, gmail_id)).fetchone()
        body_text = msg.get("body_text") if include_body else (existing["body_text"] if existing else None)
        body_html = msg.get("body_html") if include_body else (existing["body_html"] if existing else None)
        body_fetched_at = now if include_body else (existing["body_fetched_at"] if existing else None)
        conn.execute(
            """
            INSERT INTO messages(account,gmail_message_id,gmail_thread_id,source_message_id,subject,sender,to_header,cc,date_received,date_sent,snippet,label_ids_json,history_id,size_bytes,read_status,headers_json,body_text,body_html,attachments_json,raw_json,fetched_at,body_fetched_at,updated_at)
            VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
            ON CONFLICT(account,gmail_message_id) DO UPDATE SET
              gmail_thread_id=excluded.gmail_thread_id,
              source_message_id=excluded.source_message_id,
              subject=excluded.subject,
              sender=excluded.sender,
              to_header=excluded.to_header,
              cc=excluded.cc,
              date_received=excluded.date_received,
              date_sent=excluded.date_sent,
              snippet=excluded.snippet,
              label_ids_json=excluded.label_ids_json,
              history_id=excluded.history_id,
              size_bytes=excluded.size_bytes,
              read_status=excluded.read_status,
              headers_json=excluded.headers_json,
              body_text=COALESCE(excluded.body_text, messages.body_text),
              body_html=COALESCE(excluded.body_html, messages.body_html),
              attachments_json=excluded.attachments_json,
              raw_json=excluded.raw_json,
              fetched_at=excluded.fetched_at,
              body_fetched_at=COALESCE(excluded.body_fetched_at, messages.body_fetched_at),
              updated_at=excluded.updated_at
            """,
            (
                account, gmail_id, msg.get("gmail_thread_id"), msg.get("source_message_id"), msg.get("subject"), msg.get("sender"), msg.get("to"), msg.get("cc"), msg.get("date_received"), msg.get("date_sent"), msg.get("snippet"),
                json.dumps(msg.get("label_ids") or [], ensure_ascii=False), msg.get("history_id"), msg.get("size_bytes"), None if msg.get("read_status") is None else int(bool(msg.get("read_status"))),
                json.dumps(msg.get("headers") or {}, ensure_ascii=False), body_text, body_html, json.dumps(msg.get("attachments") or [], ensure_ascii=False), json.dumps(raw or {}, ensure_ascii=False), now, body_fetched_at, now,
            ),
        )
        conn.commit()


def cache_set_history(path: Path, account: str, data: dict[str, Any]) -> None:
    with cache_connect(path) as conn:
        conn.execute(
            """
            INSERT INTO sync_state(account,history_id,email_address,messages_total,threads_total,updated_at)
            VALUES(?,?,?,?,?,?)
            ON CONFLICT(account) DO UPDATE SET
              history_id=COALESCE(excluded.history_id, sync_state.history_id),
              email_address=COALESCE(excluded.email_address, sync_state.email_address),
              messages_total=COALESCE(excluded.messages_total, sync_state.messages_total),
              threads_total=COALESCE(excluded.threads_total, sync_state.threads_total),
              updated_at=excluded.updated_at
            """,
            (account, data.get("history_id") or data.get("historyId"), data.get("email_address") or data.get("emailAddress"), data.get("messages_total") or data.get("messagesTotal"), data.get("threads_total") or data.get("threadsTotal"), utc_now()),
        )
        conn.commit()


def cache_get_state(path: Path, account: str) -> dict[str, Any] | None:
    if not path.exists():
        return None
    with cache_connect(path) as conn:
        row = conn.execute("SELECT * FROM sync_state WHERE account=?", (account,)).fetchone()
        if not row:
            return None
        count = conn.execute("SELECT COUNT(*) FROM messages WHERE account=?", (account,)).fetchone()[0]
        body_count = conn.execute("SELECT COUNT(*) FROM messages WHERE account=? AND (body_text IS NOT NULL OR body_html IS NOT NULL)", (account,)).fetchone()[0]
        return {"account": account, "history_id": row["history_id"], "email_address": row["email_address"], "messages_total": row["messages_total"], "threads_total": row["threads_total"], "updated_at": row["updated_at"], "cached_messages": count, "cached_bodies": body_count}


# --- Gmail parsing ---

def quoted_gmail_id(gmail_id: str) -> str:
    return urllib.parse.quote(gmail_id, safe="")


def strip_gmail_message_prefix(raw: str) -> str:
    value = str(raw or "").strip()
    for prefix in ["gmail-message:", "gmail:", "message:"]:
        if value.startswith(prefix):
            return value[len(prefix):].strip()
    return value


def normalize_rfc_message_id(raw: str) -> str:
    value = str(raw or "").strip()
    if not value:
        raise CliError("E_GMAIL_TARGET_REQUIRED", "RFC Message-ID cannot be empty", "Pass --rfc-message-id '<message-id@example.com>'.", EXIT_USAGE)
    if not (value.startswith("<") and value.endswith(">")):
        value = f"<{value.strip('<>')}>"
    return value


def gmail_internal_date_iso(raw: Any) -> str | None:
    if raw is None:
        return None
    try:
        ms = int(str(raw))
        return dt.datetime.fromtimestamp(ms / 1000, tz=dt.timezone.utc).isoformat().replace("+00:00", "Z")
    except (TypeError, ValueError, OSError, OverflowError):
        return None


def gmail_header_map(payload: dict[str, Any]) -> dict[str, str]:
    headers: dict[str, str] = {}
    for item in payload.get("headers") or []:
        if not isinstance(item, dict):
            continue
        name = str(item.get("name") or "").strip()
        value = str(item.get("value") or "")
        if name:
            headers[name.lower()] = value
    return headers


def gmail_public_headers(headers: dict[str, str]) -> dict[str, str]:
    keep = {name.lower() for name in GMAIL_METADATA_HEADERS}
    return {k: v for k, v in headers.items() if k in keep}


def gmail_decode_body_data(raw: str | None) -> str:
    if not raw:
        return ""
    padded = raw + "=" * (-len(raw) % 4)
    try:
        return base64.urlsafe_b64decode(padded.encode("ascii")).decode("utf-8", errors="replace")
    except Exception:
        return ""


def html_to_text(raw: str) -> str:
    text = re.sub(r"(?is)<(script|style).*?>.*?</\1>", " ", raw)
    text = re.sub(r"(?i)<br\s*/?>", "\n", text)
    text = re.sub(r"(?i)</p\s*>", "\n", text)
    text = re.sub(r"(?i)</div\s*>", "\n", text)
    text = re.sub(r"(?s)<[^>]+>", " ", text)
    text = html.unescape(text)
    text = re.sub(r"[ \t\r\f\v]+", " ", text)
    text = re.sub(r"\n\s*\n\s*\n+", "\n\n", text)
    return text.strip()


def gmail_walk_parts(payload: dict[str, Any]) -> Iterable[dict[str, Any]]:
    yield payload
    for part in payload.get("parts") or []:
        if isinstance(part, dict):
            yield from gmail_walk_parts(part)


def gmail_extract_content(payload: dict[str, Any], max_body_chars: int | None = None) -> tuple[str | None, str | None, list[dict[str, Any]]]:
    plain_parts: list[str] = []
    html_parts: list[str] = []
    attachments: list[dict[str, Any]] = []
    for part in gmail_walk_parts(payload):
        mime = str(part.get("mimeType") or "").lower()
        body = part.get("body") if isinstance(part.get("body"), dict) else {}
        filename = str(part.get("filename") or "").strip()
        attachment_id = body.get("attachmentId")
        size = body.get("size")
        if filename or attachment_id:
            attachments.append({"filename": filename or None, "content_type": part.get("mimeType"), "size_bytes": size, "attachment_id": attachment_id, "part_id": part.get("partId")})
        data = body.get("data")
        if not data:
            continue
        text = gmail_decode_body_data(str(data))
        if not text.strip():
            continue
        if mime == "text/plain":
            plain_parts.append(text)
        elif mime == "text/html":
            html_parts.append(text)
    plain = "\n".join(p.strip() for p in plain_parts if p and p.strip()) or None
    body_html = "\n".join(p.strip() for p in html_parts if p and p.strip()) or None
    if not plain and body_html:
        plain = html_to_text(body_html)
    if max_body_chars is not None:
        if plain and len(plain) > max_body_chars:
            plain = plain[: max_body_chars - 1] + "…"
        if body_html and len(body_html) > max_body_chars:
            body_html = body_html[: max_body_chars - 1] + "…"
    return plain, body_html, attachments


def normalize_gmail_message(result: dict[str, Any], *, include_body: bool = False, max_body_chars: int | None = None) -> dict[str, Any]:
    payload = result.get("payload") if isinstance(result.get("payload"), dict) else {}
    headers = gmail_header_map(payload)
    msg: dict[str, Any] = {
        "id": f"gmail-message:{result.get('id')}" if result.get("id") else None,
        "backend": "gmail-api",
        "gmail_message_id": result.get("id"),
        "gmail_thread_id": result.get("threadId"),
        "thread_id": result.get("threadId"),
        "source_message_id": headers.get("message-id"),
        "subject": headers.get("subject"),
        "sender": headers.get("from"),
        "to": headers.get("to"),
        "cc": headers.get("cc"),
        "date_received": gmail_internal_date_iso(result.get("internalDate")),
        "date_sent": headers.get("date"),
        "snippet": result.get("snippet"),
        "label_ids": result.get("labelIds") or [],
        "history_id": result.get("historyId"),
        "size_bytes": result.get("sizeEstimate"),
        "read_status": False if "UNREAD" in (result.get("labelIds") or []) else True,
        "threading_supported": True,
        "headers": gmail_public_headers(headers),
        "headers_count": len(headers),
    }
    if include_body:
        body_text, body_html, attachments = gmail_extract_content(payload, max_body_chars=max_body_chars)
        msg["body_text"] = body_text
        msg["body_html"] = body_html
        msg["attachments"] = attachments
        msg["body_unavailable_reason"] = None if (body_text or body_html) else "E_GMAIL_BODY_EMPTY"
    return msg


def gmail_get_message(account: str, gmail_id: str, timeout_sec: int, *, fmt: str = "full", metadata_headers: list[str] | None = None) -> dict[str, Any]:
    params: list[tuple[str, str]] = [("format", fmt)]
    for header in metadata_headers or []:
        params.append(("metadataHeaders", header))
    suffix = "?" + urllib.parse.urlencode(params) if params else ""
    return gmail_api_request(account, "GET", f"messages/{quoted_gmail_id(gmail_id)}{suffix}", None, timeout_sec)


def gmail_list_messages(account: str, query: str, timeout_sec: int, *, max_results: int = 10, include_spam_trash: bool = True) -> list[dict[str, Any]]:
    params = urllib.parse.urlencode({"q": query, "maxResults": str(max_results), "includeSpamTrash": "true" if include_spam_trash else "false"})
    result = gmail_api_request(account, "GET", f"messages?{params}", None, timeout_sec)
    messages = result.get("messages") or []
    if not isinstance(messages, list):
        raise CliError("E_GMAIL_API_BAD_JSON", "Gmail API messages.list returned malformed messages", "Retry or inspect Gmail API status.", EXIT_FAILURE)
    return [m for m in messages if isinstance(m, dict)]


def gmail_query_from_dates(date_from: str | None, date_to: str | None) -> str:
    parts: list[str] = []
    def gmail_date(raw: str) -> str:
        text = raw.strip()
        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", text):
            parsed = dt.datetime.fromisoformat(text)
        else:
            parsed = dt.datetime.fromisoformat(text.replace("Z", "+00:00"))
            if parsed.tzinfo:
                parsed = parsed.astimezone(dt.timezone.utc).replace(tzinfo=None)
        return parsed.strftime("%Y/%m/%d")
    if date_from:
        parts.append(f"after:{gmail_date(date_from)}")
    if date_to:
        parts.append(f"before:{gmail_date(date_to)}")
    return " ".join(parts)


def build_gmail_raw_message(payload: dict[str, Any]) -> tuple[str, str]:
    msg = EmailMessage()
    sender = payload.get("sender") or ""
    msg["From"] = sender
    msg["To"] = ", ".join(payload.get("to") or [])
    if payload.get("cc"):
        msg["Cc"] = ", ".join(payload["cc"])
    if payload.get("bcc"):
        msg["Bcc"] = ", ".join(payload["bcc"])
    msg["Subject"] = payload.get("subject") or ""
    msg["Date"] = formatdate(localtime=False)
    if payload.get("in_reply_to"):
        msg["In-Reply-To"] = str(payload["in_reply_to"])
    if payload.get("references"):
        refs = payload["references"]
        msg["References"] = " ".join(str(item) for item in refs) if isinstance(refs, list) else str(refs)
    domain = clean_email_address(sender)
    domain = domain.split("@", 1)[1] if domain and "@" in domain else None
    message_id = make_msgid(domain=domain)
    msg["Message-ID"] = message_id
    msg.set_content(payload.get("body") or "")
    for attachment in payload.get("attachments") or []:
        path = Path(attachment["path"])
        try:
            data = path.read_bytes()
        except OSError as exc:
            raise CliError("E_ATTACHMENT_READ", f"Cannot read attachment: {path}", "Pass readable file paths with --attach.", EXIT_USAGE) from exc
        content_type = str(attachment.get("content_type") or "application/octet-stream")
        maintype, subtype = content_type.split("/", 1) if "/" in content_type else ("application", "octet-stream")
        msg.add_attachment(data, maintype=maintype, subtype=subtype, filename=str(attachment.get("filename") or path.name))
    raw = base64.urlsafe_b64encode(msg.as_bytes()).decode("ascii")
    return raw, message_id


def gmail_drafts_url(account: str) -> str:
    return "https://mail.google.com/mail/u/" + urllib.parse.quote(account, safe="") + "/#drafts"


# --- command helpers ---

def read_body_arg(args: argparse.Namespace) -> str:
    if getattr(args, "body", None) is not None:
        return args.body
    body_file = getattr(args, "body_file", None)
    if body_file:
        if body_file == "-":
            return sys.stdin.read()
        try:
            return Path(body_file).expanduser().read_text(encoding="utf-8")
        except OSError as exc:
            raise CliError("E_BODY_FILE_READ", f"Cannot read body file: {body_file}", "Pass a readable --body-file path or --body text.", EXIT_USAGE) from exc
    raise CliError("E_BODY_REQUIRED", "Message body required", "Pass --body, --body-file PATH, or --body-file -.", EXIT_USAGE)


def parse_recipients(values: list[str] | None) -> list[str]:
    out: list[str] = []
    for value in values or []:
        for part in value.split(","):
            addr = part.strip()
            if addr:
                out.append(addr)
    return out


def parse_attachment_paths(values: list[str] | None) -> list[str]:
    out: list[str] = []
    for value in values or []:
        for part in value.split(","):
            path = part.strip()
            if path:
                out.append(path)
    return out


def attachment_metadata(raw_path: str) -> dict[str, Any]:
    path = Path(raw_path).expanduser()
    try:
        stat = path.stat()
    except OSError as exc:
        raise CliError("E_ATTACHMENT_READ", f"Cannot read attachment: {raw_path}", "Pass existing readable file paths with --attach.", EXIT_USAGE) from exc
    if not path.is_file():
        raise CliError("E_ATTACHMENT_NOT_FILE", f"Attachment is not a regular file: {raw_path}", "Pass file paths, not directories, with --attach.", EXIT_USAGE)
    content_type = mimetypes.guess_type(str(path))[0] or "application/octet-stream"
    return {
        "path": str(path.resolve()),
        "filename": path.name,
        "content_type": content_type,
        "size_bytes": stat.st_size,
    }


def attachments_from_args(args: argparse.Namespace) -> list[dict[str, Any]]:
    return [attachment_metadata(path) for path in parse_attachment_paths(getattr(args, "attach", None))]


def draft_payload_from_args(args: argparse.Namespace) -> dict[str, Any]:
    to = parse_recipients(args.to)
    if not to:
        raise CliError("E_RECIPIENT_REQUIRED", "At least one --to recipient is required", "Pass --to recipient@example.com.", EXIT_USAGE)
    return {"to": to, "cc": parse_recipients(args.cc), "bcc": parse_recipients(args.bcc), "subject": args.subject or "", "body": read_body_arg(args), "sender": resolve_sender(args.sender), "visible": False, "attachments": attachments_from_args(args)}


def resolve_gmail_message_target(args: argparse.Namespace, account: str) -> dict[str, Any]:
    provided = [name for name in ["gmail_id", "rfc_message_id", "id"] if getattr(args, name, None)]
    if len(provided) != 1:
        raise CliError("E_GMAIL_TARGET_REQUIRED", "Pass exactly one Gmail message target", "Use --gmail-id for a Gmail API id, or --rfc-message-id from Dobby Mail's source_message_id.", EXIT_USAGE)
    if provided[0] == "gmail_id":
        gmail_id = strip_gmail_message_prefix(args.gmail_id)
        if not gmail_id:
            raise CliError("E_GMAIL_TARGET_REQUIRED", "--gmail-id cannot be empty", "Pass a Gmail API message id.", EXIT_USAGE)
        return {"gmail_id": gmail_id, "input_kind": "gmail_id", "input": args.gmail_id, "resolved_via": "direct"}
    if provided[0] == "id":
        gmail_id = strip_gmail_message_prefix(args.id)
        if not gmail_id:
            raise CliError("E_GMAIL_TARGET_REQUIRED", "--id cannot be empty", "Pass gmail-message:<id> or use --gmail-id.", EXIT_USAGE)
        return {"gmail_id": gmail_id, "input_kind": "id", "input": args.id, "resolved_via": "direct"}
    rfc_message_id = normalize_rfc_message_id(args.rfc_message_id)
    query = f"rfc822msgid:{rfc_message_id}"
    matches = gmail_list_messages(account, query, args.timeout_sec, max_results=2, include_spam_trash=True)
    if not matches:
        raise CliError("E_GMAIL_TARGET_NOT_FOUND", f"No Gmail message found for RFC Message-ID {rfc_message_id}", "Check --account or use --gmail-id.", EXIT_FAILURE)
    if len(matches) > 1:
        raise CliError("E_GMAIL_TARGET_AMBIGUOUS", f"Multiple Gmail messages matched RFC Message-ID {rfc_message_id}", "Use --gmail-id for the exact Gmail message id.", EXIT_FAILURE)
    match = matches[0]
    return {"gmail_id": str(match.get("id")), "thread_id": match.get("threadId"), "input_kind": "rfc_message_id", "input": rfc_message_id, "resolved_via": "gmail_search", "query": query}


def require_gmail_mutation_confirmation(args: argparse.Namespace, verb: str) -> None:
    if getattr(args, "confirm_mutate", False):
        return
    raise CliError("E_GMAIL_MUTATION_CONFIRMATION_REQUIRED", f"{verb} requires --confirm-mutate", "Only pass --confirm-mutate after the user explicitly approves this Gmail state change.", EXIT_USAGE)


# --- commands ---

def command_search(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    account = resolve_gmail_account(args)
    query = " ".join(part for part in [args.query, gmail_query_from_dates(args.date_from, args.date_to)] if part).strip()
    limit = clamp_limit(args.limit)
    cache_path = resolve_cache_path(args)
    messages = []
    for match in gmail_list_messages(account, query, args.timeout_sec, max_results=limit, include_spam_trash=args.include_spam_trash):
        gmail_id = str(match.get("id") or "").strip()
        if not gmail_id:
            continue
        raw = gmail_get_message(account, gmail_id, args.timeout_sec, fmt="metadata", metadata_headers=GMAIL_METADATA_HEADERS)
        msg = normalize_gmail_message(raw, include_body=False)
        if cache_enabled(args):
            cache_put_message(cache_path, account, msg, raw=raw, include_body=False)
            msg["cache"] = {"stored": True, "path": str(cache_path)}
        messages.append(msg)
    return {"backend": "gmail-api", "gmail_account": account, "query": query, "messages": messages, "cache": {"enabled": cache_enabled(args), "path": str(cache_path)}, "warnings": warnings.items}


def command_recent(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    parts = []
    date_query = gmail_query_from_dates(args.date_from, args.date_to)
    if date_query:
        parts.append(date_query)
    label = str(args.label or "inbox").strip()
    if label:
        parts.append(f"in:{label}")
    args.query = " ".join(parts).strip() or "in:inbox"
    return command_search(args, warnings)


def command_get(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    account = resolve_gmail_account(args)
    gmail_id = strip_gmail_message_prefix(args.id)
    cache_path = resolve_cache_path(args)
    if cache_enabled(args) and not args.refresh:
        cached = cache_get_message(cache_path, account, gmail_id)
        if cached and (cached.get("body_text") or cached.get("body_html")):
            return {"backend": "gmail-api", "gmail_account": account, "message": cached, "cache": {"enabled": True, "path": str(cache_path), "hit": True}, "warnings": warnings.items}
    raw = gmail_get_message(account, gmail_id, args.timeout_sec, fmt="full")
    msg = normalize_gmail_message(raw, include_body=True, max_body_chars=args.max_body_chars)
    if cache_enabled(args):
        cache_put_message(cache_path, account, msg, raw=raw, include_body=True)
        msg["cache"] = {"stored": True, "path": str(cache_path), "hit": False}
    return {"backend": "gmail-api", "gmail_account": account, "message": msg, "cache": {"enabled": cache_enabled(args), "path": str(cache_path), "hit": False}, "warnings": warnings.items}


def command_history(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    account = resolve_gmail_account(args)
    cache_path = resolve_cache_path(args)
    if not args.since:
        profile = gmail_api_request(account, "GET", "profile", None, args.timeout_sec)
        data = {"backend": "gmail-api", "gmail_account": account, "mode": "baseline", "history_id": profile.get("historyId"), "email_address": profile.get("emailAddress"), "messages_total": profile.get("messagesTotal"), "threads_total": profile.get("threadsTotal"), "messages": [], "deleted_message_ids": [], "next_action": "store history_id and pass it as --since on the next poll", "cache": {"enabled": cache_enabled(args), "path": str(cache_path)}, "warnings": warnings.items}
        if cache_enabled(args):
            cache_set_history(cache_path, account, data)
        return data

    params: list[tuple[str, str]] = [("startHistoryId", str(args.since)), ("maxResults", str(clamp_limit(args.limit)))]
    if args.label:
        params.append(("labelId", str(args.label)))
    for history_type in args.history_type or ["messageAdded"]:
        params.append(("historyTypes", str(history_type)))
    all_added: dict[str, dict[str, Any]] = {}
    deleted: list[str] = []
    page_token: str | None = args.page
    latest_history_id: str | None = None
    pages = 0
    while True:
        page_params = list(params)
        if page_token:
            page_params.append(("pageToken", page_token))
        result = gmail_api_request(account, "GET", "history?" + urllib.parse.urlencode(page_params), None, args.timeout_sec)
        latest_history_id = str(result.get("historyId") or latest_history_id or "")
        for history in result.get("history") or []:
            if not isinstance(history, dict):
                continue
            for entry in history.get("messagesAdded") or []:
                msg = entry.get("message") if isinstance(entry, dict) else None
                if isinstance(msg, dict) and msg.get("id"):
                    all_added[str(msg["id"])] = msg
            for entry in history.get("messagesDeleted") or []:
                msg = entry.get("message") if isinstance(entry, dict) else None
                if isinstance(msg, dict) and msg.get("id"):
                    deleted.append(str(msg["id"]))
        page_token = result.get("nextPageToken")
        pages += 1
        if not page_token or pages >= max(1, int(args.max_pages or 1)):
            break
    messages = []
    if args.fetch:
        for gmail_id in sorted(all_added):
            fmt = "full" if args.include_body else "metadata"
            raw = gmail_get_message(account, gmail_id, args.timeout_sec, fmt=fmt, metadata_headers=GMAIL_METADATA_HEADERS if fmt == "metadata" else None)
            msg = normalize_gmail_message(raw, include_body=bool(args.include_body), max_body_chars=args.max_body_chars)
            if cache_enabled(args):
                cache_put_message(cache_path, account, msg, raw=raw, include_body=bool(args.include_body))
                msg["cache"] = {"stored": True, "path": str(cache_path)}
            messages.append(msg)
    if cache_enabled(args):
        cache_set_history(cache_path, account, {"history_id": latest_history_id})
    return {"backend": "gmail-api", "gmail_account": account, "mode": "incremental", "since_history_id": str(args.since), "history_id": latest_history_id, "added_message_ids": sorted(all_added), "deleted_message_ids": deleted, "messages": messages, "fetched": bool(args.fetch), "pages_read": pages, "has_more": bool(page_token), "next_page_token": page_token, "cache": {"enabled": cache_enabled(args), "path": str(cache_path)}, "warnings": warnings.items}


def command_cache_status(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    account = resolve_gmail_account(args)
    path = resolve_cache_path(args)
    state = cache_get_state(path, account) or {"account": account, "history_id": None, "cached_messages": 0, "cached_bodies": 0, "updated_at": None}
    return {"backend": "gmail-cache", "cache": {"path": str(path), "exists": path.exists(), **state}, "warnings": warnings.items}


def command_sync(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    if not cache_enabled(args):
        raise CliError("E_CACHE_REQUIRED", "sync requires the local Gmail cache", "Remove --no-cache, or use `history` directly for stateless polling.", EXIT_USAGE)
    account = resolve_gmail_account(args)
    path = resolve_cache_path(args)
    if args.reset:
        state = None
    else:
        state = cache_get_state(path, account)
    if not state or not state.get("history_id"):
        profile = gmail_api_request(account, "GET", "profile", None, args.timeout_sec)
        data = {"history_id": profile.get("historyId"), "email_address": profile.get("emailAddress"), "messages_total": profile.get("messagesTotal"), "threads_total": profile.get("threadsTotal")}
        cache_set_history(path, account, data)
        return {"backend": "gmail-api", "gmail_account": account, "state": "baseline_created", "history_id": data["history_id"], "cache": {"path": str(path)}, "warnings": warnings.items}
    hist_args = argparse.Namespace(**vars(args))
    hist_args.since = state["history_id"]
    hist_args.fetch = args.fetch
    hist_args.include_body = args.include_body
    return {**command_history(hist_args, warnings), "state": "incremental_synced"}


def command_export(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    account = resolve_gmail_account(args)
    gmail_id = strip_gmail_message_prefix(args.id)
    out_dir = Path(args.out_dir).expanduser().resolve()
    out_dir.mkdir(parents=True, exist_ok=True)
    raw = gmail_get_message(account, gmail_id, args.timeout_sec, fmt="full")
    msg = normalize_gmail_message(raw, include_body=True)
    if cache_enabled(args):
        cache_put_message(resolve_cache_path(args), account, msg, raw=raw, include_body=True)
    safe_id = sanitize_filename(gmail_id, "gmail-message")
    written: list[dict[str, Any]] = []
    meta_path = out_dir / f"message-{safe_id}.json"
    meta_path.write_text(json.dumps(msg, ensure_ascii=False, indent=2), encoding="utf-8")
    written.append({"kind": "metadata_json", "path": str(meta_path)})
    if msg.get("body_text"):
        path = out_dir / f"message-{safe_id}.txt"
        path.write_text(str(msg["body_text"]), encoding="utf-8")
        written.append({"kind": "body_text", "path": str(path)})
    if msg.get("body_html"):
        path = out_dir / f"message-{safe_id}.html"
        path.write_text(str(msg["body_html"]), encoding="utf-8")
        written.append({"kind": "body_html", "path": str(path)})
    if args.raw:
        raw_result = gmail_get_message(account, gmail_id, args.timeout_sec, fmt="raw")
        raw_data = str(raw_result.get("raw") or "")
        path = out_dir / f"message-{safe_id}.eml"
        path.write_bytes(base64.urlsafe_b64decode((raw_data + "=" * (-len(raw_data) % 4)).encode("ascii")))
        written.append({"kind": "raw_eml", "path": str(path)})
    return {"backend": "gmail-api", "gmail_account": account, "message": msg, "out_dir": str(out_dir), "written": written, "warnings": warnings.items}


def command_attachments(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    account = resolve_gmail_account(args)
    gmail_id = strip_gmail_message_prefix(args.id)
    out_dir = Path(args.out_dir).expanduser().resolve()
    out_dir.mkdir(parents=True, exist_ok=True)
    raw = gmail_get_message(account, gmail_id, args.timeout_sec, fmt="full")
    msg = normalize_gmail_message(raw, include_body=True)
    saved: list[dict[str, Any]] = []
    for index, att in enumerate(msg.get("attachments") or [], start=1):
        attachment_id = att.get("attachment_id")
        if not attachment_id:
            continue
        result = gmail_api_request(account, "GET", f"messages/{quoted_gmail_id(gmail_id)}/attachments/{quoted_gmail_id(str(attachment_id))}", None, args.timeout_sec)
        raw_data = str(result.get("data") or "")
        data = base64.urlsafe_b64decode((raw_data + "=" * (-len(raw_data) % 4)).encode("ascii"))
        safe_name = sanitize_filename(att.get("filename"), f"attachment-{index}")
        target = out_dir / safe_name
        if target.exists():
            stem, suffix = target.stem, target.suffix
            i = 2
            while (out_dir / f"{stem}-{i}{suffix}").exists():
                i += 1
            target = out_dir / f"{stem}-{i}{suffix}"
        target.write_bytes(data)
        saved.append({**att, "path": str(target), "size_bytes": len(data)})
    return {"backend": "gmail-api", "gmail_account": account, "message": msg, "out_dir": str(out_dir), "attachments": saved, "warnings": warnings.items}


def command_draft(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    payload = draft_payload_from_args(args)
    account = resolve_gmail_account(args)
    if args.dry_run:
        return {"backend": "gmail-api", "gmail_account": account, "dry_run": True, "draft": {"state": "would_create_unsent_draft", "to": payload["to"], "cc": payload["cc"], "bcc_count": len(payload["bcc"]), "subject": payload["subject"], "sender": payload["sender"], "visible": False, "body_preview": payload["body"][:500], "attachments": payload["attachments"]}, "warnings": warnings.items}
    raw, message_id = build_gmail_raw_message(payload)
    result = gmail_api_request(account, "POST", "drafts", {"message": {"raw": raw}}, args.timeout_sec)
    message = result.get("message") if isinstance(result.get("message"), dict) else {}
    draft_id = result.get("id")
    return {"backend": "gmail-api", "gmail_account": account, "dry_run": False, "draft": {"id": f"gmail-draft:{draft_id}" if draft_id else None, "gmail_draft_id": draft_id, "gmail_message_id": message.get("id"), "gmail_thread_id": message.get("threadId"), "source_message_id": message_id, "subject": payload["subject"], "to": payload["to"], "cc": payload["cc"], "bcc_count": len(payload["bcc"]), "sender": payload["sender"], "visible": False, "state": "created_unsent_draft", "attachments": payload["attachments"], "links": {"gmail_drafts": gmail_drafts_url(account)}} , "warnings": warnings.items}


def command_draft_reply(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    get_args = argparse.Namespace(**vars(args))
    get_args.refresh = False
    data = command_get(get_args, warnings)
    msg = data.get("message") or {}
    _name, sender_addr = parseaddr(msg.get("sender") or "")
    to = args.to or ([sender_addr] if sender_addr else [])
    if not to:
        raise CliError("E_REPLY_RECIPIENT_UNAVAILABLE", "Could not infer reply recipient", "Pass --to explicitly.", EXIT_USAGE)
    subject = args.subject or (msg.get("subject") or "")
    if subject and not subject.lower().startswith("re:"):
        subject = "Re: " + subject
    draft_args = argparse.Namespace(**vars(args))
    draft_args.to = to
    draft_args.subject = subject
    payload = draft_payload_from_args(draft_args)
    payload["in_reply_to"] = msg.get("source_message_id")
    payload["references"] = [msg.get("source_message_id")] if msg.get("source_message_id") else []
    account = resolve_gmail_account(args)
    if args.dry_run:
        return {"backend": "gmail-api", "gmail_account": account, "read_backend": data.get("backend"), "dry_run": True, "draft": {"state": "would_create_unsent_reply_draft", "to": payload["to"], "subject": payload["subject"], "sender": payload["sender"], "reply_to": {"id": args.id, "sender": msg.get("sender"), "source_message_id": msg.get("source_message_id")}, "body_preview": payload["body"][:500], "attachments": payload["attachments"]}, "warnings": warnings.items}
    raw, message_id = build_gmail_raw_message(payload)
    result = gmail_api_request(account, "POST", "drafts", {"message": {"raw": raw}}, args.timeout_sec)
    message = result.get("message") if isinstance(result.get("message"), dict) else {}
    draft_id = result.get("id")
    return {"backend": "gmail-api", "gmail_account": account, "read_backend": data.get("backend"), "dry_run": False, "draft": {"id": f"gmail-draft:{draft_id}" if draft_id else None, "gmail_draft_id": draft_id, "gmail_message_id": message.get("id"), "gmail_thread_id": message.get("threadId"), "source_message_id": message_id, "subject": payload["subject"], "to": payload["to"], "sender": payload["sender"], "state": "created_unsent_reply_draft", "attachments": payload["attachments"], "reply_to": {"id": args.id, "sender": msg.get("sender"), "source_message_id": msg.get("source_message_id")}, "links": {"gmail_drafts": gmail_drafts_url(account)}} , "warnings": warnings.items}


def command_send(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    if not args.confirm_send:
        raise CliError("E_SEND_CONFIRMATION_REQUIRED", "Sending email requires --confirm-send", "Prefer `dobby-mail draft` first. Only pass --confirm-send after the user explicitly approves recipients and body.", EXIT_USAGE)
    payload = draft_payload_from_args(args)
    account = resolve_gmail_account(args)
    if args.dry_run:
        return {"backend": "gmail-api", "gmail_account": account, "dry_run": True, "sent": {"state": "would_send", "to": payload["to"], "cc": payload["cc"], "bcc_count": len(payload["bcc"]), "subject": payload["subject"], "sender": payload["sender"], "body_preview": payload["body"][:500], "attachments": payload["attachments"]}, "warnings": warnings.items}
    raw, message_id = build_gmail_raw_message(payload)
    result = gmail_api_request(account, "POST", "messages/send", {"raw": raw}, args.timeout_sec)
    return {"backend": "gmail-api", "gmail_account": account, "dry_run": False, "sent": {"id": f"gmail-message:{result.get('id')}" if result.get("id") else None, "gmail_message_id": result.get("id"), "gmail_thread_id": result.get("threadId"), "source_message_id": message_id, "subject": payload["subject"], "to": payload["to"], "sender": payload["sender"], "state": "sent", "attachments": payload["attachments"]}, "warnings": warnings.items}


def merge_label_actions(actions: Iterable[str], add_label_ids: Iterable[str] = (), remove_label_ids: Iterable[str] = ()) -> tuple[list[str], list[str]]:
    add = [str(item).strip() for item in add_label_ids if str(item).strip()]
    remove = [str(item).strip() for item in remove_label_ids if str(item).strip()]
    for action in actions:
        if action == "archive": remove.append("INBOX")
        elif action == "trash": add.append("TRASH"); remove.append("INBOX")
        elif action == "spam": add.append("SPAM"); remove.append("INBOX")
        elif action == "mark-read": remove.append("UNREAD")
        elif action == "mark-unread": add.append("UNREAD")
        elif action == "star": add.append("STARRED")
        elif action == "unstar": remove.append("STARRED")
        elif action == "important": add.append("IMPORTANT")
        elif action == "not-important": remove.append("IMPORTANT")
        else: raise CliError("E_GMAIL_ACTION_UNSUPPORTED", f"Unsupported Gmail action: {action}", "Use archive, trash, spam, mark-read, mark-unread, star, unstar, important, or not-important.", EXIT_USAGE)
    def unique(seq: list[str]) -> list[str]:
        out = []
        seen = set()
        for item in seq:
            if item not in seen:
                seen.add(item); out.append(item)
        return out
    add = unique(add)
    remove = [item for item in unique(remove) if item not in set(add)]
    return add, remove


def command_gmail_label_mutation(args: argparse.Namespace, warnings: WarningSink, *, action_name: str, add_label_ids: list[str], remove_label_ids: list[str]) -> dict[str, Any]:
    require_gmail_mutation_confirmation(args, action_name)
    account = resolve_gmail_account(args)
    target = resolve_gmail_message_target(args, account)
    mutation = {"state": f"would_{action_name}" if args.dry_run else action_name, "add_label_ids": add_label_ids, "remove_label_ids": remove_label_ids}
    if args.dry_run:
        return {"backend": "gmail-api", "gmail_account": account, "dry_run": True, "action": action_name, "target": target, "changed": mutation, "warnings": warnings.items}
    result = gmail_api_request(account, "POST", f"messages/{quoted_gmail_id(target['gmail_id'])}/modify", {"addLabelIds": add_label_ids, "removeLabelIds": remove_label_ids}, args.timeout_sec)
    return {"backend": "gmail-api", "gmail_account": account, "dry_run": False, "action": action_name, "target": target, "message": {"id": f"gmail-message:{result.get('id')}" if result.get("id") else None, "gmail_message_id": result.get("id"), "gmail_thread_id": result.get("threadId"), "label_ids": result.get("labelIds") or []}, "changed": {**mutation, "state": action_name}, "warnings": warnings.items}


def command_gmail_archive(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    return command_gmail_label_mutation(args, warnings, action_name="archive", add_label_ids=[], remove_label_ids=["INBOX"])


def command_gmail_spam(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    return command_gmail_label_mutation(args, warnings, action_name="mark_spam", add_label_ids=["SPAM"], remove_label_ids=["INBOX"])


def command_gmail_mark_read(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    if args.unread:
        return command_gmail_label_mutation(args, warnings, action_name="mark_unread", add_label_ids=["UNREAD"], remove_label_ids=[])
    return command_gmail_label_mutation(args, warnings, action_name="mark_read", add_label_ids=[], remove_label_ids=["UNREAD"])


def command_gmail_trash(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    require_gmail_mutation_confirmation(args, "trash")
    account = resolve_gmail_account(args)
    target = resolve_gmail_message_target(args, account)
    if args.dry_run:
        return {"backend": "gmail-api", "gmail_account": account, "dry_run": True, "action": "trashed", "target": target, "changed": {"state": "would_trash", "reversible": True}, "warnings": warnings.items}
    result = gmail_api_request(account, "POST", f"messages/{quoted_gmail_id(target['gmail_id'])}/trash", None, args.timeout_sec)
    return {"backend": "gmail-api", "gmail_account": account, "dry_run": False, "action": "trashed", "target": target, "message": {"id": f"gmail-message:{result.get('id')}" if result.get("id") else None, "gmail_message_id": result.get("id"), "gmail_thread_id": result.get("threadId")}, "changed": {"state": "trashed", "reversible": True}, "warnings": warnings.items}


def gmail_filter_payload_from_args(args: argparse.Namespace, *, default_action: str | None = None) -> dict[str, Any]:
    criteria: dict[str, Any] = {}
    if args.from_address: criteria["from"] = str(args.from_address).strip()
    if args.to: criteria["to"] = str(args.to).strip()
    if args.subject: criteria["subject"] = str(args.subject).strip()
    if args.query: criteria["query"] = str(args.query).strip()
    if args.negated_query: criteria["negatedQuery"] = str(args.negated_query).strip()
    if args.has_attachment: criteria["hasAttachment"] = True
    if args.exclude_chats: criteria["excludeChats"] = True
    criteria = {k: v for k, v in criteria.items() if v not in {"", None}}
    if not criteria:
        raise CliError("E_GMAIL_FILTER_CRITERIA_REQUIRED", "Gmail filter requires at least one criterion", "Pass --from, --to, --subject, --query, --negated-query, or --has-attachment.", EXIT_USAGE)
    actions = list(args.action or [])
    if default_action and not actions:
        actions.append(default_action)
    add, remove = merge_label_actions(actions, args.add_label or [], args.remove_label or [])
    if not add and not remove:
        raise CliError("E_GMAIL_FILTER_ACTION_REQUIRED", "Gmail filter requires at least one action", "Pass --action archive/trash/spam/mark-read, or --add-label/--remove-label.", EXIT_USAGE)
    action_payload: dict[str, Any] = {}
    if add: action_payload["addLabelIds"] = add
    if remove: action_payload["removeLabelIds"] = remove
    return {"criteria": criteria, "action": action_payload}


def command_gmail_filter(args: argparse.Namespace, warnings: WarningSink, *, default_action: str | None = None, command_action: str = "created_filter") -> dict[str, Any]:
    require_gmail_mutation_confirmation(args, "create Gmail filter")
    account = resolve_gmail_account(args)
    payload = gmail_filter_payload_from_args(args, default_action=default_action)
    data = {"backend": "gmail-api", "gmail_account": account, "dry_run": bool(args.dry_run), "action": command_action, "filter": payload, "applies_to_existing_messages": False, "warnings": warnings.items}
    if args.dry_run:
        data["created"] = {"state": f"would_{command_action.replace('created_', 'create_', 1)}"}
        return data
    result = gmail_api_request(account, "POST", "settings/filters", payload, args.timeout_sec)
    data["created"] = {"state": command_action, "id": result.get("id"), "criteria": result.get("criteria") or payload.get("criteria"), "action": result.get("action") or payload.get("action")}
    return data


def command_gmail_block_sender(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    return command_gmail_filter(args, warnings, default_action="trash", command_action="created_sender_trash_filter")


class _GmailOAuthCallbackHandler(http.server.BaseHTTPRequestHandler):
    server_version = "DobbyMailOAuth/1.0"
    def log_message(self, fmt: str, *args: Any) -> None:
        return
    def do_GET(self) -> None:  # noqa: N802
        parsed = urllib.parse.urlparse(self.path)
        params = urllib.parse.parse_qs(parsed.query)
        expected_state = getattr(self.server, "oauth_state", None)  # type: ignore[attr-defined]
        actual_state = (params.get("state") or [None])[0]
        if expected_state and actual_state != expected_state:
            self.server.oauth_error = "state_mismatch"  # type: ignore[attr-defined]
            self.server.oauth_code = None  # type: ignore[attr-defined]
        else:
            self.server.oauth_code = (params.get("code") or [None])[0]  # type: ignore[attr-defined]
        self.server.oauth_error = (params.get("error") or [None])[0]  # type: ignore[attr-defined]
        body = b"OAuth complete. You can close this tab and return to Dobby." if self.server.oauth_code else b"OAuth failed or was denied. Return to Dobby for details."  # type: ignore[attr-defined]
        self.send_response(200 if self.server.oauth_code else 400)  # type: ignore[attr-defined]
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


def command_gmail_auth(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    if args.no_input:
        raise CliError("E_GMAIL_AUTH_INTERACTIVE", "gmail-auth requires a browser consent click and cannot run with --no-input", f"Run `dobby-mail gmail-auth --account {args.account or config_value(DEFAULT_ACCOUNT_ENV) or '<email>'}` interactively once.", EXIT_USAGE)
    account = clean_email_address(args.account or config_value(DEFAULT_ACCOUNT_ENV))
    if not account:
        raise CliError("E_DEFAULT_ACCOUNT_REQUIRED", f"{DEFAULT_ACCOUNT_ENV} or --account is required for gmail-auth", "Run `dobby-mail gmail-auth --account you@example.com`.", EXIT_USAGE)
    cfg = load_gmail_client_config()
    state = "dobby-mail-" + uuid.uuid4().hex
    timeout = int(args.timeout_sec or 300)
    with socketserver.TCPServer(("127.0.0.1", 0), _GmailOAuthCallbackHandler) as server:
        server.timeout = timeout
        server.oauth_code = None  # type: ignore[attr-defined]
        server.oauth_error = None  # type: ignore[attr-defined]
        server.oauth_state = state  # type: ignore[attr-defined]
        host, port = server.server_address
        redirect_uri = f"http://localhost:{port}/"
        query = urllib.parse.urlencode({"client_id": cfg["client_id"], "redirect_uri": redirect_uri, "response_type": "code", "scope": " ".join(GMAIL_SCOPES), "access_type": "offline", "prompt": "select_account consent", "state": state, "login_hint": account})
        auth_url = cfg["auth_uri"] + "?" + query
        print(f"[dobby-mail] Open this Gmail OAuth URL if the browser does not open automatically:\n{auth_url}", file=sys.stderr)
        if not args.no_browser:
            with contextlib.suppress(Exception):
                webbrowser.open(auth_url)
        server.handle_request()
        if server.oauth_error:  # type: ignore[attr-defined]
            raise CliError("E_GMAIL_AUTH_DENIED", f"Gmail OAuth was denied: {server.oauth_error}", "Re-run gmail-auth and approve Gmail access.", EXIT_AUTH)
        code = server.oauth_code  # type: ignore[attr-defined]
    if not code:
        raise CliError("E_GMAIL_AUTH_TIMEOUT", "Timed out waiting for Gmail OAuth callback", "Re-run gmail-auth and complete the browser consent flow.", EXIT_TIMEOUT, retryable=True)
    fields = {"client_id": cfg["client_id"], "code": str(code), "grant_type": "authorization_code", "redirect_uri": redirect_uri}
    if cfg.get("client_secret"):
        fields["client_secret"] = cfg["client_secret"]
    token = gmail_form_post(cfg["token_uri"], fields, timeout)
    refresh = str(token.get("refresh_token") or "").strip()
    if not refresh:
        raise CliError("E_GMAIL_REFRESH_TOKEN_MISSING", "Google did not return a refresh token", "Re-run gmail-auth. If you previously approved this app, revoke it in Google Account access first or keep prompt=consent.", EXIT_AUTH)
    tokens_path = gmail_update_tokens_file(account, refresh)
    return {"backend": "gmail-api", "account": account, "stored_refresh_token": "tokens_file", "tokens_file": str(tokens_path), "scopes": GMAIL_SCOPES, "client_file": cfg["path"], "canonical_source": "Azure Key Vault via ~/GitHub/scripts/sync/keyvault-sync-gmail-secrets.sh", "warnings": warnings.items}


def command_doctor(args: argparse.Namespace, warnings: WarningSink) -> dict[str, Any]:
    checks: list[dict[str, Any]] = []
    def add(name: str, status: str, message: str, hint: str | None = None, details: dict[str, Any] | None = None):
        checks.append({"name": name, "status": status, "message": message, "hint": hint, "details": details or {}})
    account = clean_email_address(getattr(args, "account", None) or config_value(DEFAULT_ACCOUNT_ENV))
    add("default_account", "ok" if account else "warn", account or "not configured", f"Set {DEFAULT_ACCOUNT_ENV} or pass --account." if not account else None)
    try:
        cfg = load_gmail_client_config()
        add("gmail_oauth_client", "ok", cfg["path"], details={"scopes": GMAIL_SCOPES})
    except CliError as exc:
        add("gmail_oauth_client", "error", exc.message, exc.hint, {"code": exc.code})
        cfg = None
    if account:
        has_token, token_source = gmail_has_refresh_token(account)
        add("gmail_refresh_token", "ok" if has_token else "warn", f"Refresh token {'found' if has_token else 'not found'} for {account}", f"Run `~/GitHub/scripts/sync/keyvault-sync-gmail-secrets.sh --apply`, or run `dobby-mail gmail-auth --account {account}` once." if not has_token else None, {"account": account, "source": token_source, "tokens_file": str(resolve_gmail_tokens_file(required=False)) if resolve_gmail_tokens_file(required=False) else None})
        if args.check_gmail_api and cfg and has_token:
            try:
                gmail_access_token(account, args.timeout_sec)
                add("gmail_api_backend", "ok", f"Access token refresh succeeded for {account}")
            except CliError as exc:
                add("gmail_api_backend", "warn" if exc.exit_code in {EXIT_AUTH, EXIT_TIMEOUT} else "error", exc.message, exc.hint, {"code": exc.code})
        elif args.check_gmail_api:
            add("gmail_api_backend", "skipped", "Cannot test Gmail API backend until OAuth client/token are configured.")
        else:
            add("gmail_api_backend", "skipped", "Pass --check-gmail-api to test token refresh; no mail is read or written.")
    path = resolve_cache_path(args)
    add("gmail_cache", "ok" if path.parent.exists() or not path.exists() else "warn", str(path), details={"exists": path.exists()})
    statuses = {c["status"] for c in checks}
    summary = "needs_attention" if "error" in statuses else ("degraded" if "warn" in statuses else "ok")
    return {"selected_backend": "gmail-api", "checks": checks, "summary": summary, "warnings": warnings.items}


# --- parser ---

def add_common(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--json", action="store_true", help="Emit JSON output (default).")
    parser.add_argument("--plain", action="store_true", help="Emit stable plain text for operator inspection.")
    parser.add_argument("--no-input", action="store_true", help="Accepted for non-interactive agent safety; prompts are never used.")
    parser.add_argument("--quiet", action="store_true", help="Suppress warnings on stderr; warnings remain in JSON.")
    parser.add_argument("--timeout-sec", type=int, default=30, help="Timeout for Gmail API calls.")
    parser.add_argument("--account", help=f"Gmail/Google Workspace account. Defaults to {DEFAULT_ACCOUNT_ENV}.")
    parser.add_argument("--cache-path", help=f"SQLite cache path. Defaults to {GMAIL_CACHE_PATH_ENV} or ~/.cache/dobby-mail/cache.sqlite.")
    parser.add_argument("--no-cache", action="store_true", help="Disable local Gmail cache for this command.")


def add_draft_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--to", action="append", help="Recipient address. Repeat or comma-separate.")
    parser.add_argument("--cc", action="append", help="CC address. Repeat or comma-separate.")
    parser.add_argument("--bcc", action="append", help="BCC address. Repeat or comma-separate.")
    parser.add_argument("--subject", required=False, help="Message subject.")
    parser.add_argument("--body", help="Message body text.")
    parser.add_argument("--body-file", help="Path to body text, or - for stdin.")
    parser.add_argument("--attach", action="append", help="Outbound attachment file path. Repeat or comma-separate.")
    parser.add_argument("--sender", help=f"Sender address. If omitted, {DEFAULT_FROM_ENV} is required.")
    parser.add_argument("--dry-run", action="store_true", help="Return intended action without creating/sending anything.")


def add_gmail_target_args(parser: argparse.ArgumentParser) -> None:
    target = parser.add_argument_group("target")
    target.add_argument("--gmail-id", help="Gmail API message id. May also be gmail-message:<id>.")
    target.add_argument("--rfc-message-id", help="RFC Message-ID / source_message_id from a Dobby Mail read result.")
    target.add_argument("--id", help="Alias for Gmail API id forms.")
    parser.add_argument("--confirm-mutate", action="store_true", help="Required explicit confirmation for Gmail state changes.")
    parser.add_argument("--dry-run", action="store_true", help="Return intended mutation without changing Gmail state.")


def add_gmail_filter_args(parser: argparse.ArgumentParser, *, from_required: bool = False) -> None:
    parser.add_argument("--from", dest="from_address", required=from_required, help="Sender display name or email address to match.")
    parser.add_argument("--to", help="Recipient display name or email address to match.")
    parser.add_argument("--subject", help="Subject phrase to match.")
    parser.add_argument("--query", help="Gmail search query criterion.")
    parser.add_argument("--negated-query", help="Gmail search query criterion that must not match.")
    parser.add_argument("--has-attachment", action="store_true", help="Match messages with attachments.")
    parser.add_argument("--exclude-chats", action="store_true", help="Exclude chats from matching.")
    parser.add_argument("--action", action="append", choices=["archive", "trash", "spam", "mark-read", "mark-unread", "star", "unstar", "important", "not-important"], help="Filter action. Repeat for multiple deterministic label actions.")
    parser.add_argument("--add-label", action="append", help="Raw Gmail label id to add.")
    parser.add_argument("--remove-label", action="append", help="Raw Gmail label id to remove.")
    parser.add_argument("--confirm-mutate", action="store_true", help="Required explicit confirmation for Gmail filter changes.")
    parser.add_argument("--dry-run", action="store_true", help="Return intended filter without changing Gmail settings.")


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = DobbyArgumentParser(description="Gmail-only mail client for Dobby. JSON-first, non-interactive, cached, draft-safe.")
    add_common(parser)
    parser.add_argument("--version", action="store_true", help="Print version envelope.")
    sub = parser.add_subparsers(dest="cmd", parser_class=DobbyArgumentParser)

    p = sub.add_parser("doctor", help="Check Gmail backend and cache availability."); add_common(p); p.add_argument("--check-gmail-api", action="store_true"); p.set_defaults(func=command_doctor)
    p = sub.add_parser("gmail-auth", help="One-time interactive Gmail OAuth setup."); add_common(p); p.add_argument("--no-browser", action="store_true"); p.set_defaults(func=command_gmail_auth)
    p = sub.add_parser("cache-status", help="Inspect local Gmail cache state."); add_common(p); p.set_defaults(func=command_cache_status)
    p = sub.add_parser("sync", help="Run cached Gmail history sync."); add_common(p); p.add_argument("--reset", action="store_true"); p.add_argument("--fetch", action="store_true"); p.add_argument("--include-body", action="store_true"); p.add_argument("--label", default="INBOX"); p.add_argument("--history-type", action="append", choices=["messageAdded", "messageDeleted", "labelAdded", "labelRemoved"]); p.add_argument("--limit", type=int, default=100); p.add_argument("--max-pages", type=int, default=1); p.add_argument("--page"); p.add_argument("--max-body-chars", type=int, default=None); p.set_defaults(func=command_sync)

    p = sub.add_parser("search", help="Search Gmail messages using Gmail query syntax."); add_common(p); p.add_argument("--query", required=True); p.add_argument("--limit", type=int, default=DEFAULT_LIMIT); p.add_argument("--from", dest="date_from"); p.add_argument("--to", dest="date_to"); p.add_argument("--include-spam-trash", action="store_true", default=True); p.set_defaults(func=command_search)
    p = sub.add_parser("recent", help="List recent Gmail messages."); add_common(p); p.add_argument("--limit", type=int, default=DEFAULT_LIMIT); p.add_argument("--from", dest="date_from"); p.add_argument("--to", dest="date_to"); p.add_argument("--label", default="inbox"); p.add_argument("--include-spam-trash", action="store_true", default=True); p.set_defaults(func=command_recent)
    p = sub.add_parser("get", help="Get one Gmail message body by id."); add_common(p); p.add_argument("--id", required=True, help="gmail-message:<id> or raw Gmail message id."); p.add_argument("--max-body-chars", type=int, default=None); p.add_argument("--refresh", action="store_true", help="Bypass cached body and refetch from Gmail."); p.set_defaults(func=command_get)
    p = sub.add_parser("history", help="Gmail incremental history primitive for polling/sync."); add_common(p); p.add_argument("--since"); p.add_argument("--label", default="INBOX"); p.add_argument("--history-type", action="append", choices=["messageAdded", "messageDeleted", "labelAdded", "labelRemoved"]); p.add_argument("--limit", type=int, default=100); p.add_argument("--max-pages", type=int, default=1); p.add_argument("--page"); p.add_argument("--fetch", action="store_true"); p.add_argument("--include-body", action="store_true"); p.add_argument("--max-body-chars", type=int, default=None); p.set_defaults(func=command_history)
    p = sub.add_parser("export", help="Export one Gmail message body/metadata to files."); add_common(p); p.add_argument("--id", required=True); p.add_argument("--out-dir", required=True); p.add_argument("--raw", action="store_true"); p.set_defaults(func=command_export)
    p = sub.add_parser("attachments", help="Extract attachments from one Gmail message."); add_common(p); p.add_argument("--id", required=True); p.add_argument("--out-dir", required=True); p.set_defaults(func=command_attachments)

    p = sub.add_parser("draft", help="Create an unsent Gmail draft."); add_common(p); add_draft_args(p); p.set_defaults(func=command_draft)
    p = sub.add_parser("draft-reply", help="Create an unsent reply draft from a Gmail message id."); add_common(p); add_draft_args(p); p.add_argument("--id", required=True); p.add_argument("--refresh", action="store_true"); p.add_argument("--max-body-chars", type=int, default=0); p.set_defaults(func=command_draft_reply)
    p = sub.add_parser("send", help="Send a new email through Gmail API. Requires --confirm-send."); add_common(p); add_draft_args(p); p.add_argument("--confirm-send", action="store_true"); p.set_defaults(func=command_send)

    p = sub.add_parser("gmail-archive", help="Archive one Gmail message by removing INBOX. Requires --confirm-mutate."); add_common(p); add_gmail_target_args(p); p.set_defaults(func=command_gmail_archive)
    p = sub.add_parser("gmail-trash", help="Move one Gmail message to Trash. Requires --confirm-mutate."); add_common(p); add_gmail_target_args(p); p.set_defaults(func=command_gmail_trash)
    p = sub.add_parser("gmail-spam", help="Move one Gmail message to Spam. Requires --confirm-mutate."); add_common(p); add_gmail_target_args(p); p.set_defaults(func=command_gmail_spam)
    p = sub.add_parser("gmail-mark-read", help="Mark one Gmail message read/unread. Requires --confirm-mutate."); add_common(p); add_gmail_target_args(p); p.add_argument("--unread", action="store_true"); p.set_defaults(func=command_gmail_mark_read)
    p = sub.add_parser("gmail-filter", help="Create a Gmail server-side filter. Requires --confirm-mutate."); add_common(p); add_gmail_filter_args(p); p.set_defaults(func=command_gmail_filter)
    p = sub.add_parser("gmail-block-sender", help="Create a future-message sender filter to Trash. Requires --confirm-mutate."); add_common(p); add_gmail_filter_args(p, from_required=True); p.set_defaults(func=command_gmail_block_sender)

    args = parser.parse_args(argv)
    if args.version:
        args.cmd = "version"; return args
    if not args.cmd:
        parser.error("a subcommand is required")
    return args


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    request_id = f"mail-{uuid.uuid4()}"
    started = time.time()
    command_name = TOOL
    try:
        args = parse_args(argv)
        warnings = WarningSink(quiet=bool(getattr(args, "quiet", False)))
        if getattr(args, "version", False) and getattr(args, "cmd", None) == "version":
            payload = make_envelope(f"{TOOL} version", "ok", {"version": VERSION, "warnings": []}, None, request_id, started)
            emit(payload, plain=bool(getattr(args, "plain", False)))
            return EXIT_OK
        command_name = f"{TOOL} {args.cmd}"
        data = args.func(args, warnings)
        payload = make_envelope(command_name, "ok", data, None, request_id, started)
        emit(payload, plain=bool(getattr(args, "plain", False)))
        return EXIT_OK
    except CliError as exc:
        payload = make_envelope(command_name, "error", {}, {"code": exc.code, "message": exc.message, "retryable": exc.retryable, "hint": exc.hint}, request_id, started)
        emit(payload, plain=False)
        return exc.exit_code
    except KeyboardInterrupt:
        payload = make_envelope(command_name, "error", {}, {"code": "E_INTERRUPTED", "message": "Interrupted", "retryable": True, "hint": "Retry the command if still needed."}, request_id, started)
        emit(payload, plain=False)
        return EXIT_TIMEOUT
    except Exception as exc:  # noqa: BLE001
        if os.environ.get("DEBUG"):
            import traceback
            traceback.print_exc(file=sys.stderr)
        payload = make_envelope(command_name, "error", {}, {"code": "E_UNEXPECTED", "message": str(exc), "retryable": False, "hint": "Re-run with DEBUG=1 for stack trace, then fix/classify this error."}, request_id, started)
        emit(payload, plain=False)
        return EXIT_FAILURE


if __name__ == "__main__":
    raise SystemExit(main())
