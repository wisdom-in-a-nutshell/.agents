#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import subprocess
import sys
import time
import uuid
from pathlib import Path
from typing import Any


DEFAULT_SYMPHONY_DIR = Path.home() / "GitHub/symphony"
SCHEMA_VERSION = "1.0"


def main(argv: list[str] | None = None) -> int:
    started = time.perf_counter()
    request_id = str(uuid.uuid4())
    parser = build_parser()
    args = parser.parse_args(argv)

    try:
        task_args = normalize_task_args(args.task_args)
        if not task_args:
            raise HelperError("E_USAGE", "missing task command", "Use `task get <work-id> --no-input`.", 2)
        command = [*symphony_command(args), "task", *task_args]
        if args.db and "--db" not in task_args:
            command.extend(["--db", args.db])
        proc = subprocess.run(
            command,
            input=read_stdin_if_needed(task_args),
            text=True,
            capture_output=True,
            check=False,
            timeout=120,
        )
    except HelperError as exc:
        emit(error_envelope("task", exc, started, request_id))
        return exc.exit_code
    except Exception as exc:
        error = HelperError("E_INTERNAL", str(exc), "Check the Symphony repo and retry.", 1)
        emit(error_envelope("task", error, started, request_id))
        return error.exit_code

    if proc.stderr:
        sys.stderr.write(proc.stderr)
    if proc.stdout:
        sys.stdout.write(proc.stdout)
        if not proc.stdout.endswith("\n"):
            sys.stdout.write("\n")
    return proc.returncode


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="symphony task")
    parser.add_argument("--symphony-dir", default=str(DEFAULT_SYMPHONY_DIR), help="Path to the Symphony repo.")
    parser.add_argument("--symphony-cli", help="Path to a built Symphony JS CLI, or an executable command on PATH.")
    parser.add_argument("--db", help="Override the Symphony SQLite database path.")
    parser.add_argument("task_args", nargs=argparse.REMAINDER)
    return parser


def normalize_task_args(task_args: list[str]) -> list[str]:
    if task_args and task_args[0] == "--":
        return task_args[1:]
    return task_args


def read_stdin_if_needed(task_args: list[str]) -> str | None:
    for index, arg in enumerate(task_args):
        if arg == "--note-file" and index + 1 < len(task_args) and task_args[index + 1] == "-":
            return sys.stdin.read()
    return None


def symphony_command(args: argparse.Namespace) -> list[str]:
    if args.symphony_cli:
        cli = Path(args.symphony_cli).expanduser()
        if cli.exists():
            return ["node", str(cli)] if cli.suffix == ".js" else [str(cli)]
        return [args.symphony_cli]

    symphony_dir = Path(args.symphony_dir).expanduser()
    cli = symphony_dir / "dist/src/cli.js"
    if not cli.exists():
        build_symphony(symphony_dir)
    if not cli.exists():
        raise HelperError(
            "E_IO",
            f"Symphony CLI not found after build: {cli}",
            "Run `cd ~/GitHub/symphony && npm run build -- --pretty false`.",
            1,
        )
    return ["node", str(cli)]


def build_symphony(symphony_dir: Path) -> None:
    if not (symphony_dir / "package.json").is_file():
        raise HelperError("E_IO", f"Symphony repo not found: {symphony_dir}", "Check --symphony-dir.", 1)
    proc = subprocess.run(
        ["npm", "run", "build", "--", "--pretty", "false"],
        cwd=str(symphony_dir),
        text=True,
        capture_output=True,
        stdin=subprocess.DEVNULL,
        check=False,
        timeout=120,
    )
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip()
        raise HelperError("E_INTERNAL", f"failed to build Symphony: {detail[-1000:]}", "Fix the Symphony build.", 1)


def error_envelope(command: str, error: "HelperError", started: float, request_id: str) -> dict[str, Any]:
    return {
        "schema_version": SCHEMA_VERSION,
        "command": command,
        "status": "error",
        "data": None,
        "error": {
            "code": error.code,
            "message": error.message,
            "retryable": False,
            "hint": error.hint,
        },
        "meta": {
            "request_id": request_id,
            "duration_ms": round((time.perf_counter() - started) * 1000),
            "timestamp_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        },
    }


def emit(payload: dict[str, Any]) -> None:
    print(json.dumps(payload, sort_keys=True))


class HelperError(Exception):
    def __init__(self, code: str, message: str, hint: str, exit_code: int) -> None:
        super().__init__(message)
        self.code = code
        self.message = message
        self.hint = hint
        self.exit_code = exit_code


if __name__ == "__main__":
    raise SystemExit(main())
